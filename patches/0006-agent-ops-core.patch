diff --git a/coreutils/peek.c b/coreutils/peek.c
new file mode 100644
index 0000000..1a1b177
--- /dev/null
+++ b/coreutils/peek.c
@@ -0,0 +1,1039 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * peek - bounded, numbered and versioned file reads.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config PEEK
+//config:	bool "peek (7 kb)"
+//config:	default y
+//config:	select AGENT_JSON
+//config:	help
+//config:	Bounded file inspection for tools: numbered lines, byte budget,
+//config:	truncation cursor and a content version for guarded edits.
+
+//applet:IF_PEEK(APPLET(peek, BB_DIR_USR_BIN, BB_SUID_DROP))
+
+//kbuild:lib-$(CONFIG_PEEK) += peek.o
+
+//usage:#define peek_trivial_usage
+//usage:       "[OPTIONS] FILE..."
+//usage:#define peek_full_usage "\n\n"
+//usage:       "Print numbered lines of FILE with an explicit byte budget"
+//usage:     "\n"
+//usage:     "\n	-l RANGE	Lines to print, 1-based inclusive: A:B, A, or :B"
+//usage:     "\n	-a STRING	Print windows around each literal STRING match"
+//usage:     "\n	-c N		Context lines for -a (default 10)"
+//usage:     "\n	-r		Treat -a as a POSIX extended regex"
+//usage:     "\n	-F N		Start at byte offset N (continuation)"
+//usage:     "\n	-B N		Byte budget for content (default 16384)"
+//usage:     "\n	-M N		Refuse files larger than N bytes (default 33554432)"
+//usage:     "\n	-R FILE		Batch request (JSON)"
+//usage:     "\n	-p		Hex preview of binary files"
+//usage:     "\n	-f, --format FMT	Output format: text (default) or json"
+//usage:     "\n"
+//usage:     "\nExit: 0 ok, 1 operation failed, 2 usage error"
+//usage:     "\n\"truncated=true\" comes with next=--from-byte N; nothing is skipped."
+
+#include <regex.h>
+#include "libbb.h"
+#include "json_read.h"
+
+enum {
+	DEFAULT_MAX_BYTES = 16384,
+	DEFAULT_MAX_FILE = 32 * 1024 * 1024,
+	DEFAULT_CONTEXT = 10,
+	MAX_WINDOWS = 200,
+	BINARY_SNIFF = 8192,
+};
+
+struct peek_req {
+	char *id;
+	char *path;
+	char *lines;
+	char *around;
+	int context;
+	long from_byte;      /* -1 when unset */
+	int has_from;
+	char *diff_hash;     /* --diff: expected sha256 hex, or NULL */
+};
+
+struct peek_range {
+	unsigned first, last;   /* 0-based, inclusive */
+};
+
+struct peek_out {
+	int json;
+	size_t budget;      /* remaining content bytes */
+	size_t shown;       /* content bytes emitted */
+	int truncated;
+	size_t next_off;    /* byte offset to continue from */
+};
+
+/* ---------- helpers ---------- */
+
+static const char *find_bytes(const char *hay, size_t hlen,
+		const char *needle, size_t nlen, size_t start)
+{
+	size_t i, last;
+
+	if (nlen == 0 || nlen > hlen || start > hlen - nlen)
+		return NULL;
+	last = hlen - nlen;
+	for (i = start; i <= last; i++) {
+		if (hay[i] == needle[0] && memcmp(hay + i, needle, nlen) == 0)
+			return hay + i;
+	}
+	return NULL;
+}
+
+static size_t utf8_cut(const char *s, size_t n)
+{
+	while (n > 0 && ((unsigned char)s[n] & 0xc0) == 0x80)
+		n--;
+	return n;
+}
+
+static int detect_binary(const char *d, size_t len)
+{
+	size_t i, n = len < BINARY_SNIFF ? len : BINARY_SNIFF;
+	size_t ctrl = 0;
+
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)d[i];
+		if (c == 0)
+			return 1;
+		if (c < 0x20 && c != '\t' && c != '\n' && c != '\r')
+			ctrl++;
+	}
+	return n >= 8 && ctrl * 100 / n > 30;
+}
+
+static int read_whole_file(const char *path, size_t limit,
+		char **pdata, size_t *plen, int *pbin)
+{
+	int fd;
+	struct stat st;
+	char *data;
+	size_t len = 0, cap;
+
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return -1;
+	if (fstat(fd, &st) != 0) {
+		close(fd);
+		return -1;
+	}
+	if (S_ISDIR(st.st_mode)) {
+		close(fd);
+		errno = EISDIR;
+		return -1;
+	}
+	cap = st.st_size > 0 ? (size_t)st.st_size + 1 : 4096;
+	if (cap - 1 > limit) {
+		close(fd);
+		errno = EFBIG;
+		return -1;
+	}
+	data = xmalloc(cap);
+	for (;;) {
+		ssize_t r;
+
+		if (len == cap - 1) {
+			if (cap - 1 >= limit) {
+				free(data);
+				close(fd);
+				errno = EFBIG;
+				return -1;
+			}
+			cap *= 2;
+			if (cap - 1 > limit)
+				cap = limit + 1;
+			data = xrealloc(data, cap);
+		}
+		r = safe_read(fd, data + len, cap - 1 - len);
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			free(data);
+			close(fd);
+			return -1;
+		}
+		if (r == 0)
+			break;
+		len += (size_t)r;
+	}
+	close(fd);
+	data[len] = '\0';
+	*pdata = data;
+	*plen = len;
+	*pbin = detect_binary(data, len);
+	return 0;
+}
+
+static size_t *build_line_starts(const char *d, size_t len, unsigned *pn)
+{
+	size_t *v;
+	size_t i;
+	unsigned n = 0, cap = 256;
+
+	v = xmalloc(cap * sizeof(*v));
+	v[n++] = 0;
+	for (i = 0; i < len; i++) {
+		if (d[i] != '\n' || i + 1 >= len)
+			continue;
+		if (n == cap) {
+			cap *= 2;
+			v = xrealloc(v, cap * sizeof(*v));
+		}
+		v[n++] = i + 1;
+	}
+	*pn = n;
+	return v;
+}
+
+/* Index of the line containing byte offset off. */
+static unsigned line_of(const size_t *starts, unsigned n, size_t off)
+{
+	unsigned lo = 0, hi = n;
+
+	while (lo + 1 < hi) {
+		unsigned mid = (lo + hi) / 2;
+		if (starts[mid] <= off)
+			lo = mid;
+		else
+			hi = mid;
+	}
+	return lo;
+}
+
+static size_t line_text_len(const char *d, const size_t *starts,
+		unsigned n, size_t len, unsigned i)
+{
+	size_t end = (i + 1 < n) ? starts[i + 1] - 1 : len;
+
+	/* Drop the terminator for display only; the bytes are still hashed. */
+	if (end > starts[i] && d[end - 1] == '\n')
+		end--;
+	if (end > starts[i] && d[end - 1] == '\r')
+		end--;
+	return end - starts[i];
+}
+
+static void sha256_hex(const char *d, size_t len, char *out65)
+{
+	sha256_ctx_t ctx;
+	uint8_t raw[32];
+	unsigned i;
+
+	sha256_begin(&ctx);
+	sha256_hash(&ctx, d, len);
+	sha256_end(&ctx, raw);
+	for (i = 0; i < 32; i++)
+		sprintf(out65 + i * 2, "%02x", raw[i]);
+	out65[64] = '\0';
+}
+
+/* Write s as a JSON string literal. */
+static void json_write_str(const char *s, size_t n)
+{
+	size_t i;
+	char buf[8];
+
+	putchar('"');
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)s[i];
+		switch (c) {
+		case '"':  fputs("\\\"", stdout); break;
+		case '\\': fputs("\\\\", stdout); break;
+		case '\n': fputs("\\n", stdout); break;
+		case '\r': fputs("\\r", stdout); break;
+		case '\t': fputs("\\t", stdout); break;
+		case '\b': fputs("\\b", stdout); break;
+		case '\f': fputs("\\f", stdout); break;
+		default:
+			if (c < 0x20) {
+				sprintf(buf, "\\u%04x", c);
+				fputs(buf, stdout);
+			} else {
+				putchar(c);
+			}
+		}
+	}
+	putchar('"');
+}
+
+static void json_member_str(const char *key, const char *val)
+{
+	printf("\"%s\":", key);
+	if (val)
+		json_write_str(val, strlen(val));
+	else
+		fputs("null", stdout);
+}
+
+/* ---------- body emission ---------- */
+
+static void emit_line_text(unsigned n, const char *t, size_t tlen, int partial)
+{
+	printf("%u | ", n);
+	fwrite(t, 1, tlen, stdout);
+	if (partial)
+		fputs(" ...", stdout);
+	putchar('\n');
+}
+
+/*
+ * Emit lines first..last (0-based). from_off, when nonzero, starts the first
+ * line mid-way (continuation after a truncated view).
+ * Returns 1 when everything fit, 0 when the budget stopped us.
+ */
+static int emit_lines(const char *d, size_t len, const size_t *starts,
+		unsigned nlines, unsigned first, unsigned last, size_t from_off,
+		struct peek_out *o, int *any_emitted)
+{
+	unsigned li;
+
+	for (li = first; li <= last; li++) {
+		const char *t = d + starts[li];
+		size_t tlen = line_text_len(d, starts, nlines, len, li);
+		size_t skip = 0;
+		unsigned n = li + 1;
+		int ndig;
+		size_t cost;
+
+		if (from_off && li == first && from_off > starts[li]) {
+			skip = from_off - starts[li];
+			if (skip > tlen)
+				skip = tlen;
+		}
+		t += skip;
+		tlen -= skip;
+
+		ndig = (n < 10) ? 1 : (n < 100) ? 2 : (n < 1000) ? 3 :
+			(n < 10000) ? 4 : (n < 100000) ? 5 : 6;
+		cost = (size_t)ndig + 3 + tlen + 1;
+
+		if (o->shown + cost > o->budget) {
+			if (o->shown == 0 && o->budget > (size_t)ndig + 3) {
+				size_t room = o->budget - ((size_t)ndig + 3);
+				size_t cut = utf8_cut(t, room);
+				if (o->json) {
+					if (*any_emitted)
+						putchar(',');
+					printf("{\"n\":%u,\"text\":", n);
+					json_write_str(t, cut);
+					fputs("}", stdout);
+				} else {
+					emit_line_text(n, t, cut, 1);
+				}
+				*any_emitted = 1;
+				o->shown += (size_t)ndig + 3 + cut;
+				o->truncated = 1;
+				o->next_off = starts[li] + skip + cut;
+				return 0;
+			}
+			o->truncated = 1;
+			o->next_off = starts[li] + skip;
+			return 0;
+		}
+		if (o->json) {
+			if (*any_emitted)
+				putchar(',');
+			printf("{\"n\":%u,\"text\":", n);
+			json_write_str(t, tlen);
+			fputs("}", stdout);
+		} else {
+			emit_line_text(n, t, tlen, 0);
+		}
+		*any_emitted = 1;
+		o->shown += cost;
+	}
+	return 1;
+}
+
+/* The same hex view hex_preview() prints, as a string for JSON consumers. */
+static char *hex_preview_text(const char *d, size_t len)
+{
+	size_t i, n = len < 64 ? len : 64, cap, off = 0;
+	char *out;
+
+	cap = 64 + ((n / 16) + 1) * 96;
+	out = xzalloc(cap);
+	for (i = 0; i < n; i += 16) {
+		size_t j, k = (n - i < 16) ? n - i : 16;
+
+		off += snprintf(out + off, cap - off, "%06x  ", (unsigned)i);
+		for (j = 0; j < 16; j++) {
+			if (j < k)
+				off += snprintf(out + off, cap - off, "%02x ",
+						(unsigned char)d[i + j]);
+			else
+				off += snprintf(out + off, cap - off, "   ");
+		}
+		off += snprintf(out + off, cap - off, " ");
+		for (j = 0; j < k; j++) {
+			unsigned char c = (unsigned char)d[i + j];
+
+			out[off++] = (c >= 0x20 && c < 0x7f) ? (char)c : '.';
+		}
+		out[off++] = '\n';
+	}
+	out[off] = '\0';
+	return out;
+}
+
+static void hex_preview(const char *d, size_t len)
+{
+	size_t i, n = len < 64 ? len : 64;
+
+	printf("preview_bytes=%u\n", (unsigned)n);
+	for (i = 0; i < n; i += 16) {
+		size_t j, k = (n - i < 16) ? n - i : 16;
+
+		printf("%06x  ", (unsigned)i);
+		for (j = 0; j < 16; j++) {
+			if (j < k)
+				printf("%02x ", (unsigned char)d[i + j]);
+			else
+				fputs("   ", stdout);
+		}
+		putchar(' ');
+		for (j = 0; j < k; j++) {
+			unsigned char c = (unsigned char)d[i + j];
+			putchar((c >= 0x20 && c < 0x7f) ? c : '.');
+		}
+		putchar('\n');
+	}
+}
+
+/* ---------- request handling ---------- */
+
+static void fail_text(const char *path, const char *code, const char *msg)
+{
+	fflush(stdout);
+	bb_error_msg("%s: %s: %s", path ? path : "-", code, msg);
+}
+
+/*
+ * Run one request. Returns 0 on success, 1 on a handled failure.
+ * In JSON mode the result object is written by the caller's framing; this
+ * function writes only the object body via out_json_result().
+ */
+static int run_request(struct peek_req *rq, size_t max_file,
+		struct peek_out *o, int preview, int regex_mode,
+		char **err_code, char **err_msg)
+{
+	char *data = NULL;
+	size_t len = 0;
+	int bin = 0;
+	size_t *starts = NULL;
+	unsigned nlines = 0;
+	char hex[65];
+	struct peek_range ranges[MAX_WINDOWS];
+	unsigned nranges = 0;
+	unsigned i;
+	int any_emitted = 0;
+
+	*err_code = NULL;
+	*err_msg = NULL;
+	o->shown = 0;
+	o->truncated = 0;
+	o->next_off = 0;
+
+	if (!rq->path) {
+		*err_code = (char *)"INVALID_ARGUMENT";
+		*err_msg = xstrdup("request has no path");
+		return 1;
+	}
+	if (read_whole_file(rq->path, max_file, &data, &len, &bin) != 0) {
+		int e = errno;
+		*err_code = (char *)((e == ENOENT || e == ENOTDIR) ? "NOT_FOUND" :
+				(e == EFBIG) ? "UNSUPPORTED" :
+				(e == EACCES) ? "INVALID_ARGUMENT" : "INVALID_ARGUMENT");
+		*err_msg = xasprintf("%s", strerror(e));
+		return 1;
+	}
+
+	sha256_hex(data, len, hex);
+
+	starts = build_line_starts(data, len, &nlines);
+
+	/* Decide which lines to show. */
+	if (rq->lines) {
+		/* "5:9", "7" or several ranges: "5:9,40:60" */
+		char *copy = xstrdup(rq->lines);
+		char *save = copy, *part;
+
+		nranges = 0;
+		while ((part = strsep(&save, ",")) != NULL) {
+			char *colon = strchr(part, ':');
+			long a = 1, b;
+
+			if (!*part)
+				continue;
+			if (colon) {
+				*colon = '\0';
+				if (part[0])
+					a = strtol(part, NULL, 10);
+				b = colon[1] ? strtol(colon + 1, NULL, 10) : (long)nlines;
+			} else {
+				a = strtol(part, NULL, 10);
+				b = a;
+			}
+			if (a < 1)
+				a = 1;
+			if (b < a || (unsigned)a > nlines) {
+				*err_code = (char *)"NOT_FOUND";
+				*err_msg = xasprintf("line range %s is outside 1:%u",
+						rq->lines, nlines);
+				free(copy);
+				goto fail;
+			}
+			if ((unsigned)b > nlines)
+				b = (long)nlines;
+			if (nranges < MAX_WINDOWS) {
+				ranges[nranges].first = (unsigned)a - 1;
+				ranges[nranges].last = (unsigned)b - 1;
+				nranges++;
+			}
+		}
+		free(copy);
+		if (nranges == 0) {
+			*err_code = (char *)"INVALID_ARGUMENT";
+			*err_msg = xstrdup("--lines needs at least one range");
+			goto fail;
+		}
+	} else if (rq->around) {
+		regex_t re;
+		int have_re = 0;
+		size_t off = 0;
+		unsigned ctx = rq->context < 0 ? 0 : (unsigned)rq->context;
+
+		if (regex_mode) {
+			if (regcomp(&re, rq->around, REG_EXTENDED) != 0) {
+				*err_code = (char *)"INVALID_ARGUMENT";
+				*err_msg = xasprintf("bad regex: %s", rq->around);
+				goto fail;
+			}
+			have_re = 1;
+		}
+		while (off <= len && nranges < MAX_WINDOWS) {
+			size_t mstart, mend;
+			unsigned line;
+
+			if (have_re) {
+				regmatch_t m;
+				if (regexec(&re, data + off, 1, &m, 0) != 0)
+					break;
+				mstart = off + (size_t)m.rm_so;
+				mend = off + (size_t)m.rm_eo;
+				if (mend == mstart)
+					mend = mstart + 1;   /* empty match: advance */
+			} else {
+				const char *hit = find_bytes(data, len, rq->around,
+						strlen(rq->around), off);
+				if (!hit)
+					break;
+				mstart = (size_t)(hit - data);
+				mend = mstart + strlen(rq->around);
+			}
+			line = line_of(starts, nlines, mstart);
+			{
+				unsigned lo = line > ctx ? line - ctx : 0;
+				unsigned hi = line + ctx;
+				if (hi >= nlines)
+					hi = nlines - 1;
+				if (nranges && lo <= ranges[nranges - 1].last + 1) {
+					if (hi > ranges[nranges - 1].last)
+						ranges[nranges - 1].last = hi;
+				} else {
+					ranges[nranges].first = lo;
+					ranges[nranges].last = hi;
+					nranges++;
+				}
+			}
+			off = mend > off ? mend : off + 1;
+		}
+		if (have_re)
+			regfree(&re);
+		if (nranges == 0) {
+			*err_code = (char *)"NOT_FOUND";
+			*err_msg = xasprintf("no match for \"%s\"", rq->around);
+			goto fail;
+		}
+	} else if (rq->has_from) {
+		unsigned line;
+
+		if ((size_t)rq->from_byte > len) {
+			*err_code = (char *)"INVALID_ARGUMENT";
+			*err_msg = xasprintf("from_byte %ld is past end of file (%lu bytes)",
+					rq->from_byte, (unsigned long)len);
+			goto fail;
+		}
+		line = line_of(starts, nlines, (size_t)rq->from_byte);
+		ranges[0].first = line;
+		ranges[0].last = nlines - 1;
+		nranges = 1;
+	} else {
+		ranges[0].first = 0;
+		ranges[0].last = nlines - 1;
+		nranges = 1;
+	}
+
+	/* Header (text mode) / result prefix (json mode). */
+	if (o->json) {
+		putchar('{');
+		if (rq->id) {
+			json_member_str("id", rq->id);
+			putchar(',');
+		}
+		json_member_str("path", rq->path);
+		printf(",\"status\":\"ok\",\"binary\":%s,\"version\":\"sha256:%s\"",
+				bin ? "true" : "false", hex);
+		if (bin && preview) {
+			char *pv = hex_preview_text(data, len);
+
+			fputs(",\"guessed_type\":\"binary\",\"preview\":", stdout);
+			json_write_str(pv, strlen(pv));
+			free(pv);
+		}
+		fputs(",\"lines\":[", stdout);
+		for (i = 0; i < nranges; i++)
+			printf("%s[%u,%u]", i ? "," : "",
+					ranges[i].first + 1, ranges[i].last + 1);
+		fputs("],\"content\":[", stdout);
+	} else {
+		printf("%s lines=", rq->path);
+		for (i = 0; i < nranges; i++)
+			printf("%s%u-%u", i ? "," : "",
+					ranges[i].first + 1, ranges[i].last + 1);
+		printf(" version=sha256:%s", hex);
+		if (bin)
+			fputs(" binary=true", stdout);
+		if (rq->has_from)
+			printf(" from_byte=%ld", rq->from_byte);
+		putchar('\n');
+	}
+
+	if (bin) {
+		if (!o->json && preview)
+			hex_preview(data, len);
+	} else {
+		for (i = 0; i < nranges; i++) {
+			if (!o->json && i > 0)
+				fputs("--\n", stdout);
+			if (!emit_lines(data, len, starts, nlines,
+					ranges[i].first, ranges[i].last,
+					(i == 0 && rq->has_from) ? (size_t)rq->from_byte : 0,
+					o, &any_emitted))
+				break;
+		}
+	}
+
+	if (o->json) {
+		fputs("],", stdout);
+		printf("\"shown_bytes\":%u,\"truncated\":%s,\"next\":",
+				(unsigned)o->shown, o->truncated ? "true" : "false");
+		if (o->truncated)
+			printf("{\"from_byte\":%ld}", (long)o->next_off);
+		else
+			fputs("null", stdout);
+		putchar('}');
+	} else {
+		printf("shown_bytes=%u truncated=%s",
+				(unsigned)o->shown, o->truncated ? "true" : "false");
+		if (o->truncated)
+			printf(" next=--from-byte %ld", (long)o->next_off);
+		putchar('\n');
+	}
+	if (!o->json)
+		fflush(stdout);
+
+	free(starts);
+	free(data);
+	return 0;
+ fail:
+	free(starts);
+	free(data);
+	return 1;
+}
+
+static void json_error_result(const struct peek_req *rq,
+		const char *code, const char *msg)
+{
+	putchar('{');
+	if (rq->id) {
+		json_member_str("id", rq->id);
+		putchar(',');
+	}
+	if (rq->path) {
+		json_member_str("path", rq->path);
+		putchar(',');
+	}
+	fputs("\"status\":\"error\",\"code\":", stdout);
+	json_write_str(code, strlen(code));
+	fputs(",\"message\":", stdout);
+	json_write_str(msg, strlen(msg));
+	putchar('}');
+}
+
+/* peek --diff HASH FILE: did the file change since that version was seen? */
+static int peek_diff(const char *path, const char *want, int json)
+{
+	char *data = NULL;
+	size_t len = 0, maxsz = (size_t)-1;
+	char hex[65];
+	int same, fd;
+
+	fd = open(path, O_RDONLY);
+	if (fd < 0) {
+		if (json) {
+			fputs("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\",\"message\":", stdout);
+			json_member_str("message", strerror(errno));
+			fputs("}\n", stdout);
+		} else {
+			fprintf(stderr, "peek: %s: %s\n", path, strerror(errno));
+		}
+		return 1;
+	}
+	{
+		struct stat st;
+
+		fstat(fd, &st);
+		data = xzalloc((size_t)st.st_size + 1);
+		len = full_read(fd, data, (size_t)st.st_size);
+	}
+	close(fd);
+	(void)maxsz;
+	sha256_hex(data, len, hex);
+	free(data);
+
+	if (strncmp(want, "sha256:", 7) == 0)
+		want += 7;
+	same = (strcasecmp(want, hex) == 0);
+	if (json) {
+		fputs("{\"schema\":1,", stdout);
+		json_member_str("path", path);
+		printf(",\"status\":\"ok\",\"changed\":%s,\"version\":\"sha256:%s\"}\n",
+				same ? "false" : "true", hex);
+	} else {
+		printf("%s changed=%s version=sha256:%s\n", path,
+				same ? "false" : "true", hex);
+	}
+	return same ? 0 : 1;
+}
+
+/* peek --follow SECS: bounded equivalent of tail -f, driven by fstat only. */
+static int peek_follow(const char *path, long from, size_t budget,
+		long seconds, int json)
+{
+	char *buf = xmalloc(4096);
+	struct stat st;
+	size_t total = 0, emitted = 0;
+	long left = seconds * 1000;
+	int fd;
+
+	fd = open(path, O_RDONLY);
+	if (fd < 0) {
+		if (json) {
+			fputs("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\",\"message\":", stdout);
+			json_member_str("message", strerror(errno));
+			fputs("}\n", stdout);
+		} else {
+			fprintf(stderr, "peek: %s: %s\n", path, strerror(errno));
+		}
+		free(buf);
+		return 1;
+	}
+	if (from < 0)
+		from = 0;
+	if (lseek(fd, from, SEEK_SET) < 0)
+		from = 0;
+
+	for (;;) {
+		ssize_t n;
+
+		while (emitted < budget
+		    && (n = safe_read(fd, buf, 4096)) > 0
+		) {
+			size_t take = n;
+
+			if (take > budget - emitted)
+				take = budget - emitted;
+			fwrite(buf, 1, take, stdout);
+			emitted += take;
+			total += n;
+		}
+		if (emitted >= budget || left <= 0)
+			break;
+		if (fstat(fd, &st) == 0 && (off_t)(from + total) <= st.st_size) {
+			usleep(50 * 1000);
+			left -= 50;
+			continue;
+		}
+		{
+			/* grew: loop reads it on the next pass */
+			struct timespec ts = { 0, 50 * 1000 * 1000 };
+
+			nanosleep(&ts, NULL);
+			left -= 50;
+		}
+	}
+	close(fd);
+	if (json) {
+		fputs("\n{\"schema\":1,", stdout);
+		json_member_str("path", path);
+		printf(",\"status\":\"ok\",\"from_byte\":%ld,\"to_byte\":%ld,"
+				"\"emitted\":%u,\"truncated\":%s}\n",
+				from, from + (long)total, (unsigned)emitted,
+				emitted >= budget ? "true" : "false");
+	} else {
+		printf("followed=%u from_byte=%ld to_byte=%ld truncated=%s\n",
+				(unsigned)emitted, from, from + (long)total,
+				emitted >= budget ? "true" : "false");
+	}
+	free(buf);
+	return 0;
+}
+
+int peek_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int peek_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *opt_lines = NULL;
+	char *opt_around = NULL;
+	char *opt_ctx = NULL;
+	char *opt_budget = NULL;
+	char *opt_maxfile = NULL;
+	char *opt_from = NULL;
+	char *opt_fmt = NULL;
+	char *opt_req = NULL;
+	char *opt_diff = NULL;
+	char *opt_follow = NULL;
+	unsigned opts;
+	int json = 0;
+	int regex_mode = 0;
+	int preview = 0;
+	size_t budget = DEFAULT_MAX_BYTES;
+	size_t max_file = DEFAULT_MAX_FILE;
+	struct peek_out out;
+	int exitcode = 0;
+
+	static const char peek_longopts[] ALIGN1 =
+		"lines\0"      Required_argument "l"
+		"around\0"     Required_argument "a"
+		"context\0"    Required_argument "c"
+		"regex\0"      No_argument       "r"
+		"from-byte\0"  Required_argument "F"
+		"max-bytes\0"  Required_argument "B"
+		"max-file-bytes\0" Required_argument "M"
+		"request\0"    Required_argument "R"
+		"preview\0"    No_argument       "p"
+		"format\0"     Required_argument "f"
+		"diff\0"       Required_argument "d"
+		"follow\0"     Required_argument "w"
+		;
+
+	xfunc_error_retval = 2;   /* usage errors exit 2 */
+
+	opts = getopt32long(argv, "l:a:c:rF:B:M:R:pf:d:w:",
+			peek_longopts, &opt_lines, &opt_around, &opt_ctx,
+			&opt_from, &opt_budget, &opt_maxfile, &opt_req,
+			&opt_fmt, &opt_diff, &opt_follow);
+	(void)opts;
+	argv += optind;
+
+	regex_mode = (opts & (1 << 3)) != 0;    /* r is the 4th letter */
+	preview = (opts & (1 << 8)) != 0;       /* p is the 9th letter */
+
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+	if (opt_budget)
+		budget = (size_t)strtoul(opt_budget, NULL, 10);
+	if (opt_maxfile)
+		max_file = (size_t)strtoul(opt_maxfile, NULL, 10);
+
+	memset(&out, 0, sizeof(out));
+	out.json = json;
+	out.budget = budget;
+
+	if (opt_follow && !opt_req) {
+		if (!argv[0])
+			bb_show_usage();
+		fflush_stdout_and_exit(peek_follow(argv[0],
+				opt_from ? strtol(opt_from, NULL, 10) : 0,
+				budget, strtol(opt_follow, NULL, 10), json));
+	}
+	if (opt_diff && !opt_req) {
+		if (!argv[0])
+			bb_show_usage();
+		fflush_stdout_and_exit(peek_diff(argv[0], opt_diff, json));
+	}
+
+	if (opt_req) {
+		char *data = NULL;
+		size_t len = 0;
+		int bin;
+		char *err = NULL;
+		json_value_t *doc;
+		const json_value_t *reqs;
+		unsigned n, i;
+		unsigned emitted = 0;
+		unsigned unprocessed = 0;
+		size_t total_shown = 0;
+		int budget_left = (budget > 0);
+
+		if (read_whole_file(opt_req, 64 * 1024 * 1024, &data, &len, &bin) != 0) {
+			int e = errno;
+			if (json) {
+				printf("{\"schema\":1,\"error\":{\"code\":\"NOT_FOUND\","
+						"\"message\":");
+				json_write_str(strerror(e), strlen(strerror(e)));
+				fputs("}}\n", stdout);
+				return 1;
+			}
+			errno = e;
+			bb_perror_msg_and_die("%s", opt_req);
+		}
+		doc = json_parse(data, len, &err);
+		if (!doc) {
+			if (json) {
+				printf("{\"schema\":1,\"error\":{\"code\":\"INVALID_ARGUMENT\","
+						"\"message\":");
+				json_write_str(err ? err : "bad json", strlen(err ? err : "bad json"));
+				fputs("}}\n", stdout);
+				free(err);
+				free(data);
+				return 2;
+			}
+			bb_error_msg_and_die("%s: %s", opt_req, err ? err : "bad json");
+		}
+		free(err);
+		reqs = json_get(doc, "requests");
+		n = json_len(reqs);
+		if (json)
+			fputs("{\"schema\":1,\"results\":[", stdout);
+		for (i = 0; i < n; i++) {
+			const json_value_t *rj = json_at(reqs, i);
+			struct peek_req rq;
+			long fromb = json_int(json_get(rj, "from_byte"), -1);
+			long ctxv = json_int(json_get(rj, "context"), DEFAULT_CONTEXT);
+			char *code = NULL, *msg = NULL;
+
+			memset(&rq, 0, sizeof(rq));
+			rq.id = (char *)json_str(json_get(rj, "id"), NULL);
+			rq.path = (char *)json_str(json_get(rj, "path"), NULL);
+			rq.lines = (char *)json_str(json_get(rj, "lines"), NULL);
+			rq.around = (char *)json_str(json_get(rj, "around"), NULL);
+			rq.context = (int)ctxv;
+			if (fromb >= 0) {
+				rq.from_byte = fromb;
+				rq.has_from = 1;
+			}
+			if (emitted > 0 && budget_left == 0) {
+				/* budget spent: report, do not silently skip */
+				if (json) {
+					if (emitted > 0)
+						putchar(',');
+					json_error_result(&rq, "TRUNCATED", "output budget exhausted");
+				} else {
+					fail_text(rq.path, "TRUNCATED", "output budget exhausted");
+				}
+				exitcode = 1;
+				unprocessed++;
+				emitted++;
+				continue;
+			}
+			if (json && emitted > 0)
+				putchar(',');
+			out.budget = budget_left
+					? (total_shown < budget ? budget - total_shown : 0)
+					: 0;
+			if (run_request(&rq, max_file, &out, preview, regex_mode,
+					&code, &msg) != 0) {
+				exitcode = 1;
+				if (json)
+					json_error_result(&rq, code, msg);
+				else
+					fail_text(rq.path, code, msg);
+				free(msg);
+			}
+			emitted++;
+			total_shown += out.shown;
+			if (out.truncated || total_shown >= budget)
+				budget_left = 0;
+		}
+		if (json)
+			printf("],\"shown_bytes\":%u,\"unprocessed\":%u}\n",
+					(unsigned)total_shown, unprocessed);
+		json_free(doc);
+		free(data);
+		return exitcode;
+	}
+
+	/* Command line mode: one or more files. */
+	if (!argv[0])
+		bb_show_usage();
+	if (opt_lines && opt_around)
+		bb_error_msg_and_die("--lines and --around are mutually exclusive");
+	if (opt_lines && opt_from)
+		bb_error_msg_and_die("--lines and --from-byte are mutually exclusive");
+
+	if (json)
+		fputs("{\"schema\":1,\"results\":[", stdout);
+
+	{
+		unsigned idx = 0;
+		char **ap;
+		size_t total_shown = 0;
+		int budget_exhausted = 0;
+
+		for (ap = argv; *ap; ap++, idx++) {
+			struct peek_req rq;
+			char *code = NULL, *msg = NULL;
+
+			memset(&rq, 0, sizeof(rq));
+			rq.path = *ap;
+			rq.diff_hash = opt_diff;
+			rq.lines = opt_lines;
+			rq.around = opt_around;
+			rq.context = opt_ctx ? (int)strtol(opt_ctx, NULL, 10) : DEFAULT_CONTEXT;
+			if (opt_from) {
+				rq.from_byte = strtol(opt_from, NULL, 10);
+				rq.has_from = 1;
+			}
+			if (idx > 0 && budget_exhausted) {
+				if (json) {
+					if (idx > 0)
+						putchar(',');
+					json_error_result(&rq, "TRUNCATED", "output budget exhausted");
+				}
+				exitcode = 1;
+				continue;
+			}
+			if (json && idx > 0)
+				putchar(',');
+			out.budget = budget_exhausted ? 0
+					: budget - (total_shown < budget ? total_shown : budget);
+			if (run_request(&rq, max_file, &out, preview, regex_mode,
+					&code, &msg) != 0) {
+				exitcode = 1;
+				if (json)
+					json_error_result(&rq, code, msg);
+				else
+					fail_text(rq.path, code, msg);
+				free(msg);
+			}
+			total_shown += out.shown;
+			if (out.truncated || total_shown >= budget)
+				budget_exhausted = 1;
+		}
+		if (json)
+			printf("],\"shown_bytes\":%u}\n", (unsigned)total_shown);
+	}
+	return exitcode;
+}
diff --git a/include/error_ids.h b/include/error_ids.h
new file mode 100644
index 0000000..4e79f14
--- /dev/null
+++ b/include/error_ids.h
@@ -0,0 +1,32 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Opt-in diagnostic ids: the same message on stderr with its id in front, and
+ * the bare id on stdout.
+ *
+ * Off unless BUSYBOX_ERROR_IDS is set in the environment or the applet was
+ * started as "busybox --error-ids APPLET ...". With the switch off every
+ * diagnostic is byte-identical to what it always was, so a normal direct
+ * invocation is unaffected: the id path is one extra getenv on an error path
+ * that is already printing.
+ *
+ *   stdout   E NOT_FOUND            the id alone: branch without parsing prose
+ *   stderr   cat: NOT_FOUND: can't open '/nope': No such file or directory
+ *
+ * The id is bb_error_code when an applet set one, else derived from errno
+ * (ENOENT -> NOT_FOUND, EACCES -> PERMISSION, ...), else USAGE for a usage
+ * error, else FAILED. The channel letter is E for a diagnostic and W when the
+ * message opens with "warning".
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+#ifndef ERROR_IDS_H
+#define ERROR_IDS_H
+
+extern int bb_error_ids;      /* nonzero: ids on (environment or --error-ids) */
+extern int bb_error_ids_sent;   /* an id already went to stdout for this diagnostic */
+extern int bb_perror_errno;   /* errno at the last bb_perror_msg* call, else 0 */
+extern const char *bb_error_code; /* applet-set code for the next message */
+
+void bb_error_ids_init(void);
+
+#endif
diff --git a/include/json_read.h b/include/json_read.h
new file mode 100644
index 0000000..15c6aee
--- /dev/null
+++ b/include/json_read.h
@@ -0,0 +1,53 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Minimal JSON reader for the agent-facing applets.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+#ifndef JSON_READ_H
+#define JSON_READ_H 1
+
+#include <stddef.h>
+
+enum { JSON_MAX_DEPTH = 32 };
+
+typedef enum {
+	JSON_NULL,
+	JSON_TRUE,
+	JSON_FALSE,
+	JSON_STRING,
+	JSON_NUMBER,
+	JSON_ARRAY,
+	JSON_OBJECT,
+} json_type_t;
+
+struct json_value {
+	json_type_t type;
+	char *key;                    /* member name; NULL at top level or in arrays */
+	char *str;                    /* STRING: decoded bytes. NUMBER: literal text */
+	struct json_value *child;     /* first child of ARRAY/OBJECT */
+	struct json_value *next;      /* next sibling */
+};
+typedef struct json_value json_value_t;
+
+/*
+ * Parse a complete JSON document. Strict RFC 8259 subset: no comments, no
+ * trailing commas, no single quotes, no NaN/Infinity, duplicate keys rejected.
+ * On error returns NULL and stores a malloc'd description (caller frees) in *err.
+ */
+json_value_t *json_parse(const char *buf, size_t len, char **err) FAST_FUNC;
+
+void json_free(json_value_t *v) FAST_FUNC;
+
+/* Lookup in an OBJECT. Returns NULL when absent or when v is not an object. */
+const json_value_t *json_get(const json_value_t *v, const char *key) FAST_FUNC;
+
+/* Typed accessors, all returning dflt on mismatch/missing. */
+const char *json_str(const json_value_t *v, const char *dflt) FAST_FUNC;
+long json_int(const json_value_t *v, long dflt) FAST_FUNC;
+int json_bool(const json_value_t *v, int dflt) FAST_FUNC;
+/* Element i of an ARRAY (0-based), NULL when out of range. */
+const json_value_t *json_at(const json_value_t *v, unsigned i) FAST_FUNC;
+unsigned json_len(const json_value_t *v) FAST_FUNC;
+
+#endif

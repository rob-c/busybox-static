diff --git a/libbb/json_read.c b/libbb/json_read.c
new file mode 100644
index 0000000..ed6ae04
--- /dev/null
+++ b/libbb/json_read.c
@@ -0,0 +1,529 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Minimal JSON reader for the agent-facing applets.
+ *
+ * Strict RFC 8259 subset, DOM-lite, no allocation tricks: a document is parsed
+ * into a tree of json_value_t and freed with json_free(). Deliberately not a
+ * jq clone: no pretty-printer, no path expressions, no writer.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config AGENT_JSON
+//config:	bool
+//config:	default n
+//config:	help
+//config:	Internal: JSON reader used by peek, replace and run.
+//config:	Selected automatically; not a user-visible option.
+
+//kbuild:lib-$(CONFIG_AGENT_JSON) += json_read.o
+
+#include "libbb.h"
+#include "json_read.h"
+
+struct parser {
+	const char *p;
+	const char *end;
+	unsigned depth;
+	char *err;
+};
+
+static void set_err(struct parser *ps, const char *fmt, ...)
+{
+	va_list ap;
+	char buf[256];
+
+	if (ps->err)
+		return;
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	ps->err = xstrdup(buf);
+}
+
+static int at_end(struct parser *ps)
+{
+	return ps->p >= ps->end;
+}
+
+static void skip_ws(struct parser *ps)
+{
+	while (!at_end(ps)
+	 && (*ps->p == ' ' || *ps->p == '\t' || *ps->p == '\n' || *ps->p == '\r')
+	) {
+		ps->p++;
+	}
+}
+
+static json_value_t *new_value(json_type_t t)
+{
+	json_value_t *v = xzalloc(sizeof(*v));
+	v->type = t;
+	return v;
+}
+
+/* Encode one code point as UTF-8 (no validation: callers supply scalars). */
+static unsigned put_utf8(char *out, unsigned cp)
+{
+	if (cp < 0x80) {
+		out[0] = (char)cp;
+		return 1;
+	}
+	if (cp < 0x800) {
+		out[0] = (char)(0xc0 | (cp >> 6));
+		out[1] = (char)(0x80 | (cp & 0x3f));
+		return 2;
+	}
+	if (cp < 0x10000) {
+		out[0] = (char)(0xe0 | (cp >> 12));
+		out[1] = (char)(0x80 | ((cp >> 6) & 0x3f));
+		out[2] = (char)(0x80 | (cp & 0x3f));
+		return 3;
+	}
+	out[0] = (char)(0xf0 | (cp >> 18));
+	out[1] = (char)(0x80 | ((cp >> 12) & 0x3f));
+	out[2] = (char)(0x80 | ((cp >> 6) & 0x3f));
+	out[3] = (char)(0x80 | (cp & 0x3f));
+	return 4;
+}
+
+static int hex4(struct parser *ps, unsigned *out)
+{
+	unsigned v = 0;
+	int i;
+
+	if (ps->end - ps->p < 4) {
+		set_err(ps, "truncated \\u escape");
+		return 0;
+	}
+	for (i = 0; i < 4; i++) {
+		char c = ps->p[i];
+		v <<= 4;
+		if (c >= '0' && c <= '9')
+			v |= (unsigned)(c - '0');
+		else if (c >= 'a' && c <= 'f')
+			v |= (unsigned)(c - 'a' + 10);
+		else if (c >= 'A' && c <= 'F')
+			v |= (unsigned)(c - 'A' + 10);
+		else {
+			set_err(ps, "bad hex digit in \\u escape");
+			return 0;
+		}
+	}
+	ps->p += 4;
+	*out = v;
+	return 1;
+}
+
+/* Parse a string token; ps->p points at the opening quote. */
+static char *pstring(struct parser *ps)
+{
+	char *out;
+	size_t cap, len = 0;
+
+	ps->p++;                     /* opening quote */
+	cap = (size_t)(ps->end - ps->p) + 1;   /* upper bound */
+	out = xmalloc(cap);
+	for (;;) {
+		char c;
+
+		if (at_end(ps)) {
+			set_err(ps, "unterminated string");
+			goto bad;
+		}
+		c = *ps->p++;
+		if (c == '"')
+			break;
+		if ((unsigned char)c < 0x20) {
+			set_err(ps, "raw control character 0x%02x in string", (unsigned char)c);
+			goto bad;
+		}
+		if (c != '\\') {
+			out[len++] = c;
+			continue;
+		}
+		if (at_end(ps)) {
+			set_err(ps, "unterminated escape");
+			goto bad;
+		}
+		c = *ps->p++;
+		switch (c) {
+		case '"':  out[len++] = '"';  break;
+		case '\\': out[len++] = '\\'; break;
+		case '/':  out[len++] = '/';  break;
+		case 'b':  out[len++] = '\b'; break;
+		case 'f':  out[len++] = '\f'; break;
+		case 'n':  out[len++] = '\n'; break;
+		case 'r':  out[len++] = '\r'; break;
+		case 't':  out[len++] = '\t'; break;
+		case 'u': {
+			unsigned cp;
+			if (!hex4(ps, &cp))
+				goto bad;
+			if (cp >= 0xd800 && cp <= 0xdbff) {
+				unsigned lo;
+				if (ps->end - ps->p < 2 || ps->p[0] != '\\' || ps->p[1] != 'u') {
+					set_err(ps, "unpaired high surrogate");
+					goto bad;
+				}
+				ps->p += 2;
+				if (!hex4(ps, &lo))
+					goto bad;
+				if (lo < 0xdc00 || lo > 0xdfff) {
+					set_err(ps, "bad low surrogate");
+					goto bad;
+				}
+				cp = 0x10000 + ((cp - 0xd800) << 10) + (lo - 0xdc00);
+			} else if (cp >= 0xdc00 && cp <= 0xdfff) {
+				set_err(ps, "unpaired low surrogate");
+				goto bad;
+			}
+			len += put_utf8(out + len, cp);
+			break;
+		}
+		default:
+			set_err(ps, "unknown escape \\%c", c);
+			goto bad;
+		}
+	}
+	out[len] = '\0';
+	return out;
+ bad:
+	free(out);
+	return NULL;
+}
+
+static json_value_t *pvalue(struct parser *ps);
+
+/* Validate a JSON number and keep its literal text. */
+static char *pnumber(struct parser *ps)
+{
+	const char *start = ps->p;
+	const char *p = ps->p;
+
+	if (p < ps->end && *p == '-')
+		p++;
+	if (p >= ps->end)
+		goto bad;
+	if (*p == '0') {
+		p++;
+	} else if (*p >= '1' && *p <= '9') {
+		while (p < ps->end && *p >= '0' && *p <= '9')
+			p++;
+	} else {
+		goto bad;
+	}
+	if (p < ps->end && *p == '.') {
+		p++;
+		if (p >= ps->end || *p < '0' || *p > '9')
+			goto bad;
+		while (p < ps->end && *p >= '0' && *p <= '9')
+			p++;
+	}
+	if (p < ps->end && (*p == 'e' || *p == 'E')) {
+		p++;
+		if (p < ps->end && (*p == '+' || *p == '-'))
+			p++;
+		if (p >= ps->end || *p < '0' || *p > '9')
+			goto bad;
+		while (p < ps->end && *p >= '0' && *p <= '9')
+			p++;
+	}
+	ps->p = p;
+	return xstrndup(start, (size_t)(p - start));
+ bad:
+	set_err(ps, "malformed number");
+	return NULL;
+}
+
+static int key_seen(const json_value_t *obj, const char *key)
+{
+	const json_value_t *c;
+
+	for (c = obj->child; c; c = c->next)
+		if (c->key && strcmp(c->key, key) == 0)
+			return 1;
+	return 0;
+}
+
+static json_value_t *pobject(struct parser *ps)
+{
+	json_value_t *obj = new_value(JSON_OBJECT);
+	json_value_t **tail = &obj->child;
+
+	ps->p++;                     /* '{' */
+	skip_ws(ps);
+	if (!at_end(ps) && *ps->p == '}') {
+		ps->p++;
+		return obj;
+	}
+	for (;;) {
+		char *key;
+		json_value_t *val;
+
+		skip_ws(ps);
+		if (at_end(ps) || *ps->p != '"') {
+			set_err(ps, "expected object key");
+			goto bad;
+		}
+		key = pstring(ps);
+		if (!key)
+			goto bad;
+		if (key_seen(obj, key)) {
+			set_err(ps, "duplicate key \"%s\"", key);
+			free(key);
+			goto bad;
+		}
+		skip_ws(ps);
+		if (at_end(ps) || *ps->p != ':') {
+			set_err(ps, "expected ':' after key \"%s\"", key);
+			free(key);
+			goto bad;
+		}
+		ps->p++;
+		val = pvalue(ps);
+		if (!val) {
+			free(key);
+			goto bad;
+		}
+		val->key = key;
+		*tail = val;
+		tail = &val->next;
+		skip_ws(ps);
+		if (at_end(ps)) {
+			set_err(ps, "unterminated object");
+			goto bad;
+		}
+		if (*ps->p == ',') {
+			ps->p++;
+			continue;
+		}
+		if (*ps->p == '}') {
+			ps->p++;
+			return obj;
+		}
+		set_err(ps, "expected ',' or '}'");
+		goto bad;
+	}
+ bad:
+	json_free(obj);
+	return NULL;
+}
+
+static json_value_t *parray(struct parser *ps)
+{
+	json_value_t *arr = new_value(JSON_ARRAY);
+	json_value_t **tail = &arr->child;
+
+	ps->p++;                     /* '[' */
+	skip_ws(ps);
+	if (!at_end(ps) && *ps->p == ']') {
+		ps->p++;
+		return arr;
+	}
+	for (;;) {
+		json_value_t *val = pvalue(ps);
+
+		if (!val)
+			goto bad;
+		*tail = val;
+		tail = &val->next;
+		skip_ws(ps);
+		if (at_end(ps)) {
+			set_err(ps, "unterminated array");
+			goto bad;
+		}
+		if (*ps->p == ',') {
+			ps->p++;
+			continue;
+		}
+		if (*ps->p == ']') {
+			ps->p++;
+			return arr;
+		}
+		set_err(ps, "expected ',' or ']'");
+		goto bad;
+	}
+ bad:
+	json_free(arr);
+	return NULL;
+}
+
+static json_value_t *pvalue(struct parser *ps)
+{
+	json_value_t *v;
+
+	skip_ws(ps);
+	if (at_end(ps)) {
+		set_err(ps, "unexpected end of input");
+		return NULL;
+	}
+	if (ps->depth >= JSON_MAX_DEPTH) {
+		set_err(ps, "nesting deeper than %d", JSON_MAX_DEPTH);
+		return NULL;
+	}
+	switch (*ps->p) {
+	case '{':
+		ps->depth++;
+		v = pobject(ps);
+		ps->depth--;
+		return v;
+	case '[':
+		ps->depth++;
+		v = parray(ps);
+		ps->depth--;
+		return v;
+	case '"':
+		v = new_value(JSON_STRING);
+		v->str = pstring(ps);
+		if (!v->str) {
+			free(v);
+			return NULL;
+		}
+		return v;
+	case 't':
+		if (ps->end - ps->p >= 4 && memcmp(ps->p, "true", 4) == 0) {
+			ps->p += 4;
+			return new_value(JSON_TRUE);
+		}
+		break;
+	case 'f':
+		if (ps->end - ps->p >= 5 && memcmp(ps->p, "false", 5) == 0) {
+			ps->p += 5;
+			return new_value(JSON_FALSE);
+		}
+		break;
+	case 'n':
+		if (ps->end - ps->p >= 4 && memcmp(ps->p, "null", 4) == 0) {
+			ps->p += 4;
+			return new_value(JSON_NULL);
+		}
+		break;
+	default:
+		if (*ps->p == '-' || (*ps->p >= '0' && *ps->p <= '9')) {
+			v = new_value(JSON_NUMBER);
+			v->str = pnumber(ps);
+			if (!v->str) {
+				free(v);
+				return NULL;
+			}
+			return v;
+		}
+	}
+	set_err(ps, "unexpected character '%c'", *ps->p);
+	return NULL;
+}
+
+json_value_t *json_parse(const char *buf, size_t len, char **err)
+{
+	struct parser ps;
+	json_value_t *v;
+
+	memset(&ps, 0, sizeof(ps));
+	ps.p = buf;
+	ps.end = buf + len;
+	if (err)
+		*err = NULL;
+
+	/* Tolerate a UTF-8 BOM: some editors add one. */
+	if (len >= 3 && memcmp(buf, "\xef\xbb\xbf", 3) == 0)
+		ps.p += 3;
+
+	v = pvalue(&ps);
+	if (!v)
+		goto out;
+	skip_ws(&ps);
+	if (!at_end(&ps)) {
+		set_err(&ps, "trailing data after value");
+		json_free(v);
+		v = NULL;
+	}
+ out:
+	if (ps.err) {
+		char *with_off = xasprintf("at byte %ld: %s",
+				(long)(ps.p - buf), ps.err);
+		if (err)
+			*err = with_off;
+		else
+			free(with_off);
+	}
+	return v;
+}
+
+void json_free(json_value_t *v)
+{
+	while (v) {
+		json_value_t *next = v->next;
+		json_free(v->child);
+		free(v->key);
+		free(v->str);
+		free(v);
+		v = next;
+	}
+}
+
+const json_value_t *json_get(const json_value_t *v, const char *key)
+{
+	const json_value_t *c;
+
+	if (!v || v->type != JSON_OBJECT)
+		return NULL;
+	for (c = v->child; c; c = c->next)
+		if (c->key && strcmp(c->key, key) == 0)
+			return c;
+	return NULL;
+}
+
+const char *json_str(const json_value_t *v, const char *dflt)
+{
+	if (!v || v->type != JSON_STRING)
+		return dflt;
+	return v->str;
+}
+
+long json_int(const json_value_t *v, long dflt)
+{
+	char *end;
+	long n;
+
+	if (!v || v->type != JSON_NUMBER)
+		return dflt;
+	n = strtol(v->str, &end, 10);
+	if (end == v->str || *end)
+		return dflt;
+	return n;
+}
+
+int json_bool(const json_value_t *v, int dflt)
+{
+	if (!v)
+		return dflt;
+	if (v->type == JSON_TRUE)
+		return 1;
+	if (v->type == JSON_FALSE)
+		return 0;
+	return dflt;
+}
+
+const json_value_t *json_at(const json_value_t *v, unsigned i)
+{
+	const json_value_t *c;
+
+	if (!v || v->type != JSON_ARRAY)
+		return NULL;
+	for (c = v->child; c; c = c->next)
+		if (i-- == 0)
+			return c;
+	return NULL;
+}
+
+unsigned json_len(const json_value_t *v)
+{
+	const json_value_t *c;
+	unsigned n = 0;
+
+	if (!v || (v->type != JSON_ARRAY && v->type != JSON_OBJECT))
+		return 0;
+	for (c = v->child; c; c = c->next)
+		n++;
+	return n;
+}

+static void emit_with_ids(const char *s, va_list p, const char *strerr)
+{
+	char *body, *line;
+	const char *code;
+	int channel, n;
+
+	if (vasprintf(&body, s, p) < 0)
+		return;
+	channel = (strncmp(body, "warning", 7) == 0) ? 'W' : 'E';
+	code = bb_error_code;
+	if (!code)
+		code = bb_perror_errno ? code_for_errno(bb_perror_errno)
+		     : (channel == 'W' ? "WARN" : "FAILED");
+
+	/* stderr: the full message with the id in front of it */
+	n = asprintf(&line, "%s: %s: %s%s%s%s", applet_name, code, body,
+			strerr ? ": " : "", strerr ? strerr : "", msg_eol);
+	if (n >= 0) {
+		fflush_all();
+		full_write(STDERR_FILENO, line, (size_t)n);
+		free(line);
+	}
+	/* stdout: the id alone, so a reader never parses prose */
+	n = asprintf(&line, "%c %s\n", channel, code);
+	if (n >= 0) {
+		full_write(STDOUT_FILENO, line, (size_t)n);
+		free(line);
+		bb_error_ids_sent = 1;
+	}
+	free(body);
+}
+
+/* A diagnostic id is enabled by the environment, so an applet symlink or a
+ * plain shell invocation gets it too. Looked up once. */
+void bb_error_ids_init(void)
+{
+	const char *v;
+
+	if (bb_error_ids)
+		return;
+	v = getenv("BUSYBOX_ERROR_IDS");
+	if (v && v[0] && strcmp(v, "0") != 0)
+		bb_error_ids = 1;
+}
+
 void FAST_FUNC bb_verror_msg(const char *s, va_list p, const char* strerr)
 {
 	char *msg, *msg1;
@@ -26,6 +119,14 @@ void FAST_FUNC bb_verror_msg(const char *s, va_list p, const char* strerr)
 	if (!logmode)
 		return;
 
+	bb_error_ids_init();
+	if (bb_error_ids) {
+		emit_with_ids(s, p, strerr);
+		bb_perror_errno = 0;
+		bb_error_code = NULL;
+		return;
+	}
+
 	applet_len = strlen(applet_name) + 2; /* "applet: " */
 	strerr_len = strerr ? strlen(strerr) : 0;
 	msgeol_len = strlen(msg_eol);
diff --git a/miscutils/waitfor.c b/miscutils/waitfor.c
new file mode 100644
index 0000000..e828260
--- /dev/null
+++ b/miscutils/waitfor.c
@@ -0,0 +1,469 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * waitfor - bounded readiness polling.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config WAITFOR
+//config:	bool "waitfor (5 kb)"
+//config:	default y
+//config:	help
+//config:	Poll for file, TCP, unix-socket or HTTP readiness with one deadline.
+
+//applet:IF_WAITFOR(APPLET(waitfor, BB_DIR_USR_BIN, BB_SUID_DROP))
+
+//kbuild:lib-$(CONFIG_WAITFOR) += waitfor.o
+
+//usage:#define waitfor_trivial_usage
+//usage:       "[-T SECS] {--file PATH | --tcp HOST:PORT | --unix PATH | --http URL}"
+//usage:#define waitfor_full_usage "\n\n"
+//usage:       "Wait until a readiness condition holds, or the deadline expires"
+//usage:     "\n	-f, --file PATH		Wait for PATH to exist"
+//usage:     "\n	-t, --tcp HOST:PORT	Wait for a TCP connect to succeed"
+//usage:     "\n	-u, --unix PATH		Wait for a unix socket to accept"
+//usage:     "\n	-H, --http URL		Wait for an HTTP status (http:// only)"
+//usage:     "\n	-G, --glob PATTERN	Wait for a path matching PATTERN to exist"
+//usage:     "\n	-x, --exec CMD		Wait until CMD exits 0"
+//usage:     "\n	-e, --expect CODE	Expected HTTP status (default 200)"
+//usage:     "\n	-T, --timeout SECS	Overall deadline (default 20)"
+//usage:     "\n	-i, --interval MS	Initial poll interval (default 20)"
+//usage:     "\n	-F, --format FMT	text (default) or json"
+//usage:     "\n"
+//usage:     "\nExit: 0 ready, 3 timeout/cancelled, 1 invalid input, 2 usage error"
+//usage:     "\nA TCP connect proves the port accepts connections, not that the"
+//usage:     "\napplication behind it is ready. https:// needs wget --spider."
+
+#include <sys/un.h>
+#include <glob.h>
+#include <sys/wait.h>
+#include "libbb.h"
+
+enum {
+	DEFAULT_TIMEOUT_MS = 20000,
+	DEFAULT_INTERVAL_MS = 20,
+	MAX_INTERVAL_MS = 200,
+	CONNECT_TIMEOUT_MS = 1000,
+	HTTP_MAX_HEADER = 8192,
+};
+
+struct opts {
+	const char *file;
+	const char *unix_path;
+	const char *http;
+	const char *target;
+	char *host;
+	char *path;
+	int port;
+	int kind;           /* 0 file, 1 tcp, 2 unix, 3 http */
+	long expect;
+	long timeout_ms;
+	long interval_ms;
+	int json;
+};
+
+static void on_sig(int sig)
+{
+	bb_got_signal = sig;
+}
+
+static void sleep_ms(long ms)
+{
+	/* poll(), not sleep(): a signal interrupts it, so ^C is prompt */
+	if (ms > 0)
+		poll(NULL, 0, (int)ms);
+}
+
+static void json_str(const char *s)
+{
+	putchar('"');
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') {
+			putchar('\\');
+			putchar(c);
+		} else if (c == '\n') {
+			fputs("\\n", stdout);
+		} else if (c >= 0x20) {
+			putchar(c);
+		}
+	}
+	putchar('"');
+}
+
+static int wait_file(const char *path)
+{
+	struct stat st;
+
+	return stat(path, &st) == 0;
+}
+
+/* Connect with its own timeout, so a single attempt cannot eat the deadline. */
+static int wait_unix(const char *path)
+{
+	struct sockaddr_un sun;
+	int fd, rc;
+
+	memset(&sun, 0, sizeof(sun));
+	sun.sun_family = AF_UNIX;
+	if (strlen(path) >= sizeof(sun.sun_path))
+		return 0;
+	strcpy(sun.sun_path, path);
+	fd = socket(AF_UNIX, SOCK_STREAM, 0);
+	if (fd < 0)
+		return 0;
+	rc = connect(fd, (struct sockaddr *)&sun, sizeof(sun));
+	close(fd);
+	return rc == 0;
+}
+
+static int wait_tcp(const char *host, int port, int timeout_ms)
+{
+	int fd, rc, err = 0;
+	socklen_t errlen = sizeof(err);
+	len_and_sockaddr *lsa;
+	struct pollfd pfd;
+
+	lsa = xhost2sockaddr(host, port);
+	fd = socket(lsa->u.sa.sa_family, SOCK_STREAM, 0);
+	if (fd < 0) {
+		free(lsa);
+		return 0;
+	}
+	ndelay_on(fd);
+	rc = connect(fd, &lsa->u.sa, lsa->len);
+	if (rc != 0) {
+		if (errno != EINPROGRESS) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+		pfd.fd = fd;
+		pfd.events = POLLOUT;
+		pfd.revents = 0;
+		if (poll(&pfd, 1, timeout_ms) <= 0
+		 || getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &errlen) != 0
+		 || err != 0
+		) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+	}
+	close(fd);
+	free(lsa);
+	return 1;
+}
+
+/* Plain HTTP GET: portable, and the status code is observable (unlike --spider). */
+static int try_http(const struct opts *o, int timeout_ms)
+{
+	int fd, status = 0;
+	len_and_sockaddr *lsa;
+	struct timeval tv;
+	struct pollfd pfd;
+	char req[512];
+	char *buf;
+	size_t used = 0, need, off;
+	ssize_t r;
+
+	lsa = xhost2sockaddr(o->host, o->port);
+	fd = socket(lsa->u.sa.sa_family, SOCK_STREAM, 0);
+	if (fd < 0) {
+		free(lsa);
+		return 0;
+	}
+	ndelay_on(fd);
+	if (connect(fd, &lsa->u.sa, lsa->len) != 0) {
+		int err = 0;
+		socklen_t errlen = sizeof(err);
+
+		if (errno != EINPROGRESS) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+		pfd.fd = fd;
+		pfd.events = POLLOUT;
+		pfd.revents = 0;
+		if (poll(&pfd, 1, timeout_ms) <= 0
+		 || getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &errlen) != 0
+		 || err != 0
+		) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+	}
+	free(lsa);
+
+	snprintf(req, sizeof(req),
+			"GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n"
+			"User-Agent: busybox-waitfor\r\n\r\n",
+			o->path, o->host);
+	need = strlen(req);
+	off = 0;
+	while (off < need) {
+		r = write(fd, req + off, need - off);
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			close(fd);
+			return 0;
+		}
+		off += (size_t)r;
+	}
+
+	tv.tv_sec = timeout_ms / 1000;
+	tv.tv_usec = (timeout_ms % 1000) * 1000;
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+	buf = xmalloc(HTTP_MAX_HEADER);
+	buf[0] = '\0';
+	while (used < HTTP_MAX_HEADER - 1) {
+		r = read(fd, buf + used, HTTP_MAX_HEADER - 1 - used);
+		if (r <= 0)
+			break;
+		used += (size_t)r;
+		buf[used] = '\0';
+		if (strstr(buf, "\r\n\r\n") || strstr(buf, "\n\n"))
+			break;
+	}
+	buf[used] = '\0';
+	if (used > 5 && strncmp(buf, "HTTP/", 5) == 0) {
+		const char *sp = strchr(buf, ' ');
+		if (sp)
+			status = atoi(sp + 1);
+	}
+	close(fd);
+	free(buf);
+	return status;
+}
+
+/* host, port and path out of http://HOST[:PORT]/PATH */
+static void parse_http(struct opts *o)
+{
+	const char *p = o->http + 7;    /* past "http://" */
+	const char *slash = strchr(p, '/');
+	const char *colon = strchr(p, ':');
+
+	o->port = 80;
+	if (colon && (!slash || colon < slash)) {
+		o->host = xstrndup(p, (size_t)(colon - p));
+		o->port = atoi(colon + 1);
+	} else {
+		o->host = xstrndup(p, slash ? (size_t)(slash - p) : strlen(p));
+	}
+	o->path = xstrdup(slash ? slash : "/");
+	if (o->port <= 0 || o->port > 65535)
+		bb_error_msg_and_die("bad port in \"%s\"", o->http);
+}
+
+int waitfor_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int waitfor_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *opt_file = NULL;
+	char *opt_tcp = NULL;
+	char *opt_unix = NULL;
+	char *opt_http = NULL;
+	char *opt_glob = NULL;
+	char *opt_exec = NULL;
+	char *opt_expect = NULL;
+	char *opt_timeout = NULL;
+	char *opt_interval = NULL;
+	char *opt_fmt = NULL;
+	unsigned opts;
+	struct opts o;
+	unsigned long long deadline, start;
+	long attempt = 0, interval, elapsed_ms;
+	int ready = 0, last_status = 0;
+
+	static const char waitfor_longopts[] ALIGN1 =
+		"file\0"     Required_argument "f"
+		"tcp\0"      Required_argument "t"
+		"unix\0"     Required_argument "u"
+		"http\0"     Required_argument "H"
+		"glob\0"     Required_argument "G"
+		"exec\0"     Required_argument "x"
+		"expect\0"   Required_argument "e"
+		"timeout\0"  Required_argument "T"
+		"interval\0" Required_argument "i"
+		"format\0"   Required_argument "F"
+		;
+
+	xfunc_error_retval = 2;
+
+	opts = getopt32long(argv, "f:t:u:H:G:x:e:T:i:F:", waitfor_longopts,
+			&opt_file, &opt_tcp, &opt_unix, &opt_http, &opt_glob, &opt_exec, &opt_expect,
+			&opt_timeout, &opt_interval, &opt_fmt);
+	(void)opts;
+
+	memset(&o, 0, sizeof(o));
+	o.expect = 200;
+	o.timeout_ms = DEFAULT_TIMEOUT_MS;
+	o.interval_ms = DEFAULT_INTERVAL_MS;
+
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			o.json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+	if (opt_expect)
+		o.expect = strtol(opt_expect, NULL, 10);
+	if (opt_timeout) {
+		double s = strtod(opt_timeout, NULL);
+		/* 0 means: one attempt, no deadline. */
+		if (!(s >= 0))
+			bb_error_msg_and_die("bad timeout \"%s\"", opt_timeout);
+		o.timeout_ms = (long)(s * 1000.0);
+	}
+	if (opt_interval)
+		o.interval_ms = strtol(opt_interval, NULL, 10);
+	if (o.interval_ms < 1)
+		o.interval_ms = 1;
+	if (o.interval_ms > MAX_INTERVAL_MS)
+		o.interval_ms = MAX_INTERVAL_MS;
+
+	if ((!!opt_file + !!opt_tcp + !!opt_unix + !!opt_http + !!opt_glob + !!opt_exec) != 1)
+		bb_error_msg_and_die("exactly one of --file/--tcp/--unix/--http/--glob/--exec is required");
+
+	o.file = opt_file;
+	o.unix_path = opt_unix;
+	o.http = opt_http;
+	if (opt_file) {
+		o.kind = 0;
+		o.target = opt_file;
+	} else if (opt_glob) {
+		o.kind = 4;
+		o.target = opt_glob;
+	} else if (opt_exec) {
+		o.kind = 5;
+		o.target = opt_exec;
+	} else if (opt_unix) {
+		o.kind = 2;
+		o.target = opt_unix;
+	} else if (opt_http) {
+		if (strncmp(opt_http, "http://", 7) != 0)
+			bb_error_msg_and_die("only http:// is handled here; "
+					"use `wget --spider` for https://");
+		o.kind = 3;
+		o.target = opt_http;
+		parse_http(&o);
+	} else {
+		char *colon = strrchr(opt_tcp, ':');
+		if (!colon)
+			bb_error_msg_and_die("--tcp needs HOST:PORT");
+		*colon = '\0';
+		o.kind = 1;
+		o.host = opt_tcp[0] ? xstrdup(opt_tcp) : xstrdup("127.0.0.1");
+		o.port = atoi(colon + 1);
+		if (o.port <= 0 || o.port > 65535)
+			bb_error_msg_and_die("bad port in \"%s\"", opt_tcp);
+		o.target = xasprintf("%s:%d", o.host, o.port);
+	}
+
+	bb_signals((1 << (SIGINT - 1)) | (1 << (SIGTERM - 1)), on_sig);
+
+	start = monotonic_us();
+	deadline = start + (unsigned long long)o.timeout_ms * 1000ULL;
+	interval = o.interval_ms;
+
+	for (;;) {
+		unsigned long long now;
+		long remain_ms;
+
+		if (bb_got_signal)
+			break;
+		attempt++;
+
+		switch (o.kind) {
+		case 0: ready = wait_file(o.file); break;
+		case 1: ready = wait_tcp(o.host, o.port, CONNECT_TIMEOUT_MS); break;
+		case 2: ready = wait_unix(o.unix_path); break;
+		case 5: {
+			pid_t pid;
+			int st;
+
+			fflush_all();
+			pid = fork();
+			if (pid < 0) {
+				ready = 0;
+				break;
+			}
+			if (pid == 0) {
+				int nul = open("/dev/null", O_WRONLY);
+
+				if (nul >= 0) {
+					dup2(nul, 1);
+					dup2(nul, 2);
+					if (nul > 2)
+						close(nul);
+				}
+				execl("/bin/sh", "sh", "-c", o.target, (char *)NULL);
+				_exit(127);
+			}
+			ready = waitpid(pid, &st, 0) == pid && WIFEXITED(st) && WEXITSTATUS(st) == 0;
+			break;
+		}
+		case 4: {
+			glob_t g;
+
+			memset(&g, 0, sizeof(g));
+			ready = glob(o.target, 0, NULL, &g) == 0 && g.gl_pathc > 0;
+			globfree(&g);
+			break;
+		}
+		default:
+			last_status = try_http(&o, CONNECT_TIMEOUT_MS);
+			ready = (last_status == o.expect);
+			break;
+		}
+		if (ready)
+			break;
+		now = monotonic_us();
+		if (now >= deadline)
+			break;
+		remain_ms = (long)((deadline - now) / 1000ULL);
+		if (remain_ms <= 0)
+			break;
+		sleep_ms(interval < remain_ms ? interval : remain_ms);
+		if (interval < MAX_INTERVAL_MS) {
+			interval *= 2;
+			if (interval > MAX_INTERVAL_MS)
+				interval = MAX_INTERVAL_MS;
+		}
+	}
+
+	elapsed_ms = (long)((monotonic_us() - start) / 1000ULL);
+
+	if (o.json) {
+		printf("{\"schema\":1,\"status\":\"%s\",\"ready\":%s,\"kind\":\"%s\",\"target\":",
+				ready ? "ok" : "error",
+				ready ? "true" : "false",
+				o.kind == 0 ? "file" : o.kind == 1 ? "tcp" :
+				o.kind == 2 ? "unix" : o.kind == 4 ? "glob" :
+				o.kind == 5 ? "exec" : "http");
+		json_str(o.target);
+		printf(",\"attempts\":%ld,\"elapsed_ms\":%ld", attempt, elapsed_ms);
+		if (o.kind == 3)
+			printf(",\"status\":%d,\"expect\":%ld", last_status, o.expect);
+		if (!ready)
+			printf(",\"code\":\"%s\"",
+					bb_got_signal ? "CANCELLED" : "TIMEOUT");
+		fputs("}\n", stdout);
+	} else {
+		printf("ready=%s kind=%s target=%s attempts=%ld elapsed_ms=%ld",
+				ready ? "true" : "false",
+				o.kind == 0 ? "file" : o.kind == 1 ? "tcp" :
+				o.kind == 2 ? "unix" : o.kind == 4 ? "glob" :
+				o.kind == 5 ? "exec" : "http",
+				o.target, attempt, elapsed_ms);
+		if (o.kind == 3)
+			printf(" status=%d expect=%ld", last_status, o.expect);
+		if (!ready)
+			printf(" code=%s", bb_got_signal ? "CANCELLED" : "TIMEOUT");
+		putchar('\n');
+	}
+	fflush(stdout);
+	return ready ? 0 : 3;
+}

diff --git a/miscutils/why.c b/miscutils/why.c
new file mode 100644
index 0000000..b8ec300
--- /dev/null
+++ b/miscutils/why.c
@@ -0,0 +1,232 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * why - explain why an applet is, or is not, in this build.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config WHY
+//config:	bool "why (3 kb)"
+//config:	default y
+//config:	help
+//config:	Explain an applet's build state: its CONFIG symbol, the value in a
+//config:	.config, and the line in a prune list that disabled it.
+
+//applet:IF_WHY(APPLET(why, BB_DIR_USR_BIN, BB_SUID_DROP))
+
+//kbuild:lib-$(CONFIG_WHY) += why.o
+
+//usage:#define why_trivial_usage
+//usage:       "[-C FILE] [-p FILE] APPLET..."
+//usage:#define why_full_usage "\n\n"
+//usage:       "Say whether APPLET is in this binary and which file decided that"
+//usage:     "\n	-C, --config FILE	.config to read (default .config)"
+//usage:     "\n	-p, --prune FILE	prune list to read (default prune/darwin-off.txt)"
+//usage:     "\n	-F, --format FMT	text (default) or json"
+
+#include "libbb.h"
+
+/* add-shell -> ADD_SHELL, [ -> LBRACKET, [[ -> LBRACKET_LBRACKET */
+static char *config_symbol(const char *name)
+{
+	char *out;
+	size_t i, n = 0, len = strlen(name) + 8;
+
+	out = xmalloc(len);
+	for (i = 0; name[i]; i++) {
+		char c = name[i];
+		if (c == '-')
+			c = '_';
+		else if (c == '+')
+			c = 'P';       /* '+' is not valid in a symbol */
+		else if (c == '[')
+			c = (n == 0) ? 'L' : 'L';
+		else if (c == ']')
+			c = 'R';
+		else if (c == '.')
+			c = '_';
+		else if (c >= 'a' && c <= 'z')
+			c = (char)(c - 'a' + 'A');
+		out[n++] = c;
+	}
+	out[n] = '\0';
+	return out;
+}
+
+/* Return a malloc'd "file:line: text" for the first match, else NULL. */
+static char *find_line(const char *path, const char *needle)
+{
+	FILE *fp = fopen_for_read(path);
+	char *line;
+	unsigned lno = 0;
+
+	if (!fp)
+		return NULL;
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		char *hit;
+
+		lno++;
+		hit = strstr(line, needle);
+		if (hit) {
+			char *res = xasprintf("%s:%u: %s", path, lno, line);
+			free(line);
+			fclose(fp);
+			return res;
+		}
+		free(line);
+	}
+	fclose(fp);
+	return NULL;
+}
+
+/* "CONFIG_X is not set" / "CONFIG_X=y" in a .config */
+static char *config_state(const char *path, const char *sym)
+{
+	FILE *fp = fopen_for_read(path);
+	char *line;
+	char *want_on;
+	char *want_off;
+	char *res = NULL;
+
+	if (!fp)
+		return NULL;
+	want_on = xasprintf("CONFIG_%s=", sym);
+	want_off = xasprintf("# CONFIG_%s is not set", sym);
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		if (strncmp(line, want_on, strlen(want_on)) == 0) {
+			res = xasprintf("%s: %s", path, line);
+			free(line);
+			break;
+		}
+		if (strcmp(line, want_off) == 0) {
+			res = xasprintf("%s: %s", path, line);
+			free(line);
+			break;
+		}
+		free(line);
+	}
+	fclose(fp);
+	free(want_on);
+	free(want_off);
+	return res;
+}
+
+static void json_str(const char *s)
+{
+	putchar('"');
+	if (s) {
+		for (; *s; s++) {
+			unsigned char c = (unsigned char)*s;
+			if (c == '"' || c == '\\') {
+				putchar('\\');
+				putchar(c);
+			} else if (c == '\n') {
+				fputs("\\n", stdout);
+			} else if (c >= 0x20) {
+				putchar(c);
+			}
+		}
+	}
+	putchar('"');
+}
+
+int why_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int why_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *opt_cfg = NULL, *opt_prune = NULL, *opt_fmt = NULL;
+	unsigned opts;
+	int json = 0, idx = 0, rc = 0;
+	const char *cfg, *prune;
+	int first = 1;
+
+	static const char why_longopts[] ALIGN1 =
+		"config\0" Required_argument "C"
+		"prune\0"  Required_argument "p"
+		"format\0" Required_argument "F"
+		;
+
+	xfunc_error_retval = 2;
+
+	opts = getopt32long(argv, "C:p:F:", why_longopts,
+			&opt_cfg, &opt_prune, &opt_fmt);
+	(void)opts;
+	argv += optind;
+	if (!argv[0])
+		bb_show_usage();
+
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+	cfg = opt_cfg ? opt_cfg : ".config";
+	prune = opt_prune ? opt_prune : "prune/darwin-off.txt";
+
+	if (json)
+		fputs("{\"schema\":1,\"results\":[", stdout);
+
+	for (; *argv; argv++, idx++) {
+		char *sym = config_symbol(*argv);
+		char *state = config_state(cfg, sym);
+		char *pruned = find_line(prune, sym);
+		int enabled = 0;
+		const char *verdict;
+		const char *reason;
+
+		if (state && strchr(state, '=')) {
+			const char *eq = strrchr(state, '=');
+			enabled = !(eq[1] == 'n' && eq[2] == '\0');
+		}
+		if (pruned) {
+			verdict = "disabled";
+			reason = "prune list";
+			rc = 1;
+		} else if (state && !enabled) {
+			verdict = "disabled";
+			reason = "config";
+			rc = 1;
+		} else if (state) {
+			verdict = "enabled";
+			reason = "config";
+		} else {
+			verdict = "unknown";
+			reason = "no config entry";
+			rc = 1;
+		}
+
+		if (json) {
+			if (!first)
+				putchar(',');
+			first = 0;
+			fputs("{\"applet\":", stdout);
+			json_str(*argv);
+			fputs(",\"symbol\":", stdout);
+			json_str(sym);
+			fputs(",\"state\":", stdout);
+			json_str(verdict);
+			fputs(",\"decided_by\":", stdout);
+			json_str(reason);
+			fputs(",\"config_line\":", stdout);
+			json_str(state);
+			fputs(",\"prune_line\":", stdout);
+			json_str(pruned);
+			putchar('}');
+		} else {
+			printf("%s %s\n", verdict, *argv);
+			printf("symbol=CONFIG_%s\n", sym);
+			if (state)
+				printf("config: %s\n", state);
+			else
+				printf("config: (no %s entry in %s)\n", sym, cfg);
+			if (pruned)
+				printf("prune: %s\n", pruned);
+		}
+		free(sym);
+		free(state);
+		free(pruned);
+	}
+	if (json)
+		fputs("]}\n", stdout);
+	fflush(stdout);
+	return rc;
+}

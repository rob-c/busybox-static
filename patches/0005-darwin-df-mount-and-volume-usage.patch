diff --git a/libbb/find_mount_point.c b/libbb/find_mount_point.c
--- a/libbb/find_mount_point.c
+++ b/libbb/find_mount_point.c
@@ -45,6 +45,65 @@
 	if (!mtab_fp)
 		return NULL;
 
+#if defined(__APPLE__)
+	/* APFS firmlinks make "/" and "/System/Volumes/Data" report the same
+	 * st_dev, so the device matching below cannot tell them apart and the
+	 * first table entry (always "/") wins.  Match the longest mount-point
+	 * prefix of the requested path instead, which is what df(1) does.
+	 *
+	 * getmntent() hands back one reused static struct, so the winning entry
+	 * must be COPIED while iterating - keeping a pointer only ever yields the
+	 * last row of the table. */
+	if (!block_dev) {
+		char resolved[PATH_MAX];
+		const char *want = name;
+		/* static: the returned struct points into these */
+		static char best_dir[PATH_MAX];
+		static char best_name[PATH_MAX];
+		static char best_type[64];
+		size_t best_len = 0;
+		struct mntent *e;
+
+		best_dir[0] = best_name[0] = best_type[0] = '\0';
+		if (realpath(name, resolved))
+			want = resolved;
+		while ((e = getmntent(mtab_fp)) != NULL) {
+			size_t l = strlen(e->mnt_dir);
+			char last;
+
+			if (l == 0)
+				continue;
+			if (strncmp(want, e->mnt_dir, l) != 0)
+				continue;
+			/* the prefix must end on a path boundary */
+			last = e->mnt_dir[l - 1];
+			if (want[l] != '\0' && want[l] != '/' && last != '/')
+				continue;
+			if (l > best_len) {
+				best_len = l;
+				safe_strncpy(best_dir, e->mnt_dir, sizeof(best_dir));
+				safe_strncpy(best_name, e->mnt_fsname, sizeof(best_name));
+				safe_strncpy(best_type, e->mnt_type ? e->mnt_type : "", sizeof(best_type));
+			}
+		}
+		endmntent(mtab_fp);
+		if (best_len) {
+			static struct mntent keep;
+			keep.mnt_fsname = best_name;
+			keep.mnt_dir = best_dir;
+			keep.mnt_type = best_type;
+			keep.mnt_opts = (char *)"";
+			keep.mnt_freq = 0;
+			keep.mnt_passno = 0;
+			return &keep;
+		}
+		/* nothing matched by prefix: fall back to device matching */
+		mtab_fp = setmntent(bb_path_mtab_file, "r");
+		if (!mtab_fp)
+			return NULL;
+	}
+#endif
+
 	while ((mountEntry = getmntent(mtab_fp)) != NULL) {
 		/* rootfs mount in Linux 2.6 exists always,
 		 * and it makes sense to always ignore it.
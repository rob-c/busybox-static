diff --git a/editors/patchapply.c b/editors/patchapply.c
new file mode 100644
index 0000000..2bceb99
--- /dev/null
+++ b/editors/patchapply.c
@@ -0,0 +1,515 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * patchapply - apply a unified diff, all or nothing, with preconditions.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config PATCHAPPLY
+//config:	bool "patchapply (6 kb)"
+//config:	default n
+//config:	help
+//config:	  Apply a unified diff to existing files, verifying every hunk
+//config:	  against the bytes on disk before writing, refusing when a
+//config:	  --sha256 precondition does not hold, and replacing each file
+//config:	  atomically. A model can emit a diff; this is what turns one into
+//config:	  an edit that cannot half-succeed.
+
+//applet:IF_PATCHAPPLY(APPLET_NOEXEC(patchapply, patchapply_main, BB_DIR_USR_BIN, BB_SUID_DROP, patchapply))
+
+//kbuild:lib-$(CONFIG_PATCHAPPLY) += patchapply.o
+
+//usage:#define patchapply_trivial_usage
+//usage:       "[-n] [-c PATH=HASH]... [FILE.patch]"
+//usage:#define patchapply_full_usage "\n\n"
+//usage:       "Apply a unified diff, verifying every hunk first"
+//usage:     "\n"
+//usage:     "\n	-n, --dry-run		Report what would change, write nothing"
+//usage:     "\n	-c, --sha256 PATH=HASH	Refuse unless PATH still hashes to HASH"
+//usage:     "\n	-F, --format FMT	text (default) or json"
+//usage:     "\n"
+//usage:     "\nReads FILE.patch, or stdin when it is '-' or absent."
+//usage:     "\nEvery hunk is checked against the file as it is; one mismatch"
+//usage:     "\naborts the whole patch. Files are replaced by temp+rename."
+//usage:     "\n"
+//usage:     "\nExit: 0 applied, 1 refused or failed, 2 usage error"
+
+#include "libbb.h"
+
+
+/* libbb has the primitives; the hex form is what both callers want. */
+static void hex_sha256(const char *data, size_t len, char *out)
+{
+	sha256_ctx_t ctx;
+	unsigned char res[32];
+	int i;
+
+	sha256_begin(&ctx);
+	sha256_hash(&ctx, data, len);
+	sha256_end(&ctx, res);
+	for (i = 0; i < 32; i++)
+		sprintf(out + i * 2, "%02x", res[i]);
+	out[64] = '\0';
+}
+
+enum { MAX_FILES = 64, MAX_HUNKS = 512 };
+
+struct hunk {
+	unsigned old_start, old_count, new_start, new_count;
+	char *body;        /* the hunk lines, '\n'-terminated, prefixes kept */
+	size_t body_len;
+};
+
+struct pfile {
+	char *path;
+	struct hunk *h;
+	unsigned nh;
+	int is_new;
+	int is_delete;
+};
+
+static char *read_text(const char *path, size_t *len)
+{
+	char *data = NULL;
+	size_t n = 0;
+	int fd;
+
+	if (strcmp(path, "-") == 0)
+		fd = STDIN_FILENO;
+	else
+		fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return NULL;
+	{
+		struct stat st;
+
+		if (fstat(fd, &st) != 0 || st.st_size > 16 * 1024 * 1024) {
+			if (fd != STDIN_FILENO)
+				close(fd);
+			return NULL;
+		}
+		data = xzalloc((size_t)st.st_size + 1);
+		n = (size_t)full_read(fd, data, (size_t)st.st_size);
+	}
+	if (fd != STDIN_FILENO)
+		close(fd);
+	*len = n;
+	return data;
+}
+
+/* "--- a/x" / "+++ b/x" -> x, with the a/ and b/ prefixes removed. */
+static char *strip_prefix(const char *line, size_t len)
+{
+	char *s;
+	size_t n = len;
+
+	if (n && line[n - 1] == '\r')
+		n--;
+	s = xstrndup(line, n);
+	if (is_prefixed_with(s, "a/") || is_prefixed_with(s, "b/")) {
+		char *t = xstrdup(s + 2);
+
+		free(s);
+		return t;
+	}
+	return s;
+}
+
+/* Split the patch into files and hunks. Returns 0 on success. */
+static int parse_patch(char *data, size_t len, struct pfile *files, unsigned *nfiles)
+{
+	size_t i = 0;
+	struct pfile *cur = NULL;
+	int in_hunk = 0;
+	char *old_side = NULL;
+	struct hunk *h = NULL;
+
+
+	while (i < len) {
+		size_t start = i, l;
+
+		while (i < len && data[i] != '\n')
+			i++;
+		l = i - start;
+		if (i < len)
+			i++;
+
+		if (l >= 4 && memcmp(data + start, "--- ", 4) == 0) {
+			free(old_side);
+			old_side = strip_prefix(data + start + 4, l - 4);
+			continue;
+		}
+		if (l >= 4 && memcmp(data + start, "+++ ", 4) == 0) {
+			char *p;
+
+			if (*nfiles >= MAX_FILES)
+				return -1;
+			cur = &files[(*nfiles)++];
+			memset(cur, 0, sizeof(*cur));
+			p = strip_prefix(data + start + 4, l - 4);
+			if (old_side && strcmp(old_side, "/dev/null") == 0)
+				cur->is_new = 1;   /* creation: the old side is /dev/null */
+			if (strcmp(p, "/dev/null") == 0) {
+				/* deletion: the new side is /dev/null, the old side is the path */
+				cur->is_delete = 1;
+				free(p);
+				p = old_side ? xstrdup(old_side) : NULL;
+			}
+			cur->path = p;
+			cur->h = xzalloc(sizeof(struct hunk) * MAX_HUNKS);
+			in_hunk = 0;
+			continue;
+		}
+		if (!cur || !cur->path)
+			continue;
+		if (l >= 2 && data[start] == '@' && data[start + 1] == '@') {
+			unsigned a, b, c, d;
+			char *at = xstrndup(data + start, l);
+
+			b = d = 1;
+			if (sscanf(at, "@@ -%u,%u +%u,%u @@", &a, &b, &c, &d) != 4
+			 && (sscanf(at, "@@ -%u +%u,%u @@", &a, &c, &d) != 3
+			  || (b = 1, 0))
+			 && (sscanf(at, "@@ -%u,%u +%u @@", &a, &b, &c) != 3
+			  || (d = 1, 0))
+			 && (sscanf(at, "@@ -%u +%u @@", &a, &c) != 2
+			  || (b = 1, d = 1, 0))
+			) {
+				free(at);
+				return -1;
+			}
+			free(at);
+			if (cur->nh >= MAX_HUNKS)
+				return -1;
+			h = &cur->h[cur->nh++];
+			memset(h, 0, sizeof(*h));
+			h->old_start = a;
+			h->old_count = b;
+			h->new_start = c;
+			h->new_count = d;
+			in_hunk = 1;
+			continue;
+		}
+		if (in_hunk) {
+			if (l && (data[start] == ' ' || data[start] == '+' || data[start] == '-'
+			     || (data[start] == '\\')))
+			{
+				h->body = xrealloc(h->body, h->body_len + l + 2);
+				memcpy(h->body + h->body_len, data + start, l);
+				h->body_len += l;
+				h->body[h->body_len++] = '\n';
+			} else {
+				in_hunk = 0;
+			}
+		}
+	}
+	return 0;
+}
+
+int patchapply_main_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int patchapply_main_main(int argc UNUSED_PARAM, char **argv)
+{
+	static const char patch_longopts[] ALIGN1 =
+		"dry-run\0"  No_argument       "n"
+		"sha256\0"   Required_argument "c"
+		"format\0"   Required_argument "F"
+		;
+	char *opt_sha = NULL, *opt_fmt = NULL;
+	char **shas;
+	unsigned nshas = 0;
+	unsigned opts;
+	int dry_run, json = 0, i, rc = 0;
+	struct pfile files[MAX_FILES];
+	char **outs, **oldvers, **newvers;
+	size_t *outlens;
+	unsigned nfiles = 0;
+	char *patch;
+	size_t plen = 0;
+
+	xfunc_error_retval = 2;
+	{
+		/* -c/--sha256 repeats: one precondition per file it names. */
+		int i, j = 1;
+
+		shas = xzalloc(sizeof(char *) * ((unsigned)argc + 1));
+		for (i = 1; argv[i]; i++) {
+			if ((strcmp(argv[i], "--sha256") == 0 || strcmp(argv[i], "-c") == 0)
+			 && argv[i + 1]
+			) {
+				shas[nshas++] = argv[i + 1];
+				i++;
+				continue;
+			}
+			argv[j++] = argv[i];
+		}
+		argv[j] = NULL;
+		(void)opt_sha;
+	}
+	opts = getopt32long(argv, "nc:F:", patch_longopts, &opt_sha, &opt_fmt);
+	dry_run = (opts & 1) != 0;
+	argv += optind;
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+
+	patch = read_text(argv[0] ? argv[0] : "-", &plen);
+	if (!patch) {
+		if (json)
+			fputs("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\"}\n", stdout);
+		else
+			bb_perror_msg("can't read patch");
+		return 1;
+	}
+	memset(files, 0, sizeof(files));
+	if (parse_patch(patch, plen, files, &nfiles) != 0 || nfiles == 0) {
+		if (json)
+			fputs("{\"schema\":1,\"status\":\"error\",\"code\":\"INVALID_ARGUMENT\","
+					"\"message\":\"not a unified diff\"}\n", stdout);
+		else
+			bb_simple_error_msg("not a unified diff");
+		return 1;
+	}
+
+	/* Preconditions first: a stale file aborts everything before a write. */
+	for (i = 0; i < (int)nshas; i++) {
+		char *spec = shas[i];
+		char *eq = strchr(spec, '=');
+		char *want = eq ? xstrdup(eq + 1) : NULL;
+		size_t wlen = want ? strlen(want) : 0;
+		char *target;
+
+		if (!eq)
+			bb_simple_error_msg_and_die("--sha256 wants PATH=HASH");
+		*eq = '\0';
+		target = spec;
+		{
+			size_t len = 0;
+			char *data = read_text(target, &len);
+			char hex[65];
+
+			if (!data) {
+				if (json)
+					printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\"}\n");
+				else
+					bb_perror_msg("%s", target);
+				return 1;
+			}
+			hex_sha256(data, len, hex);
+			free(data);
+			if (is_prefixed_with(want, "sha256:")) {
+				want += 7;
+				wlen = strlen(want);
+			}
+			if (wlen < 64 ? strncmp(want, hex, wlen) != 0 : strcmp(want, hex) != 0) {
+				if (json) {
+					printf("{\"schema\":1,\"status\":\"error\",\"code\":\"STALE_INPUT\","
+							"\"message\":\"content version is sha256:%s\"}\n", hex);
+				} else {
+					bb_error_msg("%s: STALE_INPUT (content version is sha256:%s)",
+							target, hex);
+				}
+				return 1;
+			}
+		}
+	}
+
+	if (json)
+		fputs("{\"schema\":1,\"status\":\"ok\",\"dry_run\":true,\"files\":[", stdout);
+
+	/* Two phases: nothing is written until every file has been verified. A
+	 * patch that half-applies is worse than one that refuses. */
+	outs = xzalloc(sizeof(char *) * nfiles);
+	outlens = xzalloc(sizeof(size_t) * nfiles);
+	oldvers = xzalloc(sizeof(char *) * nfiles);
+	newvers = xzalloc(sizeof(char *) * nfiles);
+	for (i = 0; i < (int)nfiles; i++) {
+		struct pfile *f = &files[i];
+		size_t len = 0, out_len = 0, pos = 0;
+		char *data, *out, hex_old[65], hex_new[65];
+		unsigned hi, added = 0, removed = 0;
+		int ok = 1;
+
+		if (f->is_delete) {
+			/* verified in phase 1, acted on in phase 3 */
+			outs[i] = NULL;
+			if (!f->path || access(f->path, F_OK) != 0) {
+				if (json)
+					printf("%s{\"path\":\"%s\",\"status\":\"error\",\"code\":\"NOT_FOUND\"}",
+							i ? "," : "", f->path ? f->path : "?");
+				else
+					printf("%s: NOT_FOUND\n", f->path ? f->path : "?");
+				rc = 1;
+			}
+			outlens[i] = 0;
+			continue;
+		}
+		data = f->path ? read_text(f->path, &len) : NULL;
+		if (!data && f->is_new) {
+			data = xzalloc(1);   /* creation: nothing on disk yet */
+			len = 0;
+		}
+		if (!data) {
+			if (json)
+				printf("%s{\"path\":\"%s\",\"status\":\"error\",\"code\":\"NOT_FOUND\"}",
+						i ? "," : "", f->path ? f->path : "?");
+			else
+				printf("%s: NOT_FOUND\n", f->path ? f->path : "?");
+			rc = 1;
+			ok = 0;
+		}
+		if (!ok) {
+			free(data);
+			continue;
+		}
+		out = xzalloc(len + 1024 * 16);
+		hex_sha256(data, len, hex_old);
+		for (hi = 0; hi < f->nh && ok; hi++) {
+			struct hunk *h = &f->h[hi];
+			size_t old_line = h->old_start ? h->old_start - 1 : 0;
+			size_t want = old_line;
+			size_t j = 0;
+
+			/* copy untouched prefix up to the hunk */
+			while (pos < want && pos < len)
+				out[out_len++] = data[pos++];
+			if (pos != want) {
+				ok = 0;
+				break;   /* hunks out of order */
+			}
+			while (j < h->body_len) {
+				size_t s = j, k;
+				char tag;
+
+				while (j < h->body_len && h->body[j] != '\n')
+					j++;
+				k = j - s;
+				tag = h->body[s];
+				if (tag == '\\') {      /* "\ No newline at end of file" */
+					j++;
+					continue;
+				}
+				if (tag == ' ' || tag == '-') {
+					/* must match the file */
+					if (pos + (k ? k - 1 : 0) > len
+					 || memcmp(data + pos, h->body + s + 1, k ? k - 1 : 0) != 0
+					) {
+						ok = 0;
+						break;
+					}
+					if (tag == ' ')
+						memcpy(out + out_len, data + pos, k ? k - 1 : 0),
+						out_len += k ? k - 1 : 0,
+						out[out_len++] = '\n';
+					pos += k ? k - 1 : 0;
+					if (pos < len && data[pos] == '\n')
+						pos++;
+					if (tag == '-')
+						removed++;
+				} else if (tag == '+') {
+					memcpy(out + out_len, h->body + s + 1, k ? k - 1 : 0);
+					out_len += k ? k - 1 : 0;
+					out[out_len++] = '\n';
+					added++;
+				}
+				j++;
+			}
+		}
+		while (ok && pos < len)
+			out[out_len++] = data[pos++];
+
+		hex_sha256(out, out_len, hex_new);
+		if (!ok) {
+			if (json)
+				printf("%s{\"path\":\"%s\",\"status\":\"error\",\"code\":\"HUNK_MISMATCH\"}",
+						i ? "," : "", f->path);
+			else
+				printf("%s: HUNK_MISMATCH\n", f->path);
+			rc = 1;
+		} else {
+			outs[i] = out;
+			outlens[i] = out_len;
+			oldvers[i] = xasprintf("sha256:%s", hex_old);
+			newvers[i] = xasprintf("sha256:%s", hex_new);
+			if (0) {
+			char *tmp = xasprintf("%s.patchapply.%u", f->path, (unsigned)getpid());
+			int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+
+			if (fd < 0 || full_write(fd, out, out_len) != (ssize_t)out_len
+			 || (fd >= 0 && close(fd) != 0) || rename(tmp, f->path) != 0
+			) {
+				if (json)
+					printf("%s{\"path\":\"%s\",\"status\":\"error\",\"code\":\"WRITE_FAILED\"}",
+							i ? "," : "", f->path);
+				else
+					bb_perror_msg("%s", f->path);
+				unlink(tmp);
+				rc = 1;
+			} else if (json) {
+				printf("%s{\"path\":\"%s\",\"status\":\"ok\",\"hunks\":%u,"
+						"\"added\":%u,\"removed\":%u,\"old_version\":\"sha256:%s\","
+						"\"new_version\":\"sha256:%s\"}",
+						i ? "," : "", f->path, f->nh, added, removed, hex_old, hex_new);
+			} else {
+				printf("%s: applied hunks=%u +%u -%u\n", f->path, f->nh, added, removed);
+			}
+			free(tmp);
+			}
+		}
+		free(data);
+	}
+	/* phase 3: act only when every file verified */
+	if (rc == 0) {
+		for (i = 0; i < (int)nfiles; i++) {
+			struct pfile *f = &files[i];
+			int first = 1;
+
+			if (f->is_delete) {
+				if (!dry_run && unlink(f->path) != 0) {
+					bb_perror_msg("%s", f->path);
+					rc = 1;
+					continue;
+				}
+				if (json) {
+					printf("%s{\"path\":\"%s\",\"status\":\"ok\",\"deleted\":true",
+							first ? "" : ",", f->path);
+					printf(",\"dry_run\":%s}", dry_run ? "true" : "false");
+				} else
+					printf("%s: %s\n", f->path, dry_run ? "would delete" : "deleted");
+				continue;
+			}
+			if (!dry_run) {
+				char *tmp = xasprintf("%s.patchapply.%u", f->path, (unsigned)getpid());
+				int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+
+				if (fd < 0 || full_write(fd, outs[i], outlens[i]) != (ssize_t)outlens[i]
+				 || (fd >= 0 && close(fd) != 0) || rename(tmp, f->path) != 0
+				) {
+					bb_perror_msg("%s", f->path);
+					unlink(tmp);
+					rc = 1;
+					free(tmp);
+					continue;
+				}
+				free(tmp);
+			}
+			free(outs[i]);
+			if (json) {
+				printf("%s{\"path\":\"%s\",\"status\":\"ok\",\"hunks\":%u,"
+						"\"old_version\":%s,\"new_version\":%s,\"dry_run\":%s}",
+						first ? "" : ",", f->path, f->nh, oldvers[i], newvers[i],
+						dry_run ? "true" : "false");
+			} else {
+				printf("%s: %s hunks=%u\n", f->path,
+						dry_run ? "ok" : "applied", f->nh);
+			}
+		}
+	}
+	if (rc != 0 && !json)
+		fputs("patchapply: aborted, nothing written\n", stderr);
+	if (json)
+		fputs("]}\n", stdout);
+	fflush(stdout);
+	return rc;
+}
diff --git a/miscutils/mark.c b/miscutils/mark.c
new file mode 100644
index 0000000..745847d
--- /dev/null
+++ b/miscutils/mark.c
@@ -0,0 +1,69 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * mark - name an event on a run's timeline.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config MARK
+//config:	bool "mark (2 kb)"
+//config:	default n
+//config:	help
+//config:	  Record a named, timestamped event against the run that started
+//config:	  this process, so a script can say which phase was slow. Inside
+//config:	  `run` the event lands in the run directory; outside it the mark
+//config:	  is printed to stdout and still usable.
+
+//applet:IF_MARK(APPLET_NOEXEC(mark, mark_main, BB_DIR_USR_BIN, BB_SUID_DROP, mark))
+
+//kbuild:lib-$(CONFIG_MARK) += mark.o
+
+//usage:#define mark_trivial_usage
+//usage:       "NAME"
+//usage:#define mark_full_usage "\n\n"
+//usage:       "Name this moment in the current run's timeline"
+//usage:     "\n"
+//usage:     "\nInside 'run' (BUSYBOX_RUN_DIR set) the mark is appended to"
+//usage:     "\n<run>/marks as '<microseconds> <name>'; read it with"
+//usage:     "\n'log RUN --marks'. Outside a run it is printed to stdout."
+//usage:     "\n"
+//usage:     "\nExit: 0 recorded, 2 usage error"
+
+#include "libbb.h"
+
+int mark_main_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int mark_main_main(int argc UNUSED_PARAM, char **argv)
+{
+	const char *dir = getenv("BUSYBOX_RUN_DIR");
+	const char *name = argv[1];
+	unsigned long long us = monotonic_us();
+	int fd;
+
+	xfunc_error_retval = 2;
+	if (!name || !name[0] || argv[2])
+		bb_show_usage();
+
+	if (!dir || !dir[0]) {
+		/* Not inside a run: still useful, and never a silent no-op. */
+		printf("%llu %s\n", us, name);
+		return 0;
+	}
+	{
+		char *path = xasprintf("%s/marks", dir);
+
+		fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0600);
+		if (fd < 0) {
+			bb_perror_msg("can't record mark in %s", path);
+			free(path);
+			return 1;
+		}
+		free(path);
+	}
+	{
+		char *line = xasprintf("%llu %s\n", us, name);
+
+		full_write(fd, line, strlen(line));
+		free(line);
+	}
+	close(fd);
+	return 0;
+}
diff --git a/miscutils/outline.c b/miscutils/outline.c
new file mode 100644
index 0000000..63ad2ec
--- /dev/null
+++ b/miscutils/outline.c
@@ -0,0 +1,449 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * outline - definitions in a file, with line, byte offset and version.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config OUTLINE
+//config:	bool "outline (4 kb)"
+//config:	default n
+//config:	help
+//config:	  List the definitions a file declares (functions, types, classes,
+//config:	  headings, rules) with their line, byte offset and a content
+//config:	  version, so a reader can jump straight to a body with
+//config:	  'peek --from-byte' instead of reading the whole file.
+//config:	  Heuristics per language by file extension; no parser, no deps.
+
+//applet:IF_OUTLINE(APPLET_NOEXEC(outline, outline_main, BB_DIR_USR_BIN, BB_SUID_DROP, outline))
+
+//kbuild:lib-$(CONFIG_OUTLINE) += outline.o
+
+//usage:#define outline_trivial_usage
+//usage:       "[-f FMT] FILE..."
+//usage:#define outline_full_usage "\n\n"
+//usage:       "List definitions with line, byte offset and version"
+//usage:     "\n"
+//usage:     "\n	-f FMT	text (default) or json"
+//usage:     "\n"
+//usage:     "\nExit: 0 ok, 1 unreadable file, 2 usage error"
+
+#include "libbb.h"
+#include "json_read.h"
+
+
+/* libbb has the primitives; the hex form is what both callers want. */
+static void hex_sha256(const char *data, size_t len, char *out)
+{
+	sha256_ctx_t ctx;
+	unsigned char res[32];
+	int i;
+
+	sha256_begin(&ctx);
+	sha256_hash(&ctx, data, len);
+	sha256_end(&ctx, res);
+	for (i = 0; i < 32; i++)
+		sprintf(out + i * 2, "%02x", res[i]);
+	out[64] = '\0';
+}
+
+
+/* A local escaper: json_read.h does not export one and this applet does not
+ * link the applets that keep a static copy. */
+static void json_out_str(const char *s, size_t n)
+{
+	size_t i;
+
+	putchar('"');
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)s[i];
+
+		if (c == '"' || c == '\\') {
+			putchar('\\'); putchar((char)c);
+		} else if (c == '\n') {
+			fputs("\\n", stdout);
+		} else if (c == '\t') {
+			fputs("\\t", stdout);
+		} else if (c < 0x20) {
+			printf("\\u%04x", c);
+		} else {
+			putchar((char)c);
+		}
+	}
+	putchar('"');
+}
+
+enum { MAX_DEFS = 4000 };
+
+static const char *kind_of(const char *path, const char *line, size_t len,
+		const char **name, size_t *name_len)
+{
+	const char *p = line;
+	const char *end = line + len;
+
+	static const char *const c_words[] = {
+		"for", "if", "while", "switch", "return", "sizeof", "do", "else",
+		"case", "goto", "typedef", "static", "const", "unsigned", "signed",
+		"void", "int", "char", "long", "short", "float", "double",
+	};
+	int indented = 0;
+
+	*name = NULL;
+	*name_len = 0;
+
+	while (p < end && (*p == ' ' || *p == '\t')) {
+		p++;
+		indented = 1;
+	}
+	if (p >= end)
+		return NULL;
+	/* comments and preprocessor lines are not definitions */
+	if ((p + 1 < end && p[0] == '/' && (p[1] == '/' || p[1] == '*'))
+	 || *p == '*'
+	 || (*p == '#' && (p + 1 >= end || p[1] != ' ')))  /* '#' is a heading, not a directive */
+		return NULL;
+	/* drop declaration qualifiers so 'export class C {' still reads as a class */
+	for (;;) {
+		static const char *const qual[] = {
+			"export ", "declare ", "abstract ", "default ", "static ",
+			"public ", "private ", "protected ", "readonly ", "async ",
+			"extern ", "inline ", "unsafe ", "final ",
+		};
+		unsigned q;
+
+		for (q = 0; q < ARRAY_SIZE(qual); q++) {
+			size_t ql = strlen(qual[q]);
+
+			if ((size_t)(end - p) > ql && strncmp(p, qual[q], ql) == 0) {
+				p += ql;
+				break;
+			}
+		}
+		if (q == ARRAY_SIZE(qual))
+			break;
+	}
+
+	/* Markdown headings */
+	if (*p == '#' && p + 1 < end && p[1] == ' ') {
+		const char *h = p;
+
+		while (p < end && *p == '#')
+			p++;
+		if (p < end && *p == ' ') {
+			static const char *const directives[] = {
+				"include", "define", "undef", "if", "ifdef", "ifndef", "elif",
+				"else", "endif", "pragma", "error", "warning", "line", "import",
+			};
+			const char *t;
+			unsigned d;
+
+			while (p < end && *p == ' ')
+				p++;
+			/* '# include <x.h>' is a directive, not a heading */
+			for (d = 0; d < ARRAY_SIZE(directives); d++) {
+				size_t dl = strlen(directives[d]);
+
+				if ((size_t)(end - p) >= dl && strncmp(p, directives[d], dl) == 0
+				 && ((size_t)(end - p) == dl || p[dl] == ' ' || p[dl] == '<'
+				  || p[dl] == '"' || p[dl] == '\t')
+				)
+					return NULL;
+			}
+			for (t = p; t < end && (*t == ' ' || *t == '\t'); t++)
+				continue;
+			*name = p;
+			*name_len = (size_t)(end - p);
+			return "heading";
+		}
+		(void)h;
+		return NULL;
+	}
+
+	/* Python */
+	if (is_prefixed_with(p, "def ") || is_prefixed_with(p, "class ")) {
+		int is_class = (p[0] == 'c');
+
+		p += is_class ? 6 : 4;
+		*name = p;
+		while (p < end && (isalnum((unsigned char)*p) || *p == '_' || *p == '.'))
+			p++;
+		*name_len = (size_t)(p - *name);
+		return is_class ? "class" : "function";
+	}
+
+	/* C-like type/class/struct/enum/interface, and anything with a body brace */
+	if (is_prefixed_with(p, "class ")
+	 || is_prefixed_with(p, "struct ")
+	 || is_prefixed_with(p, "enum ")
+	 || is_prefixed_with(p, "interface ")
+	 || is_prefixed_with(p, "union ")
+	 || is_prefixed_with(p, "type ")
+	) {
+		if (indented && (is_prefixed_with(p, "struct ") || is_prefixed_with(p, "union ")))
+			return NULL;
+		{
+		const char *k = is_prefixed_with(p, "class ") ? "class"
+			: is_prefixed_with(p, "struct ") ? "struct"
+			: is_prefixed_with(p, "enum ") ? "enum"
+			: is_prefixed_with(p, "interface ") ? "interface"
+			: is_prefixed_with(p, "union ") ? "union" : "type";
+		const char *q;
+
+		p += strlen(k);
+		while (p < end && (*p == ' ' || *p == '\t'))
+			p++;
+		q = p;
+		while (p < end && (isalnum((unsigned char)*p) || *p == '_'))
+			p++;
+		if (p > q) {
+			/* 'struct item *item_new(void)' returns a struct; it is a
+			 * function, so leave it to the function test below. */
+			if (!memchr(q, '(', (size_t)(end - q))) {
+				*name = q;
+				*name_len = (size_t)(p - q);
+				return k;
+			}
+		}
+		}
+	}
+
+	/* A line ending in ')' — with the brace here or on the next line — is a
+	 * definition; a line ending in ';' is a prototype and is skipped. */
+	{
+		const char *brace = NULL;
+		const char *q;
+
+		for (q = p; q < end; q++)
+			if (*q == '{') {
+				brace = q;
+				break;
+			}
+		if (!brace) {
+			const char *e = end;
+
+			while (e > p && (e[-1] == ' ' || e[-1] == '\t'))
+				e--;
+			if (e == p || e[-1] != ')' || memchr(p, ';', (size_t)(end - p)))
+				return NULL;
+			brace = e;   /* a definition whose body opens on the next line */
+		}
+		for (q = brace; q > p; q--)
+			if (*q == ')')
+				break;
+		if (q == p || *q != ')')
+			return NULL;
+		/* the identifier immediately before '(' */
+		{
+			const char *open = NULL;
+			const char *id_end;
+			const char *id;
+
+			for (id_end = q; id_end > p && (*id_end == ')'); id_end--)
+				continue;
+			for (open = id_end; open > p && *open != '('; open--)
+				continue;
+			if (*open != '(')
+				return NULL;
+			id_end = open;
+			while (id_end > p && (id_end[-1] == ' ' || id_end[-1] == '\t'))
+				id_end--;
+			id = id_end;
+			while (id > p && (isalnum((unsigned char)id[-1]) || id[-1] == '_'))
+				id--;
+			if (id == id_end)
+				return NULL;
+			{
+				/* 'if (strcmp(…)) {' and 'readtoken() != NULL' both look like
+				 * definitions unless the token before the name is checked. */
+				const char *b = id;
+
+				while (b > p && (b[-1] == ' ' || b[-1] == '\t'))
+					b--;
+				if (b > p && strchr("(,=!&|+-/<>?%", b[-1]))
+					return NULL;
+				if (b > p && b[-2] >= 0 && 0)
+					return NULL;
+				{
+					const char *w = b;
+					size_t wl;
+
+					while (w > p && (isalnum((unsigned char)w[-1]) || w[-1] == '_'))
+						w--;
+					wl = (size_t)(b - w);
+					if ((wl == 2 && strncmp(w, "if", 2) == 0)
+					 || (wl == 5 && strncmp(w, "while", 5) == 0)
+					 || (wl == 3 && strncmp(w, "for", 3) == 0)
+					 || (wl == 6 && strncmp(w, "switch", 6) == 0)
+					 || (wl == 6 && strncmp(w, "return", 6) == 0)
+					 || (wl == 2 && strncmp(w, "do", 2) == 0)
+					)
+						return NULL;
+				}
+			}
+			{
+				unsigned w;
+				size_t nl = (size_t)(id_end - id);
+				int caps = 1, any = 0;
+
+				for (w = 0; w < ARRAY_SIZE(c_words); w++)
+					if (strlen(c_words[w]) == nl && strncmp(id, c_words[w], nl) == 0)
+						return NULL;
+				for (w = 0; w < nl; w++) {
+					if (id[w] >= 'a' && id[w] <= 'z')
+						caps = 0;
+					if (id[w] != '_')
+						any = 1;
+				}
+				if (caps && any)
+					return NULL;   /* APPLET_NOEXEC(...) is a macro call */
+			}
+			*name = id;
+			*name_len = (size_t)(id_end - id);
+			return "function";
+		}
+	}
+}
+
+int outline_main_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int outline_main_main(int argc UNUSED_PARAM, char **argv)
+{
+	static const char outline_longopts[] ALIGN1 =
+		"format\0" Required_argument "f"
+		;
+	char *opt_fmt = NULL;
+	int json = 0, first = 1, rc = 0;
+	unsigned opts;
+
+	xfunc_error_retval = 2;
+	opts = getopt32long(argv, "f:", outline_longopts, &opt_fmt);
+	(void)opts;
+	argv += optind;
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+	if (!argv[0])
+		bb_show_usage();
+
+	if (json)
+		fputs("{\"schema\":1,\"files\":[", stdout);
+	for (; *argv; argv++) {
+		char *data = NULL;
+		size_t len = 0, i = 0, line_no = 0, defs = 0;
+		char hex[65];
+		int fd = open(*argv, O_RDONLY);
+
+		if (fd < 0) {
+			bb_perror_msg("%s", *argv);
+			rc = 1;
+			continue;
+		}
+		{
+			struct stat st;
+
+			if (fstat(fd, &st) != 0 || st.st_size > 32 * 1024 * 1024) {
+				close(fd);
+				bb_perror_msg("%s", *argv);
+				rc = 1;
+				continue;
+			}
+			data = xzalloc((size_t)st.st_size + 1);
+			len = (size_t)full_read(fd, data, (size_t)st.st_size);
+		}
+		close(fd);
+		hex_sha256(data, len, hex);
+
+		if (json) {
+			printf("%s{\"path\":", first ? "" : ",");
+			json_out_str(*argv, strlen(*argv));
+			printf(",\"version\":\"sha256:%s\",\"definitions\":[", hex);
+			first = 0;
+		} else {
+			printf("%s version=sha256:%s\n", *argv, hex);
+		}
+		char *keep_joined;
+		while (i < len && defs < MAX_DEFS) {
+			size_t start = i, l;
+
+			keep_joined = NULL;
+			const char *name, *kind;
+			size_t name_len;
+
+			while (i < len && data[i] != '\n')
+				i++;
+			l = i - start;
+			line_no++;
+			{
+				/* 'static void pump(int a, int b,' continues on the next line;
+				 * join until the parentheses balance (bounded) so the whole
+				 * signature is classified at its first line. */
+				size_t joined_len = l;
+				char *joined = NULL;
+				const char *src = data + start;
+				int depth = 0;
+				size_t k;
+
+				for (k = 0; k < l; k++) {
+					if (src[k] == '(') depth++;
+					else if (src[k] == ')') depth--;
+				}
+				if (depth > 0) {
+					size_t j = i, extra = 0;
+					char *buf = xzalloc(l + 1);
+
+					memcpy(buf, src, l);
+					extra = l;
+					while (depth > 0 && j < len && extra < 4096) {
+						size_t s2 = j, l2;
+
+						while (j < len && data[j] != '\n')
+							j++;
+						l2 = j - s2;
+						buf = xrealloc(buf, extra + l2 + 2);
+						buf[extra++] = ' ';
+						memcpy(buf + extra, data + s2, l2);
+						extra += l2;
+						for (k = 0; k < l2; k++) {
+							if (data[s2 + k] == '(') depth++;
+							else if (data[s2 + k] == ')') depth--;
+						}
+						if (j < len)
+							j++;
+					}
+					buf[extra] = '\0';
+					joined = buf;
+					joined_len = extra;
+				}
+				kind = kind_of(*argv, joined ? joined : src, joined_len,
+						&name, &name_len);
+				/* `name` points into `joined`: freed after the print below */
+				keep_joined = joined;
+			}
+			if (kind) {
+				if (json) {
+					printf("%s{\"kind\":\"%s\",\"line\":%u,\"byte\":%u,\"name\":",
+							defs ? "," : "", kind, (unsigned)line_no, (unsigned)start);
+					json_out_str(name, name_len);
+					putchar('}');
+				} else {
+					printf("%u:%s:%u:%.*s\n", (unsigned)line_no, kind,
+							(unsigned)start, (int)name_len, name);
+				}
+				defs++;
+			}
+			free(keep_joined);
+			if (i < len)
+				i++;
+		}
+		if (json)
+			fputs("]}", stdout);
+		else
+			printf("%u definitions\n", (unsigned)defs);
+		free(data);
+	}
+	if (json)
+		fputs("]}\n", stdout);
+	fflush(stdout);
+	return rc;
+}

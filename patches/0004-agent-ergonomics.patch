+static unsigned next_run_id(const char *root)
+{
+	DIR *d = opendir(root);
+	struct dirent *de;
+	unsigned max = 0;
+
+	if (!d)
+		return 1;
+	while ((de = readdir(d)) != NULL) {
+		if (de->d_name[0] == 'R' && de->d_name[1] >= '0'
+		 && de->d_name[1] <= '9'
+		) {
+			unsigned v = (unsigned)atoi(de->d_name + 1);
+			if (v > max)
+				max = v;
+		}
+	}
+	closedir(d);
+	return max + 1;
+}

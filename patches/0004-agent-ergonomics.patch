 #include "libbb.h"
 
+
+#if defined(__APPLE__)
+/* No readahead(2) on Darwin: F_RDADVISE asks for the same thing (read into the
+ * cache without copying to user space). */
+#include <sys/fcntl.h>
+static int bb_readahead(int fd, off_t offset, off_t count)
+{
+	struct radvisory ra;
+
+	ra.ra_offset = offset;
+	ra.ra_count = (int)count;
+	return fcntl(fd, F_RDADVISE, &ra);
+}
+#define readahead(fd, off, len) bb_readahead(fd, off, len)
+#endif

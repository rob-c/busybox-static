+/* Collect the diagnostic ids a child wrote to its stdout ("E NOT_FOUND"), in
+ * order, deduped, capped: the answer to "what went wrong" without the prose.
+ * Ids are matched by shape, not by a list, so an applet that learns a new code
+ * needs no change here. */
+#define CODES_MAX 8
+static void put_codes(const char *path)
+{
+	char buf[4096];
+	char *seen[CODES_MAX];
+	int nseen = 0, first = 1, fd, n;
+
+	fd = open(path, O_RDONLY);
+	putchar('[');
+	while (fd >= 0 && (n = safe_read(fd, buf, sizeof(buf) - 1)) > 0) {
+		char *p = buf, *end = buf + n;
+		int j;
+
+		buf[n] = '\0';
+		while (p < end) {
+			char *nl = memchr(p, '\n', (size_t)(end - p));
+			char *sp;
+			int len;
+
+			if (!nl)   /* a partial line: ignore it, ids are short */
+				break;
+			len = (int)(nl - p);
+			sp = p + 2;   /* skip "E " */
+			if (len >= 4 && (p[0] == 'E' || p[0] == 'W' || p[0] == 'I')
+			 && p[1] == ' '
+			 && (nl - sp) > 0 && (nl - sp) < 40
+			) {
+				int ok = 1;
+				for (j = 0; j < (int)(nl - sp); j++) {
+					char c = sp[j];
+					if (!((c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9')))
+						ok = 0;
+				}
+				if (ok) {
+					int k, dup = 0;
+					for (k = 0; k < nseen; k++)
+						if ((int)strlen(seen[k]) == len && memcmp(seen[k], p, (size_t)len) == 0)
+							dup = 1;
+					if (!dup && nseen < CODES_MAX) {
+						seen[nseen++] = xstrndup(p, (size_t)len);
+						if (!first)
+							putchar(',');
+						json_write_str(seen[nseen - 1]);
+						first = 0;
+					}
+				}
+			}
+			p = nl + 1;
+		}
+		if (nseen >= CODES_MAX)
+			break;
+	}
+	if (fd >= 0)
+		close(fd);
+	while (nseen > 0)
+		free(seen[--nseen]);
+	putchar(']');
+}

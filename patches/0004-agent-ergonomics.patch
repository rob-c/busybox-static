 	while ((i = getopt(argc, argv, "-d:lnotpqxjvK")) != -1) {
 		switch (i) {
 		case 'd':  /* Extract to base directory */
@@ -804,6 +921,15 @@ int unzip_main(int argc, char **argv)
 				zip.fmt.cmpsize  = cdf.fmt.cmpsize;
 				zip.fmt.ucmpsize = cdf.fmt.ucmpsize;
 			}
+			/* Zip64: a local header may carry 0xffffffff where the
+			 * central directory has the real size (or an extra field) */

diff --git a/miscutils/snapshot.c b/miscutils/snapshot.c
new file mode 100644
index 0000000..6e828d0
--- /dev/null
+++ b/miscutils/snapshot.c
@@ -0,0 +1,297 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * snapshot - hash a directory tree and diff two snapshots.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config SNAPSHOT
+//config:	bool "snapshot (5 kb)"
+//config:	default n
+//config:	help
+//config:	  Record the sha256 of every regular file under a directory, or
+//config:	  compare two such records and print what changed. Same command,
+//config:	  same fields on Linux and Darwin, no inotify and no /proc.
+
+//applet:IF_SNAPSHOT(APPLET_NOEXEC(snapshot, snapshot_main, BB_DIR_USR_BIN, BB_SUID_DROP, snapshot))
+
+//kbuild:lib-$(CONFIG_SNAPSHOT) += snapshot.o
+
+//usage:#define snapshot_trivial_usage
+//usage:       "[-d DIR] [-o FILE] [--diff A B] [--format json]"
+//usage:#define snapshot_full_usage "\n\n"
+//usage:       "Hash a tree, or diff two saved snapshots\n"
+//usage:     "\n	-d DIR	Tree to walk (default: .)"
+//usage:     "\n	-o FILE	Write the snapshot to FILE instead of stdout"
+//usage:     "\n	--diff A B	Compare two snapshot files"
+//usage:     "\n	--format json	Structured output (schema 1)"
+
+#include "libbb.h"
+
+static const char snap_longopts[] ALIGN1 =
+	"dir\0"    Required_argument "d"
+	"output\0" Required_argument "o"
+	"diff\0"   Required_argument "D"
+	"format\0" Required_argument "F"
+	;
+#define snap_longopts (snap_longopts)
+
+struct ent {
+	char *path;      /* relative, no leading ./ */
+	char *hash;
+	off_t size;
+};
+
+struct entlist {
+	struct ent *v;
+	unsigned n, cap;
+};
+
+static void add_ent(struct entlist *l, char *path, const char *hash, off_t size)
+{
+	if (l->n == l->cap) {
+		l->cap = l->cap ? l->cap * 2 : 64;
+		l->v = xrealloc(l->v, sizeof(l->v[0]) * l->cap);
+	}
+	l->v[l->n].path = path;
+	l->v[l->n].hash = xstrdup(hash);
+	l->v[l->n].size = size;
+	l->n++;
+}
+
+static int cmp_ent(const void *a, const void *b)
+{
+	return strcmp(((const struct ent *)a)->path, ((const struct ent *)b)->path);
+}
+
+static void hash_file(const char *full, char *out64)
+{
+	sha256_ctx_t ctx;
+	unsigned char res[32];
+	int fd = open_or_warn(full, O_RDONLY);
+	ssize_t r;
+	char buf[4096];
+
+	if (fd < 0) {
+		strcpy(out64, "unreadable");
+		return;
+	}
+	sha256_begin(&ctx);
+	while ((r = safe_read(fd, buf, sizeof(buf))) > 0)
+		sha256_hash(&ctx, buf, r);
+	close(fd);
+	sha256_end(&ctx, res);
+	bin2hex(out64, (char *)res, 32);
+}
+
+static void walk(struct entlist *l, const char *base, const char *rel, int depth)
+{
+	DIR *d;
+	struct dirent *de;
+	char *dirpath = rel[0] ? xasprintf("%s/%s", base, rel) : xstrdup(base);
+
+	if (depth > 32) {
+		free(dirpath);
+		return;
+	}
+	d = opendir(dirpath);
+	if (!d) {
+		free(dirpath);
+		return;
+	}
+	while ((de = readdir(d)) != NULL) {
+		char *child_rel, *full;
+		struct stat st;
+
+		if (de->d_name[0] == '.'
+		 && (de->d_name[1] == '\0'
+		  || (de->d_name[1] == '.' && de->d_name[2] == '\0'))
+		)
+			continue;
+		child_rel = rel[0] ? xasprintf("%s/%s", rel, de->d_name) : xstrdup(de->d_name);
+		full = xasprintf("%s/%s", base, child_rel);
+		if (lstat(full, &st) != 0) {
+			free(full);
+			free(child_rel);
+			continue;
+		}
+		if (S_ISDIR(st.st_mode)) {
+			walk(l, base, child_rel, depth + 1);
+			free(child_rel);
+		} else if (S_ISREG(st.st_mode)) {
+			char h[65];
+
+			hash_file(full, h);
+			add_ent(l, child_rel, h, st.st_size);
+		} else {
+			free(child_rel);
+		}
+		free(full);
+	}
+	closedir(d);
+	free(dirpath);
+}
+
+/* Read "hash size path" lines produced by a previous run. */
+static void load(const char *file, struct entlist *l)
+{
+	char *buf = xmalloc_open_read_close(file, NULL);
+	char *save = buf, *line;
+
+	while (buf && (line = strsep(&save, "\n")) != NULL) {
+		char *hash, *size, *path;
+
+		if (!*line)
+			continue;
+		hash = strsep(&line, " ");
+		size = strsep(&line, " ");
+		path = line;
+		if (!path)
+			continue;
+		add_ent(l, xstrdup(path), hash, (off_t)strtoull(size, NULL, 10));
+	}
+	free(buf);
+}
+
+static void json_str(const char *s)
+{
+	putchar('"');
+	for (; *s; s++) {
+		if (*s == '"' || *s == '\\')
+			printf("\\%c", *s);
+		else if ((unsigned char)*s < 0x20)
+			printf("\\u%04x", (unsigned char)*s);
+		else
+			putchar(*s);
+	}
+	putchar('"');
+}
+
+int snapshot_main_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int snapshot_main_main(int argc UNUSED_PARAM, char **argv)
+{
+	const char *opt_dir = NULL, *opt_out = NULL, *opt_diff = NULL, *opt_fmt = NULL;
+	struct entlist l = { NULL, 0, 0 };
+	int json_out, rc = 0;
+	unsigned i;
+	FILE *out;
+
+	xfunc_error_retval = 2;
+	getopt32long(argv, "d:o:D:F:", snap_longopts, &opt_dir, &opt_out, &opt_diff, &opt_fmt);
+	xfunc_error_retval = 1;   /* past option parsing: failures are operational */
+	json_out = opt_fmt && strcmp(opt_fmt, "json") == 0;
+	if (opt_fmt && strcmp(opt_fmt, "json") != 0 && strcmp(opt_fmt, "text") != 0) {
+		bb_error_msg("unknown format %s", opt_fmt);
+		return 2;
+	}
+
+	if (opt_diff) {
+		/* --diff A B: opt_diff holds A, argv[optind] holds B */
+		struct entlist a = { NULL, 0, 0 }, b = { NULL, 0, 0 };
+		unsigned ia = 0, ib = 0, changed = 0, added = 0, removed = 0, comma = 0;
+
+		argv += optind;
+		if (!argv[0])
+			bb_show_usage();
+		load(opt_diff, &a);
+		load(argv[0], &b);
+		qsort(a.v, a.n, sizeof(a.v[0]), cmp_ent);
+		qsort(b.v, b.n, sizeof(b.v[0]), cmp_ent);
+
+		if (json_out)
+			fputs("{\"schema\":1,\"status\":\"ok\",\"changes\":[", stdout);
+		while (ia < a.n || ib < b.n) {
+			int c;
+			const struct ent *ea = ia < a.n ? &a.v[ia] : NULL;
+			const struct ent *eb = ib < b.n ? &b.v[ib] : NULL;
+			const char *kind = NULL;
+
+			if (!ea)
+				c = 1;
+			else if (!eb)
+				c = -1;
+			else
+				c = strcmp(ea->path, eb->path);
+			if (c < 0) {
+				kind = "removed";
+				removed++;
+				ia++;
+			} else if (c > 0) {
+				kind = "added";
+				added++;
+				ib++;
+			} else {
+				if (strcmp(ea->hash, eb->hash) != 0) {
+					kind = "changed";
+					changed++;
+				}
+				ia++;
+				ib++;
+			}
+			if (!kind)
+				continue;
+			if (json_out) {
+				if (comma++)
+					putchar(',');
+				fputs("{\"kind\":\"", stdout);
+				fputs(kind, stdout);
+				fputs("\",\"path\":", stdout);
+				json_str(c < 0 ? ea->path : eb->path);
+				putchar('}');
+			} else {
+				printf("%s %s\n", kind, c < 0 ? ea->path : eb->path);
+			}
+		}
+		if (json_out)
+			printf("],\"added\":%u,\"removed\":%u,\"changed\":%u}\n",
+					added, removed, changed);
+		else
+			printf("added=%u removed=%u changed=%u\n", added, removed, changed);
+		fflush_stdout_and_exit(added || removed || changed ? 1 : 0);
+	}
+
+	{
+		/* a missing or unreadable root must not look like an empty tree */
+		struct stat st;
+		const char *root = opt_dir ? opt_dir : ".";
+
+		if (stat(root, &st) != 0 || !S_ISDIR(st.st_mode)) {
+			int e = errno;
+
+			if (json_out) {
+				printf("{\"schema\":1,\"status\":\"error\","
+						"\"code\":\"NOT_FOUND\",\"message\":");
+				json_str(strerror(e));
+				fputs(",\"dir\":", stdout);
+				json_str(root);
+				fputs("}\n", stdout);
+			} else {
+				errno = e;
+				bb_perror_msg("%s", root);
+			}
+			fflush_stdout_and_exit(1);
+		}
+	}
+	walk(&l, opt_dir ? opt_dir : ".", "", 0);
+	qsort(l.v, l.n, sizeof(l.v[0]), cmp_ent);
+
+	out = opt_out ? xfopen_for_write(opt_out) : stdout;
+	if (json_out) {
+		fprintf(out, "{\"schema\":1,\"status\":\"ok\",\"dir\":");
+		fputs("\"", out);
+		fputs(opt_dir ? opt_dir : ".", out);
+		fprintf(out, "\",\"count\":%u,\"files\":[", l.n);
+		for (i = 0; i < l.n; i++) {
+			if (i)
+				putc(',', out);
+			fprintf(out, "{\"path\":\"%s\",\"size\":%lld,\"sha256\":\"%s\"}",
+					l.v[i].path, (long long)l.v[i].size, l.v[i].hash);
+		}
+		fputs("]}\n", out);
+	} else {
+		for (i = 0; i < l.n; i++)
+			fprintf(out, "%s %lld %s\n", l.v[i].hash, (long long)l.v[i].size, l.v[i].path);
+	}
+	if (out != stdout)
+		fclose(out);
+	return rc;
+}
diff --git a/miscutils/waitfor.c b/miscutils/waitfor.c
new file mode 100644
index 0000000..e828260
--- /dev/null
+++ b/miscutils/waitfor.c
@@ -0,0 +1,469 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * waitfor - bounded readiness polling.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config WAITFOR
+//config:	bool "waitfor (5 kb)"
+//config:	default y
+//config:	help
+//config:	Poll for file, TCP, unix-socket or HTTP readiness with one deadline.
+
+//applet:IF_WAITFOR(APPLET(waitfor, BB_DIR_USR_BIN, BB_SUID_DROP))
+
+//kbuild:lib-$(CONFIG_WAITFOR) += waitfor.o
+
+//usage:#define waitfor_trivial_usage
+//usage:       "[-T SECS] {--file PATH | --tcp HOST:PORT | --unix PATH | --http URL}"
+//usage:#define waitfor_full_usage "\n\n"
+//usage:       "Wait until a readiness condition holds, or the deadline expires"
+//usage:     "\n	-f, --file PATH		Wait for PATH to exist"
+//usage:     "\n	-t, --tcp HOST:PORT	Wait for a TCP connect to succeed"
+//usage:     "\n	-u, --unix PATH		Wait for a unix socket to accept"
+//usage:     "\n	-H, --http URL		Wait for an HTTP status (http:// only)"
+//usage:     "\n	-G, --glob PATTERN	Wait for a path matching PATTERN to exist"
+//usage:     "\n	-x, --exec CMD		Wait until CMD exits 0"
+//usage:     "\n	-e, --expect CODE	Expected HTTP status (default 200)"
+//usage:     "\n	-T, --timeout SECS	Overall deadline (default 20)"
+//usage:     "\n	-i, --interval MS	Initial poll interval (default 20)"
+//usage:     "\n	-F, --format FMT	text (default) or json"
+//usage:     "\n"
+//usage:     "\nExit: 0 ready, 3 timeout/cancelled, 1 invalid input, 2 usage error"
+//usage:     "\nA TCP connect proves the port accepts connections, not that the"
+//usage:     "\napplication behind it is ready. https:// needs wget --spider."
+
+#include <sys/un.h>
+#include <glob.h>
+#include <sys/wait.h>
+#include "libbb.h"
+
+enum {
+	DEFAULT_TIMEOUT_MS = 20000,
+	DEFAULT_INTERVAL_MS = 20,
+	MAX_INTERVAL_MS = 200,
+	CONNECT_TIMEOUT_MS = 1000,
+	HTTP_MAX_HEADER = 8192,
+};
+
+struct opts {
+	const char *file;
+	const char *unix_path;
+	const char *http;
+	const char *target;
+	char *host;
+	char *path;
+	int port;
+	int kind;           /* 0 file, 1 tcp, 2 unix, 3 http */
+	long expect;
+	long timeout_ms;
+	long interval_ms;
+	int json;
+};
+
+static void on_sig(int sig)
+{
+	bb_got_signal = sig;
+}
+
+static void sleep_ms(long ms)
+{
+	/* poll(), not sleep(): a signal interrupts it, so ^C is prompt */
+	if (ms > 0)
+		poll(NULL, 0, (int)ms);
+}
+
+static void json_str(const char *s)
+{
+	putchar('"');
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') {
+			putchar('\\');
+			putchar(c);
+		} else if (c == '\n') {
+			fputs("\\n", stdout);
+		} else if (c >= 0x20) {
+			putchar(c);
+		}
+	}
+	putchar('"');
+}
+
+static int wait_file(const char *path)
+{
+	struct stat st;
+
+	return stat(path, &st) == 0;
+}
+
+/* Connect with its own timeout, so a single attempt cannot eat the deadline. */
+static int wait_unix(const char *path)
+{
+	struct sockaddr_un sun;
+	int fd, rc;
+
+	memset(&sun, 0, sizeof(sun));
+	sun.sun_family = AF_UNIX;
+	if (strlen(path) >= sizeof(sun.sun_path))
+		return 0;
+	strcpy(sun.sun_path, path);
+	fd = socket(AF_UNIX, SOCK_STREAM, 0);
+	if (fd < 0)
+		return 0;
+	rc = connect(fd, (struct sockaddr *)&sun, sizeof(sun));
+	close(fd);
+	return rc == 0;
+}
+
+static int wait_tcp(const char *host, int port, int timeout_ms)
+{
+	int fd, rc, err = 0;
+	socklen_t errlen = sizeof(err);
+	len_and_sockaddr *lsa;
+	struct pollfd pfd;
+
+	lsa = xhost2sockaddr(host, port);
+	fd = socket(lsa->u.sa.sa_family, SOCK_STREAM, 0);
+	if (fd < 0) {
+		free(lsa);
+		return 0;
+	}
+	ndelay_on(fd);
+	rc = connect(fd, &lsa->u.sa, lsa->len);
+	if (rc != 0) {
+		if (errno != EINPROGRESS) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+		pfd.fd = fd;
+		pfd.events = POLLOUT;
+		pfd.revents = 0;
+		if (poll(&pfd, 1, timeout_ms) <= 0
+		 || getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &errlen) != 0
+		 || err != 0
+		) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+	}
+	close(fd);
+	free(lsa);
+	return 1;
+}
+
+/* Plain HTTP GET: portable, and the status code is observable (unlike --spider). */
+static int try_http(const struct opts *o, int timeout_ms)
+{
+	int fd, status = 0;
+	len_and_sockaddr *lsa;
+	struct timeval tv;
+	struct pollfd pfd;
+	char req[512];
+	char *buf;
+	size_t used = 0, need, off;
+	ssize_t r;
+
+	lsa = xhost2sockaddr(o->host, o->port);
+	fd = socket(lsa->u.sa.sa_family, SOCK_STREAM, 0);
+	if (fd < 0) {
+		free(lsa);
+		return 0;
+	}
+	ndelay_on(fd);
+	if (connect(fd, &lsa->u.sa, lsa->len) != 0) {
+		int err = 0;
+		socklen_t errlen = sizeof(err);
+
+		if (errno != EINPROGRESS) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+		pfd.fd = fd;
+		pfd.events = POLLOUT;
+		pfd.revents = 0;
+		if (poll(&pfd, 1, timeout_ms) <= 0
+		 || getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &errlen) != 0
+		 || err != 0
+		) {
+			close(fd);
+			free(lsa);
+			return 0;
+		}
+	}
+	free(lsa);
+
+	snprintf(req, sizeof(req),
+			"GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n"
+			"User-Agent: busybox-waitfor\r\n\r\n",
+			o->path, o->host);
+	need = strlen(req);
+	off = 0;
+	while (off < need) {
+		r = write(fd, req + off, need - off);
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			close(fd);
+			return 0;
+		}
+		off += (size_t)r;
+	}
+
+	tv.tv_sec = timeout_ms / 1000;
+	tv.tv_usec = (timeout_ms % 1000) * 1000;
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+	buf = xmalloc(HTTP_MAX_HEADER);
+	buf[0] = '\0';
+	while (used < HTTP_MAX_HEADER - 1) {
+		r = read(fd, buf + used, HTTP_MAX_HEADER - 1 - used);
+		if (r <= 0)
+			break;
+		used += (size_t)r;
+		buf[used] = '\0';
+		if (strstr(buf, "\r\n\r\n") || strstr(buf, "\n\n"))
+			break;
+	}
+	buf[used] = '\0';
+	if (used > 5 && strncmp(buf, "HTTP/", 5) == 0) {
+		const char *sp = strchr(buf, ' ');
+		if (sp)
+			status = atoi(sp + 1);
+	}
+	close(fd);
+	free(buf);
+	return status;
+}
+
+/* host, port and path out of http://HOST[:PORT]/PATH */
+static void parse_http(struct opts *o)
+{
+	const char *p = o->http + 7;    /* past "http://" */
+	const char *slash = strchr(p, '/');
+	const char *colon = strchr(p, ':');
+
+	o->port = 80;
+	if (colon && (!slash || colon < slash)) {
+		o->host = xstrndup(p, (size_t)(colon - p));
+		o->port = atoi(colon + 1);
+	} else {
+		o->host = xstrndup(p, slash ? (size_t)(slash - p) : strlen(p));
+	}
+	o->path = xstrdup(slash ? slash : "/");
+	if (o->port <= 0 || o->port > 65535)
+		bb_error_msg_and_die("bad port in \"%s\"", o->http);
+}
+
+int waitfor_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int waitfor_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *opt_file = NULL;
+	char *opt_tcp = NULL;
+	char *opt_unix = NULL;
+	char *opt_http = NULL;
+	char *opt_glob = NULL;
+	char *opt_exec = NULL;
+	char *opt_expect = NULL;
+	char *opt_timeout = NULL;
+	char *opt_interval = NULL;
+	char *opt_fmt = NULL;
+	unsigned opts;
+	struct opts o;
+	unsigned long long deadline, start;
+	long attempt = 0, interval, elapsed_ms;
+	int ready = 0, last_status = 0;
+
+	static const char waitfor_longopts[] ALIGN1 =
+		"file\0"     Required_argument "f"
+		"tcp\0"      Required_argument "t"
+		"unix\0"     Required_argument "u"
+		"http\0"     Required_argument "H"
+		"glob\0"     Required_argument "G"
+		"exec\0"     Required_argument "x"
+		"expect\0"   Required_argument "e"
+		"timeout\0"  Required_argument "T"
+		"interval\0" Required_argument "i"
+		"format\0"   Required_argument "F"
+		;
+
+	xfunc_error_retval = 2;
+
+	opts = getopt32long(argv, "f:t:u:H:G:x:e:T:i:F:", waitfor_longopts,
+			&opt_file, &opt_tcp, &opt_unix, &opt_http, &opt_glob, &opt_exec, &opt_expect,
+			&opt_timeout, &opt_interval, &opt_fmt);
+	(void)opts;
+
+	memset(&o, 0, sizeof(o));
+	o.expect = 200;
+	o.timeout_ms = DEFAULT_TIMEOUT_MS;
+	o.interval_ms = DEFAULT_INTERVAL_MS;
+
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			o.json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+	if (opt_expect)
+		o.expect = strtol(opt_expect, NULL, 10);
+	if (opt_timeout) {
+		double s = strtod(opt_timeout, NULL);
+		/* 0 means: one attempt, no deadline. */
+		if (!(s >= 0))
+			bb_error_msg_and_die("bad timeout \"%s\"", opt_timeout);
+		o.timeout_ms = (long)(s * 1000.0);
+	}
+	if (opt_interval)
+		o.interval_ms = strtol(opt_interval, NULL, 10);
+	if (o.interval_ms < 1)
+		o.interval_ms = 1;
+	if (o.interval_ms > MAX_INTERVAL_MS)
+		o.interval_ms = MAX_INTERVAL_MS;
+
+	if ((!!opt_file + !!opt_tcp + !!opt_unix + !!opt_http + !!opt_glob + !!opt_exec) != 1)
+		bb_error_msg_and_die("exactly one of --file/--tcp/--unix/--http/--glob/--exec is required");
+
+	o.file = opt_file;
+	o.unix_path = opt_unix;
+	o.http = opt_http;
+	if (opt_file) {
+		o.kind = 0;
+		o.target = opt_file;
+	} else if (opt_glob) {
+		o.kind = 4;
+		o.target = opt_glob;
+	} else if (opt_exec) {
+		o.kind = 5;
+		o.target = opt_exec;
+	} else if (opt_unix) {
+		o.kind = 2;
+		o.target = opt_unix;
+	} else if (opt_http) {
+		if (strncmp(opt_http, "http://", 7) != 0)
+			bb_error_msg_and_die("only http:// is handled here; "
+					"use `wget --spider` for https://");
+		o.kind = 3;
+		o.target = opt_http;
+		parse_http(&o);
+	} else {
+		char *colon = strrchr(opt_tcp, ':');
+		if (!colon)
+			bb_error_msg_and_die("--tcp needs HOST:PORT");
+		*colon = '\0';
+		o.kind = 1;
+		o.host = opt_tcp[0] ? xstrdup(opt_tcp) : xstrdup("127.0.0.1");
+		o.port = atoi(colon + 1);
+		if (o.port <= 0 || o.port > 65535)
+			bb_error_msg_and_die("bad port in \"%s\"", opt_tcp);
+		o.target = xasprintf("%s:%d", o.host, o.port);
+	}
+
+	bb_signals((1 << (SIGINT - 1)) | (1 << (SIGTERM - 1)), on_sig);
+
+	start = monotonic_us();
+	deadline = start + (unsigned long long)o.timeout_ms * 1000ULL;
+	interval = o.interval_ms;
+
+	for (;;) {
+		unsigned long long now;
+		long remain_ms;
+
+		if (bb_got_signal)
+			break;
+		attempt++;
+
+		switch (o.kind) {
+		case 0: ready = wait_file(o.file); break;
+		case 1: ready = wait_tcp(o.host, o.port, CONNECT_TIMEOUT_MS); break;
+		case 2: ready = wait_unix(o.unix_path); break;
+		case 5: {
+			pid_t pid;
+			int st;
+
+			fflush_all();
+			pid = fork();
+			if (pid < 0) {
+				ready = 0;
+				break;
+			}
+			if (pid == 0) {
+				int nul = open("/dev/null", O_WRONLY);
+
+				if (nul >= 0) {
+					dup2(nul, 1);
+					dup2(nul, 2);
+					if (nul > 2)
+						close(nul);
+				}
+				execl("/bin/sh", "sh", "-c", o.target, (char *)NULL);
+				_exit(127);
+			}
+			ready = waitpid(pid, &st, 0) == pid && WIFEXITED(st) && WEXITSTATUS(st) == 0;
+			break;
+		}
+		case 4: {
+			glob_t g;
+
+			memset(&g, 0, sizeof(g));
+			ready = glob(o.target, 0, NULL, &g) == 0 && g.gl_pathc > 0;
+			globfree(&g);
+			break;
+		}
+		default:
+			last_status = try_http(&o, CONNECT_TIMEOUT_MS);
+			ready = (last_status == o.expect);
+			break;
+		}
+		if (ready)
+			break;
+		now = monotonic_us();
+		if (now >= deadline)
+			break;
+		remain_ms = (long)((deadline - now) / 1000ULL);
+		if (remain_ms <= 0)
+			break;
+		sleep_ms(interval < remain_ms ? interval : remain_ms);
+		if (interval < MAX_INTERVAL_MS) {
+			interval *= 2;
+			if (interval > MAX_INTERVAL_MS)
+				interval = MAX_INTERVAL_MS;
+		}
+	}
+
+	elapsed_ms = (long)((monotonic_us() - start) / 1000ULL);
+
+	if (o.json) {
+		printf("{\"schema\":1,\"status\":\"%s\",\"ready\":%s,\"kind\":\"%s\",\"target\":",
+				ready ? "ok" : "error",
+				ready ? "true" : "false",
+				o.kind == 0 ? "file" : o.kind == 1 ? "tcp" :
+				o.kind == 2 ? "unix" : o.kind == 4 ? "glob" :
+				o.kind == 5 ? "exec" : "http");
+		json_str(o.target);
+		printf(",\"attempts\":%ld,\"elapsed_ms\":%ld", attempt, elapsed_ms);
+		if (o.kind == 3)
+			printf(",\"status\":%d,\"expect\":%ld", last_status, o.expect);
+		if (!ready)
+			printf(",\"code\":\"%s\"",
+					bb_got_signal ? "CANCELLED" : "TIMEOUT");
+		fputs("}\n", stdout);
+	} else {
+		printf("ready=%s kind=%s target=%s attempts=%ld elapsed_ms=%ld",
+				ready ? "true" : "false",
+				o.kind == 0 ? "file" : o.kind == 1 ? "tcp" :
+				o.kind == 2 ? "unix" : o.kind == 4 ? "glob" :
+				o.kind == 5 ? "exec" : "http",
+				o.target, attempt, elapsed_ms);
+		if (o.kind == 3)
+			printf(" status=%d expect=%ld", last_status, o.expect);
+		if (!ready)
+			printf(" code=%s", bb_got_signal ? "CANCELLED" : "TIMEOUT");
+		putchar('\n');
+	}
+	fflush(stdout);
+	return ready ? 0 : 3;
+}
diff --git a/miscutils/why.c b/miscutils/why.c
new file mode 100644
index 0000000..594f3ab
--- /dev/null
+++ b/miscutils/why.c
@@ -0,0 +1,237 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * why - explain why an applet is, or is not, in this build.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config WHY
+//config:	bool "why (3 kb)"
+//config:	default y
+//config:	help
+//config:	Explain an applet's build state: its CONFIG symbol, the value in a
+//config:	.config, and the line in a prune list that disabled it.
+
+//applet:IF_WHY(APPLET(why, BB_DIR_USR_BIN, BB_SUID_DROP))
+
+//kbuild:lib-$(CONFIG_WHY) += why.o
+
+//usage:#define why_trivial_usage
+//usage:       "[-C FILE] [-p FILE] APPLET..."
+//usage:#define why_full_usage "\n\n"
+//usage:       "Say whether APPLET is in this binary and which file decided that"
+//usage:     "\n	-C, --config FILE	.config to read (default .config)"
+//usage:     "\n	-p, --prune FILE	prune list to read (default prune/darwin-off.txt)"
+//usage:     "\n	-F, --format FMT	text (default) or json"
+
+#include "libbb.h"
+
+/* add-shell -> ADD_SHELL, [ -> LBRACKET, [[ -> LBRACKET_LBRACKET */
+static char *config_symbol(const char *name)
+{
+	char *out;
+	size_t i, n = 0, len = strlen(name) + 8;
+
+	out = xmalloc(len);
+	for (i = 0; name[i]; i++) {
+		char c = name[i];
+		if (c == '-')
+			c = '_';
+		else if (c == '+')
+			c = 'P';       /* '+' is not valid in a symbol */
+		else if (c == '[')
+			c = (n == 0) ? 'L' : 'L';
+		else if (c == ']')
+			c = 'R';
+		else if (c == '.')
+			c = '_';
+		else if (c >= 'a' && c <= 'z')
+			c = (char)(c - 'a' + 'A');
+		out[n++] = c;
+	}
+	out[n] = '\0';
+	return out;
+}
+
+/* Return a malloc'd "file:line: text" for the first match, else NULL. */
+static char *find_line(const char *path, const char *needle)
+{
+	FILE *fp = fopen_for_read(path);
+	char *line;
+	unsigned lno = 0;
+
+	if (!fp)
+		return NULL;
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		char *hit;
+
+		lno++;
+		hit = strstr(line, needle);
+		if (hit) {
+			char *res = xasprintf("%s:%u: %s", path, lno, line);
+			free(line);
+			fclose(fp);
+			return res;
+		}
+		free(line);
+	}
+	fclose(fp);
+	return NULL;
+}
+
+/* "CONFIG_X is not set" / "CONFIG_X=y" in a .config */
+static char *config_state(const char *path, const char *sym)
+{
+	FILE *fp = fopen_for_read(path);
+	char *line;
+	char *want_on;
+	char *want_off;
+	char *res = NULL;
+
+	if (!fp)
+		return NULL;
+	want_on = xasprintf("CONFIG_%s=", sym);
+	want_off = xasprintf("# CONFIG_%s is not set", sym);
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		if (strncmp(line, want_on, strlen(want_on)) == 0) {
+			res = xasprintf("%s: %s", path, line);
+			free(line);
+			break;
+		}
+		if (strcmp(line, want_off) == 0) {
+			res = xasprintf("%s: %s", path, line);
+			free(line);
+			break;
+		}
+		free(line);
+	}
+	fclose(fp);
+	free(want_on);
+	free(want_off);
+	return res;
+}
+
+static void json_str(const char *s)
+{
+	putchar('"');
+	if (s) {
+		for (; *s; s++) {
+			unsigned char c = (unsigned char)*s;
+			if (c == '"' || c == '\\') {
+				putchar('\\');
+				putchar(c);
+			} else if (c == '\n') {
+				fputs("\\n", stdout);
+			} else if (c >= 0x20) {
+				putchar(c);
+			}
+		}
+	}
+	putchar('"');
+}
+
+int why_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int why_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *opt_cfg = NULL, *opt_prune = NULL, *opt_fmt = NULL;
+	unsigned opts;
+	int json = 0, idx = 0, rc = 0;
+	const char *cfg, *prune;
+	int first = 1;
+
+	static const char why_longopts[] ALIGN1 =
+		"config\0" Required_argument "C"
+		"prune\0"  Required_argument "p"
+		"format\0" Required_argument "F"
+		;
+
+	xfunc_error_retval = 2;
+
+	opts = getopt32long(argv, "C:p:F:", why_longopts,
+			&opt_cfg, &opt_prune, &opt_fmt);
+	(void)opts;
+	argv += optind;
+	if (!argv[0])
+		bb_show_usage();
+
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+	cfg = opt_cfg ? opt_cfg : ".config";
+	prune = opt_prune ? opt_prune : "prune/darwin-off.txt";
+
+	if (json)
+		fputs("{\"schema\":1,\"results\":[", stdout);
+
+	for (; *argv; argv++, idx++) {
+		char *sym = config_symbol(*argv);
+		char *state = config_state(cfg, sym);
+		char *pruned = find_line(prune, sym);
+		int enabled = 0;
+		const char *verdict;
+		const char *reason;
+
+		if (state && strchr(state, '=')) {
+			const char *eq = strrchr(state, '=');
+			enabled = !(eq[1] == 'n' && eq[2] == '\0');
+		}
+		if (pruned) {
+			verdict = "disabled";
+			reason = "prune list";
+			rc = 1;
+		} else if (state && !enabled) {
+			verdict = "disabled";
+			reason = "config";
+			rc = 1;
+		} else if (state) {
+			verdict = "enabled";
+			reason = "config";
+		} else {
+			verdict = "unknown";
+			reason = "no config entry";
+			rc = 1;
+		}
+
+		if (json) {
+			if (!first)
+				putchar(',');
+			first = 0;
+			fputs("{\"applet\":", stdout);
+			json_str(*argv);
+			fputs(",\"symbol\":", stdout);
+			json_str(sym);
+			fputs(",\"state\":", stdout);
+			json_str(verdict);
+			fputs(",\"decided_by\":", stdout);
+			json_str(reason);
+			fputs(",\"config_line\":", stdout);
+			json_str(state);
+			fputs(",\"prune_line\":", stdout);
+			json_str(pruned);
+			putchar('}');
+		} else {
+			printf("%s %s\n", verdict, *argv);
+			printf("symbol=CONFIG_%s\n", sym);
+			if (state)
+				printf("config: %s\n", state);
+			else
+				printf("config: (no %s entry in %s)\n", sym, cfg);
+			if (pruned)
+				printf("prune: %s\n", pruned);
+		}
+		free(sym);
+		free(state);
+		free(pruned);
+	}
+	if (json) {
+		/* one envelope for every applet: status first, code when it failed */
+		printf("],\"status\":\"%s\"", rc ? "error" : "ok");
+		if (rc)
+			fputs(",\"code\":\"NOT_FOUND\"", stdout);
+		fputs("}\n", stdout);
+	}
+	fflush(stdout);
+	return rc;
+}
diff --git a/networking/ifconfig.c b/networking/ifconfig.c
index 32638e2..591298b 100644
--- a/networking/ifconfig.c
+++ b/networking/ifconfig.c
@@ -96,6 +96,310 @@
 //usage:       "	[up|down] ..."
 
 #include "libbb.h"
+
+#if defined(__APPLE__)
+/*
+ * Darwin port.  Everything after the #else is the Linux rtnetlink/ioctl
+ * implementation, which cannot compile here (no ifr_netmask / ifr_ifindex /
+ * ifr_hwaddr, no SIOCGIFINDEX).
+ *
+ * Listing lives in display_interfaces() (networking/interface.c, getifaddrs).
+ * Setting uses the BSD ioctl family, all of which the SDK provides:
+ *
+ *   up/down        SIOCSIFFLAGS      (read-modify-write of ifr_flags)
+ *   mtu N          SIOCSIFMTU
+ *   addr[/pfx]     SIOCSIFADDR + SIOCSIFNETMASK   (in place)
+ *   alias addr     SIOCAIFADDR                    (add secondary)
+ *   -alias addr    SIOCDIFADDR                    (remove secondary)
+ *   netmask M      SIOCSIFNETMASK
+ *   broadcast B    SIOCSIFBRDADDR
+ *   pointopoint P  SIOCSIFDSTADDR
+ *   hw ether MAC   SIOCSIFLLADDR     (sockaddr_dl in ifr_addr)
+ *
+ * All of it needs root; unprivileged calls fail with EPERM, exactly as the
+ * Linux build does.
+ */
+#include <sys/sockio.h>
+#include <net/if_dl.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+
+static int darwin_ifreq_sock(void)
+{
+	int s = socket(AF_INET, SOCK_DGRAM, 0);
+	if (s < 0)
+		bb_simple_perror_msg_and_die("socket");
+	return s;
+}
+
+/* Fill ifr_name on a fresh ifreq */
+static void darwin_ifr_init(struct ifreq *ifr, const char *name)
+{
+	memset(ifr, 0, sizeof(*ifr));
+	strncpy(ifr->ifr_name, name, IFNAMSIZ - 1);
+}
+
+static void darwin_ifr_addr(struct ifreq *ifr, const char *addr, int *prefix)
+{
+	struct sockaddr_in *sin = (struct sockaddr_in *)&ifr->ifr_addr;
+	char *slash;
+	char buf[64];
+	int plen = -1;
+
+	safe_strncpy(buf, addr, sizeof(buf));
+	slash = strchr(buf, '/');
+	if (slash) {
+		*slash = '\0';
+		plen = xatoi_positive(slash + 1);
+	}
+	memset(sin, 0, sizeof(*sin));
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	if (inet_pton(AF_INET, buf, &sin->sin_addr) != 1)
+		bb_error_msg_and_die("invalid address: %s", buf);
+	if (prefix)
+		*prefix = plen;
+}
+
+static void darwin_ifr_mask(struct ifreq *ifr, int prefix)
+{
+	struct sockaddr_in *sin = (struct sockaddr_in *)&ifr->ifr_addr;
+	uint32_t m = prefix <= 0 ? 0 : (prefix >= 32 ? 0xffffffffU : (0xffffffffU << (32 - prefix)));
+
+	memset(sin, 0, sizeof(*sin));
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = htonl(m);
+}
+
+/* An alias needs struct ifaliasreq (address + netmask + broadcast together) */
+static void darwin_alias(int s, const char *name, const char *addr, int add)
+{
+	struct ifaliasreq ifra;

+	{
+		unsigned len = 0;
+		out = xzalloc(1);
+		for (unsigned j = i; j < nf; j++) {
+			out = xrealloc(out, len + 3 + 1);
+			memcpy(out + len, "../", 3);
+			len += 3;
+			out[len] = '\0';
+		}
+		for (unsigned j = i; j < nt; j++) {
+			unsigned l = strlen(tp[j]);

+static char *json_join_argv(char **argv)
+{
+		size_t len = 0;
+	int i;
+	char *out, *p;
+
+	for (i = 0; argv[i]; i++)
+		len += strlen(argv[i]) + 1;
+	out = xzalloc(len + 1);
+	p = out;
+	for (i = 0; argv[i]; i++) {
+		size_t n = strlen(argv[i]);
+		if (i)
+			*p++ = ' ';
+		memcpy(p, argv[i], n);
+		p += n;
+	}
+	return out;
+}

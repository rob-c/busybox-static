+		} else if (strcmp(*args, "up") == 0) {
+			up = 1; args++;
+		} else if (strcmp(*args, "down") == 0) {
+			up = 0; args++;
+		} else if (strcmp(*args, "mtu") == 0 && args[1]) {
+			mtu = xatoi_positive(*++args); args++;
+		} else if (strcmp(*args, "address") == 0 && args[1]) {
+			mac = *++args; args++;
+		} else {
+			bb_error_msg_and_die("unsupported: ip link set %s", *args);
+		}
+	}
+	if (!dev)
+		bb_show_usage();
+
+	if (mac) {
+		struct ifreq ifr;
+		struct sockaddr_dl *sdl;
+		unsigned b[6];
+		int i;
+
+		memset(&ifr, 0, sizeof(ifr));
+		strncpy(ifr.ifr_name, dev, IFNAMSIZ - 1);
+		sdl = (struct sockaddr_dl *)&ifr.ifr_addr;
+		memset(&ifr.ifr_addr, 0, sizeof(ifr.ifr_addr));
+		sdl->sdl_len = offsetof(struct sockaddr_dl, sdl_data) + 6;
+		sdl->sdl_family = AF_LINK;
+		sdl->sdl_alen = 6;
+		if (sscanf(mac, "%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6)
+			bb_error_msg_and_die("invalid MAC: %s", mac);
+		for (i = 0; i < 6; i++)
+			sdl->sdl_data[i] = (unsigned char)b[i];
+		if (ioctl(s, SIOCSIFLLADDR, &ifr) < 0)
+			bb_perror_msg_and_die("can't set address on %s", dev);
+	}
+	if (mtu > 0) {
+		struct ifreq ifr;
+		memset(&ifr, 0, sizeof(ifr));
+		strncpy(ifr.ifr_name, dev, IFNAMSIZ - 1);
+		ifr.ifr_mtu = mtu;
+		if (ioctl(s, SIOCSIFMTU, &ifr) < 0)
+			bb_perror_msg_and_die("can't set mtu on %s", dev);
+	}
+	if (up >= 0) {
+		struct ifreq ifr;
+		memset(&ifr, 0, sizeof(ifr));
+		strncpy(ifr.ifr_name, dev, IFNAMSIZ - 1);
+		if (ioctl(s, SIOCGIFFLAGS, &ifr) < 0)
+			bb_perror_msg_and_die("can't read flags of %s", dev);
+		if (up)
+			ifr.ifr_flags |= IFF_UP;
+		else
+			ifr.ifr_flags &= ~IFF_UP;
+		if (ioctl(s, SIOCSIFFLAGS, &ifr) < 0)
+			bb_perror_msg_and_die("can't change flags of %s", dev);
+	}
+	close(s);
+}
+
+/* ip addr add|del ADDR[/PFX] dev IFACE */
+static void darwin_ip_addr_set(char **args, int add)
+{
+	int s = darwin_ip_sock();
+	const char *addr = NULL, *dev = NULL;
+	struct ifaliasreq ifra;
+	struct sockaddr_in *sin;
+	int plen;
+
+	if (*args && (*args)[0] != '-') {
+		addr = *args++;
+	}
+	while (*args) {
+		if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev = *++args; args++;
+		} else if (strcmp(*args, "peer") == 0 && args[1]) {
+			args += 2;                  /* accepted, unused */
+		} else {
+			bb_error_msg_and_die("unsupported: ip addr %s", *args);
+		}
+	}
+	if (!addr || !dev)
+		bb_show_usage();
+
+	plen = darwin_ip_prefix(addr, 32);
+	memset(&ifra, 0, sizeof(ifra));
+	strncpy(ifra.ifra_name, dev, IFNAMSIZ - 1);
+
+	sin = (struct sockaddr_in *)&ifra.ifra_addr;
+	darwin_ip_sockaddr(sin, addr);
+
+	sin = (struct sockaddr_in *)&ifra.ifra_mask;
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = htonl(plen >= 32 ? 0xffffffffU
+			: (plen <= 0 ? 0 : (0xffffffffU << (32 - plen))));
+
+	if (ioctl(s, add ? SIOCAIFADDR : SIOCDIFADDR, &ifra) < 0)
+		bb_perror_msg_and_die("%s %s on %s", add ? "can't add" : "can't delete", addr, dev);
+	close(s);
+}
+
+/* ip route add|del DST [via GW] [dev IFACE] */
+static void darwin_ip_route_set(char **args, int add)
+{
+	int s;
+	struct {
+		struct rt_msghdr hdr;
+		struct sockaddr_in dst;
+		struct sockaddr_in gw;
+		struct sockaddr_in mask;
+	} msg;
+	char dest[64] = "";
+	const char *gw = NULL, *dev = NULL;
+	unsigned char addrs = 0;
+	char *cp;
+	int i;
+
+	while (*args) {
+		if (strcmp(*args, "via") == 0 && args[1]) {
+			gw = *++args; args++;
+		} else if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev = *++args; args++;
+		} else if (strcmp(*args, "proto") == 0 && args[1]) {
+			args += 2;
+		} else if (!dest[0]) {
+			safe_strncpy(dest, *args, sizeof(dest));
+			args++;
+		} else {
+			bb_error_msg_and_die("unsupported: ip route %s", *args);
+		}
+	}
+	if (!dest[0])
+		bb_show_usage();
+
+	s = socket(PF_ROUTE, SOCK_RAW, 0);
+	if (s < 0)
+		bb_simple_perror_msg_and_die("socket(PF_ROUTE)");
+
+	memset(&msg, 0, sizeof(msg));
+	msg.hdr.rtm_version = RTM_VERSION;
+	msg.hdr.rtm_type = add ? RTM_ADD : RTM_DELETE;
+	msg.hdr.rtm_seq = (int)getpid();
+	msg.hdr.rtm_flags = RTF_UP;
+
+	msg.dst.sin_len = sizeof(msg.dst);
+	msg.dst.sin_family = AF_INET;
+	if (strcmp(dest, "default") == 0) {
+		msg.dst.sin_addr.s_addr = 0;
+	} else {
+		darwin_ip_sockaddr(&msg.dst, dest);
+	}
+	addrs |= RTA_DST;
+
+	{
+		int plen = darwin_ip_prefix(dest, strcmp(dest, "default") == 0 ? 0 : 32);
+		if (plen <= 0 && strcmp(dest, "default") != 0)
+			plen = 32;
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		msg.mask.sin_addr.s_addr = htonl(plen >= 32 ? 0xffffffffU
+				: (plen <= 0 ? 0 : (0xffffffffU << (32 - plen))));
+		addrs |= RTA_NETMASK;
+		if (plen == 32)
+			msg.hdr.rtm_flags |= RTF_HOST;
+	}
+
+	if (gw) {
+		msg.gw.sin_len = sizeof(msg.gw);
+		msg.gw.sin_family = AF_INET;
+		if (inet_pton(AF_INET, gw, &msg.gw.sin_addr) != 1)
+			bb_error_msg_and_die("invalid gateway: %s", gw);
+		msg.hdr.rtm_flags |= RTF_GATEWAY;
+		addrs |= RTA_GATEWAY;
+	}
+
+	msg.hdr.rtm_addrs = addrs;
+	if (dev)
+		msg.hdr.rtm_index = if_nametoindex(dev);
+
+	cp = (char *)(&msg.hdr + 1);
+	for (i = 1; i < RTAX_MAX; i++) {
+		struct sockaddr *sa;
+		int n;
+		if (!(addrs & (1 << i)))
+			continue;
+		switch (i) {
+		case RTAX_DST:     sa = (struct sockaddr *)&msg.dst; break;
+		case RTAX_GATEWAY: sa = (struct sockaddr *)&msg.gw; break;
+		case RTAX_NETMASK: sa = (struct sockaddr *)&msg.mask; break;
+		default: continue;
+		}
+		n = (sa->sa_len + 3) & ~3;
+		memcpy(cp, sa, sa->sa_len);
+		cp += n;
+	}
+	msg.hdr.rtm_msglen = (u_short)(cp - (char *)&msg);
+
+	if (write(s, &msg, msg.hdr.rtm_msglen) < 0)
+		bb_perror_msg_and_die("%s %s", add ? "add" : "delete", dest);
+	close(s);
+}
+
+static int darwin_ip_usage(void)
+{
+	bb_show_usage();
+	return 1;
+}
+
+int ip_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int ip_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *cmd;
+	char *verb;
+	int want_link = 0, want_addr = 0, want_route = 0;
+
+	++argv;
+	/* skip common option words the way iproute2 accepts them */
+	while (*argv && (*argv)[0] == '-')
+		argv++;
+
+	if (!*argv)
+		return darwin_ip_usage();
+
+	cmd = *argv;
+	if (is_prefixed_with(cmd, "link") || strcmp(cmd, "l") == 0) {
+		want_link = 1;
+		cmd = "link";
+	} else if (is_prefixed_with(cmd, "addr") || strcmp(cmd, "a") == 0) {
+		want_addr = 1;
+		cmd = "addr";
+	} else if (is_prefixed_with(cmd, "route") || strcmp(cmd, "r") == 0
+		|| strcmp(cmd, "ro") == 0
+	) {
+		want_route = 1;
+		cmd = "route";
+	} else {
+		bb_error_msg_and_die("only 'link', 'addr' and 'route' are supported on Darwin");
+	}
+
+	/* sub-verb: show/list print, add/del/set mutate */
+	verb = argv[1];
+
+	if (want_link) {
+		if (!verb || !strcmp(verb, "show") || !strcmp(verb, "list"))
+			darwin_ip_link();
+		else if (!strcmp(verb, "set"))
+			darwin_ip_link_set(argv + 2);
+		else
+			bb_error_msg_and_die("unsupported: ip link %s", verb);
+	} else if (want_addr) {
+		if (!verb || !strcmp(verb, "show") || !strcmp(verb, "list"))
+			darwin_ip_addr();
+		else if (!strcmp(verb, "add"))
+			darwin_ip_addr_set(argv + 2, 1);
+		else if (!strcmp(verb, "del") || !strcmp(verb, "delete"))
+			darwin_ip_addr_set(argv + 2, 0);
+		else
+			bb_error_msg_and_die("unsupported: ip addr %s", verb);
+	} else if (want_route) {
+		if (!verb || !strcmp(verb, "show") || !strcmp(verb, "list"))
+			darwin_ip_route();
+		else if (!strcmp(verb, "add"))
+			darwin_ip_route_set(argv + 2, 1);
+		else if (!strcmp(verb, "del") || !strcmp(verb, "delete"))
+			darwin_ip_route_set(argv + 2, 0);
+		else
+			bb_error_msg_and_die("unsupported: ip route %s", verb);
+	}
+
+	(void)cmd;
+	return EXIT_SUCCESS;
+}

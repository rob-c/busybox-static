+		if (strncmp(gw, "link", 4) == 0) {
+			sdl_gw = (struct sockaddr_dl *)&msg.gw;
+			sdl_gw->sdl_len = offsetof(struct sockaddr_dl, sdl_data) + 6;
+			sdl_gw->sdl_family = AF_LINK;
+			sdl_gw->sdl_index = dev ? if_nametoindex(dev) : 0;
+			sdl_gw->sdl_alen = 6;
+		} else {
+			msg.gw.sin_len = sizeof(msg.gw);
+			msg.gw.sin_family = AF_INET;
+			if (inet_pton(AF_INET, gw, &msg.gw.sin_addr) != 1)
+				bb_error_msg_and_die("invalid gateway: %s", gw);
+			msg.hdr.rtm_flags |= RTF_GATEWAY;
+		}

+/* brief's JSON payload with its trailing newline removed, or NULL if empty. */
+static char *trim_json(char *s)
+{
+	size_t n;
+
+	if (!s)
+		return NULL;
+	n = strlen(s);
+	while (n && (s[n - 1] == '\n' || s[n - 1] == ' '))
+		s[--n] = '\0';
+	return s[0] == '{' ? s : NULL;
+}

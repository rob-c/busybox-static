+		printf("%s", d);
+		if (gw && gw->sa_family == AF_INET) {
+			inet_ntop(AF_INET, &((const struct sockaddr_in *)gw)->sin_addr, g, sizeof(g));
+			printf(" via %s", g);
+		}
+		ifname[0] = '\0';
+		if_indextoname(rtm->rtm_index, ifname);
+		if (ifname[0])

diff --git a/util-linux/column.c b/util-linux/column.c
new file mode 100644
index 0000000..84b0e4f
--- /dev/null
+++ b/util-linux/column.c
@@ -0,0 +1,200 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * column - format input into columns
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config COLUMN
+//config:	bool "column (2.6 kb)"
+//config:	default y
+//config:	help
+//config:	Format input into aligned columns.
+
+//applet:IF_COLUMN(APPLET_NOEXEC(column, column, BB_DIR_USR_BIN, BB_SUID_DROP, column))
+
+//kbuild:lib-$(CONFIG_COLUMN) += column.o
+
+//usage:#define column_trivial_usage
+//usage:       "[-t] [-s SEP] [-o SEP] [FILE]..."
+//usage:#define column_full_usage "\n\n"
+//usage:       "Format lines into columns"
+//usage:     "\n	-t	Build a table: align fields into columns"
+//usage:     "\n	-s SEP	Input field separator (default: runs of blanks)"
+//usage:     "\n	-o SEP	Output separator between columns (default: two spaces)"
+
+#include "libbb.h"
+
+static void json_escape(const char *s)
+{
+	for (; s && *s; s++) {
+		if (*s == '"' || *s == '\\')
+			printf("\\%c", *s);
+		else if ((unsigned char)*s < 0x20)
+			printf("\\u%04x", (unsigned char)*s);
+		else
+			putchar(*s);
+	}
+}
+
+int column_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int column_main(int argc UNUSED_PARAM, char **argv)
+{
+	unsigned opts;
+	const char *in_sep = NULL;
+	const char *out_sep = "  ";
+	llist_t *lines = NULL;
+	const char *opt_fmt = NULL;
+	int json_out;
+	llist_t *lp;
+	FILE *fp;
+	char *line;
+	unsigned nrows = 0;
+	unsigned maxcols = 0;
+	unsigned *width;      /* width[i]: widest cell in column i */
+	char ***cells;        /* cells[row][col] */
+	unsigned *ncells;     /* number of cells per row */
+	unsigned r, c;
+
+	/* bits: t = 1, s = 2, o = 4 */
+	xfunc_error_retval = 2;
+	opts = getopt32long(argv, "^" "ts:o:" "F:" "\0" "?1",
+		"table\0"          No_argument       "t"
+		"separator\0"      Required_argument "s"
+		"output-separator\0" Required_argument "o"
+		"format\0"         Required_argument "F"
+		, &in_sep, &out_sep, &opt_fmt
+	);
+	json_out = opt_fmt && strcmp(opt_fmt, "json") == 0;
+	if (opt_fmt && !json_out && strcmp(opt_fmt, "text") != 0) {
+		xfunc_error_retval = 2;
+		bb_error_msg("unknown format %s", opt_fmt);
+		return 2;
+	}
+	xfunc_error_retval = 1;   /* past option parsing: failures are operational */
+
+	argv += optind;
+	if (argv[0] && strcmp(argv[0], "-") != 0) {
+		fp = fopen(argv[0], "r");
+		if (!fp) {
+			int e = errno;
+
+			if (json_out) {
+				printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\","
+						"\"message\":");
+				json_escape(strerror(e));
+				fputs("}\n", stdout);
+				fflush_stdout_and_exit(1);
+			}
+			errno = e;
+			bb_perror_msg_and_die("%s", argv[0]);
+		}
+	} else {
+		fp = stdin;
+	}
+
+	while ((line = xmalloc_fgetline(fp)) != NULL)
+		llist_add_to_end(&lines, line);
+	if (fp != stdin)
+		fclose(fp);
+
+	/* First pass: split and measure. */
+	for (lp = lines; lp; lp = lp->link)
+		nrows++;
+
+	if (nrows == 0)
+		return EXIT_SUCCESS;
+
+	cells = xzalloc(nrows * sizeof(cells[0]));
+	ncells = xzalloc(nrows * sizeof(ncells[0]));
+	width = xzalloc(sizeof(width[0]));
+
+	r = 0;
+	for (lp = lines; lp; lp = lp->link) {
+		char *text = lp->data;
+		char **vec = NULL;
+		unsigned n = 0;
+
+		if (in_sep) {
+			/* single-character separator: split on each occurrence */
+			char *p = text;
+			while (p) {
+				char *next = strchr(p, in_sep[0]);
+				if (next)
+					*next++ = '\0';
+				vec = xrealloc_vector(vec, 4, n);
+				vec[n++] = p;
+				p = next;
+			}
+		} else {
+			/* default: split on runs of blanks, as `column -t` does */
+			char *p = text;
+			while (*p) {
+				while (*p == ' ' || *p == '\t')
+					p++;
+				if (!*p)
+					break;
+				vec = xrealloc_vector(vec, 4, n);
+				vec[n++] = p;
+				while (*p && *p != ' ' && *p != '\t')
+					p++;
+				if (*p)
+					*p++ = '\0';
+			}
+		}
+
+		cells[r] = vec;
+		ncells[r] = n;
+		if (n > maxcols)
+			maxcols = n;
+		r++;
+	}
+
+	if (json_out) {
+		/* the parsed table, so an agent never has to guess column widths */
+		printf("{\"schema\":1,\"rows\":%u,\"cols\":%u,\"data\":[", nrows, maxcols);
+		for (r = 0; r < nrows; r++) {
+			printf("%s[", r ? "," : "");
+			for (c = 0; c < ncells[r]; c++) {
+				printf("%s\"", c ? "," : "");
+				json_escape(cells[r][c]);
+				putchar('"');
+			}
+			putchar(']');
+		}
+		fputs("]}\n", stdout);
+		return EXIT_SUCCESS;
+	}
+
+	if (maxcols == 0)
+		return EXIT_SUCCESS;
+
+	width = xrealloc(width, maxcols * sizeof(width[0]));
+	memset(width, 0, maxcols * sizeof(width[0]));
+	for (r = 0; r < nrows; r++) {
+		for (c = 0; c < ncells[r]; c++) {
+			unsigned w = strlen(cells[r][c]);
+			if (w > width[c])
+				width[c] = w;
+		}
+	}
+
+	for (r = 0; r < nrows; r++) {
+		for (c = 0; c < ncells[r]; c++) {
+			fputs(cells[r][c], stdout);
+			if (c + 1 < ncells[r]) {
+				unsigned pad = width[c] - strlen(cells[r][c]);
+				unsigned k;
+				if (opts & 1) { /* -t */
+					for (k = 0; k < pad; k++)
+						bb_putchar(' ');
+					fputs(out_sep, stdout);
+				} else {
+					fputs(out_sep, stdout);
+				}
+			}
+		}
+		bb_putchar('\n');
+	}
+
+	return EXIT_SUCCESS;
+}

+static cputime_t iostat_uptime_darwin(void)
+{
+	struct timeval boot, now;
+	size_t len = sizeof(boot);
+	int mib[2] = { CTL_KERN, KERN_BOOTTIME };
+
+	if (sysctl(mib, 2, &boot, &len, NULL, 0) != 0)
+		return 0;
+	gettimeofday(&now, NULL);
+	if (now.tv_sec <= boot.tv_sec)
+		return 0;
+	return (cputime_t)(now.tv_sec - boot.tv_sec) * G.clk_tck;
+}
+
+static void iostat_cpu_darwin(stats_cpu_t *sc)
+{
+	host_cpu_load_info_data_t ci;
+	mach_msg_type_number_t count = HOST_CPU_LOAD_INFO_COUNT;
+
+	memset(sc, 0, sizeof(*sc));
+	if (host_statistics(mach_host_self(), HOST_CPU_LOAD_INFO,
+			(host_info_t)&ci, &count) != KERN_SUCCESS
+	) {
+		return;
+	}
+	sc->vector[STATS_CPU_USER]   = ci.cpu_ticks[CPU_STATE_USER];
+	sc->vector[STATS_CPU_NICE]   = ci.cpu_ticks[CPU_STATE_NICE];
+	sc->vector[STATS_CPU_SYSTEM] = ci.cpu_ticks[CPU_STATE_SYSTEM];
+	sc->vector[STATS_CPU_IDLE]   = ci.cpu_ticks[CPU_STATE_IDLE];
+	/* GLOBAL_UPTIME is the sum of all per-state ticks (this is what the
+	 * /proc parser stores), and SMP_UPTIME is the wall-clock uptime.  Both
+	 * feed get_interval(); leaving them zero makes every rate divide by 1. */
+	sc->vector[GLOBAL_UPTIME] = sc->vector[STATS_CPU_USER]
+		+ sc->vector[STATS_CPU_NICE]
+		+ sc->vector[STATS_CPU_SYSTEM]
+		+ sc->vector[STATS_CPU_IDLE];
+	sc->vector[SMP_UPTIME] = iostat_uptime_darwin();
+}
+
+/* Read one unsigned 64-bit counter out of the Statistics dictionary. */
+static unsigned long long darwin_stat(CFDictionaryRef dict, CFStringRef key)
+{
+	CFNumberRef num;
+	long long v = 0;
+
+	if (!dict || CFGetTypeID(dict) != CFDictionaryGetTypeID())
+		return 0;
+	num = (CFNumberRef)CFDictionaryGetValue(dict, key);
+	if (!num || CFGetTypeID(num) != CFNumberGetTypeID())
+		return 0;
+	if (!CFNumberGetValue(num, kCFNumberLongLongType, &v))
+		return 0;
+	return (unsigned long long)v;
+}
+
+static void do_disk_statistics_darwin(cputime_t itv)
+{
+	io_iterator_t iter = 0;
+	io_object_t drv;
+	CFMutableDictionaryRef match;
+
+	match = IOServiceMatching(kIOBlockStorageDriverClass);
+	if (!match)
+		return;
+	if (IOServiceGetMatchingServices(kIOMasterPortDefault, match, &iter) != KERN_SUCCESS)
+		return;
+
+	while ((drv = IOIteratorNext(iter)) != 0) {
+		CFDictionaryRef stats;
+		io_iterator_t kids = 0;
+		io_object_t kid;
+		char dev_name[MAX_DEVICE_NAME + 1];
+		stats_dev_data_t *curr_data;
+		stats_dev_t *stats_dev;
+
+		dev_name[0] = '\0';
+		if (IORegistryEntryGetChildIterator(drv, kIOServicePlane, &kids) == KERN_SUCCESS) {
+			while ((kid = IOIteratorNext(kids)) != 0) {
+				CFTypeRef bsd = IORegistryEntryCreateCFProperty(kid,
+						CFSTR(kIOBSDNameKey), kCFAllocatorDefault, 0);
+				if (bsd) {
+					if (CFGetTypeID(bsd) == CFStringGetTypeID())
+						CFStringGetCString(bsd, dev_name, sizeof(dev_name),
+								kCFStringEncodingUTF8);
+					CFRelease(bsd);
+				}
+				IOObjectRelease(kid);
+				if (dev_name[0])
+					break;
+			}
+			IOObjectRelease(kids);
+		}
+		if (!dev_name[0]) {
+			IOObjectRelease(drv);
+			continue;
+		}
+		/* The -x list uses whole-disk names like the /proc version */
+		if (G.dev_name_list && !llist_find_str(G.dev_name_list, dev_name)) {
+			IOObjectRelease(drv);
+			continue;
+		}
+
+		stats = (CFDictionaryRef)IORegistryEntryCreateCFProperty(drv,
+				CFSTR(kIOBlockStorageDriverStatisticsKey),
+				kCFAllocatorDefault, 0);
+
+		stats_dev = stats_dev_find_or_new(dev_name);
+		curr_data = &stats_dev->curr_data;
+		curr_data->rd_sectors = darwin_stat(stats,
+				CFSTR(kIOBlockStorageDriverStatisticsBytesReadKey)) >> 9;
+		curr_data->wr_sectors = darwin_stat(stats,
+				CFSTR(kIOBlockStorageDriverStatisticsBytesWrittenKey)) >> 9;
+		curr_data->rd_ops = (unsigned long)darwin_stat(stats,
+				CFSTR(kIOBlockStorageDriverStatisticsReadsKey));
+		curr_data->wr_ops = (unsigned long)darwin_stat(stats,
+				CFSTR(kIOBlockStorageDriverStatisticsWritesKey));
+		if (stats)
+			CFRelease(stats);
+
+		if (!G.dev_name_list
+		 && !G.show_all
+		 && curr_data->rd_ops == 0
+		 && curr_data->wr_ops == 0
+		) {
+			IOObjectRelease(drv);
+			continue;
+		}
+
+		print_stats_dev_struct(stats_dev, itv);
+		stats_dev->prev_data = *curr_data;
+		IOObjectRelease(drv);
+	}
+	IOObjectRelease(iter);
+}

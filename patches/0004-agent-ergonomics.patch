+#if defined(__APPLE__)
+/*
+ * Darwin port.  Three /proc files to replace:
+ *   /proc/uptime   -> KERN_BOOTTIME
+ *   /proc/stat     -> host_statistics(HOST_CPU_LOAD_INFO)
+ *   /proc/diskstats-> IOKit IOBlockStorageDriver "Statistics"
+ *
+ * IOKit is a public framework present on every supported macOS, so the Darwin
+ * link line adds "-framework IOKit" (see build.sh).  Key names come from
+ * <IOKit/storage/IOBlockStorageDriver.h>; the BSD name lives on the driver's
+ * child IOMedia object, not on the driver itself.

+/*
+ * "realpath -m": resolve the longest existing prefix, then re-attach the
+ * missing components.  Recursing on the directory part handles paths whose
+ * last few components do not exist yet, which is what agents need when they
+ * canonicalize a file they are about to create.
+ */
+static char *pop_last_component(const char *abs)
+{
+	char *s = xstrdup(abs);
+	char *p = strrchr(s, '/');
+	if (!p || p == s) {
+		free(s);
+		return xstrdup("/");
+	}
+	*p = '\0';
+	return s;
+}
+
+static char *canon_missing(const char *path)
+{
+	char *res;
+	const char *base;
+	char *dir, *dirres, *out;
+	unsigned len;
+
+	res = xmalloc_realpath_coreutils((char *)path);
+	if (res)
+		return res;
+
+	base = bb_basename(path);
+	if (base == path) {
+		/* single relative component: anchor at the current directory */
+		char *cwd = getcwd(NULL, 0);
+		if (!cwd)
+			bb_perror_msg_and_die("getcwd");
+		char *full = concat_path_file(cwd, path);
+		free(cwd);
+		res = canon_missing(full);
+		free(full);
+		return res;
+	}
+
+	len = (unsigned)(base - path); /* includes the '/' before base */
+	dir = xasprintf("%.*s", (int)(len - 1), path);
+	if (!dir[0]) {
+		free(dir);
+		dir = xstrdup("/");
+	}
+	dirres = canon_missing(dir);
+	free(dir);
+
+	if (strcmp(base, ".") == 0)
+		return dirres;
+	if (strcmp(base, "..") == 0) {
+		out = pop_last_component(dirres);
+		free(dirres);
+		return out;
+	}
+	out = concat_path_file(dirres, base);
+	free(dirres);
+	return out;

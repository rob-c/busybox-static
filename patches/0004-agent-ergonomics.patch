+ *
+ * struct rtentry is opaque here, so ioctl(SIOCADDRT) is not available - but it
+ * is also not needed: BSD and macOS manage the table through a PF_ROUTE
+ * socket, writing struct rt_msghdr messages.  That is exactly what the system
+ * route(8) does.  Requires root, like every other mutating networking call.
+ *
+ *   route add -net 10.0.0.0/8 gw 192.168.1.1 dev en0
+ *   route add default gw 192.168.1.1
+ *   route del -net 10.0.0.0/8
+ */
+#define BB_RTM_MAXMSG 512
+
+static void darwin_route_set(int action, char **args)
+{
+	int s;
+	struct {
+		struct rt_msghdr hdr;
+		struct sockaddr_in dst;
+		struct sockaddr_in gw;
+		struct sockaddr_in mask;
+	} msg;
+	char dest[64] = "";
+	char *gw = NULL, *dev = NULL, *mask = NULL;
+	int is_host = 0;
+	unsigned char addrs = 0;
+	struct sockaddr_dl *sdl_gw;
+	int n;
+
+	/* --- parse: [-net|-host] DEST [gw GW] [dev DEV] [netmask M] --- */
+	while (*args) {
+		if (strcmp(*args, "-net") == 0 || strcmp(*args, "#net") == 0) {
+			is_host = 0;
+			args++;
+		} else if (strcmp(*args, "-host") == 0 || strcmp(*args, "#host") == 0) {
+			is_host = 1;
+			args++;
+		} else if (strcmp(*args, "gw") == 0 && args[1]) {
+			gw = *++args;
+			args++;
+		} else if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev = *++args;
+			args++;
+		} else if (strcmp(*args, "netmask") == 0 && args[1]) {
+			mask = *++args;
+			args++;
+		} else if (strcmp(*args, "metric") == 0 && args[1]) {
+			args += 2;                 /* accepted, not applicable */
+		} else if (strcmp(*args, "default") == 0) {
+			safe_strncpy(dest, "0.0.0.0", sizeof(dest));
+			addrs = 1;
+			args++;
+		} else if (!dest[0] && !addrs) {
+			char *slash;
+			safe_strncpy(dest, *args, sizeof(dest));
+			slash = strchr(dest, '/');
+			if (slash) {
+				*slash = '\0';
+				mask = NULL;       /* prefix length handled below */
+				/* remember prefix in a spare slot */
+				safe_strncpy(msg.mask.sin_zero, slash + 1,
+						sizeof(msg.mask.sin_zero));
+			}
+			args++;
+		} else {
+			bb_error_msg_and_die("unsupported route argument on Darwin: %s", *args);
+		}
+	}
+
+	if (!dest[0])
+		bb_show_usage();
+
+	s = socket(PF_ROUTE, SOCK_RAW, 0);
+	if (s < 0)
+		bb_simple_perror_msg_and_die("socket(PF_ROUTE)");
+
+	memset(&msg, 0, sizeof(msg));
+	msg.hdr.rtm_version = RTM_VERSION;
+	msg.hdr.rtm_type = (action == RTACTION_ADD) ? RTM_ADD : RTM_DELETE;
+	msg.hdr.rtm_seq = (int)getpid();
+
+	/* destination */
+	msg.dst.sin_len = sizeof(msg.dst);
+	msg.dst.sin_family = AF_INET;
+	if (inet_pton(AF_INET, dest, &msg.dst.sin_addr) != 1)
+		bb_error_msg_and_die("invalid destination: %s", dest);
+	addrs |= RTA_DST;
+
+	msg.hdr.rtm_flags = RTF_UP;
+	if (is_host)
+		msg.hdr.rtm_flags |= RTF_HOST;
+
+	/* gateway: either an IPv4 address or a link (dev) */
+	if (gw) {
+		if (strncmp(gw, "link", 4) == 0) {
+			sdl_gw = (struct sockaddr_dl *)&msg.gw;
+			sdl_gw->sdl_len = offsetof(struct sockaddr_dl, sdl_data) + 6;
+			sdl_gw->sdl_family = AF_LINK;
+			sdl_gw->sdl_index = dev ? if_nametoindex(dev) : 0;
+			sdl_gw->sdl_alen = 6;
+		} else {
+			msg.gw.sin_len = sizeof(msg.gw);
+			msg.gw.sin_family = AF_INET;
+			if (inet_pton(AF_INET, gw, &msg.gw.sin_addr) != 1)
+				bb_error_msg_and_die("invalid gateway: %s", gw);
+			msg.hdr.rtm_flags |= RTF_GATEWAY;
+		}
+		addrs |= RTA_GATEWAY;
+	}
+
+	if (mask) {
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		if (inet_pton(AF_INET, mask, &msg.mask.sin_addr) != 1)
+			bb_error_msg_and_die("invalid netmask: %s", mask);
+		addrs |= RTA_NETMASK;
+	} else if (msg.mask.sin_zero[0]) {
+		/* prefix length captured during parsing */
+		int plen = xatoi_positive(msg.mask.sin_zero);
+		uint32_t m = plen >= 32 ? 0xffffffffU
+			: (plen <= 0 ? 0 : (0xffffffffU << (32 - plen)));
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		msg.mask.sin_addr.s_addr = htonl(m);
+		addrs |= RTA_NETMASK;
+	} else if (!is_host && msg.dst.sin_addr.s_addr != 0) {
+		/* -net without a mask: classful default, as route(8) does */
+		uint32_t d = ntohl(msg.dst.sin_addr.s_addr);
+		uint32_t m = (d < 0x80000000U) ? 0xff000000U
+			: (d < 0xc0000000U) ? 0xffff0000U : 0xffffff00U;
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		msg.mask.sin_addr.s_addr = htonl(m);
+		addrs |= RTA_NETMASK;
+	}
+
+	msg.hdr.rtm_addrs = addrs;
+	if (dev)
+		msg.hdr.rtm_index = if_nametoindex(dev);
+
+	/* lay out the sockaddrs in RTA_* order, rounding each to 4 bytes */
+	{
+		char *cp = (char *)(&msg.hdr + 1);
+		int i;
+		struct sockaddr *sa;
+
+		for (i = 1; i < RTAX_MAX; i++) {
+			if (!(addrs & (1 << i)))
+				continue;
+			switch (i) {
+			case RTAX_DST:     sa = (struct sockaddr *)&msg.dst; break;
+			case RTAX_GATEWAY: sa = (struct sockaddr *)&msg.gw; break;
+			case RTAX_NETMASK: sa = (struct sockaddr *)&msg.mask; break;
+			default: continue;
+			}
+			n = (sa->sa_len + 3) & ~3;
+			memcpy(cp, sa, sa->sa_len);
+			cp += n;
+		}
+		msg.hdr.rtm_msglen = (u_short)(cp - (char *)&msg);
+	}
+
+	if (write(s, &msg, msg.hdr.rtm_msglen) < 0)
+		bb_perror_msg_and_die("%s %s", action == RTACTION_ADD ? "add" : "delete", dest);
+	close(s);
+}
+
+static NOINLINE void INET_setroute(int action, char **args)
+{
+	darwin_route_set(action, args);
+}

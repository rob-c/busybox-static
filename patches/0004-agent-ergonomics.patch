+	setpgid(0, 0);
+	fd = open("/dev/null", O_RDWR);
+	if (fd >= 0) {
+		dup2(fd, 0);
+		dup2(fd, 1);
+		dup2(fd, 2);
+		if (fd > 2)
+			close(fd);
+	}
+	for (i = 3; i < 256; i++)
+		close(i);
+	for (;;) {
+		if (kill(me, 0) != 0)
+			break;
+		usleep(100 * 1000);
+	}
+	kill(-target_group, SIGKILL);
+	_exit(0);

+	if (sa->sa_family == AF_LINK) {
+		safe_strncpy(out, "link", outlen);
+		return;
+	}
+	/* An unknown/empty mask sockaddr means a /0 route (the default route). */
+	safe_strncpy(out, is_mask ? "0.0.0.0" : "?", outlen);
+}

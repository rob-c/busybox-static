diff --git a/include/error_ids.h b/include/error_ids.h
new file mode 100644
index 0000000..4e79f14
--- /dev/null
+++ b/include/error_ids.h
@@ -0,0 +1,32 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Opt-in diagnostic ids: the same message on stderr with its id in front, and
+ * the bare id on stdout.
+ *
+ * Off unless BUSYBOX_ERROR_IDS is set in the environment or the applet was
+ * started as "busybox --error-ids APPLET ...". With the switch off every
+ * diagnostic is byte-identical to what it always was, so a normal direct
+ * invocation is unaffected: the id path is one extra getenv on an error path
+ * that is already printing.
+ *
+ *   stdout   E NOT_FOUND            the id alone: branch without parsing prose
+ *   stderr   cat: NOT_FOUND: can't open '/nope': No such file or directory
+ *
+ * The id is bb_error_code when an applet set one, else derived from errno
+ * (ENOENT -> NOT_FOUND, EACCES -> PERMISSION, ...), else USAGE for a usage
+ * error, else FAILED. The channel letter is E for a diagnostic and W when the
+ * message opens with "warning".
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+#ifndef ERROR_IDS_H
+#define ERROR_IDS_H
+
+extern int bb_error_ids;      /* nonzero: ids on (environment or --error-ids) */
+extern int bb_error_ids_sent;   /* an id already went to stdout for this diagnostic */
+extern int bb_perror_errno;   /* errno at the last bb_perror_msg* call, else 0 */
+extern const char *bb_error_code; /* applet-set code for the next message */
+
+void bb_error_ids_init(void);
+
+#endif
diff --git a/include/json_read.h b/include/json_read.h
new file mode 100644
index 0000000..15c6aee
--- /dev/null
+++ b/include/json_read.h
@@ -0,0 +1,53 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Minimal JSON reader for the agent-facing applets.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+#ifndef JSON_READ_H
+#define JSON_READ_H 1
+
+#include <stddef.h>
+
+enum { JSON_MAX_DEPTH = 32 };
+
+typedef enum {
+	JSON_NULL,
+	JSON_TRUE,
+	JSON_FALSE,
+	JSON_STRING,
+	JSON_NUMBER,
+	JSON_ARRAY,
+	JSON_OBJECT,
+} json_type_t;
+
+struct json_value {
+	json_type_t type;
+	char *key;                    /* member name; NULL at top level or in arrays */
+	char *str;                    /* STRING: decoded bytes. NUMBER: literal text */
+	struct json_value *child;     /* first child of ARRAY/OBJECT */
+	struct json_value *next;      /* next sibling */
+};
+typedef struct json_value json_value_t;
+
+/*
+ * Parse a complete JSON document. Strict RFC 8259 subset: no comments, no
+ * trailing commas, no single quotes, no NaN/Infinity, duplicate keys rejected.
+ * On error returns NULL and stores a malloc'd description (caller frees) in *err.
+ */
+json_value_t *json_parse(const char *buf, size_t len, char **err) FAST_FUNC;
+
+void json_free(json_value_t *v) FAST_FUNC;
+
+/* Lookup in an OBJECT. Returns NULL when absent or when v is not an object. */
+const json_value_t *json_get(const json_value_t *v, const char *key) FAST_FUNC;
+
+/* Typed accessors, all returning dflt on mismatch/missing. */
+const char *json_str(const json_value_t *v, const char *dflt) FAST_FUNC;
+long json_int(const json_value_t *v, long dflt) FAST_FUNC;
+int json_bool(const json_value_t *v, int dflt) FAST_FUNC;
+/* Element i of an ARRAY (0-based), NULL when out of range. */
+const json_value_t *json_at(const json_value_t *v, unsigned i) FAST_FUNC;
+unsigned json_len(const json_value_t *v) FAST_FUNC;
+
+#endif
diff --git a/include/sysinfo_compat.h b/include/sysinfo_compat.h
new file mode 100644
index 0000000..028d094
--- /dev/null
+++ b/include/sysinfo_compat.h
@@ -0,0 +1,135 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * shim for the one Linux API that free, uptime, fallocate and ps rely on.
+ * Kept entirely in this new header so the port never has to edit
+ * include/platform.h or libbb/platform.c, which patches 0002 and 0003 own.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+#ifndef BB_SYSINFO_COMPAT_H
+#define BB_SYSINFO_COMPAT_H
+
+#if !defined(__linux__)
+
+/* free/uptime/ps read struct sysinfo.  Off Linux there is none, so provide a
+ * minimal one, filled from sysctls below. */
+struct sysinfo {
+	unsigned long uptime;
+	unsigned long loads[3];
+	unsigned long totalram;
+	unsigned long freeram;
+	unsigned long sharedram;
+	unsigned long bufferram;
+	unsigned long totalswap;
+	unsigned long freeswap;
+	unsigned short procs;
+	unsigned long mem_unit;
+};
+
+#if defined(__APPLE__)
+#include <sys/sysctl.h>
+#include <mach/mach.h>
+#include <mach/vm_statistics.h>
+#include <mach/mach_host.h>
+
+static int bb_sysinfo(struct sysinfo *si)
+{
+	struct timeval boot, now;
+	size_t len;
+	uint64_t memsize = 0;
+	vm_statistics64_data_t vm;
+	mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+	double loads[3];
+	int mib[2];
+
+	memset(si, 0, sizeof(*si));
+
+	mib[0] = CTL_KERN;
+	mib[1] = KERN_BOOTTIME;
+	len = sizeof(boot);
+	if (sysctl(mib, 2, &boot, &len, NULL, 0) == 0) {
+		gettimeofday(&now, NULL);
+		if (now.tv_sec > boot.tv_sec)
+			si->uptime = (unsigned long)(now.tv_sec - boot.tv_sec);
+	}
+
+	len = sizeof(memsize);
+	if (sysctlbyname("hw.memsize", &memsize, &len, NULL, 0) == 0)
+		si->totalram = (unsigned long)memsize;
+
+	if (host_statistics64(mach_host_self(), HOST_VM_INFO64,
+			(host_info64_t)&vm, &count) == KERN_SUCCESS
+	) {
+		unsigned long page = (unsigned long)vm_page_size;
+
+		si->freeram = (unsigned long)
+			(((uint64_t)vm.free_count + vm.speculative_count) * page);
+		si->bufferram = (unsigned long)
+			(((uint64_t)vm.purgeable_count + vm.wire_count) * page);
+	}
+
+	si->mem_unit = 1;
+	{
+		/* free(1) prints Swap: total/used/free from these.  macOS keeps swap
+		 * accounting in vm.swapusage rather than in the VM stats. */
+		struct xsw_usage xsw;
+		size_t xlen = sizeof(xsw);
+		if (sysctlbyname("vm.swapusage", &xsw, &xlen, NULL, 0) == 0) {
+			si->totalswap = (unsigned long)xsw.xsu_total;
+			si->freeswap = (unsigned long)xsw.xsu_avail;
+		}
+	}
+	if (getloadavg(loads, 3) == 3) {
+		/* uptime prints these via LOAD_INT/LOAD_FRAC, i.e. /2048 */
+		si->loads[0] = (unsigned long)(loads[0] * 2048.0);
+		si->loads[1] = (unsigned long)(loads[1] * 2048.0);
+		si->loads[2] = (unsigned long)(loads[2] * 2048.0);
+	}
+	return 0;
+}
+#define sysinfo(info) bb_sysinfo(info)
+
+/* Reclaimable page cache: inactive + purgeable pages.  One definition for
+ * free, vmstat and top, so the three do not report different "cached" values
+ * for the same machine. */
+static unsigned long long bb_darwin_cached_bytes(void)
+{
+	vm_statistics64_data_t vm;
+	mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+
+	memset(&vm, 0, sizeof(vm));
+	if (host_statistics64(mach_host_self(), HOST_VM_INFO64,
+			(host_info64_t)&vm, &count) != KERN_SUCCESS)
+		return 0;
+	return ((unsigned long long)vm.inactive_count + vm.purgeable_count)
+		* (unsigned long long)vm_page_size;
+}
+
+
+/* macOS has no posix_fallocate: F_PREALLOCATE does the work, then the file is
+ * grown so the semantics match glibc (size becomes offset+len). */
+#include <sys/fcntl.h>
+static int bb_posix_fallocate(int fd, off_t offset, off_t len)
+{
+	struct fstore fst;
+	struct stat st;
+
+	memset(&fst, 0, sizeof(fst));
+	fst.fst_flags = F_ALLOCATEALL;
+	fst.fst_posmode = F_PEOFPOSMODE;
+	fst.fst_offset = offset;
+	fst.fst_length = len;
+	if (fcntl(fd, F_PREALLOCATE, &fst) == -1)
+		return errno ? errno : EIO;
+	if (fstat(fd, &st) == 0 && st.st_size < offset + len) {
+		if (ftruncate(fd, offset + len) != 0)
+			return errno ? errno : EIO;
+	}
+	return 0;
+}
+#define posix_fallocate(fd, off, len) bb_posix_fallocate(fd, off, len)
+#endif /* __APPLE__ */
+
+#endif /* !__linux__ */
+
+#endif

+static int darwin_fuser_scan(void)
+{
+	procps_status_t *proc = NULL;
+	pid_t self = getpid();
+	int found = 0;
+
+	while ((proc = procps_scan(proc, PSSCAN_PID | PSSCAN_ARGV0)) != NULL) {
+		struct proc_fdinfo fds[FUSER_MAX_FDS];
+		int nfds, i, hit = 0;
+
+		if (proc->pid == 0 || proc->pid == (unsigned)self)
+			continue;

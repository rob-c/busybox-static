+	int mib[6] = { CTL_NET, PF_ROUTE, 0, AF_INET, NET_RT_DUMP, 0 };
+	size_t needed = 0;
+	char *buf, *lim, *next;
+
+	if (sysctl(mib, 6, NULL, &needed, NULL, 0) != 0 || needed == 0)
+		return;
+	buf = xmalloc(needed);
+	if (sysctl(mib, 6, buf, &needed, NULL, 0) != 0) {
+		free(buf);
+		return;
+	}
+	lim = buf + needed;
+	for (next = buf; next + sizeof(struct rt_msghdr) <= lim; ) {
+		struct rt_msghdr *rtm = (struct rt_msghdr *)next;
+		const struct sockaddr *sa, *dst = NULL, *gw = NULL, *mask = NULL;
+		char d[64], g[64], m[64], ifname[IFNAMSIZ];
+		int i, is_default;
+
+		if (rtm->rtm_msglen == 0)
+			break;
+		next += rtm->rtm_msglen;
+		if (rtm->rtm_version != RTM_VERSION || !(rtm->rtm_flags & RTF_UP))
+			continue;
+
+		sa = (const struct sockaddr *)(rtm + 1);
+		for (i = 0; i < RTAX_MAX; i++) {
+			if (!(rtm->rtm_addrs & (1 << i)))
+				continue;
+			if ((const char *)sa >= next)
+				break;
+			switch (i) {
+			case RTAX_DST:     dst  = sa; break;
+			case RTAX_GATEWAY: gw   = sa; break;
+			case RTAX_NETMASK: mask = sa; break;
+			default: break;
+			}
+			sa = (const struct sockaddr *)((const char *)sa
+					+ ((sa->sa_len + 3) & ~3));
+		}
+
+		/* destination */
+		is_default = (!mask || mask->sa_len <= (int)offsetof(struct sockaddr_in, sin_addr))
+			&& dst && dst->sa_family == AF_INET
+			&& ((const struct sockaddr_in *)dst)->sin_addr.s_addr == 0;
+		if (is_default) {
+			safe_strncpy(d, "default", sizeof(d));
+		} else if (dst && dst->sa_family == AF_INET) {
+			unsigned p = 0;
+			if (mask && mask->sa_len > offsetof(struct sockaddr_in, sin_addr)) {
+				unsigned mm = ntohl(((const struct sockaddr_in *)mask)->sin_addr.s_addr);
+				while (mm & 0x80000000U) { p++; mm <<= 1; }
+			}
+			inet_ntop(AF_INET, &((const struct sockaddr_in *)dst)->sin_addr, d, sizeof(d));
+			if (p)
+				sprintf(d + strlen(d), "/%u", p);
+		} else {
+			safe_strncpy(d, "?", sizeof(d));
+		}

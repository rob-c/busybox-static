+ACTF(printf)
+{
+	const char *f = ap->fmt;
+	const char *base = bb_basename(fileName);
+	const char *rel = fileName;
+	struct tm tm;
+	char modebuf[12];
+
+	if (rel[0] == '.' && rel[1] == '/')
+		rel += 2;
+	localtime_r(&statbuf->st_mtime, &tm);
+
+	while (*f) {
+		if (*f != '%') {
+			if (*f == '\\') {
+				f++;
+				if (*f == 'n') { bb_putchar('\n'); f++; continue; }
+				if (*f == 't') { bb_putchar('\t'); f++; continue; }
+				if (*f == '0') { bb_putchar('\0'); f++; continue; }
+				if (*f == '\0') { bb_putchar('\\'); break; }
+				bb_putchar('\\');
+				continue;
+			}
+			bb_putchar(*f++);
+			continue;
+		}
+		f++;
+		switch (*f) {
+		case '%': bb_putchar('%'); break;
+		case 'p': fputs(fileName, stdout); break;
+		case 'P': fputs(rel, stdout); break;
+		case 'f': fputs(base, stdout); break;
+		case 'h': {
+			char *dir = xstrdup(fileName);
+			char *slash = strrchr(dir, '/');
+			if (!slash)
+				fputs(".", stdout);
+			else if (slash == dir)
+				fputs("/", stdout);
+			else {
+				*slash = '\0';
+				fputs(dir, stdout);
+			}
+			free(dir);
+			break;
+		}
+		case 'y':
+			bb_putchar(S_ISREG(statbuf->st_mode) ? 'f' :
+				S_ISDIR(statbuf->st_mode) ? 'd' :
+				S_ISLNK(statbuf->st_mode) ? 'l' :
+				S_ISCHR(statbuf->st_mode) ? 'c' :
+				S_ISBLK(statbuf->st_mode) ? 'b' :
+				S_ISFIFO(statbuf->st_mode) ? 'p' :
+				S_ISSOCK(statbuf->st_mode) ? 's' : '?');
+			break;
+		case 's': printf("%llu", (unsigned long long)statbuf->st_size); break;
+		case 'm': printf("%o", (unsigned)(statbuf->st_mode & 07777)); break;
+		case 'M': fputs(printf_mode_string(modebuf, statbuf->st_mode), stdout); break;
+		case 'i': printf("%llu", (unsigned long long)statbuf->st_ino); break;
+		case 'n': printf("%lu", (unsigned long)statbuf->st_nlink); break;
+		case 'u': {
+			struct passwd *pw = getpwuid(statbuf->st_uid);
+			if (pw)
+				fputs(pw->pw_name, stdout);
+			else
+				printf("%u", (unsigned)statbuf->st_uid);
+			break;
+		}
+		case 'g': {
+			struct group *gr = getgrgid(statbuf->st_gid);
+			if (gr)
+				fputs(gr->gr_name, stdout);
+			else
+				printf("%u", (unsigned)statbuf->st_gid);
+			break;
+		}
+		case 'U': printf("%u", (unsigned)statbuf->st_uid); break;
+		case 'G': printf("%u", (unsigned)statbuf->st_gid); break;
+		case 'l': {
+			char *target = xmalloc_readlink(fileName);
+			fputs(target ? target : "", stdout);
+			free(target);
+			break;
+		}
+		case 'T':
+			f++;
+			switch (*f) {
+			case '@':
+				printf("%llu.%09u",
+					(unsigned long long)statbuf->st_mtime,
+					(unsigned)statbuf->st_mtim.tv_nsec);
+				break;
+			case 'Y': printf("%04d", tm.tm_year + 1900); break;
+			case 'm': printf("%02d", tm.tm_mon + 1); break;
+			case 'd': printf("%02d", tm.tm_mday); break;
+			case 'H': printf("%02d", tm.tm_hour); break;
+			case 'M': printf("%02d", tm.tm_min); break;
+			case 'S': printf("%02d", tm.tm_sec); break;
+			default: bb_putchar('T'); bb_putchar(*f); break;
+			}
+			break;
+		default:
+			bb_putchar('%');
+			if (*f)
+				bb_putchar(*f);
+			else
+				f--;
+			break;
+		}
+		if (*f)
+			f++;
+	}
+	return TRUE;
+}

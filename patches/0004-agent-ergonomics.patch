+
+/* Two runs by shape: lines, stderr lines, first stderr, longest gap, duration. */
+static int log_diff_timeline(const char *root, const char *spec, int json)
+{
+	const char *colon = strchr(spec, ':');
+	char *a, *b;
+	struct tlstat sa, sb;
+	long da = 0, dbb = 0;
+	int changed = 0;
+
+	if (!colon || colon == spec || !colon[1]) {
+		fprintf(stderr, "log: --diff-timeline wants RUN1:RUN2\n");
+		return 2;
+	}
+	a = xstrndup(spec, (size_t)(colon - spec));
+	b = xstrdup(colon + 1);
+	if (tl_stats(root, a, &sa, &da) || tl_stats(root, b, &sb, &dbb)) {
+		if (json)
+			printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\"}");
+		else
+			fprintf(stderr, "log: one of %s / %s has no timeline\n", a, b);
+		free(a);
+		free(b);
+		return 1;
+	}
+	if (sa.lines != sb.lines || sa.err_lines != sb.err_lines
+	 || sa.gap_us != sb.gap_us || da != dbb)
+		changed = 1;
+	if (json)
+		printf("{\"schema\":1,\"status\":\"ok\",\"a\":\"%s\",\"b\":\"%s\",\"changed\":%s,"
+				"\"lines\":{\"a\":%u,\"b\":%u},\"stderr_lines\":{\"a\":%u,\"b\":%u},"
+				"\"first_err_us\":{\"a\":%ld,\"b\":%ld},"
+				"\"longest_gap_us\":{\"a\":%ld,\"b\":%ld},"
+				"\"duration_ms\":{\"a\":%ld,\"b\":%ld}}",
+				a, b, changed ? "true" : "false",
+				sa.lines, sb.lines, sa.err_lines, sb.err_lines,
+				sa.first_err, sb.first_err, sa.gap_us, sb.gap_us, da, dbb);
+	else
+		printf("%s -> %s lines %u->%u stderr %u->%u gap_us %ld->%ld duration_ms %ld->%ld changed=%s\n",
+				a, b, sa.lines, sb.lines, sa.err_lines, sb.err_lines,
+				sa.gap_us, sb.gap_us, da, dbb, changed ? "true" : "false");
+	free(a);
+	free(b);
+	fflush(stdout);
+	return 0;
+}
+
+static int log_diff(const char *root, const char *spec, int json)
+{
+	char *colon = strchr(spec, ':');
+	char *a = NULL, *b = NULL, *pa, *pb, *sa, *sb;
+	size_t alen = 0, blen = 0;
+	unsigned line = 0, changed = 0, shown = 0;
+	char *spec2;
+
+	if (!colon || !colon[1])
+		bb_error_msg_and_die("--diff needs R1:R2");
+	spec2 = xstrdup(spec);
+	colon = strchr(spec2, ':');
+	*colon = '\0';
+
+	pa = art_path(xasprintf("%s/%s", root, spec2), "stdout");
+	pb = art_path(xasprintf("%s/%s", root, colon + 1), "stdout");
+	if (read_all(pa, &a, &alen) != 0 || read_all(pb, &b, &blen) != 0) {
+		if (json) {
+			fputs("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\",\"message\":", stdout);
+			json_write_str("a run has no stdout artifact");
+			fputs("}\n", stdout);
+		} else {
+			fprintf(stderr, "%s: NOT_FOUND\n", a ? pb : pa);
+		}
+		free(a);
+		free(b);
+		free(spec2);
+		return 1;
+	}
+
+	if (json)
+		fputs("{\"schema\":1,\"status\":\"ok\",\"changes\":[", stdout);
+	sa = a;
+	sb = b;
+	while (*sa || *sb) {
+		char *ea = strchr(sa, '\n');
+		char *eb = strchr(sb, '\n');
+		size_t na = ea ? (size_t)(ea - sa) : strlen(sa);
+		size_t nb = eb ? (size_t)(eb - sb) : strlen(sb);
+
+		line++;
+		if (!(na == nb && memcmp(sa, sb, na) == 0)) {
+			changed++;
+			if (shown < 20) {
+				if (json) {
+					if (shown)
+						putchar(',');
+					printf("{\"line\":%u,\"a\":", line);
+					json_write_str(xasprintf("%.*s", (int)na, sa));
+					fputs(",\"b\":", stdout);
+					json_write_str(xasprintf("%.*s", (int)nb, sb));
+					putchar('}');
+				} else {
+					printf("line %u\n  - %.*s\n  + %.*s\n",
+							line, (int)na, sa, (int)nb, sb);
+				}
+				shown++;
+			}
+		}
+		if (!ea && !eb)
+			break;
+		sa = ea ? ea + 1 : sa + na;
+		sb = eb ? eb + 1 : sb + nb;
+	}
+	if (json)
+		printf("],\"lines\":%u,\"changed\":%u}\n", line, changed);
+	else
+		printf("lines=%u changed=%u\n", line, changed);
+	free(a);
+	free(b);
+	free(spec2);
+	return changed ? 1 : 0;
+}

+/* Remove all but the newest `keep` run directories under root. Returns the count. */
+#if 0
+#endif
+/*
+ * Reaper: a tiny child in its own process group that kills the guest group when
+ * this process disappears for ANY reason, including SIGKILL, which cannot be
+ * caught. It watches the parent id until it stops existing, so a wrapper killed
+ * with -9 does not leave the command running.
+ */
+/* Take the watchdog down before returning: it is only needed while we are alive,
+ * and leaving it for up to 100 ms would make it visible to process scans. */
+static void stop_reaper(void)
+{
+	if (reaper_pid > 0) {
+		kill(reaper_pid, SIGKILL);
+		waitpid(reaper_pid, NULL, 0);
+		reaper_pid = 0;
+	}
+}
+
+static void spawn_reaper(pid_t target_group) NORETURN;
+static void spawn_reaper(pid_t target_group)
+{
+	pid_t me = getppid();   /* the run process; stays valid if re-parented */
+	int fd, i;
+
+	setpgid(0, 0);          /* own group: a group kill of the guest misses us */
+	/* Detach from the run's plumbing: holding the capture pipe open would make
+	 * the parent wait for EOF forever. */
+	fd = open("/dev/null", O_RDWR);
+	if (fd >= 0) {
+		dup2(fd, 0);
+		dup2(fd, 1);
+		dup2(fd, 2);
+		if (fd > 2)
+			close(fd);
+	}
+	for (i = 3; i < 256; i++)
+		close(i);
+	for (;;) {
+		if (kill(me, 0) != 0)
+			break;
+		usleep(100 * 1000);
+	}
+	kill(-target_group, SIGKILL);
+	_exit(0);
+}

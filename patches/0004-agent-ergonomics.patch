+	msg.hdr.rtm_seq = (int)getpid();
+
+	/* destination */
+	msg.dst.sin_len = sizeof(msg.dst);
+	msg.dst.sin_family = AF_INET;
+	if (inet_pton(AF_INET, dest, &msg.dst.sin_addr) != 1)
+		bb_error_msg_and_die("invalid destination: %s", dest);
+	addrs |= RTA_DST;
+
+	msg.hdr.rtm_flags = RTF_UP;
+	if (is_host)

+ * instead of reordering, which keeps both getopt implementations on one path.
+ * Returns the new argc; argv is compacted in place.
+ */
+static int unzip_take_dash_d(int argc, char **argv, char **base_dir)
+{
+	int i, w = 1;
+
+	for (i = 1; i < argc; i++) {
+		char *a = argv[i];
+		char *d;
+
+		if (a[0] != '-' || a[1] == '\0')
+			goto keep;
+		d = strchr(a + 1, 'd');
+		if (!d)
+			goto keep;
+		if (d[1] != '\0') {
+			/* -dDIR (or -qdDIR): the directory is attached */

+/*
+ * -printf: one line per file with the fields a script needs.  This is the
+ * find feature that turns "list files with size and mtime" from N+1
+ * processes into one, so agent workflows reach for it constantly.
+ * Supported: %% %p %P %f %h %y %s %m %M %i %n %u %g %U %G %l %T@ %TY %Tm
+ * %Td %TH %TM %TS, plus \n \t \0 and \\.
+ */
+static const char *printf_mode_string(char *buf, mode_t mode)
+{
+	static const char rwx[] = "rwx";
+	int i;
+
+	switch (mode & S_IFMT) {
+	case S_IFDIR:  buf[0] = 'd'; break;
+	case S_IFLNK:  buf[0] = 'l'; break;
+	case S_IFCHR:  buf[0] = 'c'; break;
+	case S_IFBLK:  buf[0] = 'b'; break;
+	case S_IFIFO:  buf[0] = 'p'; break;
+	case S_IFSOCK: buf[0] = 's'; break;
+	default:       buf[0] = '-'; break;
+	}
+	for (i = 0; i < 9; i++)
+		buf[1 + i] = (mode & (1 << (8 - i))) ? rwx[i % 3] : '-';
+	buf[10] = '\0';
+	if (mode & S_ISUID) buf[3] = (buf[3] == 'x') ? 's' : 'S';
+	if (mode & S_ISGID) buf[6] = (buf[6] == 'x') ? 's' : 'S';
+	if (mode & S_ISVTX) buf[9] = (buf[9] == 'x') ? 't' : 'T';
+	return buf;
+}

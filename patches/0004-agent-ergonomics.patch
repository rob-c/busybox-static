+/* vi: set sw=4 ts=4: */
+/*
+ * brief - structure-preserving reduction of line-oriented tool output.
+ *
+ * The rule this applet obeys: reduce the *number* of records, never edit a
+ * record. Lines keep their bytes - no whitespace squeezing, no word
+ * abbreviation, no truncation of a line's tail, no NUL-to-newline rewriting -
+ * and what is dropped is whole records, counted on one greppable marker line
+ * so a reader can never mistake a reduced view for the whole output.
+ *
+ * Input is treated as bytes, not as C strings: a NUL inside a line is data,
+ * it does not end the line, and it survives to the output. That matters
+ * because libbb's xmalloc_fgetline() splits on NUL - see
+ * docs/instructions/brief-a-generic-record-reducing-filter-that-never-edits-a-line.md
+ *
+ * One table produces two kinds of view, and the accounting is the same for
+ * both. A *reduction* (-d, -s) shows every distinct record once, in the order
+ * it first appeared. An *aggregation* (-c, with -t and -m) shows one record
+ * per distinct value of the selected fields, and can order by count. The
+ * reduction is what you read; the aggregation is what you count with, and it
+ * is the view that answers "what repeats here", which is the question a
+ * reader asks first and the one a pipeline of cut/sort/uniq answers with four
+ * forks and no byte-exactness. Both obey the same invariant.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config BRIEF
+//config:	bool "brief (6 kb)"
+//config:	default n
+//config:	help
+//config:	  Reduce large line-oriented output to a bounded, readable view
+//config:	  without rewriting lines: identical (or digit-masked) lines are
+//config:	  grouped and counted, caller-declared salient lines are kept
+//config:	  verbatim, and every reduction is reported on a marker line.
+//config:	  Input is byte-exact: NULs inside a line are data, not separators.
+//config:	  With -c it also aggregates: one record per distinct value of the
+//config:	  chosen fields, which -t orders by count and -m filters.
+
+//applet:IF_BRIEF(APPLET_NOEXEC(brief, brief_main, BB_DIR_USR_BIN, BB_SUID_DROP, brief))
+
+//kbuild:lib-$(CONFIG_BRIEF) += brief.o
+
+//usage:#define brief_trivial_usage
+//usage:       "[-dsq] [-c LIST] [-t N] [-m N] [-o STR] [-x STR] [-R STR]"
+//usage:       " [-k STR] [-f LIST] [-i SEP] [-S SEP] [-B BYTES] [-n N] [-a N]"
+//usage:#define brief_full_usage "\n\n"
+//usage:       "Reduce line-oriented output to a bounded view, preserving every byte shown"
+//usage:     "\n"
+//usage:     "\n	-d	Group identical records and count them"
+//usage:     "\n	-s	Group records equal after masking digits (implies -d)"
+//usage:     "\n	-c LIST	Group by these fields (1,3-4) and show them"
+//usage:     "\n	-t N	Order groups by count, highest first (implies -d)"
+//usage:     "\n	-m N	Show only groups seen at least N times (implies -d)"
+//usage:     "\n	-o STR	Show only records containing STR (repeatable, OR)"
+//usage:     "\n	-x STR	Drop records containing STR (repeatable, OR)"
+//usage:     "\n	-R STR	A record starts at each line containing literal STR"
+//usage:     "\n	-q	Bare records: no \"Nx \" and no \"+ \" prefix"
+//usage:     "\n	-k STR	Keep records containing STR verbatim, never merged"
+//usage:     "\n	-f LIST	Show only these 1-based fields (1,3-4); input may be reformatted"
+//usage:     "\n	-i SEP	Field separators for -f/-c (default: space and tab)"
+//usage:     "\n	-S SEP	Join -f fields with SEP (default: one space)"
+//usage:     "\n	-B N	Output budget in bytes (default 8000)"
+//usage:     "\n	-n N	Maximum distinct records kept (default 2000)"
+//usage:     "\n	-a N	Samples shown per group, 1-8 (default 1)"
+//usage:     "\n	-F, --format FMT	text (default) or json (schema 1)"
+//usage:     "\n"
+//usage:     "\nA group prints as \"Nx <first line>\"; further -a samples print"
+//usage:     "\nwith a \"+ \" prefix so they cannot be read as repeats."
+//usage:     "\n"
+//usage:     "\nA record is one line, or - with -R - every line up to the next"
+//usage:     "\nmatch, so a commit, a test failure or a stack trace is one record."
+//usage:     "\nRecords are shown whole or not at all: the budget never cuts one."
+//usage:     "\n"
+//usage:     "\nGrouping is on the original record, so -f can never merge two"
+//usage:     "\nrecords that differ only outside the shown fields. -c groups on"
+//usage:     "\nthe projected record instead, which is what makes it an aggregate."
+//usage:     "\n"
+//usage:     "\nRecords are bytes: an embedded NUL is kept, not treated as a line"
+//usage:     "\nbreak, and the marker reports nul=<n> when any record held one."
+//usage:     "\n"
+//usage:     "\n-o and -x are the selection: \"brief -o error -o warning\" is the"
+//usage:     "\nfailures of any tool, without a format registry. Combined with -c"
+//usage:     "\nand -t it counts instead of listing: -o error -c 1 -t 10 is the ten"
+//usage:     "\nfiles with the most errors. -i : makes that work on colon-delimited"
+//usage:     "\noutput such as grep -n or a compiler diagnostic."
+//usage:     "\n"
+//usage:     "\nThe marker carries in_bytes and bytes, so the saving of every call"
+//usage:     "\nis measurable without a ledger file."
+//usage:     "\n"
+//usage:     "\n-F json returns the same numbers plus a summary sentence, hints"
+//usage:     "\nnaming the flag that would change the answer, a reason in"
+//usage:     "\ntruncated_by, and one object per group whose line carries the"
+//usage:     "\nrecord itself - no count prefix, no trailing newline."
+
+#include "libbb.h"
+
+#define BRIEF_MAX_SAMPLES 8
+#define BRIEF_MAX_FRANGES 32
+/* A -R record is assembled in memory, so an input that never matches the start
+ * pattern would otherwise hold the whole stream. Past this size the record is
+ * closed early: a pathological input gets several records instead of an OOM. */
+#define BRIEF_MAX_RECORD (4 * 1024 * 1024)
+
+enum {
+	OPT_d = (1 << 0),
+	OPT_s = (1 << 1),
+	OPT_k = (1 << 2),
+	OPT_f = (1 << 3),
+	OPT_S = (1 << 4),
+	OPT_B = (1 << 5),
+	OPT_n = (1 << 6),
+	OPT_a = (1 << 7),
+	OPT_F = (1 << 8),
+	OPT_c = (1 << 9),
+	OPT_t = (1 << 10),
+	OPT_m = (1 << 11),
+	OPT_q = (1 << 12),
+	OPT_o = (1 << 13),
+	OPT_x = (1 << 14),
+	OPT_R = (1 << 15),
+	OPT_i = (1 << 16),
+};
+
+static const char brief_longopts[] ALIGN1 =
+	"dedupe\0"  No_argument       "d"
+	"skeleton\0" No_argument      "s"
+	"keep\0"    Required_argument "k"
+	"fields\0"  Required_argument "f"
+	"sep\0"     Required_argument "S"
+	"max-bytes\0" Required_argument "B"
+	"max-records\0" Required_argument "n"
+	"samples\0" Required_argument "a"
+	"format\0"  Required_argument "F"
+	"count-by\0" Required_argument "c"
+	"top\0"     Required_argument "t"
+	"min-count\0" Required_argument "m"
+	"bare\0"    No_argument       "q"
+	"only\0"    Required_argument "o"
+	"without\0" Required_argument "x"
+	"record\0"  Required_argument "R"
+	"in-sep\0"  Required_argument "i"
+	;
+
+struct fw {
+	unsigned lo, hi;
+};
+
+/* One stored record: its bytes and how many lines they hold. In the default
+ * mode a record is one line (nl == 1); with -R a record is every line up to
+ * the next start pattern, so a record can be a whole commit, test failure or
+ * stack trace. The bytes are never a C string. */
+struct sample {
+	char *p;
+	size_t n;
+	unsigned nl;
+};
+
+struct item {
+	char *key;                 /* normalized key bytes; NULL for a kept line */
+	size_t keylen;
+	struct sample smp[BRIEF_MAX_SAMPLES];
+	unsigned nsmp;
+	unsigned count;            /* occurrences in the input */
+	unsigned long lines;       /* lines across all occurrences (for the books) */
+	int shown;                 /* selected for output */
+	int is_kept;               /* -k matched: printed verbatim, never merged */
+};
+
+/* ---- byte-exact line reader -------------------------------------------- */
+
+/* libbb's xmalloc_fgetline() stops at NUL, which both splits a line in two
+ * and loses the byte. This reader splits on '\n' only, so every other byte
+ * - including NUL, '\r' and 0x80-0xff - is preserved exactly. A trailing
+ * '\r' is deliberately NOT stripped: CRLF records then differ from LF ones,
+ * which is the truth about the input. */
+static char *brief_readline(FILE *fp, size_t *lenp)
+{
+	size_t cap = 0, n = 0;
+	char *buf = NULL;
+	int ch;
+
+	for (;;) {
+		ch = getc(fp);
+		if (ch == EOF)
+			break;
+		if (ch == '\n')
+			break;
+		if (n + 2 > cap) {
+			cap = cap ? cap * 2 : 128;
+			buf = xrealloc(buf, cap);
+		}
+		buf[n++] = (char)ch;
+	}
+	if (!buf) {
+		if (ch == EOF)
+			return NULL;      /* end of input, nothing pending */
+		cap = 2;
+		buf = xmalloc(cap);
+	}
+	buf[n] = '\0';
+	*lenp = n;
+	return buf;
+}
+
+/* ---- small growable string ---------------------------------------------- */
+
+struct sbuf {
+	char *p;
+	size_t len, cap;
+};
+
+static void sb_add(struct sbuf *b, const char *s, size_t n)
+{
+	if (b->len + n + 1 > b->cap) {
+		b->cap = (b->len + n + 1) * 2;
+		b->p = xrealloc(b->p, b->cap);
+	}
+	if (n)
+		memcpy(b->p + b->len, s, n);
+	b->len += n;
+	b->p[b->len] = '\0';
+}
+
+static void sb_addstr(struct sbuf *b, const char *s)
+{
+	sb_add(b, s, strlen(s));
+}
+
+static void sb_addch(struct sbuf *b, char c)
+{
+	sb_add(b, &c, 1);
+}
+
+/* ---- JSON string escaping ---------------------------------------------- */
+
+static void put_json_str(const char *s, size_t n)
+{
+	const char *end = s + n;
+
+	putchar('"');
+	for (; s < end; s++) {
+		if (*s == '"' || *s == '\\') {
+			printf("\\%c", *s);
+		} else if (*s == '\n') {
+			printf("\\n");          /* 2 bytes, not the 6 of \\u000a */
+		} else if (*s == '\t') {
+			printf("\\t");
+		} else if (*s == '\r') {
+			printf("\\r");
+		} else if ((unsigned char)*s < 0x20) {
+			printf("\\u%04x", (unsigned char)*s);
+		} else {
+			putchar(*s);
+		}
+	}
+	putchar('"');
+}
+
+/* ---- field selection --------------------------------------------------- */
+
+static unsigned parse_fields(const char *spec, struct fw *out)
+{
+	unsigned n = 0;
+
+	for (;;) {
+		char *end;
+		unsigned long lo, hi;
+
+		lo = strtoul(spec, &end, 10);
+		if (end == spec || lo == 0 || lo > INT_MAX)
+			break;
+		hi = lo;
+		spec = end;
+		if (*spec == '-') {
+			spec++;
+			hi = strtoul(spec, &end, 10);
+			if (end == spec || hi < lo || hi > INT_MAX)
+				break;
+			spec = end;
+		}
+		if (n == BRIEF_MAX_FRANGES)
+			return 0;
+		out[n].lo = (unsigned)lo;
+		out[n].hi = (unsigned)hi;
+		n++;
+		if (*spec == ',') {
+			spec++;
+			continue;
+		}
+		if (*spec == '\0')
+			return n;
+		break;
+	}
+	bb_error_msg("bad field list");
+	xfunc_error_retval = 2;
+	return 0;
+}
+
+/* Which bytes separate fields. Default is any run of space or tab, but most
+ * tool output that matters is colon-delimited ("path:line: message", grep -n,
+ * compiler diagnostics), so -i lets the caller say so. A 256-entry map keeps
+ * the split O(1) per byte and byte-transparent: no byte is ever rewritten. */
+static unsigned char is_sep[256];
+
+static void set_in_sep(const char *s)
+{
+	memset(is_sep, 0, sizeof(is_sep));
+	if (!s || !*s) {
+		is_sep[' '] = is_sep['\t'] = 1;
+		return;
+	}
+	while (*s)
+		is_sep[(unsigned char)*s++] = 1;
+}
+
+/* Rebuild the line from the selected fields. Out-of-range fields are simply
+ * absent; the caller reports that -f was used, so the reader knows the record
+ * was reformatted. Field bytes are copied as bytes. */
+static void project_into(struct sbuf *out, const char *line, size_t len,
+		const struct fw *fr, unsigned nfr, const char *sep)
+{
+	unsigned field = 0, printed = 0;
+	const char *p = line, *end = line + len;
+
+	while (p < end) {
+		const char *start;
+		unsigned i;
+		int want = 0;
+
+		while (p < end && is_sep[(unsigned char)*p])
+			p++;
+		if (p == end)
+			break;
+		start = p;
+		while (p < end && !is_sep[(unsigned char)*p])
+			p++;
+		field++;
+		for (i = 0; i < nfr; i++) {
+			if (field >= fr[i].lo && field <= fr[i].hi) {
+				want = 1;
+				break;
+			}
+		}
+		if (!want)
+			continue;
+		if (printed)
+			sb_addstr(out, sep);
+		sb_add(out, start, (size_t)(p - start));
+		printed = 1;
+	}
+}
+
+/* ---- normalization ----------------------------------------------------- */
+
+/* -s: mask runs of digits. Digits are the one class that is almost always
+ * noise in a repeated message ("line 12", "port 8080", "pid 4711"), and they
+ * are masked only for the equality test: the stored sample stays verbatim.
+ * Only 0x30-0x39 is touched, so NUL and high bytes pass through as data. */
+static char *norm_key(const char *line, size_t len, int mask_digits, size_t *outlen)
+{
+	struct sbuf b = { 0 };
+	size_t i = 0;
+
+	if (!mask_digits) {
+		sb_add(&b, line, len);
+		*outlen = b.len;
+		return b.p;
+	}
+	while (i < len) {
+		if (line[i] >= '0' && line[i] <= '9') {
+			while (i < len && line[i] >= '0' && line[i] <= '9')
+				i++;
+			sb_addch(&b, '#');
+			continue;
+		}
+		sb_addch(&b, line[i++]);
+	}
+	if (!b.p) {
+		sb_add(&b, "", 0);
+	}
+	*outlen = b.len;
+	return b.p;
+}
+
+/* ---- record table ------------------------------------------------------ */
+
+static struct item *items;
+static unsigned nitems, citems;
+static unsigned *htab;          /* index+1, 0 = empty */
+static unsigned hsize;
+
+static unsigned hash_bytes(const char *s, size_t n)
+{
+	unsigned h = 2166136261u;
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		h ^= (unsigned char)s[i];
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static void htab_grow(void)
+{
+	unsigned i, new_size = hsize ? hsize * 2 : 512;
+	unsigned *old = htab;
+	unsigned old_size = hsize;
+
+	htab = xzalloc(new_size * sizeof(htab[0]));
+	hsize = new_size;
+	for (i = 0; i < old_size; i++) {
+		unsigned idx, j;
+
+		if (!old[i])
+			continue;
+		idx = old[i] - 1;
+		j = hash_bytes(items[idx].key, items[idx].keylen) & (hsize - 1);
+		while (htab[j])
+			j = (j + 1) & (hsize - 1);
+		htab[j] = idx + 1;
+	}
+	free(old);
+}
+
+/* Returns the item for KEY, creating it when absent (or NULL when the record
+ * cap is reached and the caller must count it as dropped). Keys are compared
+ * as bytes: a NUL inside a key is not a terminator. */
+static struct item *item_find(const char *key, size_t keylen, int create)
+{
+	unsigned j;
+
+	if (create && (hsize == 0 || nitems * 2 >= hsize))
+		htab_grow();
+	if (hsize) {
+		j = hash_bytes(key, keylen) & (hsize - 1);
+		while (htab[j]) {
+			struct item *it = &items[htab[j] - 1];
+
+			if (it->keylen == keylen && memcmp(it->key, key, keylen) == 0)
+				return it;
+			j = (j + 1) & (hsize - 1);
+		}
+	}
+	if (!create)
+		return NULL;
+	if (nitems == citems) {
+		citems = citems ? citems * 2 : 256;
+		items = xrealloc(items, citems * sizeof(items[0]));
+	}
+	memset(&items[nitems], 0, sizeof(items[0]));
+	items[nitems].key = xmalloc(keylen + 1);
+	memcpy(items[nitems].key, key, keylen);
+	items[nitems].key[keylen] = '\0';
+	items[nitems].keylen = keylen;
+	j = hash_bytes(key, keylen) & (hsize - 1);
+	while (htab[j])
+		j = (j + 1) & (hsize - 1);
+	htab[j] = nitems + 1;
+	return &items[nitems++];
+}
+
+static struct item *item_new(void)
+{
+	struct item *it;
+
+	if (nitems == citems) {
+		citems = citems ? citems * 2 : 256;
+		items = xrealloc(items, citems * sizeof(items[0]));
+	}
+	memset(&items[nitems], 0, sizeof(items[0]));
+	it = &items[nitems++];
+	it->key = NULL;
+	it->keylen = 0;
+	return it;
+}
+
+/* -t: order by count, highest first; ties keep first-appearance order so the
+ * output is deterministic and the budget is spent on the repeated records
+ * instead of on whatever happened to arrive first. */
+static int cmp_by_count(const void *pa, const void *pb)
+{
+	unsigned ia = *(const unsigned *)pa;
+	unsigned ib = *(const unsigned *)pb;
+	unsigned ca = items[ia].count;
+	unsigned cb = items[ib].count;
+
+	if (ca != cb)
+		return ca > cb ? -1 : 1;
+	return ia < ib ? -1 : (ia > ib);
+}
+
+static int mem_contains(const char *h, size_t hn, const char *n)
+{
+	size_t nn = strlen(n), i;
+
+	if (nn == 0)
+		return 1;
+	if (nn > hn)
+		return 0;
+	for (i = 0; i + nn <= hn; i++) {
+		if (h[i] == n[0] && memcmp(h + i, n, nn) == 0)
+			return 1;
+	}
+	return 0;
+}
+
+/* ---- ingest state -------------------------------------------------------
+ * The reader produces *records*: one line by default, or every line up to the
+ * next -R match. Selection (-o/-x), grouping (-d/-s/-c), the record cap (-n),
+ * the threshold (-m) and the budget (-B) all work on whole records, so both
+ * modes share one code path and the accounting stays per line.
+ */
+struct istate {
+	struct sbuf cur;          /* the record being assembled */
+	unsigned cur_nl;
+
+	unsigned long lines_in, lines_shown, lines_merged;
+	unsigned long dropped_records, dropped_lines;
+	unsigned long kept, nul_lines, matched, projected;
+	size_t in_bytes;
+
+	unsigned budget, max_recs, max_samples, top_n, min_count;
+	int dedupe, skeleton, bare;
+	const char *sep;
+	const char *keep, *record_pat;
+	llist_t *only, *without;
+	const struct fw *fr;
+	unsigned nfr;
+	const struct fw *cbfr;
+	unsigned ncb;
+};
+
+static struct istate st;
+
+/* Why the view is incomplete, by how much it narrows the output. -F json and
+ * the marker both name it, because "truncated" alone does not tell a reader
+ * which flag to change. */
+enum { TB_NONE, TB_SELECTION, TB_RECORDS, TB_MIN, TB_TOP, TB_SIZE, TB_BUDGET };
+static int trunc_by;
+static const char *const trunc_names[] = {
+	"", "selection", "records", "min_count", "top", "record_size", "budget"
+};
+
+static void note_loss(int why)
+{
+	if (why > trunc_by)
+		trunc_by = why;
+}
+
+/* 1 when any pattern in the list occurs in the record. Substrings, not regex:
+ * a pattern that has to be escaped is a pattern an agent gets wrong. */
+static int pat_hit(llist_t *list, const char *h, size_t hn)
+{
+	for (; list; list = list->link) {
+		if (list->data && mem_contains(h, hn, list->data))
+			return 1;
+	}
+	return 0;
+}
+
+/* Project every line of a record, joined with '\n': the key for -c. */
+static void project_record(struct sbuf *out, const char *p, size_t n,
+		const struct fw *fr, unsigned nfr, const char *sep)
+{
+	const char *end = p + n;
+
+	for (;;) {
+		const char *nl = memchr(p, '\n', (size_t)(end - p));
+		size_t l = nl ? (size_t)(nl - p) : (size_t)(end - p);
+
+		project_into(out, p, l, fr, nfr, sep);
+		if (!nl)
+			break;
+		sb_addch(out, '\n');
+		p = nl + 1;
+	}
+}
+
+/* Copy the record into the item's sample list, subject to -a. The bytes are
+ * copied, never referenced: the assembly buffer is reused for the next record. */
+static void take_sample(struct item *it, const char *p, size_t n, unsigned nl)
+{
+	struct sample *sm;
+
+	it->lines += nl;
+	if (it->nsmp >= st.max_samples)
+		return;
+	sm = &it->smp[it->nsmp];
+	sm->p = xmalloc(n + 1);
+	if (n)
+		memcpy(sm->p, p, n);
+	sm->p[n] = '\0';
+	sm->n = n;
+	sm->nl = nl;
+	it->nsmp++;
+}
+
+/* Close the record being assembled: select it, group it, store it. Everything
+ * that is not stored is counted, so the marker can always close the books. */
+static void flush_record(void)
+{
+	struct item *it;
+	size_t keylen = 0;
+	char *key = NULL;
+	unsigned nl = st.cur_nl;
+	const char *p = st.cur.p ? st.cur.p : "";
+	size_t n = st.cur.len;
+	int kept;
+
+	if (nl == 0)
+		return;
+	st.cur.len = 0;
+	st.cur_nl = 0;
+
+	/* -o/-x act before the table, so -n cannot fill up with records the
+	 * caller did not ask for and hide the ones it did. */
+	if (st.only && !pat_hit(st.only, p, n)) {
+		note_loss(TB_SELECTION);
+		st.dropped_records++;
+		st.dropped_lines += nl;
+		return;
+	}
+	if (st.without && pat_hit(st.without, p, n)) {
+		note_loss(TB_SELECTION);
+		st.dropped_records++;
+		st.dropped_lines += nl;
+		return;
+	}
+	st.matched++;
+
+	kept = st.keep && mem_contains(p, n, st.keep);
+	if (kept) {
+		/* -k: printed verbatim, never merged with another record */
+		if (nitems >= st.max_recs) {
+			st.dropped_records++;
+			st.dropped_lines += nl;
+			return;
+		}
+		it = item_new();
+		it->is_kept = 1;
+		it->count = 1;
+		take_sample(it, p, n, nl);
+		st.kept++;
+		return;
+	}
+
+	if (st.dedupe) {
+		if (st.ncb) {
+			struct sbuf kb = { 0 };
+
+			project_record(&kb, p, n, st.cbfr, st.ncb, st.sep);
+			key = norm_key(kb.p ? kb.p : "", kb.len, st.skeleton, &keylen);
+			free(kb.p);
+		} else {
+			key = norm_key(p, n, st.skeleton, &keylen);
+		}
+		it = item_find(key, keylen, nitems < st.max_recs);
+		free(key);
+		if (!it) {
+			note_loss(TB_RECORDS);
+			st.dropped_records++;
+			st.dropped_lines += nl;
+			return;
+		}
+	} else {
+		if (nitems >= st.max_recs) {
+			note_loss(TB_RECORDS);
+			st.dropped_records++;
+			st.dropped_lines += nl;
+			return;
+		}
+		it = item_new();
+	}
+	if (it->count == 0) {
+		it->count = 1;
+		take_sample(it, p, n, nl);
+	} else {
+		it->count++;
+		take_sample(it, p, n, nl);
+	}
+}
+
+/* Render one stored sample: the count prefix on its first line, then the
+ * record's lines, each projected if -f/-c asked. Records are never split. */
+static void render_record(struct sbuf *out, const struct sample *sm,
+		unsigned count, int first)
+{
+	const char *p = sm->p, *end = sm->p + sm->n;
+
+	if (!st.bare) {
+		if (count > 1 && first) {
+			char num[32];
+
+			sprintf(num, "%ux ", count);
+			sb_addstr(out, num);
+		} else if (!first) {
+			sb_addstr(out, "+ ");
+		}
+	}
+	for (;;) {
+		const char *nl = memchr(p, '\n', (size_t)(end - p));
+		size_t l = nl ? (size_t)(nl - p) : (size_t)(end - p);
+
+		if (st.nfr) {
+			project_into(out, p, l, st.fr, st.nfr, st.sep);
+			st.projected++;
+		} else {
+			sb_add(out, p, l);
+		}
+		sb_addch(out, '\n');
+		if (!nl)
+			break;
+		p = nl + 1;
+	}
+}
+
+/* The JSON rendering of a record: the same bytes as the text view, without the
+ * presentation the JSON object already carries. The "Nx " count is a field
+ * ("n") and the final newline is a text-layout artifact, so neither is
+ * duplicated into the string: a model reading "line" gets the record itself. */
+static void render_json_record(struct sbuf *out, const struct sample *sm)
+{
+	const char *p = sm->p, *end = sm->p + sm->n;
+
+	for (;;) {
+		const char *nl = memchr(p, '\n', (size_t)(end - p));
+		size_t l = nl ? (size_t)(nl - p) : (size_t)(end - p);
+
+		if (st.nfr)
+			project_into(out, p, l, st.fr, st.nfr, st.sep);
+		else
+			sb_add(out, p, l);
+		if (!nl)
+			break;
+		sb_addch(out, '\n');
+		p = nl + 1;
+	}
+}
+
+/* The selected fields as a JSON array, so a reader never has to re-split the
+ * projected line. Only for single-line records: a projection of a section has
+ * no one obvious array to be. */
+static void put_json_fields(const char *line, size_t len)
+{
+	const struct fw *fr = st.nfr ? st.fr : st.cbfr;
+	unsigned nfr = st.nfr ? st.nfr : st.ncb;
+	const char *p = line, *end = line + len;
+	unsigned field = 0, i;
+	int first = 1;
+
+	putchar('[');
+	while (p < end) {
+		const char *start;
+		int want = 0;
+
+		while (p < end && is_sep[(unsigned char)*p])
+			p++;
+		if (p == end)
+			break;
+		start = p;
+		while (p < end && !is_sep[(unsigned char)*p])
+			p++;
+		field++;
+		for (i = 0; i < nfr; i++)
+			if (field >= fr[i].lo && field <= fr[i].hi) {
+				want = 1;
+				break;
+			}
+		if (!want)
+			continue;
+		if (!first)
+			putchar(',');
+		put_json_str(start, (size_t)(p - start));
+		first = 0;
+	}
+	putchar(']');
+}
+
+/* ---- main -------------------------------------------------------------- */
+
+int brief_main_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int brief_main_main(int argc UNUSED_PARAM, char **argv)
+{
+	const char *opt_fields = NULL, *opt_sep = NULL, *opt_bytes = NULL;
+	const char *opt_recs = NULL, *opt_samples = NULL, *opt_fmt = NULL;
+	const char *opt_countby = NULL, *opt_top = NULL, *opt_min = NULL;
+	const char *opt_insep = NULL;
+	struct fw fr[BRIEF_MAX_FRANGES], cbfr[BRIEF_MAX_FRANGES];
+	unsigned nfr = 0, ncb = 0, i, oi;
+	unsigned budget = 8000, max_recs = 2000, max_samples = 1;
+	unsigned top_n = 0, min_count = 1;
+	int json_out;
+	unsigned *order, shown_groups = 0;
+	char *body = NULL;
+	size_t body_len = 0;
+	int truncated = 0;
+	FILE *fp;
+	unsigned flags;
+
+	xfunc_error_retval = 2; /* usage errors, until input is opened */
+	flags = getopt32long(argv, "dsk:f:S:B:n:a:F:c:t:m:q|o:*x:*R:i:", brief_longopts,
+			&st.keep, &opt_fields, &opt_sep,
+			&opt_bytes, &opt_recs, &opt_samples, &opt_fmt,
+			&opt_countby, &opt_top, &opt_min,
+			&st.only, &st.without, &st.record_pat, &opt_insep);
+	argv += optind;
+
+	if (opt_bytes)
+		budget = xatoul_range(opt_bytes, 0, INT_MAX);
+	if (opt_recs)
+		max_recs = xatoul_range(opt_recs, 1, INT_MAX);
+	if (opt_samples)
+		max_samples = xatoul_range(opt_samples, 1, BRIEF_MAX_SAMPLES);
+	if (!opt_sep)
+		opt_sep = " ";
+	set_in_sep(opt_insep);
+	if (opt_fields) {
+		nfr = parse_fields(opt_fields, fr);
+		if (!nfr)
+			return xfunc_error_retval;
+	}
+	if (opt_countby) {
+		ncb = parse_fields(opt_countby, cbfr);
+		if (!ncb)
+			return xfunc_error_retval;
+	}
+	if (opt_top)
+		top_n = xatoul_range(opt_top, 1, INT_MAX);
+	if (opt_min)
+		min_count = xatoul_range(opt_min, 1, INT_MAX);
+	json_out = opt_fmt && strcmp(opt_fmt, "json") == 0;
+	if (opt_fmt && !json_out && strcmp(opt_fmt, "text") != 0) {
+		bb_error_msg("unknown format %s", opt_fmt);
+		return 2;
+	}
+	/* -c decides grouping and, unless -f says otherwise, display: a caller
+	 * can aggregate on one field and print another. */
+	if (!nfr && ncb) {
+		memcpy(fr, cbfr, sizeof(cbfr[0]) * ncb);
+		nfr = ncb;
+	}
+
+	st.budget = budget;
+	st.max_recs = max_recs;
+	st.max_samples = max_samples;
+	st.top_n = top_n;
+	st.min_count = min_count;
+	st.sep = opt_sep;
+	st.fr = fr;
+	st.nfr = nfr;
+	st.cbfr = cbfr;
+	st.ncb = ncb;
+	st.skeleton = (flags & OPT_s) != 0;
+	st.bare = (flags & OPT_q) != 0;
+	/* -c, -t and -m are grouping requests in their own right: asking for an
+	 * aggregate without -d must not silently produce a pass-through. */
+	st.dedupe = st.skeleton || (flags & OPT_d) != 0 || ncb || top_n || min_count > 1;
+
+	xfunc_error_retval = 1;
+
+	for (;;) {
+		int from_stdin = (!*argv || strcmp(*argv, "-") == 0);
+
+		/* fopen_or_warn_stdin() is not NULL-safe in this tree: it tests
+		 * filename[0] == '-' before it tests filename != NULL. */
+		fp = from_stdin ? stdin
+				: (json_out ? fopen(*argv, "r") : fopen_or_warn(*argv, "r"));
+		if (!fp) {
+			if (json_out) {
+				int e = errno;
+
+				printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\","
+						"\"message\":");
+				put_json_str(strerror(e), strlen(strerror(e)));
+				fputs("}\n", stdout);
+				fflush_stdout_and_exit(1);
+			}
+			return 1;
+		}
+		for (;;) {
+			size_t len = 0;
+			char *line = brief_readline(fp, &len);
+
+			if (!line)
+				break;
+			st.lines_in++;
+			st.in_bytes += len + 1;
+			if (memchr(line, 0, len))
+				st.nul_lines++;
+			/* A new line opens a new record: always without -R, and
+			 * only when it matches the start pattern with -R. */
+			if (st.cur_nl && (!st.record_pat
+					|| st.cur.len >= BRIEF_MAX_RECORD
+					|| mem_contains(line, len, st.record_pat)))
+				flush_record();
+			if (st.cur_nl)
+				sb_addch(&st.cur, '\n');
+			sb_add(&st.cur, line, len);
+			st.cur_nl++;
+			free(line);
+		}
+		if (!from_stdin)
+			fclose(fp);
+		if (!*argv)
+			break;          /* nothing named: one pass over stdin */
+		argv++;
+		if (!*argv)
+			break;          /* last named file done */
+	}
+	flush_record();
+
+	/* The table's own order unless -t asked for a frequency order. */
+	order = xmalloc((nitems ? nitems : 1) * sizeof(order[0]));
+	for (i = 0; i < nitems; i++)
+		order[i] = i;
+	if (top_n && nitems > 1)
+		qsort(order, nitems, sizeof(order[0]), cmp_by_count);
+
+	for (oi = 0; oi < nitems; oi++) {
+		struct item *it = &items[order[oi]];
+		unsigned k;
+		unsigned long emitted;
+
+		/* -m: below the threshold the record is not shown at all */
+		if (it->count < st.min_count) {
+			note_loss(TB_MIN);
+			st.dropped_records++;
+			st.dropped_lines += it->lines;
+			continue;
+		}
+		/* -t N keeps the N most frequent groups: "top" has to mean a cap,
+		 * or the count says 87 groups while the hint says 3. */
+		if (top_n && shown_groups >= top_n) {
+			note_loss(TB_TOP);
+			truncated = 1;
+			st.dropped_records++;
+			st.dropped_lines += it->lines;
+			continue;
+		}
+		it->shown = 1;
+		emitted = 0;
+		for (k = 0; k < it->nsmp; k++) {
+			struct sbuf rec = { 0 };
+
+			render_record(&rec, &it->smp[k], it->count, k == 0);
+			/* A record is shown whole or not at all: a budget that
+			 * cuts inside a commit or a stack trace produces output
+			 * that no longer means anything. */
+			if (rec.len > (size_t)budget) {
+				/* Too big to fit under ANY budget. That is a drop,
+				 * not a truncation: dropping it must not hide every
+				 * record after it - a 12 KB banner would otherwise
+				 * empty the whole view. */
+				it->shown = -1;
+				truncated = 1;   /* the view is incomplete, by size */
+				note_loss(TB_SIZE);
+				free(rec.p);
+				break;
+			}
+			if (body_len + rec.len > (size_t)budget) {
+				it->shown = 0;
+				truncated = 1;
+				note_loss(TB_BUDGET);
+				free(rec.p);
+				break;
+			}
+			body = xrealloc(body, body_len + rec.len + 1);
+			memcpy(body + body_len, rec.p, rec.len);
+			body_len += rec.len;
+			free(rec.p);
+			st.lines_shown += it->smp[k].nl;
+			emitted += it->smp[k].nl;
+		}
+		/* Invariant: lines_in == lines_shown + lines_merged + dropped_lines.
+		 * A record counts as merged only for the occurrences it did not
+		 * display, so -a cannot double-count them. */
+		if (it->shown < 0) {
+			st.dropped_records++;
+			st.dropped_lines += it->lines;
+			continue;
+		}
+		if (it->shown) {
+			shown_groups++;
+			if (it->lines > emitted)
+				st.lines_merged += it->lines - emitted;
+			continue;
+		}
+		/* The budget is spent. Lines of THIS record that were not printed
+		 * are merges into the record that was; everything after it in the
+		 * chosen order is dropped whole. */
+		if (emitted) {
+			st.lines_merged += it->lines - emitted;
+			st.dropped_records += nitems - oi - 1;
+		} else {
+			st.dropped_lines += it->lines;
+			st.dropped_records += nitems - oi;
+		}
+		for (i = oi + 1; i < nitems; i++)
+			st.dropped_lines += items[order[i]].lines;
+		break;
+	}
+
+	if (json_out) {
+		int first = 1, nhint = 0;
+		double pct10 = 0;
+
+		/* Everything a reader needs in order to understand the view
+		 * without seeing the input: what came in, what is shown, how
+		 * much is missing and which flag caused that. */
+		if (st.in_bytes)
+			pct10 = 100.0 * (double)body_len / (double)st.in_bytes;
+		printf("{\"schema\":1,\"summary\":");
+		{
+			char sum[256];
+
+			if (shown_groups == nitems)
+				snprintf(sum, sizeof(sum),
+						"%lu lines in, %u records, all shown, "
+						"%lu of %lu body bytes, %s",
+						st.lines_in, nitems,
+						(unsigned long)body_len, (unsigned long)st.in_bytes,
+						trunc_by ? "incomplete" : "complete");
+			else
+				snprintf(sum, sizeof(sum),
+						"%lu lines in, %u records, %u of %u shown, "
+						"%lu of %lu body bytes, %s",
+						st.lines_in, nitems, shown_groups, nitems,
+						(unsigned long)body_len, (unsigned long)st.in_bytes,
+						trunc_by ? "incomplete" : "complete");
+			put_json_str(sum, strlen(sum));
+		}
+		printf(",\"pct_of_input\":%.1f", (double)pct10);
+		fputs(",\"hints\":[", stdout);
+		/* One hint per cause, each naming the flag to change. Computed
+		 * from the counters, never canned: a complete view with nothing
+		 * merged emits an empty array. */
+		if (trunc_by == TB_BUDGET) {
+			printf("%s\"the byte budget stopped the view: raise -B (-B 0 is a zero budget)\"",
+					nhint++ ? "," : "");
+		} else if (trunc_by == TB_SIZE) {
+			printf("%s\"records larger than the whole budget were dropped: raise -B\"",
+					nhint++ ? "," : "");
+		} else if (trunc_by == TB_RECORDS) {
+			printf("%s\"the table stopped at -n, so later records were not counted: raise -n\"",
+					nhint++ ? "," : "");
+		} else if (trunc_by == TB_MIN) {
+			printf("%s\"groups seen fewer than -m times are hidden: lower -m or drop it\"",
+					nhint++ ? "," : "");
+		} else if (trunc_by == TB_TOP) {
+			printf("%s\"-t kept the %u highest-count groups of %u: raise -t for the rest\"",
+					nhint++ ? "," : "", top_n, nitems);
+		} else if (trunc_by == TB_SELECTION && st.matched == 0) {
+			printf("%s\"nothing matched -o/-x: they are substrings, not regexes\"",
+					nhint++ ? "," : "");
+		}
+		if (st.lines_merged && !top_n) {
+			printf("%s\"%lu lines are repeats of a shown record: -t 10 ranks them first\"",
+					nhint++ ? "," : "", st.lines_merged);
+		}
+
+		fputs("],\"truncated_by\":", stdout);
+		if (trunc_by)
+			put_json_str(trunc_names[trunc_by], strlen(trunc_names[trunc_by]));
+		else
+			fputs("null", stdout);
+		printf(",\"lines_in\":%lu,\"records\":%u,\"kept\":%lu,"
+				"\"lines_shown\":%lu,\"lines_merged\":%lu,"
+				"\"dropped_records\":%lu,\"dropped_lines\":%lu,"
+				"\"nul_lines\":%lu,\"bytes\":%lu,\"truncated\":%s,\"fields\":%s,"
+				"\"shown_groups\":%u,\"projected\":%lu,\"bare\":%s,"
+				"\"top\":%u,\"min_count\":%u,\"matched\":%lu,\"in_bytes\":%lu,"
+				"\"grouped_by\":",
+				st.lines_in, nitems, st.kept,
+				st.lines_shown, st.lines_merged,
+				st.dropped_records, st.dropped_lines,
+				st.nul_lines, (unsigned long)body_len,
+				truncated ? "true" : "false",
+				nfr ? "true" : "false",
+				shown_groups, st.projected, st.bare ? "true" : "false",
+				top_n, min_count, st.matched, (unsigned long)st.in_bytes);
+		if (ncb)
+			put_json_str(opt_countby, strlen(opt_countby));
+		else
+			fputs("null", stdout);
+		fputs(",\"record_start\":", stdout);
+		if (st.record_pat)
+			put_json_str(st.record_pat, strlen(st.record_pat));
+		else
+			fputs("null", stdout);
+		fputs(",\"items\":[", stdout);
+		for (oi = 0; oi < nitems; oi++) {
+			struct item *it = &items[order[oi]];
+			unsigned k;
+			struct sbuf rec = { 0 };
+
+			if (it->shown != 1)
+				continue;
+			/* One object per group: "n" is its count, "line" its first
+			 * sample, and "samples" appears only when -a showed more
+			 * than one, so the default output carries no repetition. */
+			render_json_record(&rec, &it->smp[0]);
+			printf("%s{\"n\":%u,\"lines\":%lu,\"kept\":%s",
+					first ? "" : ",", it->count, it->lines,
+					it->is_kept ? "true" : "false");
+			if (nfr && it->smp[0].nl == 1) {
+				fputs(",\"f\":", stdout);
+				put_json_fields(it->smp[0].p, it->smp[0].n);
+			}
+			fputs(",\"line\":", stdout);
+			put_json_str(rec.p ? rec.p : "", rec.len);
+			if (it->nsmp > 1) {
+				fputs(",\"samples\":[", stdout);
+				put_json_str(rec.p ? rec.p : "", rec.len);
+				for (k = 1; k < it->nsmp; k++) {
+					struct sbuf more = { 0 };
+
+					render_json_record(&more, &it->smp[k]);
+					putchar(',');
+					put_json_str(more.p ? more.p : "", more.len);
+					free(more.p);
+				}
+				putchar(']');
+			}
+			putchar('}');
+			free(rec.p);
+			first = 0;
+		}
+		fputs("]}\n", stdout);
+	} else {
+		/* The marker comes first: a reader knows the shape of what follows
+		 * before reading it, and can never mistake a reduced view for the
+		 * whole output. */
+		printf("[brief] lines_in=%lu records=%u kept=%lu shown_lines=%lu"
+				" merged=%lu dropped_records=%lu dropped_lines=%lu"
+				" nul=%lu bytes=%lu truncated=%d shown_groups=%u projected=%lu"
+				" bare=%d top=%u min=%u matched=%lu in_bytes=%lu truncated_by=%s\n",
+				st.lines_in, nitems, st.kept, st.lines_shown,
+				st.lines_merged, st.dropped_records, st.dropped_lines,
+				st.nul_lines, (unsigned long)body_len, truncated,
+				shown_groups, st.projected, st.bare, top_n, min_count,
+				st.matched, (unsigned long)st.in_bytes,
+				trunc_by ? trunc_names[trunc_by] : "-");
+		if (body && body_len)
+			fwrite(body, 1, body_len, stdout);
+	}
+	fflush_stdout_and_exit(0);
+}
diff --git a/miscutils/check.c b/miscutils/check.c
new file mode 100644
index 0000000..d17eb78
--- /dev/null
+++ b/miscutils/check.c
@@ -0,0 +1,230 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * check - run a table of shell test cases and report pass/fail.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config CHECKTBL
+//config:	bool "check (6 kb)"
+//config:	default n
+//config:	help
+//config:	  Run a table of test cases, one per line:
+//config:	      name | command | want_exit | want_substring
+//config:	  Reports pass/fail per case plus a summary, or JSON with
+//config:	  --format json. Comments start with '#'. Named 'check' because
+//config:	  'test' and '[' are already applets.
+
+//applet:IF_CHECKTBL(APPLET_NOEXEC(check, check_main, BB_DIR_USR_BIN, BB_SUID_DROP, check))
+
+//kbuild:lib-$(CONFIG_CHECKTBL) += check.o
+
+//usage:#define check_trivial_usage
+//usage:       "[-f FILE] [-v] [--format json]"
+//usage:#define check_full_usage "\n\n"
+//usage:       "Run test cases from FILE (default: stdin)\n"
+//usage:     "\n	-f FILE	Case table"
+//usage:     "\n	-v	Show output of failing cases"
+//usage:     "\n	--format json	Structured output (schema 1)"
+
+#include "libbb.h"
+
+static void put_json_string(const char *s)
+{
+	putchar('"');
+	for (; s && *s; s++) {
+		if (*s == '"' || *s == '\\')
+			printf("\\%c", *s);
+		else if ((unsigned char)*s < 0x20)
+			printf("\\u%04x", (unsigned char)*s);
+		else
+			putchar(*s);
+	}
+	putchar('"');
+}
+#include <sys/wait.h>
+
+static const char check_longopts[] ALIGN1 =
+	"file\0"   Required_argument "f"
+	"verbose\0" No_argument      "v"
+	"format\0" Required_argument "F"
+	;
+#define check_longopts (check_longopts)
+
+#define MAX_OUT 8192
+
+struct result {
+	char *name;
+	int want_exit, got_exit;
+	int ok;
+	char *why;
+	char out[MAX_OUT];
+};
+
+static int run_case(const char *cmd, char *out, size_t outsz)
+{
+	int fds[2];
+	pid_t pid;
+	int st;
+	ssize_t n;
+	size_t used = 0;
+
+	if (pipe(fds) != 0)
+		return -1;
+	fflush_all();
+	pid = fork();
+	if (pid < 0) {
+		close(fds[0]);
+		close(fds[1]);
+		return -1;
+	}
+	if (pid == 0) {
+		close(fds[0]);
+		dup2(fds[1], 1);
+		close(fds[1]);
+		execl("/bin/sh", "sh", "-c", cmd, (char *)NULL);
+		_exit(127);
+	}
+	close(fds[1]);
+	while ((n = safe_read(fds[0], out + used, outsz - 1 - used)) > 0) {
+		used += n;
+		if (used >= outsz - 1)
+			break;
+	}
+	out[used] = '\0';
+	close(fds[0]);
+	if (waitpid(pid, &st, 0) < 0)
+		return -1;
+	if (WIFEXITED(st))
+		return WEXITSTATUS(st);
+	return 128 + WTERMSIG(st);
+}
+
+static char *pc_trim(char *s)
+{
+	char *e;
+
+	while (*s == ' ' || *s == '\t')
+		s++;
+	e = s + strlen(s);
+	while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\n' || e[-1] == '\r'))
+		*--e = '\0';
+	return s;
+}
+
+static void json_str(const char *s)
+{
+	putchar('"');
+	for (; *s; s++) {
+		if (*s == '"' || *s == '\\')
+			printf("\\%c", *s);
+		else if ((unsigned char)*s < 0x20)
+			printf("\\u%04x", (unsigned char)*s);
+		else
+			putchar(*s);
+	}
+	putchar('"');
+}
+
+int check_main_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int check_main_main(int argc UNUSED_PARAM, char **argv)
+{
+	const char *opt_file = NULL, *opt_fmt = NULL;
+	int opts, json_out, verbose = 0;
+	struct result *res;
+	unsigned n = 0, cap = 64, passed = 0, failed = 0, i;
+	char *buf, *save, *line;
+
+	xfunc_error_retval = 2;
+	opts = getopt32long(argv, "f:v" "F:", check_longopts, &opt_file, &opt_fmt);
+	xfunc_error_retval = 1;   /* past option parsing: failures are operational */
+	verbose = (opts & 2) != 0;   /* v */
+	json_out = opt_fmt && strcmp(opt_fmt, "json") == 0;
+	if (opt_fmt && strcmp(opt_fmt, "json") != 0 && strcmp(opt_fmt, "text") != 0) {
+		bb_error_msg("unknown format %s", opt_fmt);
+		return 2;
+	}
+
+	buf = xmalloc_open_read_close(opt_file ? opt_file : "/dev/stdin", NULL);
+	if (!buf) {
+		int e = errno;
+
+		if (json_out) {
+			printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\","
+					"\"message\":");
+			put_json_string(strerror(e));
+			fputs("}\n", stdout);
+		} else {
+			errno = e;
+			bb_perror_msg("%s", opt_file ? opt_file : "stdin");
+		}
+		return 1;
+	}
+
+	res = xzalloc(sizeof(res[0]) * cap);
+	save = buf;
+	while ((line = strsep(&save, "\n")) != NULL) {
+		char *name, *cmd, *want, *sub;
+		struct result *r;
+
+		if (!*pc_trim(line) || *pc_trim(line) == '#')
+			continue;
+		name = strsep(&line, "|");
+		cmd = strsep(&line, "|");
+		want = strsep(&line, "|");
+		sub = line;
+		if (!cmd)
+			continue;
+		if (n == cap) {
+			cap *= 2;
+			res = xrealloc(res, sizeof(res[0]) * cap);
+		}
+		r = &res[n++];
+		r->name = xstrdup(pc_trim(name));
+		r->want_exit = want ? atoi(pc_trim(want)) : 0;
+		r->got_exit = run_case(pc_trim(cmd), r->out, sizeof(r->out));
+		r->ok = (r->got_exit == r->want_exit);
+		if (r->ok && sub && *pc_trim(sub)) {
+			if (!strstr(r->out, pc_trim(sub))) {
+				r->ok = 0;
+				r->why = xasprintf("missing %s", pc_trim(sub));
+			}
+		} else if (!r->ok) {
+			r->why = xasprintf("exit %d, want %d", r->got_exit, r->want_exit);
+		}
+		if (r->ok)
+			passed++;
+		else
+			failed++;
+	}
+
+	if (json_out) {
+		printf("{\"schema\":1,\"status\":\"%s\",\"total\":%u,\"passed\":%u,"
+				"\"failed\":%u,\"cases\":[",
+				failed ? "error" : "ok", n, passed, failed);
+		for (i = 0; i < n; i++) {
+			if (i)
+				putchar(',');
+			fputs("{\"name\":", stdout);
+			json_str(res[i].name);
+			printf(",\"ok\":%s,\"exit\":%d,\"want_exit\":%d",
+					res[i].ok ? "true" : "false", res[i].got_exit, res[i].want_exit);
+			if (!res[i].ok && res[i].why) {
+				fputs(",\"why\":", stdout);
+				json_str(res[i].why);
+			}
+			putchar('}');
+		}
+		fputs("]}\n", stdout);
+	} else {
+		for (i = 0; i < n; i++) {
+			printf("%s %s", res[i].ok ? "ok  " : "FAIL", res[i].name);
+			if (!res[i].ok && res[i].why)
+				printf(": %s", res[i].why);
+			putchar('\n');
+			if (!res[i].ok && verbose)
+				printf("--- output ---\n%s---\n", res[i].out);
+		}
+		printf("total=%u passed=%u failed=%u\n", n, passed, failed);
+	}
+	fflush_stdout_and_exit(failed ? 1 : 0);
+}
diff --git a/miscutils/doctor.c b/miscutils/doctor.c
new file mode 100644
index 0000000..5b607d5
--- /dev/null
+++ b/miscutils/doctor.c
@@ -0,0 +1,280 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * doctor - report the environment an agent-facing busybox is running in.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config DOCTOR
+//config:	bool "doctor (4 kb)"
+//config:	default y
+//config:	help
+//config:	Report cwd, executable, shell, writable temp storage and the
+//config:	location of a few named tools. Never prints environment values.
+
+//applet:IF_DOCTOR(APPLET(doctor, BB_DIR_USR_BIN, BB_SUID_DROP))
+
+//kbuild:lib-$(CONFIG_DOCTOR) += doctor.o
+
+//usage:#define doctor_trivial_usage
+//usage:       "[-d TOOL,TOOL...] [-F FMT]"
+//usage:#define doctor_full_usage "\n\n"
+//usage:       "Report the runtime environment without dumping secrets"
+//usage:     "\n	-b, --build	Also report toolchain and tree layout"
+//usage:     "\n	-d, --deps LIST	Comma-separated tools to locate"
+//usage:     "\n	-F, --format FMT	text (default) or json"
+
+#if defined(__APPLE__)
+# include <mach-o/dyld.h>
+#endif
+#include "libbb.h"
+
+/* CONFIG_BUSYBOX_EXEC_PATH is "/proc/self/exe" even on Darwin; ask dyld there. */
+static char *self_exe(void)
+{
+#if defined(__APPLE__)
+	uint32_t size = 0;
+	char *buf;
+
+	_NSGetExecutablePath(NULL, &size);
+	buf = xmalloc(size + 1);
+	if (_NSGetExecutablePath(buf, &size) == 0 && buf[0])
+		return buf;
+	free(buf);
+	return NULL;
+#else
+	return realpath("/proc/self/exe", NULL);
+#endif
+}
+
+static void json_write_str(const char *s)
+{
+	putchar('"');
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') {
+			putchar('\\');
+			putchar(c);
+		} else if (c >= 0x20) {
+			putchar(c);
+		}
+	}
+	putchar('"');
+}
+
+/* PATH lookup without executing anything. */
+static char *find_tool(const char *name)
+{
+	const char *path = getenv("PATH");
+	const char *p;
+
+	if (!path)
+		path = "/usr/local/bin:/usr/bin:/bin";
+	p = path;
+	while (p && *p) {
+		const char *colon = strchr(p, ':');
+		size_t len = colon ? (size_t)(colon - p) : strlen(p);
+		char *cand;
+		struct stat st;
+
+		cand = len ? xasprintf("%.*s/%s", (int)len, p, name)
+				: xasprintf("./%s", name);
+		if (stat(cand, &st) == 0 && S_ISREG(st.st_mode)
+		 && (st.st_mode & (S_IXUSR | S_IXGRP | S_IXOTH))) {
+			char *rp = realpath(cand, NULL);
+			if (rp) {
+				free(cand);
+				return rp;
+			}
+			return cand;
+		}
+		free(cand);
+		if (!colon)
+			break;
+		p = colon + 1;
+	}
+	return NULL;
+}
+
+static int tmp_writable(char **pused)
+{
+	const char *t = getenv("TMPDIR");
+	char *template;
+	int fd;
+
+	if (!t || !t[0])
+		t = "/tmp";
+	template = xasprintf("%s/busybox-doctor-XXXXXX", t);
+	fd = mkstemp(template);
+	if (fd < 0) {
+		free(template);
+		return 0;
+	}
+	close(fd);
+	unlink(template);
+	*pused = xasprintf("%s", t);
+	free(template);
+	return 1;
+}
+
+int doctor_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int doctor_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *opt_deps = NULL, *opt_fmt = NULL;
+	unsigned opts;
+	int json = 0, want_build = 0;
+	char *cwd, *exe, *tmpdir = NULL;
+	int tmp_ok;
+	const char *deps;
+
+	static const char doctor_longopts[] ALIGN1 =
+		"build\0"  No_argument       "b"
+		"deps\0"   Required_argument "d"
+		"format\0" Required_argument "F"
+		;
+
+	xfunc_error_retval = 2;
+
+	opts = getopt32long(argv, "bd:F:", doctor_longopts, &opt_deps, &opt_fmt);
+	(void)opts;
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+
+	cwd = getcwd(NULL, 0);
+	exe = self_exe();
+	if (!exe)
+		exe = xstrdup(bb_busybox_exec_path);
+	tmp_ok = tmp_writable(&tmpdir);
+	deps = opt_deps ? opt_deps : "git,make,python3";
+	want_build = (opts & 1) != 0;    /* b */
+
+	if (json) {
+		printf("{\"schema\":1,\"platform\":\"%s\",\"cwd\":",
+#if defined(__APPLE__)
+				"darwin");
+#elif defined(__linux__)
+				"linux");
+#else
+				"unknown");
+#endif
+		json_write_str(cwd ? cwd : "");
+		fputs(",\"exe\":", stdout);
+		json_write_str(exe);
+		printf(",\"shell\":\"%s\"", bb_busybox_exec_path[0] ? "busybox sh" : "sh");
+		printf(",\"tmp\":");
+		if (tmp_ok) {
+			json_write_str(tmpdir);
+		} else
+			fputs("null", stdout);
+		printf(",\"tmp_writable\":%s,\"deps\":{", tmp_ok ? "true" : "false");
+		{
+			char *copy = xstrdup(deps);
+			char *save = copy, *tok;
+			int first = 1;
+
+			while ((tok = strsep(&save, ",")) != NULL) {
+				char *hit;
+
+				while (*tok == ' ')
+					tok++;
+				if (!*tok)
+					continue;
+				hit = find_tool(tok);
+				if (!first)
+					putchar(',');
+				first = 0;
+				json_write_str(tok);
+				putchar(':');
+				if (hit)
+					json_write_str(hit);
+				else
+					fputs("null", stdout);
+				free(hit);
+			}
+			free(copy);
+		}
+		if (want_build) {
+			static const char *const tools[] = {
+				"cc", "clang", "llvm-ar", "llvm-nm", "llvm-strip",
+				"zig", "make", "git", NULL };
+			unsigned i;
+
+			fputs("},\"build\":{\"tools\":{", stdout);
+			for (i = 0; tools[i]; i++) {
+				char *hit = find_tool(tools[i]);
+				if (i)
+					putchar(',');
+				json_write_str(tools[i]);
+				putchar(':');
+				if (hit)
+					json_write_str(hit);
+				else
+					fputs("null", stdout);
+				free(hit);
+			}
+			printf("},\"tree\":{\"src\":%s,\"build\":%s,\"patches\":%s}}",
+					access("src/Makefile", F_OK) == 0 ? "true" : "false",
+					access("build", F_OK) == 0 ? "true" : "false",
+					access("patches", F_OK) == 0 ? "true" : "false");
+		} else {
+			putchar('}');
+		}
+		fputs("}\n", stdout);
+	} else {
+		printf("platform=%s\n",
+#if defined(__APPLE__)
+				"darwin"
+#elif defined(__linux__)
+				"linux"
+#else
+				"unknown"
+#endif
+		);
+		printf("cwd=%s\n", cwd ? cwd : "(unknown)");
+		printf("exe=%s\n", exe);
+		printf("shell=%s\n", "busybox sh");
+		printf("tmp=%s writable=%s\n", tmp_ok ? tmpdir : "(none)",
+				tmp_ok ? "true" : "false");
+		{
+			char *copy = xstrdup(deps);
+			char *save = copy, *tok;
+
+			while ((tok = strsep(&save, ",")) != NULL) {
+				char *hit;
+
+				while (*tok == ' ')
+					tok++;
+				if (!*tok)
+					continue;
+				hit = find_tool(tok);
+				printf("dep=%s path=%s\n", tok, hit ? hit : "-");
+				free(hit);
+			}
+			free(copy);
+		}
+		if (want_build) {
+			static const char *const tools[] = {
+				"cc", "clang", "llvm-ar", "llvm-nm", "llvm-strip",
+				"zig", "make", "git", NULL };
+			unsigned i;
+
+			for (i = 0; tools[i]; i++) {
+				char *hit = find_tool(tools[i]);
+				printf("tool=%s path=%s\n", tools[i], hit ? hit : "-");
+				free(hit);
+			}
+			printf("tree=src:%s build:%s patches:%s\n",
+					access("src/Makefile", F_OK) == 0 ? "yes" : "no",
+					access("build", F_OK) == 0 ? "yes" : "no",
+					access("patches", F_OK) == 0 ? "yes" : "no");
+		}
+	}
+	fflush(stdout);
+	free(cwd);
+	free(exe);
+	free(tmpdir);
+	return 0;
+}
diff --git a/miscutils/patchcheck.c b/miscutils/patchcheck.c
new file mode 100644
index 0000000..c58a89f
--- /dev/null
+++ b/miscutils/patchcheck.c
@@ -0,0 +1,225 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * patchcheck - structural checks on the patches/ series.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+//config:config PATCHCHECK
+//config:	bool "patchcheck (4 kb)"
+//config:	default n
+//config:	help
+//config:	  Sanity-check the patch series without git: numbering gaps,
+//config:	  missing or malformed diff headers, absolute paths, CRLF, and
+//config:	  patches that touch nothing. Exit 1 when any check fails.
+
+//applet:IF_PATCHCHECK(APPLET_NOEXEC(patchcheck, patchcheck_main, BB_DIR_USR_BIN, BB_SUID_DROP, patchcheck))
+
+//kbuild:lib-$(CONFIG_PATCHCHECK) += patchcheck.o
+
+//usage:#define patchcheck_trivial_usage
+//usage:       "[-d DIR] [--format json]"
+//usage:#define patchcheck_full_usage "\n\n"
+//usage:       "Check every *.patch in DIR (default: patches)\n"
+//usage:     "\n	-d DIR	Patch directory"
+//usage:     "\n	--format json	Structured output (schema 1)"
+
+#include "libbb.h"
+
+enum { OPT_FMT = (1 << 0) };
+
+static const char pc_longopts[] ALIGN1 =
+	"dir\0"    Required_argument "d"
+	"format\0" Required_argument "F"
+	;
+#define pc_longopts (pc_longopts)
+
+struct pc_result {
+	const char *name;
+	int bad;
+	char why[128];
+};
+
+static void put_str(const char *s)
+{
+	putchar('"');
+	for (; *s; s++) {
+		if (*s == '"' || *s == '\\')
+			printf("\\%c", *s);
+		else if ((unsigned char)*s < 0x20)
+			printf("\\u%04x", (unsigned char)*s);
+		else
+			putchar(*s);
+	}
+	putchar('"');
+}
+
+/* Returns 1 when the patch looks structurally sound. */
+static int check_one(const char *dir, const char *name, char *why, size_t whysz)
+{
+	char *path = xasprintf("%s/%s", dir, name);
+	char *buf;
+	size_t len;
+	int has_minus = 0, has_plus = 0, has_hunk = 0, bad = 0;
+	const char *p;
+
+	why[0] = '\0';
+	len = (size_t)-1;
+	buf = xmalloc_open_read_close(path, &len);
+	if (!buf) {
+		snprintf(why, whysz, "unreadable");
+		free(path);
+		return 0;
+	}
+	if (*buf == '\0') {
+		snprintf(why, whysz, "empty file");
+		free(buf);
+		free(path);
+		return 0;
+	}
+
+	for (p = buf; *p; ) {
+		const char *eol = strchr(p, '\n');
+		size_t n = eol ? (size_t)(eol - p) : strlen(p);
+
+		if (n >= 4 && p[0] == '-' && p[1] == '-' && p[2] == '-' && p[3] == ' ')
+			has_minus = 1;
+		if (n >= 4 && p[0] == '+' && p[1] == '+' && p[2] == '+' && p[3] == ' ')
+			has_plus = 1;
+		if (n >= 2 && p[0] == '@' && p[1] == '@')
+			has_hunk = 1;
+		if (n > 5 && p[0] == ' ' && memcmp(p, " --- ", 5) == 0) {
+			snprintf(why, whysz, "space before --- header at offset %lu",
+					(unsigned long)(p - buf));
+			bad = 1;
+			break;
+		}
+		if (memchr(p, '\r', n)) {
+			snprintf(why, whysz, "CR at offset %lu", (unsigned long)(p - buf));
+			bad = 1;
+			break;
+		}
+		if (!eol)
+			break;
+		p = eol + 1;
+	}
+	if (!bad && !has_minus) {
+		snprintf(why, whysz, "no '--- ' header");
+		bad = 1;
+	}
+	if (!bad && !has_plus) {
+		snprintf(why, whysz, "no '+++ ' header");
+		bad = 1;
+	}
+	if (!bad && !has_hunk) {
+		snprintf(why, whysz, "no '@@' hunk");
+		bad = 1;
+	}
+	free(buf);
+	free(path);
+	return !bad;
+}
+
+int patchcheck_main_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int patchcheck_main_main(int argc UNUSED_PARAM, char **argv)
+{
+	const char *opt_dir = NULL, *opt_fmt = NULL;
+	struct pc_result *res;
+	DIR *d;
+	struct dirent *de;
+	unsigned n = 0, bad = 0, i, expect = 0;
+	int json_out, rc = 0;
+
+	xfunc_error_retval = 2;
+	getopt32long(argv, "d:F:", pc_longopts, &opt_dir, &opt_fmt);
+	xfunc_error_retval = 1;   /* past option parsing: failures are operational */
+	json_out = opt_fmt && strcmp(opt_fmt, "json") == 0;
+	if (opt_fmt && strcmp(opt_fmt, "json") != 0 && strcmp(opt_fmt, "text") != 0) {
+		bb_error_msg("unknown format %s", opt_fmt);
+		return 2;
+	}
+	opt_dir = opt_dir ? opt_dir : "patches";
+
+	d = opendir(opt_dir ? opt_dir : "patches");
+	if (!d) {
+		if (json_out) {
+			int e = errno;
+
+			printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\","
+					"\"message\":");
+			put_str(strerror(e));
+			fputs(",\"dir\":", stdout);
+			put_str(opt_dir);
+			fputs("}\n", stdout);
+		} else {
+			printf("NOT_FOUND %s\n", opt_dir);
+		}
+		return 1;
+	}
+	res = xzalloc(sizeof(res[0]) * 256);
+	while ((de = readdir(d)) != NULL) {
+		size_t nl = strlen(de->d_name);
+
+		if (nl < 6 || strcmp(de->d_name + nl - 6, ".patch") != 0)
+			continue;
+		if (n == 256)
+			break;
+		res[n].name = xstrdup(de->d_name);
+		res[n].bad = !check_one(opt_dir, de->d_name, res[n].why, sizeof(res[n].why));
+		if (res[n].bad)
+			bad++;
+		n++;
+	}
+	closedir(d);
+
+	/* order by name so the numbering pass sees 0001, 0002, … */
+	for (i = 1; i < n; i++) {
+		struct pc_result tmp = res[i];
+		unsigned j = i;
+
+		while (j > 0 && strcmp(res[j - 1].name, tmp.name) > 0) {
+			res[j] = res[j - 1];
+			j--;
+		}
+		res[j] = tmp;
+	}
+	for (i = 0; i < n; i++) {
+		unsigned num = 0;
+		if (sscanf(res[i].name, "%04u-", &num) == 1) {
+			expect++;
+			if (num != expect) {
+				res[i].bad = 1;
+				snprintf(res[i].why, sizeof(res[i].why), "numbering gap: expected %04u", expect);
+				bad++;
+				expect = num;
+			}
+		}
+	}
+
+	if (json_out) {
+		printf("{\"schema\":1,\"status\":\"%s\",\"dir\":", bad ? "error" : "ok");
+		put_str(opt_dir);
+		printf(",\"count\":%u,\"bad\":%u,\"patches\":[", n, bad);
+		for (i = 0; i < n; i++) {
+			if (i)
+				putchar(',');
+			fputs("{\"name\":", stdout);
+			put_str(res[i].name);
+			printf(",\"ok\":%s", res[i].bad ? "false" : "true");
+			if (res[i].bad) {
+				fputs(",\"why\":", stdout);
+				put_str(res[i].why);
+			}
+			putchar('}');
+		}
+		fputs("]}\n", stdout);
+	} else {
+		for (i = 0; i < n; i++)
+			printf("%s %s%s%s\n", res[i].bad ? "BAD " : "ok  ",
+					res[i].name,
+					res[i].bad ? ": " : "",
+					res[i].bad ? res[i].why : "");
+		printf("checked=%u bad=%u\n", n, bad);
+	}
+	rc = bad ? 1 : 0;
+	fflush_stdout_and_exit(rc);
+}

+ * canonicalize a file they are about to create.
+ */
+static char *pop_last_component(const char *abs)
+{
+	char *s = xstrdup(abs);
+	char *p = strrchr(s, '/');
+	if (!p || p == s) {
+		free(s);
+		return xstrdup("/");
+	}
+	*p = '\0';
+	return s;
+}
+
+static char *canon_missing(const char *path)
+{
+	char *res;
+	const char *base;
+	char *dir, *dirres, *out;
+	unsigned len;
+
+	res = xmalloc_realpath_coreutils((char *)path);
+	if (res)
+		return res;
+
+	base = bb_basename(path);
+	if (base == path) {
+		/* single relative component: anchor at the current directory */
+		char *cwd = getcwd(NULL, 0);
+		if (!cwd)
+			bb_perror_msg_and_die("getcwd");
+		char *full = concat_path_file(cwd, path);
+		free(cwd);
+		res = canon_missing(full);
+		free(full);
+		return res;
+	}
+
+	len = (unsigned)(base - path); /* includes the '/' before base */
+	dir = xasprintf("%.*s", (int)(len - 1), path);
+	if (!dir[0]) {
+		free(dir);
+		dir = xstrdup("/");
+	}
+	dirres = canon_missing(dir);
+	free(dir);
+
+	if (strcmp(base, ".") == 0)
+		return dirres;
+	if (strcmp(base, "..") == 0) {
+		out = pop_last_component(dirres);
+		free(dirres);
+		return out;
+	}
+	out = concat_path_file(dirres, base);
+	free(dirres);
+	return out;
+}
+
+/* Print TO relative to FROM. Both are absolute paths. */
+static char *rel_path(const char *from, const char *to)
+{
+	char *fbuf = xstrdup(from);
+	char *tbuf = xstrdup(to);
+	char *fp[128], *tp[128];
+	unsigned nf = 0, nt = 0, i;
+	char *tok, *next, *out;
+
+	for (tok = fbuf; tok && *tok && nf < ARRAY_SIZE(fp); tok = next) {
+		next = strchr(tok, '/');
+		if (next)
+			*next++ = '\0';
+		if (*tok)
+			fp[nf++] = tok;
+	}
+	for (tok = tbuf; tok && *tok && nt < ARRAY_SIZE(tp); tok = next) {
+		next = strchr(tok, '/');
+		if (next)
+			*next++ = '\0';
+		if (*tok)
+			tp[nt++] = tok;
+	}
+	for (i = 0; i < nf && i < nt && strcmp(fp[i], tp[i]) == 0; i++)
+		continue;

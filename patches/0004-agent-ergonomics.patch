+static int tl_stats(const char *root, const char *run, struct tlstat *st, long *duration_ms)
+{
+	char *dir = xasprintf("%s/%s", root, run);
+	char *path = art_path(dir, "timeline");
+	char *meta = art_path(dir, "meta");
+	char *data = NULL, *m = NULL;
+	size_t len = 0, mlen = 0, *starts;
+	unsigned nlines = 0, i;
+
+	memset(st, 0, sizeof(*st));
+	st->first_out = st->first_err = -1;
+	*duration_ms = 0;
+	if (read_all(path, &data, &len) != 0) {
+		free(dir); free(path); free(meta);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us, prev = 0;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		st->lines++;
+		if (is_err) {
+			st->err_lines++;
+			if (st->first_err < 0)
+				st->first_err = us;
+		} else if (st->first_out < 0) {
+			st->first_out = us;
+		}
+		if (i) {
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+			int pe;
+
+			prev = pl ? stamp_us(data + starts[i - 1], pl, &pe) : 0;
+			if (us - prev > st->gap_us) {
+				st->gap_us = us - prev;
+				st->gap_from = prev;
+			}
+		}
+	}
+	if (read_all(meta, &m, &mlen) == 0) {
+		char *d = strstr(m, "duration_ms=");
+
+		if (d)
+			*duration_ms = strtol(d + 12, NULL, 10);
+	}
+	free(starts);
+	free(data);
+	free(m);
+	free(dir);
+	free(path);
+	free(meta);
+	return 0;
+}

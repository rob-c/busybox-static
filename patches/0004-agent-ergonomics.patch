+/* The closed vocabulary of BUSYBOX-CONTRACT.md, plus the errno cases that
+ * carry a distinct meaning for a caller. Anything unmapped is FAILED: an id
+ * that might be wrong would be worse than one that says "something failed". */
+static const char *code_for_errno(int e)
+{
+	switch (e) {
+	case ENOENT:      return "NOT_FOUND";
+	case EACCES:
+	case EPERM:       return "PERMISSION";
+	case EINVAL:      return "INVALID_ARGUMENT";
+	case EEXIST:      return "EXISTS";
+	case ENOSPC:      return "NO_SPACE";
+	case ETIMEDOUT:   return "TIMEOUT";
+	case EISDIR:      return "IS_DIR";
+	case ENOTDIR:     return "NOT_DIR";
+	case ELOOP:       return "SYMLINK_LOOP";
+	case EINTR:       return "INTERRUPTED";
+	case EPIPE:       return "BROKEN_PIPE";
+	case ENAMETOOLONG:return "NAME_TOO_LONG";
+	case EBUSY:       return "BUSY";
+	case EMFILE:
+	case ENFILE:      return "TOO_MANY_FILES";
+	case ENOMEM:      return "NO_MEMORY";
+	case EAGAIN:      return "WOULD_BLOCK";
+	case ESRCH:       return "NOT_FOUND";
+	case ENOSYS:
+	case EOPNOTSUPP:  return "UNSUPPORTED";
+	case EROFS:       return "READ_ONLY";
+	case ENOTEMPTY:   return "NOT_EMPTY";
+	case ECHILD:      return "NO_CHILD";
+	case ENOEXEC:     return "NOT_EXECUTABLE";
+	case ERANGE:
+	case EOVERFLOW:   return "OUT_OF_RANGE";
+	case E2BIG:       return "TOO_LARGE";
+	case EXDEV:       return "CROSS_DEVICE";
+	}
+	return "FAILED";
+}
+
+/* Called on the few diagnostic paths that need ids. It re-formats rather than
+ * reusing the fast path above: ids are off by default and never on a hot path,
+ * so the default output must stay exactly as it was. */
+static void emit_with_ids(const char *s, va_list p, const char *strerr)
+{
+	char *body, *line;
+	const char *code;
+	int channel, n;
+
+	if (vasprintf(&body, s, p) < 0)
+		return;
+	channel = (strncmp(body, "warning", 7) == 0) ? 'W' : 'E';
+	code = bb_error_code;
+	if (!code)
+		code = bb_perror_errno ? code_for_errno(bb_perror_errno)
+		     : (channel == 'W' ? "WARN" : "FAILED");
+
+	/* stderr: the full message with the id in front of it */
+	n = asprintf(&line, "%s: %s: %s%s%s%s", applet_name, code, body,
+			strerr ? ": " : "", strerr ? strerr : "", msg_eol);
+	if (n >= 0) {
+		fflush_all();
+		full_write(STDERR_FILENO, line, (size_t)n);
+		free(line);
+	}
+	/* stdout: the id alone, so a reader never parses prose */
+	n = asprintf(&line, "%c %s\n", channel, code);
+	if (n >= 0) {
+		full_write(STDOUT_FILENO, line, (size_t)n);
+		free(line);
+		bb_error_ids_sent = 1;
+	}
+	free(body);
+}
+
+/* A diagnostic id is enabled by the environment, so an applet symlink or a
+ * plain shell invocation gets it too. Looked up once. */
+void bb_error_ids_init(void)
+{
+	const char *v;
+
+	if (bb_error_ids)
+		return;
+	v = getenv("BUSYBOX_ERROR_IDS");
+	if (v && v[0] && strcmp(v, "0") != 0)
+		bb_error_ids = 1;
+}
+
 void FAST_FUNC bb_verror_msg(const char *s, va_list p, const char* strerr)
 {
 	char *msg, *msg1;
@@ -26,6 +119,14 @@ void FAST_FUNC bb_verror_msg(const char *s, va_list p, const char* strerr)
 	if (!logmode)
 		return;
 
+	bb_error_ids_init();
+	if (bb_error_ids) {
+		emit_with_ids(s, p, strerr);
+		bb_perror_errno = 0;
+		bb_error_code = NULL;
+		return;
+	}
+
 	applet_len = strlen(applet_name) + 2; /* "applet: " */
 	strerr_len = strerr ? strlen(strerr) : 0;
 	msgeol_len = strlen(msg_eol);
diff --git a/miscutils/bench.c b/miscutils/bench.c

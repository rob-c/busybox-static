+/*
+ * Darwin has no /proc.  KERN_PROC_ALL gives one struct kinfo_proc per pid;
+ * KERN_PROCARGS2 gives "int argc, exec path, argv[0..argc-1], environment".
+ *
+ * Three rules learned the hard way (docs/gotchas/darwin-procps-*):
+ *  1. the iteration cursor cannot live in procps_status_t - callers memset it
+ *     per process, so the snapshot lives in a file-static iterator;
+ *  2. the argv walk must be bounded by argc AND by a byte cap AND must stop at
+ *     a "KEY=value" string, because for some processes the reported argc
+ *     overruns into the environment, which then shows up as PATH=... in ps and
+ *     makes killall match the wrong pids;
+ *  3. macOS puts the interpreter in p_comm for scripts, with the script path in
+ *     argv[1], so name matching has to look at the argv list.
+ */
+#include <sys/sysctl.h>
+#include <sys/proc.h>
+#include <libproc.h>	/* proc_pidinfo for CPU time and memory */
+
+#define DARWIN_ARGV_MAX_ARGS 24
+#define DARWIN_ARGV_MAX_BYTES 1024
+
+static struct {
+	struct kinfo_proc *procs;
+	int count;
+	int idx;
+} darwin_it;
+
+static void darwin_stop_iter(void)
+{
+	free(darwin_it.procs);
+	darwin_it.procs = NULL;
+	darwin_it.count = 0;
+	darwin_it.idx = 0;
+}
+
+static int darwin_start_iter(void)
+{
+	int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_ALL, 0 };
+	size_t size = 0;
+
+	darwin_stop_iter();
+	if (sysctl(mib, 4, NULL, &size, NULL, 0) != 0 || size == 0)
+		return 0;
+	size += 64 * sizeof(struct kinfo_proc);
+	darwin_it.procs = xmalloc(size);
+	if (sysctl(mib, 4, darwin_it.procs, &size, NULL, 0) != 0) {
+		darwin_stop_iter();
+		return 0;
+	}
+	darwin_it.count = (int)(size / sizeof(struct kinfo_proc));
+	darwin_it.idx = 0;
+	return darwin_it.count > 0;
+}
+
+/* Copy argv[0..] into a fresh buffer, never reaching the environment. */
+static void darwin_fill_argv(procps_status_t *sp, unsigned pid)
+{
+	int mib[3] = { CTL_KERN, KERN_PROCARGS2, (int)pid };
+	size_t size = 0;
+	char *buf, *q, *end, *argv0, *walk;
+	int argc, n;
+	size_t len;
+
+	if (sp->argv0) {
+		free(sp->argv0);
+		sp->argv0 = NULL;
+		sp->argv_len = 0;
+	}
+	if (sysctl(mib, 3, NULL, &size, NULL, 0) != 0 || size < sizeof(int) + 4)
+		return;
+	buf = xmalloc(size);
+	if (sysctl(mib, 3, buf, &size, NULL, 0) != 0) {
+		free(buf);
+		return;
+	}
+	memcpy(&argc, buf, sizeof(int));
+	if (argc <= 0) {
+		free(buf);
+		return;
+	}
+	q = buf + sizeof(int);
+	end = buf + size;
+	while (q < end && *q)        /* exec path */
+		q++;
+	while (q < end && !*q)       /* padding to argv[0] */
+		q++;
+	if (q >= end) {
+		free(buf);
+		return;
+	}
+
+	argv0 = q;
+	walk = q;
+	n = 0;
+	while (walk < end && n < argc && n < DARWIN_ARGV_MAX_ARGS
+	    && (size_t)(walk - argv0) < DARWIN_ARGV_MAX_BYTES
+	) {
+		char *str = walk;
+		size_t slen;
+
+		while (walk < end && *walk)
+			walk++;
+		if (walk >= end)
+			break;              /* unterminated: stop here */
+		slen = (size_t)(walk - str);
+		/* environment entries look like KEY=value; argv entries do not. Rewind
+		 * before breaking: that string belongs to the environment. */
+		if (n > 0 && memchr(str, '=', slen) != NULL
+		 && !(slen > 1 && (str[0] == '-' || str[0] == '/' || str[0] == '.'))
+		) {
+			walk = str;
+			break;
+		}
+		n++;
+		walk++;                     /* past this string's NUL */
+		while (walk < end && !*walk) /* NUL padding between args */
+			walk++;
+	}
+	len = (size_t)(walk - argv0);
+	if (len == 0) {
+		free(buf);
+		return;
+	}
+	/* do not keep the padding that follows the last argument */
+	while (len > 1 && argv0[len - 1] == '\0')
+		len--;
+	if (len > 0xfffe)
+		len = 0xfffe;
+	memmove(buf, argv0, len);
+	buf[len] = '\0';
+	sp->argv0 = buf;
+	sp->argv_len = (uint16_t)len;
+}
+
+static procps_status_t* FAST_FUNC alloc_procps_scan(void)
+{
+	return xzalloc(sizeof(procps_status_t));
+}
+
+void FAST_FUNC free_procps_scan(procps_status_t* sp)
+{
+	if (!sp)
+		return;
+	free(sp->argv0);
+	free(sp->exe);
+	free(sp);
+	darwin_stop_iter();
+}
+
+procps_status_t* FAST_FUNC procps_scan(procps_status_t* sp, int flags)
+{
+	const struct kinfo_proc *kp;
+
+	if (!sp)
+		sp = alloc_procps_scan();
+	if (!darwin_it.procs && !darwin_start_iter()) {
+		free_procps_scan(sp);
+		return NULL;
+	}
+	if (darwin_it.idx >= darwin_it.count) {
+		free_procps_scan(sp);
+		return NULL;
+	}
+	kp = &darwin_it.procs[darwin_it.idx++];
+
+	sp->pid = kp->kp_proc.p_pid;
+	sp->ppid = kp->kp_eproc.e_ppid;
+	sp->pgid = kp->kp_eproc.e_pgid;
+	sp->sid = (unsigned)(uintptr_t)kp->kp_eproc.e_sess;
+	sp->uid = kp->kp_eproc.e_ucred.cr_uid;
+	sp->gid = kp->kp_eproc.e_ucred.cr_gid;
+	/* Same caveat as the PROC_PIDTBSDINFO branch below: p_stat==2 covers both
+	 * running and sleeping processes on macOS, and /bin/ps renders those as S.
+	 * This path is used when proc_pidinfo() is refused (other users' pids). */
+	switch (kp->kp_proc.p_stat) {
+	case 1: case 2: sp->state[0] = 'S'; break;
+	case 3: sp->state[0] = 'S'; break;
+	case 4: sp->state[0] = 'T'; break;
+	case 5: sp->state[0] = 'Z'; break;
+	default: sp->state[0] = '?'; break;
+	}
+	sp->state[1] = '\0';
+	safe_strncpy(sp->comm, kp->kp_proc.p_comm, COMM_LEN);
+	sp->exe = NULL;
+	/* CPU time and memory: kinfo_proc carries neither, but libproc does.
+	 * pti_total_* is nanoseconds, so convert to the clock-tick units that
+	 * top/ps expect (bb_clk_tck() is 100 on macOS); rss/vsz come in bytes
+	 * and are reported in KB, matching what Linux ps/top print. */
+	{
+		struct proc_taskinfo pti;
+		struct proc_bsdinfo pbi;
+		if (proc_pidinfo(sp->pid, PROC_PIDTASKINFO, 0, &pti, sizeof(pti)) == sizeof(pti)) {
+			unsigned hz = bb_clk_tck();
+			unsigned long long tick_ns = 1000000000ULL / (hz ? hz : 100);
+			sp->utime = (unsigned long)(pti.pti_total_user / tick_ns);
+			sp->stime = (unsigned long)(pti.pti_total_system / tick_ns);
+			sp->rss = (unsigned long)(pti.pti_resident_size >> 10);
+			sp->vsz = (unsigned long)(pti.pti_virtual_size >> 10);
+		}
+		/* kinfo_proc.p_stat reports SRUN for almost every process on modern
+		 * macOS, so top showed every process as "R".  PROC_PIDTBSDINFO
+		 * carries the real state. */
+		if (proc_pidinfo(sp->pid, PROC_PIDTBSDINFO, 0, &pbi, sizeof(pbi)) == sizeof(pbi)) {
+			/* macOS reports SRUN (2) for a sleeping process AND for one burning a
+			 * core, so the field cannot distinguish them (measured: p_stat==2
+			 * and pbi_status==2 for both).  /bin/ps prints S for those, so
+			 * follow the platform instead of calling every process running. */
+			switch (pbi.pbi_status) {
+			case 1: sp->state[0] = 'I'; break; /* SIDL  */
+			case 2: sp->state[0] = 'S'; break; /* SRUN (indistinguishable) */
+			case 3: sp->state[0] = 'S'; break; /* SSLEEP*/
+			case 4: sp->state[0] = 'T'; break; /* SSTOP */
+			case 5: sp->state[0] = 'Z'; break; /* SZOMB */
+			default: sp->state[0] = '?'; break;
+			}
+		}
+	}
+	/* always: ps needs it for COMMAND, pgrep -f for matching, and
+	 * killall/pidof ask with PSSCAN_ARGVN (a separate 1<<16 bit) */
+	(void)flags;
+	darwin_fill_argv(sp, sp->pid);
+	/* ps -o exe and lsof want the executable path; argv[0] is the closest
+	 * Darwin offers without proc_pidpath() per process */
+	if (sp->argv0 && sp->argv0[0])
+		sp->exe = xstrdup(sp->argv0);
+	return sp;
+}
+
+int FAST_FUNC read_cmdline(char *buf, int col, unsigned pid, const char *comm)
+{
+	procps_status_t sp;
+	int len;
+
+	memset(&sp, 0, sizeof(sp));
+	(void)comm;
+	darwin_fill_argv(&sp, pid);
+	if (!sp.argv0)
+		return -1;
+	len = (int)sp.argv_len;
+	if (len > col - 1)
+		len = col - 1;
+	memcpy(buf, sp.argv0, len);
+	buf[len] = '\0';
+	while (--len > 0)             /* argv strings are NUL separated */
+		if (buf[len] == '\0')
+			buf[len] = ' ';
+	free(sp.argv0);
+	return 0;
+}
+#endif /* __APPLE__ */
+

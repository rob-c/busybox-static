+/* sha256 over the argv (NUL-separated) and the start cwd, so two runs that
+ * differ only in arguments or directory hash differently. */
+static void run_inputs_hash(char **argv, const char *cwd, char *out65)
+{
+	sha256_ctx_t ctx;
+	unsigned char dig[32];
+	int i, k;
+
+	sha256_begin(&ctx);
+	for (i = 0; argv[i]; i++) {
+		sha256_hash(&ctx, argv[i], strlen(argv[i]));
+		sha256_hash(&ctx, "", 1);
+	}
+	sha256_hash(&ctx, cwd ? cwd : "", cwd ? strlen(cwd) : 0);
+	sha256_end(&ctx, (char *)dig);
+	for (k = 0; k < 32; k++)
+		sprintf(out65 + k * 2, "%02x", dig[k]);
+	out65[64] = '\0';
+}

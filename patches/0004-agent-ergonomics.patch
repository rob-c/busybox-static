+/* First N and last N lines of a stream: the digest for output brief cannot reduce. */
+static int dump_sample(const char *dir, const char *label, long want,
+		size_t budget, int json)
+{
+	char *path = art_path(dir, label);
+	char *data = NULL;
+	size_t len = 0, *starts, printed = 0;
+	unsigned nlines = 0, i, head, tail;
+
+	if (read_all(path, &data, &len) != 0) {
+		if (json)
+			printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"error\","
+					"\"code\":\"NOT_FOUND\",\"message\":\"run not found or stream missing\"}", label);
+		else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+	head = ((unsigned)want < nlines) ? (unsigned)want : nlines;
+	tail = (nlines > head && (nlines - head) > (unsigned)want) ? (unsigned)want : (nlines - head);
+
+	if (json)
+		printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"ok\",\"lines\":[", label);
+	for (i = 0; i < head; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+
+		if (json) {
+			fputs(i ? "," : "", stdout);
+			json_write_str(xstrndup(data + starts[i], l));
+		} else {
+			fwrite(data + starts[i], 1, l, stdout);
+			putchar('\n');
+		}
+		printed += l;
+	}
+	if (json)
+		printf("],\"omitted\":%u,\"tail\":[", nlines - head - tail);
+	for (i = nlines - tail; tail && i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+
+		if (json) {
+			fputs(i == nlines - tail ? "" : ",", stdout);
+			json_write_str(xstrndup(data + starts[i], l));
+		} else {
+			fwrite(data + starts[i], 1, l, stdout);
+			putchar('\n');
+		}
+		printed += l;
+	}
+	if (json)
+		printf("],\"shown_bytes\":%u,\"truncated\":%s}", (unsigned)printed,
+				(nlines > head + tail) ? "true" : "false");
+	free(starts);
+	free(data);
+	fflush(stdout);
+	return 0;
+}

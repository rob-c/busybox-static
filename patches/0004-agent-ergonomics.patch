diff --git a/networking/ifconfig.c b/networking/ifconfig.c
index 32638e2..591298b 100644
--- a/networking/ifconfig.c
+++ b/networking/ifconfig.c
@@ -96,6 +96,310 @@
 //usage:       "	[up|down] ..."
 
 #include "libbb.h"
+
+#if defined(__APPLE__)
+/*
+ * Darwin port.  Everything after the #else is the Linux rtnetlink/ioctl
+ * implementation, which cannot compile here (no ifr_netmask / ifr_ifindex /
+ * ifr_hwaddr, no SIOCGIFINDEX).
+ *
+ * Listing lives in display_interfaces() (networking/interface.c, getifaddrs).
+ * Setting uses the BSD ioctl family, all of which the SDK provides:
+ *
+ *   up/down        SIOCSIFFLAGS      (read-modify-write of ifr_flags)
+ *   mtu N          SIOCSIFMTU
+ *   addr[/pfx]     SIOCSIFADDR + SIOCSIFNETMASK   (in place)
+ *   alias addr     SIOCAIFADDR                    (add secondary)
+ *   -alias addr    SIOCDIFADDR                    (remove secondary)
+ *   netmask M      SIOCSIFNETMASK
+ *   broadcast B    SIOCSIFBRDADDR
+ *   pointopoint P  SIOCSIFDSTADDR
+ *   hw ether MAC   SIOCSIFLLADDR     (sockaddr_dl in ifr_addr)
+ *
+ * All of it needs root; unprivileged calls fail with EPERM, exactly as the
+ * Linux build does.
+ */
+#include <sys/sockio.h>
+#include <net/if_dl.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+
+static int darwin_ifreq_sock(void)
+{
+	int s = socket(AF_INET, SOCK_DGRAM, 0);
+	if (s < 0)
+		bb_simple_perror_msg_and_die("socket");
+	return s;
+}
+
+/* Fill ifr_name on a fresh ifreq */
+static void darwin_ifr_init(struct ifreq *ifr, const char *name)
+{
+	memset(ifr, 0, sizeof(*ifr));
+	strncpy(ifr->ifr_name, name, IFNAMSIZ - 1);
+}
+
+static void darwin_ifr_addr(struct ifreq *ifr, const char *addr, int *prefix)
+{
+	struct sockaddr_in *sin = (struct sockaddr_in *)&ifr->ifr_addr;
+	char *slash;
+	char buf[64];
+	int plen = -1;
+
+	safe_strncpy(buf, addr, sizeof(buf));
+	slash = strchr(buf, '/');
+	if (slash) {
+		*slash = '\0';
+		plen = xatoi_positive(slash + 1);
+	}
+	memset(sin, 0, sizeof(*sin));
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	if (inet_pton(AF_INET, buf, &sin->sin_addr) != 1)
+		bb_error_msg_and_die("invalid address: %s", buf);
+	if (prefix)
+		*prefix = plen;
+}
+
+static void darwin_ifr_mask(struct ifreq *ifr, int prefix)
+{
+	struct sockaddr_in *sin = (struct sockaddr_in *)&ifr->ifr_addr;
+	uint32_t m = prefix <= 0 ? 0 : (prefix >= 32 ? 0xffffffffU : (0xffffffffU << (32 - prefix)));
+
+	memset(sin, 0, sizeof(*sin));
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = htonl(m);
+}
+
+/* An alias needs struct ifaliasreq (address + netmask + broadcast together) */
+static void darwin_alias(int s, const char *name, const char *addr, int add)
+{
+	struct ifaliasreq ifra;
+	struct sockaddr_in *sin;
+	char buf[64];
+	int prefix = -1;
+
+	memset(&ifra, 0, sizeof(ifra));
+	strncpy(ifra.ifra_name, name, IFNAMSIZ - 1);
+
+	safe_strncpy(buf, addr, sizeof(buf));
+	{
+		char *slash = strchr(buf, '/');
+		if (slash) {
+			*slash = '\0';
+			prefix = xatoi_positive(slash + 1);
+		}
+	}
+
+	sin = (struct sockaddr_in *)&ifra.ifra_addr;
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	if (inet_pton(AF_INET, buf, &sin->sin_addr) != 1)
+		bb_error_msg_and_die("invalid address: %s", buf);
+
+	sin = (struct sockaddr_in *)&ifra.ifra_mask;
+	{
+		uint32_t m = prefix <= 0 ? 0xffffffffU
+			: (prefix >= 32 ? 0xffffffffU : (0xffffffffU << (32 - prefix)));
+		sin->sin_len = sizeof(*sin);
+		sin->sin_family = AF_INET;
+		sin->sin_addr.s_addr = htonl(m);
+	}
+
+	if (ioctl(s, add ? SIOCAIFADDR : SIOCDIFADDR, &ifra) < 0)
+		bb_perror_msg_and_die("%s %s on %s", add ? "can't add" : "can't delete",
+				buf, name);
+}
+
+static void darwin_set_hwaddr(int s, const char *name, const char *mac)
+{
+	struct ifreq ifr;
+	struct sockaddr_dl *sdl;
+	unsigned b[6];
+	int i;
+
+	darwin_ifr_init(&ifr, name);
+	/* ifr_addr is only 16 bytes (SOCKADDR size); sizeof(sockaddr_dl) is 20,
+	 * so size the structure to just the MAC bytes or the write overruns. */
+	sdl = (struct sockaddr_dl *)&ifr.ifr_addr;
+	memset(&ifr.ifr_addr, 0, sizeof(ifr.ifr_addr));
+	sdl->sdl_len = offsetof(struct sockaddr_dl, sdl_data) + 6;
+	sdl->sdl_family = AF_LINK;
+	sdl->sdl_alen = 6;
+	if (sscanf(mac, "%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6)
+		bb_error_msg_and_die("invalid MAC address: %s", mac);
+	for (i = 0; i < 6; i++)
+		sdl->sdl_data[i] = (unsigned char)b[i];
+	if (ioctl(s, SIOCSIFLLADDR, &ifr) < 0)
+		bb_perror_msg_and_die("can't set MAC address on %s", name);
+}
+
+int ifconfig_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int ifconfig_main(int argc UNUSED_PARAM, char **argv)
+{
+	const char *name;
+	int s;
+	int do_up = -1;         /* -1 unset, 1 up, 0 down */
+	const char *set_addr = NULL;
+	const char *set_alias = NULL;
+	const char *del_alias = NULL;
+	const char *set_mask = NULL;
+	const char *set_bcast = NULL;
+	const char *set_dst = NULL;
+	const char *set_mac = NULL;
+	int set_mtu = -1;
+	int prefix = -1;
+
+	++argv;
+	if (argv[0] && argv[0][0] == '-' && argv[0][1] == 'a' && !argv[0][2])
+		++argv;
+	if (!argv[0])
+		return display_interfaces(IFNAME_SHOW_DOWNED_TOO);
+
+	name = argv[0];
+	if (!argv[1])
+		return display_interfaces((char *)name);
+
+	/* ---- parse the rest ---- */
+	argv++;
+	while (*argv) {
+		const char *kw = *argv++;
+
+		if (strcmp(kw, "up") == 0) {
+			do_up = 1;
+		} else if (strcmp(kw, "down") == 0) {
+			do_up = 0;
+		} else if (strcmp(kw, "mtu") == 0) {
+			if (!*argv) bb_show_usage();
+			set_mtu = xatoi_positive(*argv++);
+		} else if (strcmp(kw, "netmask") == 0) {
+			if (!*argv) bb_show_usage();
+			set_mask = *argv++;
+		} else if (strcmp(kw, "broadcast") == 0) {
+			if (!*argv) bb_show_usage();
+			set_bcast = *argv++;
+		} else if (strcmp(kw, "pointopoint") == 0) {
+			if (!*argv) bb_show_usage();
+			set_dst = *argv++;
+		} else if (strcmp(kw, "alias") == 0) {
+			if (!*argv) bb_show_usage();
+			set_alias = *argv++;
+		} else if (strcmp(kw, "-alias") == 0) {
+			if (!*argv) bb_show_usage();
+			del_alias = *argv++;
+		} else if (strcmp(kw, "hw") == 0) {
+			if (!*argv) bb_show_usage();
+			if (strcmp(*argv, "ether") != 0)
+				bb_error_msg_and_die("only 'hw ether' is supported on Darwin");
+			argv++;
+			if (!*argv) bb_show_usage();
+			set_mac = *argv++;
+		} else if (strcmp(kw, "media") == 0) {
+			/* accepted but not applied; SIOCSIFMEDIA needs media words */
+			while (*argv && strcmp(*argv, "up") && strcmp(*argv, "down"))
+				argv++;
+		} else if (isdigit((unsigned char)kw[0])) {
+			set_addr = kw;
+		} else {
+			bb_error_msg_and_die("unsupported option on Darwin: %s", kw);
+		}
+	}
+
+	s = darwin_ifreq_sock();
+
+	if (set_mac)
+		darwin_set_hwaddr(s, name, set_mac);
+	if (set_alias)
+		darwin_alias(s, name, set_alias, 1);
+	if (del_alias)
+		darwin_alias(s, name, del_alias, 0);
+
+	if (set_addr) {
+		struct ifreq ifr;
+
+		darwin_ifr_init(&ifr, name);
+		darwin_ifr_addr(&ifr, set_addr, &prefix);
+		if (ioctl(s, SIOCSIFADDR, &ifr) < 0)
+			bb_perror_msg_and_die("can't set address on %s", name);
+	}
+
+	if (set_mask || prefix >= 0) {
+		struct ifreq ifr;
+
+		darwin_ifr_init(&ifr, name);
+		{
+			darwin_ifr_init(&ifr, name);
+			if (set_mask) {
+				struct sockaddr_in *sin = (struct sockaddr_in *)&ifr.ifr_addr;
+				sin->sin_len = sizeof(*sin);
+				sin->sin_family = AF_INET;
+				if (inet_pton(AF_INET, set_mask, &sin->sin_addr) != 1)
+					bb_error_msg_and_die("invalid netmask: %s", set_mask);
+			} else {
+				darwin_ifr_mask(&ifr, prefix);
+			}
+			if (ioctl(s, SIOCSIFNETMASK, &ifr) < 0)
+				bb_perror_msg_and_die("can't set netmask on %s", name);
+		}
+	}
+
+	if (set_bcast) {
+		struct ifreq ifr;
+		struct sockaddr_in *sin;
+
+		darwin_ifr_init(&ifr, name);
+		sin = (struct sockaddr_in *)&ifr.ifr_addr;
+		sin->sin_len = sizeof(*sin);
+		sin->sin_family = AF_INET;
+		if (inet_pton(AF_INET, set_bcast, &sin->sin_addr) != 1)
+			bb_error_msg_and_die("invalid broadcast: %s", set_bcast);
+		if (ioctl(s, SIOCSIFBRDADDR, &ifr) < 0)
+			bb_perror_msg_and_die("can't set broadcast on %s", name);
+	}
+
+	if (set_dst) {
+		struct ifreq ifr;
+		struct sockaddr_in *sin;
+
+		darwin_ifr_init(&ifr, name);
+		sin = (struct sockaddr_in *)&ifr.ifr_addr;
+		sin->sin_len = sizeof(*sin);
+		sin->sin_family = AF_INET;
+		if (inet_pton(AF_INET, set_dst, &sin->sin_addr) != 1)
+			bb_error_msg_and_die("invalid peer address: %s", set_dst);
+		if (ioctl(s, SIOCSIFDSTADDR, &ifr) < 0)
+			bb_perror_msg_and_die("can't set pointopoint on %s", name);
+	}
+
+	if (set_mtu > 0) {
+		struct ifreq ifr;
+
+		darwin_ifr_init(&ifr, name);
+		ifr.ifr_mtu = set_mtu;
+		if (ioctl(s, SIOCSIFMTU, &ifr) < 0)
+			bb_perror_msg_and_die("can't set mtu on %s", name);
+	}
+
+	if (do_up >= 0) {
+		struct ifreq ifr;
+

+/*
+ * Darwin port: there is no /sys/block, so devices come from the IOKit
+ * IOMedia tree, and mountpoints from getmntinfo(3) (already wrapped by
+ * libbb/mntent.c for df and mount).
+ *
+ * IOKit properties used:
+ *   kIOBSDNameKey  -> "disk0", "disk0s1" ...
+ *   kIOMediaSizeKey-> byte size            (sectors = size >> 9)
+ *   kIOMediaWholeKey-> true for a whole disk, false for a partition
+ * MAJ:MIN has no meaning here, so that column prints "-" and the rest of the
+ * layout matches util-linux / busybox on Linux.
+ */
+static unsigned long long cf_ull_prop(io_object_t obj, CFStringRef key)
+{
+	CFTypeRef v = IORegistryEntryCreateCFProperty(obj, key, kCFAllocatorDefault, 0);
+	unsigned long long out = 0;
+
+	if (v) {
+		if (CFGetTypeID(v) == CFNumberGetTypeID()) {
+			long long n = 0;
+			if (CFNumberGetValue((CFNumberRef)v, kCFNumberLongLongType, &n))
+				out = (unsigned long long)n;
+		} else if (CFGetTypeID(v) == CFBooleanGetTypeID()) {
+			out = CFBooleanGetValue((CFBooleanRef)v) ? 1 : 0;
+		}
+		CFRelease(v);
+	}
+	return out;
+}
+
+static char *cf_str_prop(io_object_t obj, CFStringRef key)
+{
+	CFTypeRef v = IORegistryEntryCreateCFProperty(obj, key, kCFAllocatorDefault, 0);
+	char buf[64];
+	char *out = NULL;
+
+	if (v) {
+		if (CFGetTypeID(v) == CFStringGetTypeID()
+		 && CFStringGetCString((CFStringRef)v, buf, sizeof(buf), kCFStringEncodingUTF8)
+		) {
+			out = xstrdup(buf);
+		}
+		CFRelease(v);
+	}
+	return out;
+}
+
+int lsblk_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int lsblk_main(int argc UNUSED_PARAM, char **argv)
+{
+	io_iterator_t iter = 0;
+	io_object_t media;
+	CFMutableDictionaryRef match;
+	unsigned i;
+
+	INIT_G();
+
+	getopt32(argv, "a");   /* -a is the only option this version accepts */
+	argv += optind;
+
+	match = IOServiceMatching(kIOMediaClass);
+	if (match && IOServiceGetMatchingServices(kIOMasterPortDefault, match, &iter) == KERN_SUCCESS) {
+		while ((media = IOIteratorNext(iter)) != 0) {
+			char *name = cf_str_prop(media, CFSTR(kIOBSDNameKey));
+			if (name) {
+				struct blockdev_info *b;
+				unsigned long long bytes = cf_ull_prop(media, CFSTR(kIOMediaSizeKey));
+				int whole = (int)cf_ull_prop(media, CFSTR(kIOMediaWholeKey));
+
+				b = get_or_create_info(name);
+				b->size = bytes >> 9;          /* lsblk prints 512-byte sectors */
+				b->type = whole ? "disk" : "part";
+				b->majmin = "-";
+				free(name);
+			}
+			IOObjectRelease(media);
+		}
+		IOObjectRelease(iter);
+	}
+
+	if (G.count == 0)
+		return 32;
+
+	qsort(G.list, G.count, sizeof(G.list[0]), compare_devices);
+
+	printf("%-15s %-7s  SIZE TYPE MOUNTPOINTS\n", "NAME", "MAJ:MIN");

+/* One deterministic digest: what the plugin builds in TypeScript today. */
+static int tl_summary(const char *dir, const char *run, int json)
+{
+	char *path = art_path(dir, "timeline");
+	char *meta = art_path(dir, "meta");
+	char *data = NULL;
+	size_t len = 0, *starts;
+	unsigned nlines = 0, i;
+	struct tlstat st;
+	long exit_code = 0, duration_ms = 0;
+	char *m = NULL;
+	size_t mlen = 0;
+	int timed_out = 0;
+
+	memset(&st, 0, sizeof(st));
+	st.first_out = st.first_err = -1;
+	if (read_all(path, &data, &len) != 0) {
+		if (json)
+			printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\"}");
+		else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us, prev = 0;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		st.lines++;
+		if (is_err) {
+			st.err_lines++;
+			if (st.first_err < 0)
+				st.first_err = us;
+		} else if (st.first_out < 0) {
+			st.first_out = us;
+		}
+		if (i) {
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+			int pe;
+
+			prev = pl ? stamp_us(data + starts[i - 1], pl, &pe) : 0;
+			if (us - prev > st.gap_us) {
+				st.gap_us = us - prev;
+				st.gap_from = prev;
+			}
+		}
+		if (us > st.last)
+			st.last = us;
+	}
+	if (read_all(meta, &m, &mlen) == 0) {
+		char *p = strstr(m, "exit_code=");
+		char *d = strstr(m, "duration_ms=");
+		char *t = strstr(m, "timed_out=");
+
+		if (p) exit_code = strtol(p + 10, NULL, 10);
+		if (d) duration_ms = strtol(d + 12, NULL, 10);
+		if (t) timed_out = (t[10] == '1');
+	}
+	if (json) {
+		printf("{\"schema\":1,\"run\":");
+		json_write_str(run);
+		printf(",\"status\":\"ok\",\"lines\":%u,\"stderr_lines\":%u,"
+				"\"first_out_us\":%ld,\"first_err_us\":%ld,\"last_us\":%ld,"
+				"\"longest_gap\":{\"from_us\":%ld,\"to_us\":%ld,\"gap_us\":%ld},"
+				"\"exit_code\":%ld,\"duration_ms\":%ld,\"timed_out\":%s}",
+				st.lines, st.err_lines, st.first_out, st.first_err, st.last,
+				st.gap_from, st.gap_from + st.gap_us, st.gap_us,
+				exit_code, duration_ms, timed_out ? "true" : "false");
+	} else {
+		printf("run=%s lines=%u stderr=%u first_out_us=%ld first_err_us=%ld "
+				"last_us=%ld longest_gap_us=%ld exit_code=%ld duration_ms=%ld timed_out=%d\n",
+				run, st.lines, st.err_lines, st.first_out, st.first_err,
+				st.last, st.gap_us, exit_code, duration_ms, timed_out);
+	}
+	free(starts);
+	free(data);
+	free(m);
+	fflush(stdout);
+	return 0;
+}

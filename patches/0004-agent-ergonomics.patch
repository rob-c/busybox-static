+			is_host = 0;
+			args++;
+		} else if (strcmp(*args, "-host") == 0 || strcmp(*args, "#host") == 0) {
+			is_host = 1;
+			args++;
+		} else if (strcmp(*args, "gw") == 0 && args[1]) {
+			gw = *++args;
+			args++;
+		} else if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev = *++args;
+			args++;
+		} else if (strcmp(*args, "netmask") == 0 && args[1]) {
+			mask = *++args;
+			args++;
+		} else if (strcmp(*args, "metric") == 0 && args[1]) {
+			args += 2;                 /* accepted, not applicable */
+		} else if (strcmp(*args, "default") == 0) {
+			safe_strncpy(dest, "0.0.0.0", sizeof(dest));
+			addrs = 1;
+			args++;
+		} else if (!dest[0] && !addrs) {
+			char *slash;
+			safe_strncpy(dest, *args, sizeof(dest));
+			slash = strchr(dest, '/');
+			if (slash) {

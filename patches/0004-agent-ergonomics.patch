+static unsigned prune_runs(const char *root, unsigned keep)
+{
+	struct dirent *de;
+	DIR *d;
+	unsigned *ids, n = 0, cap = 64, i, j, removed = 0;
+
+	d = opendir(root);
+	if (!d)
+		return 0;
+	ids = xmalloc(sizeof(ids[0]) * cap);
+	while ((de = readdir(d)) != NULL) {
+		unsigned v;
+
+		if (de->d_name[0] != 'R' || sscanf(de->d_name + 1, "%u", &v) != 1)
+			continue;
+		if (n == cap) {
+			cap *= 2;
+			ids = xrealloc(ids, sizeof(ids[0]) * cap);
+		}
+		ids[n++] = v;
+	}
+	closedir(d);
+
+	/* newest first */
+	for (i = 1; i < n; i++) {
+		unsigned t = ids[i];
+
+		for (j = i; j > 0 && ids[j - 1] < t; j--)
+			ids[j] = ids[j - 1];
+		ids[j] = t;
+	}
+	for (i = keep; i < n; i++) {
+		char *dir = xasprintf("%s/R%u", root, ids[i]);
+		/* Empty the directory first: a timed run also holds `timeline` (and
+		 * future artifacts), and an unlink list would rot every time one is
+		 * added. rmdir still refuses if anything is left. */
+		DIR *d = opendir(dir);
+		int emptied = 1;
+
+		if (d) {
+			struct dirent *de;
+
+			while ((de = readdir(d)) != NULL) {
+				char *f;
+
+				if (de->d_name[0] == '.'
+				 && (de->d_name[1] == '\0'
+				  || (de->d_name[1] == '.' && de->d_name[2] == '\0')))
+					continue;
+				f = xasprintf("%s/%s", dir, de->d_name);
+				if (unlink(f) != 0)
+					emptied = 0;
+				free(f);
+			}
+			closedir(d);
+		}
+		if (emptied && rmdir(dir) == 0)
+			removed++;
+		free(dir);
+	}
+	free(ids);
+	return removed;
+}

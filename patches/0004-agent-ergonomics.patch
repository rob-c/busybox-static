+static cputime_t iostat_uptime_darwin(void)
+{
+	struct timeval boot, now;
+	size_t len = sizeof(boot);
+	int mib[2] = { CTL_KERN, KERN_BOOTTIME };
+
+	if (sysctl(mib, 2, &boot, &len, NULL, 0) != 0)
+		return 0;
+	gettimeofday(&now, NULL);
+	if (now.tv_sec <= boot.tv_sec)
+		return 0;
+	return (cputime_t)(now.tv_sec - boot.tv_sec) * G.clk_tck;
+}

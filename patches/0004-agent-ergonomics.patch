+void FAST_FUNC bb_displayroutes(int noresolve, int netstatfmt)
+{
+	int mib[6] = { CTL_NET, PF_ROUTE, 0, AF_INET, NET_RT_DUMP, 0 };
+	size_t needed = 0;
+	char *buf, *lim, *next;
+
+	printf("Kernel IP routing table\n"
+		"Destination     Gateway         Genmask         Flags %s Iface\n",
+			netstatfmt ? "  MSS Window  irtt" : "Metric Ref    Use");
+
+	if (sysctl(mib, 6, NULL, &needed, NULL, 0) != 0 || needed == 0)
+		return;
+	buf = xmalloc(needed);
+	if (sysctl(mib, 6, buf, &needed, NULL, 0) != 0) {
+		free(buf);
+		bb_simple_perror_msg_and_die("NET_RT_DUMP");
+	}
+	lim = buf + needed;
+
+	for (next = buf; next + sizeof(struct rt_msghdr) <= lim; ) {
+		struct rt_msghdr *rtm = (struct rt_msghdr *)next;
+		const struct sockaddr *sa, *dst = NULL, *gw = NULL, *mask = NULL;
+		char dest[64], gate[64], netmask[64], flags[16], ifname[IFNAMSIZ];
+		int i;
+
+		if (rtm->rtm_msglen == 0)
+			break;
+		next += rtm->rtm_msglen;
+		if (rtm->rtm_version != RTM_VERSION)
+			continue;
+		if (!(rtm->rtm_flags & RTF_UP))
+			continue;
+
+		sa = (const struct sockaddr *)(rtm + 1);
+		for (i = 0; i < RTAX_MAX; i++) {
+			if (!(rtm->rtm_addrs & (1 << i)))
+				continue;
+			if ((const char *)sa >= next)
+				break;
+			switch (i) {
+			case RTAX_DST:     dst  = sa; break;
+			case RTAX_GATEWAY: gw   = sa; break;
+			case RTAX_NETMASK: mask = sa; break;
+			default: break;
+			}
+			sa = (const struct sockaddr *)((const char *)sa + BB_SA_ROUNDUP(sa));
+		}
+
+		darwin_ntop(dest, sizeof(dest), dst, noresolve, 0);
+		darwin_ntop(gate, sizeof(gate), gw, noresolve, 0);
+		darwin_ntop(netmask, sizeof(netmask), mask, noresolve, 1);
+
+		set_flags(flags, (rtm->rtm_flags & IPV4_MASK));
+#ifdef RTF_REJECT
+		if (rtm->rtm_flags & RTF_REJECT)
+			flags[0] = '!';
+#endif
+		ifname[0] = '\0';
+		if_indextoname(rtm->rtm_index, ifname);
+
+		printf("%-15.15s %-15.15s %-16s%-6s", dest, gate, netmask, flags);
+		if (netstatfmt)
+			printf("%5d %-5d %6d %s\n", 0, 0, 0, ifname);
+		else
+			printf("%-6d %-2d %7d %s\n", rtm->rtm_flags & 0xff ? 0 : 0, 0, 0, ifname);
+	}
+	free(buf);
+}

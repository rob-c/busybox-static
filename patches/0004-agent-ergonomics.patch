+ * Darwin port.  /proc/net/route does not exist; the table comes from
+ * sysctl(NET_RT_DUMP) over PF_ROUTE, one variable-length struct rt_msghdr per
+ * route followed by its sockaddrs.  RTAX_DST / RTAX_GATEWAY / RTAX_NETMASK are
+ * only present when their bit is set in rtm_addrs, and each sockaddr is padded
+ * to sizeof(uint32_t), so the walk must round every step.
+ *
+ * Also used by netstat, hence living here rather than in route.c's main.
+ */
+#include <sys/sysctl.h>
+#include <net/route.h>
+
+#define BB_SA_ROUNDUP(sa) \
+	(((sa)->sa_len + sizeof(uint32_t) - 1) & ~(sizeof(uint32_t) - 1))
+
+static void darwin_ntop(char *out, size_t outlen, const struct sockaddr *sa,
+		int noresolve, int is_mask)
+{
+	if (!sa) {
+		safe_strncpy(out, is_mask ? "0.0.0.0" : "*", outlen);
+		return;
+	}
+	if (sa->sa_family == AF_INET) {
+		const struct sockaddr_in *sin = (const struct sockaddr_in *)sa;
+		inet_ntop(AF_INET, &sin->sin_addr, out, outlen);
+		return;
+	}
+	if (is_mask && sa->sa_len > offsetof(struct sockaddr_in, sin_addr)) {
+		/* BSD sends netmask sockaddrs with sa_family == 0, but the address
+		 * bytes are still there; a zero-length one means /0. */
+		const struct sockaddr_in *sin = (const struct sockaddr_in *)sa;
+		inet_ntop(AF_INET, &sin->sin_addr, out, outlen);
+		return;
+	}
+	if (sa->sa_family == AF_LINK) {
+		safe_strncpy(out, "link", outlen);
+		return;
+	}
+	/* An unknown/empty mask sockaddr means a /0 route (the default route). */
+	safe_strncpy(out, is_mask ? "0.0.0.0" : "?", outlen);
+}
+
+void FAST_FUNC bb_displayroutes(int noresolve, int netstatfmt)
+{
+	int mib[6] = { CTL_NET, PF_ROUTE, 0, AF_INET, NET_RT_DUMP, 0 };
+	size_t needed = 0;
+	char *buf, *lim, *next;
+
+	printf("Kernel IP routing table\n"
+		"Destination     Gateway         Genmask         Flags %s Iface\n",
+			netstatfmt ? "  MSS Window  irtt" : "Metric Ref    Use");
+
+	if (sysctl(mib, 6, NULL, &needed, NULL, 0) != 0 || needed == 0)
+		return;
+	buf = xmalloc(needed);
+	if (sysctl(mib, 6, buf, &needed, NULL, 0) != 0) {
+		free(buf);
+		bb_simple_perror_msg_and_die("NET_RT_DUMP");
+	}
+	lim = buf + needed;
+
+	for (next = buf; next + sizeof(struct rt_msghdr) <= lim; ) {
+		struct rt_msghdr *rtm = (struct rt_msghdr *)next;
+		const struct sockaddr *sa, *dst = NULL, *gw = NULL, *mask = NULL;
+		char dest[64], gate[64], netmask[64], flags[16], ifname[IFNAMSIZ];
+		int i;
+
+		if (rtm->rtm_msglen == 0)
+			break;
+		next += rtm->rtm_msglen;
+		if (rtm->rtm_version != RTM_VERSION)
+			continue;
+		if (!(rtm->rtm_flags & RTF_UP))
+			continue;
+
+		sa = (const struct sockaddr *)(rtm + 1);
+		for (i = 0; i < RTAX_MAX; i++) {
+			if (!(rtm->rtm_addrs & (1 << i)))
+				continue;
+			if ((const char *)sa >= next)
+				break;
+			switch (i) {
+			case RTAX_DST:     dst  = sa; break;
+			case RTAX_GATEWAY: gw   = sa; break;
+			case RTAX_NETMASK: mask = sa; break;
+			default: break;
+			}
+			sa = (const struct sockaddr *)((const char *)sa + BB_SA_ROUNDUP(sa));
+		}
+
+		darwin_ntop(dest, sizeof(dest), dst, noresolve, 0);
+		darwin_ntop(gate, sizeof(gate), gw, noresolve, 0);
+		darwin_ntop(netmask, sizeof(netmask), mask, noresolve, 1);
+
+		set_flags(flags, (rtm->rtm_flags & IPV4_MASK));
+#ifdef RTF_REJECT
+		if (rtm->rtm_flags & RTF_REJECT)
+			flags[0] = '!';
+#endif
+		ifname[0] = '\0';
+		if_indextoname(rtm->rtm_index, ifname);
+
+		printf("%-15.15s %-15.15s %-16s%-6s", dest, gate, netmask, flags);
+		if (netstatfmt)
+			printf("%5d %-5d %6d %s\n", 0, 0, 0, ifname);
+		else
+			printf("%-6d %-2d %7d %s\n", rtm->rtm_flags & 0xff ? 0 : 0, 0, 0, ifname);
+	}
+	free(buf);
+}

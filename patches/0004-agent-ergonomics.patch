+			*d = '\0';
+			if (a[1] != '\0')
+				argv[w++] = a;      /* -qd -> -q */
+			continue;
+		}
+		if (i + 1 < argc) {
+			/* -d DIR (or -qd DIR): the directory is the next word */
+			if (base_dir && !*base_dir)

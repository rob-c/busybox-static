+	if (iflag)
+		return;
+	if (getpgrp() != getpid())
+		setpgid(0, 0);          /* our own group, so the kill covers children */
+	group = getpid();
+	r = fork();
+	if (r == 0)
+		ash_reaper(group);      /* the group, not the reaper's own pid */
+	ash_reaper_pid = r;
+	atexit(ash_stop_reaper);
+}

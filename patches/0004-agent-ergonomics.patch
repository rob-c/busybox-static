+	replay_quote(&b, cwd ? cwd : ".");
+	sb_addstr_(&b, " && ");
+	for (i = 0; argv[i]; i++) {
+		if (i)
+			sb_addch_(&b, ' ');
+		replay_quote(&b, argv[i]);
+	}

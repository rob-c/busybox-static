+/*
+ * Zip64: when a size does not fit in 32 bits, the central directory stores
+ * 0xffffffff there and the real value in an extra field with ID 0x0001.
+ * Only the sizes are taken from it; fields that fit stay untouched.
+ * NEXT_CDF_OFF is the offset read_next_cdf() computed for the entry *after*
+ * this one, from which the extra field can be located exactly.
+ */
+static void zip64_fix_sizes(uint32_t next_cdf_off, cdf_header_t *cdf, zip_header_t *zip)
+{
+	uint16_t extra_len = cdf->fmt.extra_len;
+	uint32_t pos;
+	unsigned char *extra;
+	unsigned i;
+
+	if (extra_len < 4)
+		return;
+	if (cdf->fmt.ucmpsize != 0xffffffff && cdf->fmt.cmpsize != 0xffffffff)
+		return;
+	pos = next_cdf_off - extra_len - cdf->fmt.file_comment_length;
+	extra = xmalloc(extra_len);
+	xlseek(zip_fd, pos, SEEK_SET);
+	xread(zip_fd, extra, extra_len);
+
+	for (i = 0; i + 4 <= extra_len; ) {
+		unsigned id = extra[i] | (extra[i + 1] << 8);
+		unsigned sz = extra[i + 2] | (extra[i + 3] << 8);
+		unsigned j = i + 4;
+		unsigned char *v = extra + j;
+		unsigned avail = (j + sz <= extra_len) ? sz : 0;
+
+		if (id == 0x0001) {
+			uint64_t u, c;
+			if (cdf->fmt.ucmpsize == 0xffffffff) {
+				unsigned n;
+				if (avail < 8)
+					break;
+				u = 0;
+				for (n = 0; n < 8; n++)
+					u |= (uint64_t)v[n] << (8 * n);
+				v += 8;
+				avail -= 8;
+				if (u <= 0xffffffff)
+					zip->fmt.ucmpsize = (uint32_t)u;
+				cdf->fmt.ucmpsize = (uint32_t)u;
+			}
+			if (cdf->fmt.cmpsize == 0xffffffff) {
+				if (avail < 8)
+					break;
+				{
+					unsigned n;
+					c = 0;
+					for (n = 0; n < 8; n++)
+						c |= (uint64_t)v[n] << (8 * n);
+				}
+				if (c <= 0xffffffff) {
+					zip->fmt.cmpsize = (uint32_t)c;
+					cdf->fmt.cmpsize = (uint32_t)c;
+				}
+			}
+			break;
+		}
+		i = j + sz;
+	}
+	free(extra);
+}
+
+
 
 /* This value means that we failed to find CDF */
 #define BAD_CDF_OFFSET ((uint32_t)0xffffffff)
@@ -488,6 +555,52 @@ static int get_lstat_mode(const char *dst_fn)
 	return stat_buf.st_mode;
 }
 
+/*
+ * BSD getopt stops at the first non-option, glibc permutes, so on macOS
+ * `unzip a.zip -d out` treated "-d out" as member names: nothing matched and the
+ * exit status was 0 while Linux worked. Peel -d out of argv wherever it appears
+ * instead of reordering, which keeps both getopt implementations on one path.
+ * Returns the new argc; argv is compacted in place.
+ */
+static int unzip_take_dash_d(int argc, char **argv, char **base_dir)
+{
+	int i, w = 1;
+
+	for (i = 1; i < argc; i++) {
+		char *a = argv[i];
+		char *d;
+
+		if (a[0] != '-' || a[1] == '\0')
+			goto keep;
+		d = strchr(a + 1, 'd');
+		if (!d)
+			goto keep;
+		if (d[1] != '\0') {
+			/* -dDIR (or -qdDIR): the directory is attached */
+			if (base_dir && !*base_dir)
+				*base_dir = d + 1;
+			*d = '\0';
+			if (a[1] != '\0')
+				argv[w++] = a;      /* -qd -> -q */
+			continue;
+		}
+		if (i + 1 < argc) {
+			/* -d DIR (or -qd DIR): the directory is the next word */
+			if (base_dir && !*base_dir)
+				*base_dir = argv[i + 1];
+			i++;
+			*d = '\0';
+			if (a[1] != '\0')
+				argv[w++] = a;      /* -qd -> -q */
+			continue;
+		}
+ keep:
+		argv[w++] = a;
+	}
+	argv[w] = NULL;
+	return w;
+}
+

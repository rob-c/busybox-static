+	close(p[1]);
+	if (keep > 2)
+		close(keep);
+}
+
+/*
+ * Watchdog: a child in its own process group that kills this shell's group when
+ * the shell disappears for any reason, SIGKILL included. Shells normally leave
+ * their children running when the shell is killed; a tool harness that kills
+ * busybox expects the whole command to stop.
+ */
+static void ash_reaper(pid_t target_group) NORETURN;
+static void ash_reaper(pid_t target_group)
+{
+	pid_t me = getppid();
+	int fd, i;
+
+	setpgid(0, 0);
+	fd = open("/dev/null", O_RDWR);
+	if (fd >= 0) {
+		dup2(fd, 0);
+		dup2(fd, 1);
+		dup2(fd, 2);
+		if (fd > 2)
+			close(fd);
+	}
+	for (i = 3; i < 256; i++)
+		close(i);
+	for (;;) {
+		if (kill(me, 0) != 0)
+			break;
+		usleep(100 * 1000);
+	}
+	kill(-target_group, SIGKILL);
+	_exit(0);
+}
+
+/* Only for a non-interactive shell: an interactive one shares the terminal's
+ * process group, and moving it would break job control. */
+static pid_t ash_reaper_pid;
+
+/* Stop the watchdog on the way out: it is only needed while we are alive. */
+static void ash_stop_reaper(void)
+{
+	if (ash_reaper_pid > 0) {
+		kill(ash_reaper_pid, SIGKILL);
+		waitpid(ash_reaper_pid, NULL, 0);
+		ash_reaper_pid = 0;
+	}
+}
+
+static void ash_install_reaper(void)
+{
+	pid_t r, group;
+
+	if (iflag)
+		return;
+	if (getpgrp() != getpid())
+		setpgid(0, 0);          /* our own group, so the kill covers children */
+	group = getpid();
+	r = fork();
+	if (r == 0)
+		ash_reaper(group);      /* the group, not the reaper's own pid */
+	ash_reaper_pid = r;
+	atexit(ash_stop_reaper);
+}
+
+static void ash_agent_setup(void)
+{
+	ash_install_reaper();
+	if (ash_brief_which) {
+		int orig_out = dup(1);
+		int orig_err = dup(2);
+
+		if (strcmp(ash_brief_which, "stdout") == 0
+		 || strcmp(ash_brief_which, "both") == 0)
+			ash_brief_stream(1, orig_out, orig_err);
+		if (strcmp(ash_brief_which, "stderr") == 0
+		 || strcmp(ash_brief_which, "both") == 0)
+			ash_brief_stream(2, orig_out, orig_err);
+	}
+}

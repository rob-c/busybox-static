+		FILE *mt = setmntent(bb_path_mtab_file, "r");
+		struct mntent *m;
+		int printed = 0;
+
+		smart_ulltoa5(G.list[i].size * 512, buf6, " KMGTPEZY");
+		printf("%-15s %-7s %.5s %4s", G.list[i].name, G.list[i].majmin,
+				buf6, G.list[i].type);
+
+		if (mt) {
+			char want[64];
+			snprintf(want, sizeof(want), "/dev/%s", G.list[i].name);
+			while ((m = getmntent(mt)) != NULL) {
+				if (strcmp(m->mnt_fsname, want) == 0) {
+					printf("%s%s", printed ? "\n" : " ", m->mnt_dir);
+					printed = 1;
+				}
+			}
+			endmntent(mt);
+		}
+		bb_putchar('\n');
+	}
+
+	fflush_stdout_and_exit(EXIT_SUCCESS);
+}
+#endif /* __APPLE__ */

+	if (mask) {
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		if (inet_pton(AF_INET, mask, &msg.mask.sin_addr) != 1)
+			bb_error_msg_and_die("invalid netmask: %s", mask);
+		addrs |= RTA_NETMASK;
+	} else if (msg.mask.sin_zero[0]) {
+		/* prefix length captured during parsing */
+		int plen = xatoi_positive(msg.mask.sin_zero);
+		uint32_t m = plen >= 32 ? 0xffffffffU
+			: (plen <= 0 ? 0 : (0xffffffffU << (32 - plen)));
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		msg.mask.sin_addr.s_addr = htonl(m);
+		addrs |= RTA_NETMASK;
+	} else if (!is_host && msg.dst.sin_addr.s_addr != 0) {
+		/* -net without a mask: classful default, as route(8) does */
+		uint32_t d = ntohl(msg.dst.sin_addr.s_addr);
+		uint32_t m = (d < 0x80000000U) ? 0xff000000U

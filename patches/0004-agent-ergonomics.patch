+
+		if (!both && strcmp(which, "stdout") != 0
+		 && strcmp(which, "stderr") != 0
+		 && strcmp(which, "timeline") != 0)
+			bb_error_msg_and_die("--stream is stdout, stderr, timeline or both");
+		if (strcmp(which, "timeline") == 0) {
+			rc = dump_stream(art_path(dir, "timeline"), "timeline", opt_match,
+					first, last, ctx, budget, json);
+			fflush(stdout);
+			return rc;
+		}
+		if (json && both)
+			fputs("{\"schema\":1,\"results\":[", stdout);
+		if (both || strcmp(which, "stdout") == 0) {
+			rc |= dump_stream(art_path(dir, "stdout"), "stdout", opt_match,
+					first, last, ctx, budget, json);
+			if (both && json)
+				putchar(',');
+		}
+		if (both || strcmp(which, "stderr") == 0)
+			rc |= dump_stream(art_path(dir, "stderr"), "stderr", opt_match,
+					first, last, ctx, budget, json);
+		if (json && both)
+			fputs("]}\n", stdout);
+		else if (json)
+			putchar('\n');
+	}
+	fflush(stdout);
+	return rc;
+}

+/* ---------- log ---------- */
+
+static int read_all(const char *path, char **pdata, size_t *plen)
+{
+	int fd = open(path, O_RDONLY);
+	struct stat st;
+	char *data;
+	size_t len = 0, cap;
+
+	if (fd < 0)
+		return -1;
+	if (fstat(fd, &st) != 0) {
+		close(fd);
+		return -1;
+	}
+	cap = st.st_size > 0 ? (size_t)st.st_size + 1 : 4096;
+	data = xmalloc(cap);
+	for (;;) {
+		ssize_t r;
+
+		if (len == cap - 1) {
+			cap *= 2;
+			data = xrealloc(data, cap);
+		}
+		r = safe_read(fd, data + len, cap - 1 - len);
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			free(data);
+			close(fd);
+			return -1;
+		}
+		if (r == 0)
+			break;
+		len += (size_t)r;
+	}
+	close(fd);
+	data[len] = '\0';
+	*pdata = data;
+	*plen = len;
+	return 0;
+}
+
+static size_t *line_starts(const char *d, size_t len, unsigned *pn)
+{
+	size_t *v;
+	size_t i;
+	unsigned n = 0, cap = 256;
+
+	v = xmalloc(cap * sizeof(*v));
+	v[n++] = 0;
+	for (i = 0; i < len; i++) {
+		if (d[i] != '\n' || i + 1 >= len)
+			continue;
+		if (n == cap) {
+			cap *= 2;
+			v = xrealloc(v, cap * sizeof(*v));
+		}
+		v[n++] = i + 1;
+	}
+	*pn = n;
+	return v;
+}
+
+static size_t line_len(const char *d, const size_t *starts, unsigned n,
+		size_t len, unsigned i)
+{
+	size_t end = (i + 1 < n) ? starts[i + 1] - 1 : len;
+	size_t l;
+
+	if (end > starts[i] && d[end - 1] == '\n')
+		end--;
+	if (end > starts[i] && d[end - 1] == '\r')
+		end--;
+	l = end - starts[i];
+	return l;
+}
+
+static int dump_stream(const char *path, const char *label, const char *match,
+		long first, long last, long ctx, long budget, int json)
+{
+	char *data = NULL;
+	size_t len = 0, *starts, shown = 0;
+	unsigned nlines = 0, i;
+	struct rng r[MAX_RANGES];
+	unsigned nr = 0;
+	int truncated = 0;
+
+	if (read_all(path, &data, &len) != 0) {
+		if (json) {
+			printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"error\","
+					"\"code\":\"NOT_FOUND\",\"message\":", label);
+			json_write_str("run not found or stream missing");
+			putchar('}');
+		} else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+
+	if (match) {
+		for (i = 0; i < nlines && nr < MAX_RANGES; i++) {
+			size_t l = line_len(data, starts, nlines, len, i);
+			char *line;
+			int hit;
+
+			if (l == 0)
+				continue;
+			line = xstrndup(data + starts[i], l);
+			hit = strstr(line, match) != NULL;
+			free(line);
+			if (!hit)
+				continue;
+			{
+				unsigned lo = (i >= (unsigned)ctx) ? i - (unsigned)ctx : 0;
+				unsigned hi = i + (unsigned)ctx;
+				if (hi >= nlines)
+					hi = nlines - 1;
+				if (nr && lo <= r[nr - 1].last + 1) {
+					if (hi > r[nr - 1].last)
+						r[nr - 1].last = hi;
+				} else {
+					r[nr].first = lo;
+					r[nr].last = hi;
+					nr++;
+				}
+			}
+		}
+		if (nr == 0) {
+			if (json)
+				printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"error\","
+						"\"code\":\"NOT_FOUND\",\"message\":\"no match\"}", label);
+			else
+				fprintf(stderr, "%s: NOT_FOUND: no match for \"%s\"\n",
+						path, match);
+			free(starts);
+			free(data);
+			return 1;
+		}
+	} else {
+		unsigned lo, hi;
+
+		if (first < 1)
+			first = 1;
+		if (last < first)
+			last = first;
+		if ((unsigned long)last > nlines)
+			last = nlines;
+		lo = (unsigned)first - 1;
+		hi = (unsigned)last - 1;
+		r[0].first = lo;
+		r[0].last = hi;
+		nr = 1;
+	}
+
+	if (json) {
+		printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"ok\",\"lines\":[",
+				label);
+		for (i = 0; i < nr; i++)
+			printf("%s[%u,%u]", i ? "," : "", r[i].first + 1, r[i].last + 1);
+		fputs("],\"content\":[", stdout);
+	} else {
+		printf("%s lines=", label);
+		for (i = 0; i < nr; i++)
+			printf("%s%u-%u", i ? "," : "", r[i].first + 1, r[i].last + 1);
+		putchar('\n');
+	}
+
+	{
+		unsigned emitted = 0;
+
+		for (i = 0; i < nr && !truncated; i++) {
+			unsigned li;
+
+			if (!json && i > 0)
+				fputs("--\n", stdout);
+			for (li = r[i].first; li <= r[i].last; li++) {
+				size_t l = line_len(data, starts, nlines, len, li);
+				char num[32];
+				int nd = snprintf(num, sizeof(num), "%u | ", li + 1);
+
+				if (shown + (size_t)nd + l + 1 > (size_t)budget) {
+					truncated = 1;
+					break;
+				}
+				if (json) {
+					if (emitted++)
+						putchar(',');
+					printf("{\"n\":%u,\"text\":", li + 1);
+					{
+						char *t = xstrndup(data + starts[li], l);
+						json_write_str(t);
+						free(t);
+					}
+					putchar('}');
+				} else {
+					fwrite(num, 1, (size_t)nd, stdout);
+					fwrite(data + starts[li], 1, l, stdout);
+					putchar('\n');
+				}
+				shown += (size_t)nd + l + 1;
+			}
+		}
+	}
+
+	if (json)
+		printf("],\"shown_bytes\":%u,\"truncated\":%s}",
+				(unsigned)shown, truncated ? "true" : "false");
+	else
+		printf("shown_bytes=%u truncated=%s\n", (unsigned)shown,
+				truncated ? "true" : "false");
+	free(starts);
+	free(data);
+	return 0;
+}
+
+/* log --diff R1:R2: compare two runs' stdout, line by line. */
+/* ---------- time-addressed timeline retrieval ---------- */
+
+/* "[   0.011354 out] text" -> microseconds, and which stream. */
+static long stamp_us(const char *line, size_t len, int *is_err)
+{
+	long sec = 0, frac = 0;
+	size_t i = 0;
+	int digits = 0;
+
+	*is_err = 0;
+	while (i < len && (line[i] == '[' || line[i] == ' '))
+		i++;
+	while (i < len && line[i] >= '0' && line[i] <= '9')
+		sec = sec * 10 + (line[i++] - '0');
+	if (i < len && line[i] == '.') {
+		i++;
+		while (i < len && line[i] >= '0' && line[i] <= '9' && digits < 9) {
+			frac = frac * 10 + (line[i++] - '0');
+			digits++;
+		}
+	}
+	while (digits++ < 9)
+		frac *= 10;
+	for (; i < len; i++)
+		if (line[i] == 'e' && i + 3 < len && memcmp(line + i, "err", 3) == 0) {
+			*is_err = 1;
+			break;
+		}
+	return sec * 1000000L + frac / 1000;
+}
+
+struct tlstat {
+	unsigned lines, err_lines;
+	long first_out, first_err, last;
+	long gap_from, gap_us;
+};
+
+/* Walk the timeline artifact, filling `st` and printing whatever the caller wants. */
+static int tl_query(const char *dir, long since_us, long until_us,
+		double gap_s, long limit, int json, size_t budget)
+{
+	char *path = art_path(dir, "timeline");
+	char *data = NULL;
+	size_t len = 0, starts_n = 0, *starts;
+	unsigned nlines = 0, i, shown = 0;
+	size_t printed = 0;
+	struct tlstat st;
+
+	memset(&st, 0, sizeof(st));
+	st.first_out = -1;
+	st.first_err = -1;
+
+	if (read_all(path, &data, &len) != 0) {
+		if (json)
+			printf("{\"schema\":1,\"stream\":\"timeline\",\"status\":\"error\","
+					"\"code\":\"NOT_FOUND\",\"message\":\"run not found or stream missing\"}");
+		else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		free(path);
+		return 1;
+	}
+	free(path);
+	starts = line_starts(data, len, &nlines);
+
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		st.lines++;
+		if (is_err) {
+			st.err_lines++;
+			if (st.first_err < 0)
+				st.first_err = us;
+		} else if (st.first_out < 0) {
+			st.first_out = us;
+		}
+		if (us > st.last)
+			st.last = us;
+		if (i && st.last > 0) {
+			long prev = 0;
+			int pe;
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+
+			prev = pl ? stamp_us(data + starts[i - 1], pl, &pe) : 0;
+			if (us - prev > st.gap_us) {
+				st.gap_us = us - prev;
+				st.gap_from = prev;
+			}
+		}
+	}
+
+	if (gap_s > 0) {
+		/* The N widest silences, with the line on each side. */
+		long want = (long)(gap_s * 1000000.0);
+		long shown_gaps = 0;
+
+		if (json)
+			printf("{\"schema\":1,\"stream\":\"timeline\",\"status\":\"ok\",\"gaps\":[");
+		for (i = 1; i < nlines && shown_gaps < (limit > 0 ? limit : 3); i++) {
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+			size_t cl = line_len(data, starts, nlines, len, i);
+			int pe, ce;
+			long pu, cu;
+
+			if (!pl || !cl)
+				continue;
+			pu = stamp_us(data + starts[i - 1], pl, &pe);
+			cu = stamp_us(data + starts[i], cl, &ce);
+			if (cu - pu < want)
+				continue;
+			if (json) {
+				printf("%s{\"from_us\":%ld,\"to_us\":%ld,\"gap_us\":%ld,\"before\":",
+						shown_gaps ? "," : "", pu, cu, cu - pu);
+				json_write_str(xstrndup(data + starts[i - 1], pl));
+				printf(",\"after\":");
+				json_write_str(xstrndup(data + starts[i], cl));
+				putchar('}');
+			} else {
+				printf("gap %ldus -> %ldus (%ldus)\n", pu, cu, cu - pu);
+			}
+			shown_gaps++;
+		}
+		if (json)
+			printf("],\"lines\":%u,\"stderr_lines\":%u}", st.lines, st.err_lines);
+		else
+			printf("gaps=%ld lines=%u stderr_lines=%u\n", shown_gaps, st.lines, st.err_lines);
+		free(starts);
+		free(data);
+		fflush(stdout);
+		return 0;
+	}
+
+	if (json)
+		printf("{\"schema\":1,\"stream\":\"timeline\",\"status\":\"ok\",\"events\":[");
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		if (since_us >= 0 && us < since_us)
+			continue;
+		if (until_us >= 0 && us > until_us)
+			continue;
+		if (printed + l + 40 > budget) {
+			shown = i;
+			break;
+		}
+		if (json) {
+			char *text = xstrndup(data + starts[i], l);
+			char *body = strchr(text, ']');
+
+			while (body && *body == ']')
+				body++, body += (*body == ' ');
+			printf("%s{\"n\":%u,\"us\":%ld,\"stream\":\"%s\",\"text\":",
+					printed ? "," : "", i + 1, us, is_err ? "err" : "out");
+			json_write_str(body ? body : "");
+			putchar('}');
+			free(text);
+		} else {
+			fwrite(data + starts[i], 1, l, stdout);
+			putchar('\n');
+		}
+		printed += l;
+	}
+	if (json)
+		printf("],\"shown_bytes\":%u,\"truncated\":%s}", (unsigned)printed,
+				shown ? "true" : "false");
+	free(starts);
+	free(data);
+	fflush(stdout);
+	return 0;
+}

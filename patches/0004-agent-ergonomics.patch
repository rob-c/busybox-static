+			i++;
+			*d = '\0';
+			if (a[1] != '\0')
+				argv[w++] = a;      /* -qd -> -q */
+			continue;
+		}
+ keep:
+		argv[w++] = a;
+	}
+	argv[w] = NULL;
+	return w;

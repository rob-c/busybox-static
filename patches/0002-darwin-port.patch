diff --git a/libbb/mntent.c b/libbb/mntent.c
new file mode 100644
index 0000000..bbbe774
--- /dev/null
+++ b/libbb/mntent.c
@@ -0,0 +1,119 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * A <mntent.h> work-alike for systems that lack it (Darwin).
+ *
+ * Darwin exposes the mount table through getmntinfo(3) and <sys/mount.h>,
+ * not through /etc/mtab, so implement setmntent()/getmntent()/endmntent()
+ * on top of that. Callers (df, find_mount_point, ...) then work unchanged.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+#include "libbb.h"
+
+#if defined(__APPLE__) && !defined(HAVE_MNTENT_H)
+
+#include <sys/param.h>
+#include <sys/mount.h>
+#include <sys/ucred.h>
+
+/* Only one mount table is ever walked at a time by busybox, so a single
+ * static iteration state is enough. The FILE* handed out is just a token.
+ */
+static struct statfs *sf_tab;
+static int sf_count;
+static int sf_idx;
+static char *sf_opts;
+
+static char* FAST_FUNC make_opts(const struct statfs *sf)
+{
+	char *opts = xmalloc(512);
+	size_t len;
+
+	strcpy(opts, (sf->f_flags & MNT_RDONLY) ? "ro" : "rw");
+	if ((sf->f_flags & MNT_SYNCHRONOUS) || (sf->f_flags & MNT_ASYNC))
+		strcat(opts, (sf->f_flags & MNT_ASYNC) ? ",async" : ",sync");
+	if (sf->f_flags & MNT_NOEXEC)
+		strcat(opts, ",noexec");
+	if (sf->f_flags & MNT_NOSUID)
+		strcat(opts, ",nosuid");
+	if (sf->f_flags & MNT_NODEV)
+		strcat(opts, ",nodev");
+	if (sf->f_flags & MNT_DONTBROWSE)
+		strcat(opts, ",nobrowse");
+	if (sf->f_flags & MNT_UNION)
+		strcat(opts, ",union");
+	if (sf->f_flags & MNT_LOCAL)
+		strcat(opts, ",local");
+	len = strlen(opts);
+	(void)len;
+	return opts;
+}
+
+FILE* setmntent(const char *filename, const char *type)
+{
+	(void)filename;
+	/* "w"/"a+" (mtab rewriting) is meaningless on Darwin */
+	if (type && type[0] != 'r') {
+		errno = ENOSYS;
+		return NULL;
+	}
+	free(sf_opts);
+	sf_opts = NULL;
+	sf_idx = 0;
+	sf_count = getmntinfo(&sf_tab, MNT_NOWAIT);
+	if (sf_count <= 0) {
+		sf_count = 0;
+		return NULL;
+	}
+	/* any non-NULL value; callers only pass it back to us */
+	return (FILE *)sf_tab;
+}
+
+struct mntent* getmntent(FILE *stream)
+{
+	static struct mntent m;
+
+	(void)stream;
+	if (sf_idx >= sf_count)
+		return NULL;
+
+	free(sf_opts);
+	sf_opts = make_opts(&sf_tab[sf_idx]);
+
+	m.mnt_fsname = sf_tab[sf_idx].f_mntfromname;
+	m.mnt_dir    = sf_tab[sf_idx].f_mntonname;
+	m.mnt_type   = sf_tab[sf_idx].f_fstypename;
+	m.mnt_opts   = sf_opts;
+	m.mnt_freq   = 0;
+	m.mnt_passno = 0;
+	sf_idx++;
+	return &m;
+}
+
+int endmntent(FILE *stream)
+{
+	(void)stream;
+	free(sf_opts);
+	sf_opts = NULL;
+	sf_tab = NULL;
+	sf_count = 0;
+	sf_idx = 0;
+	return 1;
+}
+
+char* hasmntopt(const struct mntent *m, const char *opt)
+{
+	char *p = m->mnt_opts;
+	size_t l = strlen(opt);
+
+	while (p && *p) {
+		if (strncmp(p, opt, l) == 0 && (p[l] == '\0' || p[l] == ','))
+			return p;
+		p = strchr(p, ',');
+		if (p)
+			p++;
+	}
+	return NULL;
+}
+
+#endif /* __APPLE__ && !HAVE_MNTENT_H */

diff --git a/libbb/poll_with_signals.c b/libbb/poll_with_signals.c
index 47419f2..38f4351 100644
--- a/libbb/poll_with_signals.c
+++ b/libbb/poll_with_signals.c
@@ -10,6 +10,52 @@
 
 #include "libbb.h"
 
+#if defined(__APPLE__)
+/* Darwin has no ppoll(). Emulate it.
+ * The point of ppoll() here is atomicity: unblock the signals *and* start
+ * waiting in one syscall. Without that we can lose a signal that arrives
+ * in the unblock->poll() window and then sleep forever.
+ * Emulation: poll() in short slices and re-check bb_got_signal between them.
+ */
+static int darwin_ppoll(struct pollfd *pfd, nfds_t nfds,
+		const struct timespec *tsp, const sigset_t *sigmask)
+{
+	int n;
+	long left_ms = -1;
+	sigset_t saved;
+
+	if (tsp) {
+		left_ms = tsp->tv_sec * 1000 + (tsp->tv_nsec + 999999) / 1000000;
+		if (left_ms < 0)
+			left_ms = 0;
+	}
+	if (sigmask)
+		sigprocmask(SIG_SETMASK, sigmask, &saved);
+	for (;;) {
+		int slice = 100; /* ms */
+		if (left_ms >= 0 && left_ms < slice)
+			slice = (int)left_ms;
+		n = poll(pfd, nfds, slice);
+		if (n != 0) /* ready, or error (EINTR) */
+			break;
+		if (bb_got_signal) {
+			errno = EINTR;
+			n = -1;
+			break;
+		}
+		if (left_ms >= 0) {
+			left_ms -= slice;
+			if (left_ms <= 0) /* timed out */
+				break;
+		}
+	}
+	if (sigmask)
+		sigprocmask(SIG_SETMASK, &saved, NULL);
+	return n;
+}
+# define ppoll darwin_ppoll
+#endif

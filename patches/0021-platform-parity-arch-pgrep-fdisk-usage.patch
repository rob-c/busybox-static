+				printf("    inet %s/%d", buf, plen);
+				if (j->ifa_flags & IFF_LOOPBACK)
+					printf(" scope host");
+				else
+					printf(" scope global %s", ifa->ifa_name);
+				if (j->ifa_broadaddr && (j->ifa_flags & IFF_BROADCAST)) {
+					const struct sockaddr_in *b = (const struct sockaddr_in *)j->ifa_broadaddr;
+					inet_ntop(AF_INET, &b->sin_addr, buf, sizeof(buf));
+					printf(" brd %s", buf);
+				}
+				printf("\n");
+			} else if (j->ifa_addr->sa_family == AF_INET6) {
+				const struct sockaddr_in6 *s6 = (const struct sockaddr_in6 *)j->ifa_addr;
+				const unsigned char *m6 = ((const struct sockaddr_in6 *)j->ifa_netmask)->sin6_addr.s6_addr;
+				int plen = 0;
+				unsigned k;
+				for (k = 0; k < 16; k++)
+					plen += __builtin_popcount(m6[k]);
+				inet_ntop(AF_INET6, &s6->sin6_addr, buf, sizeof(buf));
+				printf("    inet6 %s/%d scope global\n", buf, plen);
+			}
+		}
+	}
+	freeifaddrs(ifap);
+}
+
+static void darwin_ip_route(void)
+{
+	int mib[6] = { CTL_NET, PF_ROUTE, 0, AF_INET, NET_RT_DUMP, 0 };
+	size_t needed = 0;
+	char *buf, *lim, *next;
+
+	if (sysctl(mib, 6, NULL, &needed, NULL, 0) != 0 || needed == 0)
+		return;
+	buf = xmalloc(needed);
+	if (sysctl(mib, 6, buf, &needed, NULL, 0) != 0) {
+		free(buf);
+		return;
+	}
+	lim = buf + needed;
+	for (next = buf; next + sizeof(struct rt_msghdr) <= lim; ) {
+		struct rt_msghdr *rtm = (struct rt_msghdr *)next;
+		const struct sockaddr *sa, *dst = NULL, *gw = NULL, *mask = NULL;
+		char d[64], g[64], m[64], ifname[IFNAMSIZ];
+		int i, is_default;
+
+		if (rtm->rtm_msglen == 0)
+			break;
+		next += rtm->rtm_msglen;
+		if (rtm->rtm_version != RTM_VERSION || !(rtm->rtm_flags & RTF_UP))
+			continue;
+
+		sa = (const struct sockaddr *)(rtm + 1);
+		for (i = 0; i < RTAX_MAX; i++) {
+			if (!(rtm->rtm_addrs & (1 << i)))
+				continue;
+			if ((const char *)sa >= next)
+				break;
+			switch (i) {
+			case RTAX_DST:     dst  = sa; break;
+			case RTAX_GATEWAY: gw   = sa; break;
+			case RTAX_NETMASK: mask = sa; break;
+			default: break;
+			}
+			sa = (const struct sockaddr *)((const char *)sa
+					+ ((sa->sa_len + 3) & ~3));
+		}
+
+		/* destination */
+		is_default = (!mask || mask->sa_len <= (int)offsetof(struct sockaddr_in, sin_addr))
+			&& dst && dst->sa_family == AF_INET
+			&& ((const struct sockaddr_in *)dst)->sin_addr.s_addr == 0;
+		if (is_default) {
+			safe_strncpy(d, "default", sizeof(d));
+		} else if (dst && dst->sa_family == AF_INET) {
+			unsigned p = 0;
+			if (mask && mask->sa_len > offsetof(struct sockaddr_in, sin_addr)) {
+				unsigned mm = ntohl(((const struct sockaddr_in *)mask)->sin_addr.s_addr);
+				while (mm & 0x80000000U) { p++; mm <<= 1; }
+			}
+			inet_ntop(AF_INET, &((const struct sockaddr_in *)dst)->sin_addr, d, sizeof(d));
+			if (p)
+				sprintf(d + strlen(d), "/%u", p);
+		} else {
+			safe_strncpy(d, "?", sizeof(d));
+		}
+
+		printf("%s", d);
+		if (gw && gw->sa_family == AF_INET) {
+			inet_ntop(AF_INET, &((const struct sockaddr_in *)gw)->sin_addr, g, sizeof(g));
+			printf(" via %s", g);
+		}
+		ifname[0] = '\0';
+		if_indextoname(rtm->rtm_index, ifname);
+		if (ifname[0])
+			printf(" dev %s", ifname);
+		if (rtm->rtm_flags & RTF_GATEWAY)
+			printf(" proto static");
+		bb_putchar('\n');
+	}
+	free(buf);
+}
+
+/*
+ * --- setters ---------------------------------------------------------------
+ * link set  : SIOCSIFFLAGS / SIOCSIFMTU / SIOCSIFLLADDR
+ * addr add|del : SIOCAIFADDR / SIOCDIFADDR (with the netmask in one message)
+ * route add|del : PF_ROUTE rt_msghdr, same as the route applet
+ */
+static int darwin_ip_sock(void)
+{
+	int s = socket(AF_INET, SOCK_DGRAM, 0);
+	if (s < 0)
+		bb_simple_perror_msg_and_die("socket");
+	return s;
+}
+
+static void darwin_ip_sockaddr(struct sockaddr_in *sin, const char *addr)
+{
+	char buf[64];
+	char *slash;
+
+	safe_strncpy(buf, addr, sizeof(buf));
+	slash = strchr(buf, '/');
+	if (slash)
+		*slash = '\0';
+	memset(sin, 0, sizeof(*sin));
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	if (inet_pton(AF_INET, buf, &sin->sin_addr) != 1)
+		bb_error_msg_and_die("invalid address: %s", buf);
+}
+
+static int darwin_ip_prefix(const char *addr, int dflt)
+{
+	const char *slash = strchr(addr, '/');
+	return slash ? xatoi_positive(slash + 1) : dflt;
+}
+
+/* ip link set dev IFACE [up|down] [mtu N] [address MAC] */
+static void darwin_ip_link_set(char **args)
+{
+	int s = darwin_ip_sock();
+	const char *dev = NULL, *mac = NULL;
+	int up = -1, mtu = -1;
+
+	while (*args) {
+		if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev = *++args; args++;
+		} else if (strcmp(*args, "up") == 0) {
+			up = 1; args++;
+		} else if (strcmp(*args, "down") == 0) {
+			up = 0; args++;
+		} else if (strcmp(*args, "mtu") == 0 && args[1]) {
+			mtu = xatoi_positive(*++args); args++;
+		} else if (strcmp(*args, "address") == 0 && args[1]) {
+			mac = *++args; args++;
+		} else {
+			bb_error_msg_and_die("unsupported: ip link set %s", *args);
+		}
+	}
+	if (!dev)
+		bb_show_usage();
+
+	if (mac) {
+		struct ifreq ifr;
+		struct sockaddr_dl *sdl;
+		unsigned b[6];
+		int i;
+
+		memset(&ifr, 0, sizeof(ifr));
+		strncpy(ifr.ifr_name, dev, IFNAMSIZ - 1);
+		sdl = (struct sockaddr_dl *)&ifr.ifr_addr;
+		memset(&ifr.ifr_addr, 0, sizeof(ifr.ifr_addr));
+		sdl->sdl_len = offsetof(struct sockaddr_dl, sdl_data) + 6;
+		sdl->sdl_family = AF_LINK;
+		sdl->sdl_alen = 6;
+		if (sscanf(mac, "%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6)
+			bb_error_msg_and_die("invalid MAC: %s", mac);
+		for (i = 0; i < 6; i++)
+			sdl->sdl_data[i] = (unsigned char)b[i];
+		if (ioctl(s, SIOCSIFLLADDR, &ifr) < 0)
+			bb_perror_msg_and_die("can't set address on %s", dev);
+	}
+	if (mtu > 0) {
+		struct ifreq ifr;
+		memset(&ifr, 0, sizeof(ifr));
+		strncpy(ifr.ifr_name, dev, IFNAMSIZ - 1);
+		ifr.ifr_mtu = mtu;
+		if (ioctl(s, SIOCSIFMTU, &ifr) < 0)
+			bb_perror_msg_and_die("can't set mtu on %s", dev);
+	}
+	if (up >= 0) {
+		struct ifreq ifr;
+		memset(&ifr, 0, sizeof(ifr));
+		strncpy(ifr.ifr_name, dev, IFNAMSIZ - 1);
+		if (ioctl(s, SIOCGIFFLAGS, &ifr) < 0)
+			bb_perror_msg_and_die("can't read flags of %s", dev);
+		if (up)
+			ifr.ifr_flags |= IFF_UP;
+		else
+			ifr.ifr_flags &= ~IFF_UP;
+		if (ioctl(s, SIOCSIFFLAGS, &ifr) < 0)
+			bb_perror_msg_and_die("can't change flags of %s", dev);
+	}
+	close(s);
+}
+
+/* ip addr add|del ADDR[/PFX] dev IFACE */
+static void darwin_ip_addr_set(char **args, int add)
+{
+	int s = darwin_ip_sock();
+	const char *addr = NULL, *dev = NULL;
+	struct ifaliasreq ifra;
+	struct sockaddr_in *sin;
+	int plen;
+
+	if (*args && (*args)[0] != '-') {
+		addr = *args++;
+	}
+	while (*args) {
+		if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev = *++args; args++;
+		} else if (strcmp(*args, "peer") == 0 && args[1]) {
+			args += 2;                  /* accepted, unused */
+		} else {
+			bb_error_msg_and_die("unsupported: ip addr %s", *args);
+		}
+	}
+	if (!addr || !dev)
+		bb_show_usage();
+
+	plen = darwin_ip_prefix(addr, 32);
+	memset(&ifra, 0, sizeof(ifra));
+	strncpy(ifra.ifra_name, dev, IFNAMSIZ - 1);
+
+	sin = (struct sockaddr_in *)&ifra.ifra_addr;
+	darwin_ip_sockaddr(sin, addr);
+
+	sin = (struct sockaddr_in *)&ifra.ifra_mask;
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = htonl(plen >= 32 ? 0xffffffffU
+			: (plen <= 0 ? 0 : (0xffffffffU << (32 - plen))));
+
+	if (ioctl(s, add ? SIOCAIFADDR : SIOCDIFADDR, &ifra) < 0)
+		bb_perror_msg_and_die("%s %s on %s", add ? "can't add" : "can't delete", addr, dev);
+	close(s);
+}
+
+/* ip route add|del DST [via GW] [dev IFACE] */
+/* ---- tunnels: Darwin clones gif/stf interfaces instead of Linux's tunl0 ---- */
+static int darwin_if_ioctl(int cmd, struct ifreq *ifr)
+{
+	int fd = socket(AF_INET, SOCK_DGRAM, 0);
+	int rc;
+
+	if (fd < 0)
+		return -1;
+	rc = ioctl(fd, cmd, ifr);
+	close(fd);
+	return rc;
+}
+
+/* Linux shape: "gif0: ip/ip  remote A  local B" */
+static void darwin_ip_tunnel_show(void)
+{
+	struct ifaddrs *ifap, *ifa;
+	char last[IFNAMSIZ] = "";
+
+	if (getifaddrs(&ifap) != 0)
+		return;
+	for (ifa = ifap; ifa; ifa = ifa->ifa_next) {
+		struct ifreq ifr;
+		char src[64] = "any", dst[64] = "any";
+
+		if (!ifa->ifa_name || strncmp(ifa->ifa_name, "gif", 3) != 0)
+			continue;
+		if (strcmp(last, ifa->ifa_name) == 0)
+			continue;               /* one line per interface */
+		safe_strncpy(last, ifa->ifa_name, sizeof(last));
+
+		memset(&ifr, 0, sizeof(ifr));
+		safe_strncpy(ifr.ifr_name, ifa->ifa_name, IFNAMSIZ);
+		if (darwin_if_ioctl(SIOCGIFPSRCADDR, &ifr) == 0) {
+			struct sockaddr_in *sin = (struct sockaddr_in *)&ifr.ifr_addr;
+			if (sin->sin_family == AF_INET && sin->sin_addr.s_addr)
+				inet_ntop(AF_INET, &sin->sin_addr, src, sizeof(src));
+		}
+		memset(&ifr, 0, sizeof(ifr));
+		safe_strncpy(ifr.ifr_name, ifa->ifa_name, IFNAMSIZ);
+		if (darwin_if_ioctl(SIOCGIFPDSTADDR, &ifr) == 0) {
+			struct sockaddr_in *sin = (struct sockaddr_in *)&ifr.ifr_addr;
+			if (sin->sin_family == AF_INET && sin->sin_addr.s_addr)
+				inet_ntop(AF_INET, &sin->sin_addr, dst, sizeof(dst));
+		}
+		/* Linux prints "… remote A  local B  ttl inherit  nopmtudisc"; gif
+		 * inherits the TTL from the route, and PMTU-disc is not a knob here,
+		 * so only the field that is true on both is printed. */
+		printf("%s: ip/ip  remote %s  local %s  ttl inherit\n",
+				ifa->ifa_name, dst, src);
+	}
+	freeifaddrs(ifap);
+}
+
+/* add|change|del: SIOCIFCREATE + SIOCSIFPHYADDR / SIOCDIFPHYADDR / SIOCIFDESTROY.
+ * All of it needs root, which is why none of it is exercised by the test suite. */
+static void darwin_ip_tunnel_set(char **args, int add, int del)
+{
+	struct ifreq ifr;
+	struct ifaliasreq ifra;
+	const char *name = NULL, *remote = NULL, *local = NULL;
+	int rc;
+
+	while (args && *args) {
+		if (strcmp(*args, "mode") == 0 && args[1]) {
+			args += 2;
+		} else if (strcmp(*args, "remote") == 0 && args[1]) {
+			remote = *++args; args++;
+		} else if (strcmp(*args, "local") == 0 && args[1]) {
+			local = *++args; args++;
+		} else if (strcmp(*args, "ttl") == 0 && args[1]) {
+			bb_error_msg("ttl is not settable on Darwin gif tunnels; ignored");
+			args += 2;
+		} else if (!name) {
+			name = *args++;
+		} else {
+			bb_error_msg_and_die("unsupported: ip tunnel %s", *args);
+		}
+	}
+	if (!name)
+		bb_show_usage();
+	xfunc_error_retval = 1;   /* a failed mutation must not exit 0 */
+
+	memset(&ifr, 0, sizeof(ifr));
+	memcpy(ifr.ifr_name, "gif", 3);
+
+	if (del) {
+		memset(&ifra, 0, sizeof(ifra));
+		safe_strncpy(ifra.ifra_name, name, sizeof(ifra.ifra_name));
+		if (darwin_if_ioctl(SIOCDIFPHYADDR, (struct ifreq *)&ifra) != 0)
+			bb_perror_msg("cannot clear tunnel endpoints on %s", name);
+		memset(&ifr, 0, sizeof(ifr));
+		safe_strncpy(ifr.ifr_name, name, IFNAMSIZ);
+		if (darwin_if_ioctl(SIOCIFDESTROY, &ifr) != 0)
+			bb_perror_msg_and_die("cannot destroy %s", name);
+		return;
+	}
+
+	/* create (ignored when the interface already exists) */
+	if (add) {
+		memset(&ifr, 0, sizeof(ifr));
+		safe_strncpy(ifr.ifr_name, name, IFNAMSIZ);
+		darwin_if_ioctl(SIOCIFCREATE, &ifr);
+	}
+
+	if (remote || local) {
+		memset(&ifra, 0, sizeof(ifra));
+		safe_strncpy(ifra.ifra_name, name, sizeof(ifra.ifra_name));
+		/* ifra_addr/ifra_broadaddr are plain sockaddr here; fill a
+		 * sockaddr_in and copy its bytes over (same layout, sa_len first). */
+		{
+			struct sockaddr_in sin;
+
+			memset(&sin, 0, sizeof(sin));
+			sin.sin_len = sizeof(sin);
+			sin.sin_family = AF_INET;
+			if (local && inet_pton(AF_INET, local, &sin.sin_addr) != 1)
+				bb_error_msg_and_die("invalid local address: %s", local);
+			memcpy(&ifra.ifra_addr, &sin, sizeof(sin));
+			if (remote && inet_pton(AF_INET, remote, &sin.sin_addr) != 1)
+				bb_error_msg_and_die("invalid remote address: %s", remote);
+			if (!remote)
+				memset(&sin.sin_addr, 0, sizeof(sin.sin_addr));
+			memcpy(&ifra.ifra_broadaddr, &sin, sizeof(sin));
+		}
+		if (darwin_if_ioctl(SIOCSIFPHYADDR, (struct ifreq *)&ifra) != 0)
+			bb_perror_msg_and_die("cannot set tunnel endpoints on %s", name);
+	}
+
+	/* bring it up */
+	memset(&ifr, 0, sizeof(ifr));
+	safe_strncpy(ifr.ifr_name, name, IFNAMSIZ);
+	rc = darwin_if_ioctl(SIOCGIFFLAGS, &ifr);
+	if (rc == 0) {
+		ifr.ifr_flags |= IFF_UP;
+		if (darwin_if_ioctl(SIOCSIFFLAGS, &ifr) != 0)
+			bb_perror_msg("cannot bring %s up", name);
+	}
+}
+
+/* ARP cache: sysctl(NET_RT_FLAGS, RTF_LLINFO) is what `arp -an` reads.
+ * Linux prints "ADDR dev IF lladdr MAC STATE"; match that shape. */
+static int darwin_ip_neigh_read(char **out_buf, size_t *out_len)
+{
+	int mib[6] = { CTL_NET, PF_ROUTE, 0, AF_INET, NET_RT_FLAGS, RTF_LLINFO };
+	size_t needed = 0;
+
+	if (sysctl(mib, 6, NULL, &needed, NULL, 0) != 0 || needed == 0)
+		return -1;
+	*out_buf = xmalloc(needed);
+	if (sysctl(mib, 6, *out_buf, &needed, NULL, 0) != 0) {
+		free(*out_buf);
+		return -1;
+	}
+	*out_len = needed;
+	return 0;
+}
+
+/* rtm -> "dev name", "lladdr aa:bb:..", dst sockaddr and llinfo flags */
+static void darwin_ip_neigh_parse(struct rt_msghdr *rtm, char *ifname, size_t ifsz,
+		char *lladdr, size_t llsz, struct sockaddr_in *dst)
+{
+	const struct sockaddr *sa = (const struct sockaddr *)(rtm + 1);
+	char *end = (char *)rtm + rtm->rtm_msglen;
+	int i;
+
+	ifname[0] = '\0';
+	lladdr[0] = '\0';
+	memset(dst, 0, sizeof(*dst));
+	if (rtm->rtm_index)
+		if_indextoname(rtm->rtm_index, ifname);
+	for (i = 1; i < RTAX_MAX && (char *)sa < end; i++) {
+		if (!(rtm->rtm_addrs & (1 << i)))
+			continue;
+		if (i == RTAX_DST && sa->sa_family == AF_INET)
+			memcpy(dst, sa, sizeof(*dst) < sa->sa_len ? sizeof(*dst) : sa->sa_len);
+		if (i == RTAX_GATEWAY && sa->sa_family == AF_LINK) {
+			const struct sockaddr_dl *sdl = (const struct sockaddr_dl *)sa;
+			const unsigned char *ll = (const unsigned char *)LLADDR(sdl);
+			size_t k, n = 0;
+
+			for (k = 0; k < (size_t)sdl->sdl_alen && n + 4 < llsz; k++)
+				n += sprintf(lladdr + n, k ? ":%02x" : "%02x", ll[k]);
+		}
+		sa = (const struct sockaddr *)((const char *)sa + ((sa->sa_len + 3) & ~3));
+	}
+}
+
+static void darwin_ip_neigh(char **args)
+{
+	char *buf, *lim, *next;
+	size_t len = 0;
+	const char *dev_filter = NULL;
+
+	while (args && *args) {
+		if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev_filter = *++args;
+			args++;
+		} else if (strcmp(*args, "to") == 0 || strcmp(*args, "nud") == 0) {
+			args += 2;      /* accepted, not filtered on */
+		} else {
+			bb_error_msg_and_die("unsupported: ip neigh %s", *args);
+		}
+	}
+
+	if (darwin_ip_neigh_read(&buf, &len) != 0)
+		return;                 /* empty cache is not an error */
+	lim = buf + len;
+	for (next = buf; next + sizeof(struct rt_msghdr) <= lim; ) {
+		struct rt_msghdr *rtm = (struct rt_msghdr *)next;
+		char ifname[IFNAMSIZ], lladdr[64], abuf[64];
+		struct sockaddr_in dst;
+
+		if (rtm->rtm_msglen == 0)
+			break;
+		next += rtm->rtm_msglen;
+		if (rtm->rtm_version != RTM_VERSION || !(rtm->rtm_flags & RTF_LLINFO))
+			continue;
+		darwin_ip_neigh_parse(rtm, ifname, sizeof(ifname), lladdr, sizeof(lladdr), &dst);
+		if (dst.sin_family != AF_INET)
+			continue;
+		if (dev_filter && strcmp(dev_filter, ifname) != 0)
+			continue;
+		inet_ntop(AF_INET, &dst.sin_addr, abuf, sizeof(abuf));
+		printf("%s dev %s", abuf, ifname[0] ? ifname : "?");
+		if (lladdr[0])
+			printf(" lladdr %s", lladdr);
+		puts(" REACHABLE");
+	}
+	free(buf);
+}
+
+/* Drop every entry (or those on --dev): RTM_DELETE on a PF_ROUTE socket. */
+static void darwin_ip_neigh_flush(char **args)
+{
+	char *buf, *lim, *next;
+	size_t len = 0;
+	const char *dev_filter = NULL;
+	int s;
+
+	while (args && *args) {
+		if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev_filter = *++args;
+			args++;
+		} else if (strcmp(*args, "to") == 0 || strcmp(*args, "nud") == 0) {
+			args += 2;
+		} else {
+			bb_error_msg_and_die("unsupported: ip neigh flush %s", *args);
+		}
+	}
+	if (darwin_ip_neigh_read(&buf, &len) != 0)
+		return;
+	s = socket(PF_ROUTE, SOCK_RAW, 0);
+	if (s < 0) {
+		free(buf);
+		bb_simple_perror_msg_and_die("socket(PF_ROUTE)");
+	}
+	lim = buf + len;
+	for (next = buf; next + sizeof(struct rt_msghdr) <= lim; ) {
+		struct rt_msghdr *rtm = (struct rt_msghdr *)next;
+		char ifname[IFNAMSIZ], lladdr[64], abuf[64];
+		struct sockaddr_in dst;
+		struct {
+			struct rt_msghdr hdr;
+			struct sockaddr_in dst;
+			struct sockaddr_in mask;
+		} msg;
+
+		if (rtm->rtm_msglen == 0)
+			break;
+		next += rtm->rtm_msglen;
+		if (rtm->rtm_version != RTM_VERSION || !(rtm->rtm_flags & RTF_LLINFO))
+			continue;
+		darwin_ip_neigh_parse(rtm, ifname, sizeof(ifname), lladdr, sizeof(lladdr), &dst);
+		if (dst.sin_family != AF_INET)
+			continue;
+		if (dev_filter && strcmp(dev_filter, ifname) != 0)
+			continue;
+
+		memset(&msg, 0, sizeof(msg));
+		msg.hdr.rtm_version = RTM_VERSION;
+		msg.hdr.rtm_type = RTM_DELETE;
+		msg.hdr.rtm_seq = (int)getpid();
+		msg.hdr.rtm_flags = RTF_LLINFO | RTF_HOST;
+		msg.hdr.rtm_addrs = RTA_DST | RTA_NETMASK;
+		msg.hdr.rtm_msglen = sizeof(msg);
+		msg.hdr.rtm_index = rtm->rtm_index;
+		msg.dst = dst;
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		msg.mask.sin_addr.s_addr = 0xffffffffU;
+		if (write(s, &msg, sizeof(msg)) < 0) {
+			inet_ntop(AF_INET, &dst.sin_addr, abuf, sizeof(abuf));
+			bb_perror_msg("cannot remove neighbour %s", abuf);
+		}
+	}
+	close(s);
+	free(buf);
+}
+
+static void darwin_ip_route_set(char **args, int add)
+{
+	int s;
+	struct {
+		struct rt_msghdr hdr;
+		struct sockaddr_in dst;
+		struct sockaddr_in gw;
+		struct sockaddr_in mask;
+	} msg;
+	char dest[64] = "";
+	const char *gw = NULL, *dev = NULL;
+	unsigned char addrs = 0;
+	char *cp;
+	int i;
+
+	while (*args) {
+		if (strcmp(*args, "via") == 0 && args[1]) {
+			gw = *++args; args++;
+		} else if (strcmp(*args, "dev") == 0 && args[1]) {
+			dev = *++args; args++;
+		} else if (strcmp(*args, "proto") == 0 && args[1]) {
+			args += 2;
+		} else if (!dest[0]) {
+			safe_strncpy(dest, *args, sizeof(dest));
+			args++;
+		} else {
+			bb_error_msg_and_die("unsupported: ip route %s", *args);
+		}
+	}
+	if (!dest[0])
+		bb_show_usage();
+
+	s = socket(PF_ROUTE, SOCK_RAW, 0);
+	if (s < 0)
+		bb_simple_perror_msg_and_die("socket(PF_ROUTE)");
+
+	memset(&msg, 0, sizeof(msg));
+	msg.hdr.rtm_version = RTM_VERSION;
+	msg.hdr.rtm_type = add ? RTM_ADD : RTM_DELETE;
+	msg.hdr.rtm_seq = (int)getpid();
+	msg.hdr.rtm_flags = RTF_UP;
+
+	msg.dst.sin_len = sizeof(msg.dst);
+	msg.dst.sin_family = AF_INET;
+	if (strcmp(dest, "default") == 0) {
+		msg.dst.sin_addr.s_addr = 0;
+	} else {
+		darwin_ip_sockaddr(&msg.dst, dest);
+	}
+	addrs |= RTA_DST;
+
+	{
+		int plen = darwin_ip_prefix(dest, strcmp(dest, "default") == 0 ? 0 : 32);
+		if (plen <= 0 && strcmp(dest, "default") != 0)
+			plen = 32;
+		msg.mask.sin_len = sizeof(msg.mask);
+		msg.mask.sin_family = AF_INET;
+		msg.mask.sin_addr.s_addr = htonl(plen >= 32 ? 0xffffffffU
+				: (plen <= 0 ? 0 : (0xffffffffU << (32 - plen))));
+		addrs |= RTA_NETMASK;
+		if (plen == 32)
+			msg.hdr.rtm_flags |= RTF_HOST;
+	}
+
+	if (gw) {
+		msg.gw.sin_len = sizeof(msg.gw);
+		msg.gw.sin_family = AF_INET;
+		if (inet_pton(AF_INET, gw, &msg.gw.sin_addr) != 1)
+			bb_error_msg_and_die("invalid gateway: %s", gw);
+		msg.hdr.rtm_flags |= RTF_GATEWAY;
+		addrs |= RTA_GATEWAY;
+	}
+
+	msg.hdr.rtm_addrs = addrs;
+	if (dev)
+		msg.hdr.rtm_index = if_nametoindex(dev);
+
+	cp = (char *)(&msg.hdr + 1);
+	for (i = 1; i < RTAX_MAX; i++) {
+		struct sockaddr *sa;
+		int n;
+		if (!(addrs & (1 << i)))
+			continue;
+		switch (i) {
+		case RTAX_DST:     sa = (struct sockaddr *)&msg.dst; break;
+		case RTAX_GATEWAY: sa = (struct sockaddr *)&msg.gw; break;
+		case RTAX_NETMASK: sa = (struct sockaddr *)&msg.mask; break;
+		default: continue;
+		}
+		n = (sa->sa_len + 3) & ~3;
+		memcpy(cp, sa, sa->sa_len);
+		cp += n;
+	}
+	msg.hdr.rtm_msglen = (u_short)(cp - (char *)&msg);
+
+	if (write(s, &msg, msg.hdr.rtm_msglen) < 0)
+		bb_perror_msg_and_die("%s %s", add ? "add" : "delete", dest);
+	close(s);
+}
+
+static int darwin_ip_usage(void)
+{
+	bb_show_usage();
+	return 1;
+}
+
+int ip_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int ip_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *cmd;
+	char *verb;
+	int want_link = 0, want_addr = 0, want_route = 0, want_neigh = 0, want_tunnel = 0;
+
+	++argv;
+	/* skip common option words the way iproute2 accepts them */
+	while (*argv && (*argv)[0] == '-')
+		argv++;
+
+	if (!*argv)
+		return darwin_ip_usage();
+
+	cmd = *argv;
+	if (is_prefixed_with(cmd, "link") || strcmp(cmd, "l") == 0) {
+		want_link = 1;
+		cmd = "link";
+	} else if (is_prefixed_with(cmd, "addr") || strcmp(cmd, "a") == 0) {
+		want_addr = 1;
+		cmd = "addr";
+	} else if (is_prefixed_with(cmd, "route") || strcmp(cmd, "r") == 0
+		|| strcmp(cmd, "ro") == 0
+	) {
+		want_route = 1;
+		cmd = "route";
+	} else if (is_prefixed_with(cmd, "tunnel") || is_prefixed_with(cmd, "tun")) {
+		want_tunnel = 1;
+		cmd = "tunnel";
+	} else if (is_prefixed_with(cmd, "neigh") || is_prefixed_with(cmd, "neighbor")) {
+		want_neigh = 1;
+		cmd = "neigh";
+	} else {
+		bb_error_msg_and_die("only 'link', 'addr', 'route' and 'neigh' are supported on Darwin");
+	}
+
+	/* sub-verb: show/list print, add/del/set mutate */
+	verb = argv[1];
+
+	if (want_link) {
+		if (!verb || !strcmp(verb, "show") || !strcmp(verb, "list"))
+			darwin_ip_link();
+		else if (!strcmp(verb, "set"))
+			darwin_ip_link_set(argv + 2);
+		else
+			bb_error_msg_and_die("unsupported: ip link %s", verb);
+	} else if (want_addr) {
+		if (!verb || !strcmp(verb, "show") || !strcmp(verb, "list"))
+			darwin_ip_addr();
+		else if (!strcmp(verb, "add"))
+			darwin_ip_addr_set(argv + 2, 1);
+		else if (!strcmp(verb, "del") || !strcmp(verb, "delete"))
+			darwin_ip_addr_set(argv + 2, 0);
+		else
+			bb_error_msg_and_die("unsupported: ip addr %s", verb);
+	} else if (want_tunnel) {
+		if (!verb || !strcmp(verb, "show") || !strcmp(verb, "list"))
+			darwin_ip_tunnel_show();
+		else if (!strcmp(verb, "add"))
+			darwin_ip_tunnel_set(argv + 2, 1, 0);
+		else if (!strcmp(verb, "change") || !strcmp(verb, "set"))
+			darwin_ip_tunnel_set(argv + 2, 0, 0);
+		else if (!strcmp(verb, "del") || !strcmp(verb, "delete"))
+			darwin_ip_tunnel_set(argv + 2, 0, 1);
+		else
+			bb_error_msg_and_die("unsupported: ip tunnel %s", verb);
+	} else if (want_neigh) {
+		/* Match the Linux applet: only "show" (or no verb) prints, only
+		 * "flush" with a filter is accepted, everything else is an error. */
+		if (!verb)
+			darwin_ip_neigh(argv + 1);
+		else if (!strcmp(verb, "show"))
+			darwin_ip_neigh(argv + 2);
+		else if (!strcmp(verb, "flush") || !strcmp(verb, "del") || !strcmp(verb, "delete")) {
+			if (!argv[2])
+				bb_error_msg_and_die("ip neigh flush needs a filter");
+			darwin_ip_neigh_flush(argv + 2);
+		} else
+			bb_error_msg_and_die("unsupported: ip neigh %s", verb);
+	} else if (want_route) {
+		if (!verb || !strcmp(verb, "show") || !strcmp(verb, "list"))
+			darwin_ip_route();
+		else if (!strcmp(verb, "add"))
+			darwin_ip_route_set(argv + 2, 1);
+		else if (!strcmp(verb, "del") || !strcmp(verb, "delete"))
+			darwin_ip_route_set(argv + 2, 0);
+		else
+			bb_error_msg_and_die("unsupported: ip route %s", verb);
+	}
+
+	(void)cmd;
+	return EXIT_SUCCESS;
+}

+#if defined(__APPLE__)
+/*
+ * Darwin port: if_readlist() and friends speak rtnetlink, which does not exist
+ * here.  getifaddrs(3) gives everything the printer needs in one pass: the
+ * flag word, one sockaddr per address family, and ifa_data pointing at a
+ * struct if_data with the metrics (mtu, bytes, packets, errors).
+ *
+ * Output follows macOS ifconfig closely enough for grep/awk use:
+ *   en0: flags=8863<UP,BROADCAST,SMART,RUNNING,SIMPLEX,MULTICAST> mtu 1500
+ *           ether a4:83:e7:xx:xx:xx
+ *           inet 192.168.1.24 netmask 0xffffff00 broadcast 192.168.1.255
+ *           inet6 fe80::1c2b:...%en0 prefixlen 64 scopeid 0x4
+ *           status: active
+ * Setting anything is not supported (see ifconfig.c's Darwin branch).
+ */
+#include <ifaddrs.h>
+#include <net/if_dl.h>
+#include <net/if_var.h>
+
+static void darwin_print_flags(int flags)
+{
+	static const struct {
+		unsigned bit;
+		const char *name;
+	} names[] = {
+		{ IFF_UP,          "UP"          },
+		{ IFF_BROADCAST,   "BROADCAST"   },
+		{ IFF_DEBUG,       "DEBUG"       },
+		{ IFF_LOOPBACK,    "LOOPBACK"    },
+		{ IFF_POINTOPOINT, "POINTOPOINT" },
+		{ IFF_NOTRAILERS,  "NOTRAILERS"  },
+		{ IFF_RUNNING,     "RUNNING"     },
+		{ IFF_NOARP,       "NOARP"       },
+		{ IFF_PROMISC,     "PROMISC"     },
+		{ IFF_ALLMULTI,    "ALLMULTI"    },
+		{ IFF_MULTICAST,   "MULTICAST"   },
+	};
+	unsigned i;
+	int first = 1;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (flags & names[i].bit) {
+			if (!first)
+				bb_putchar(',');
+			fputs(names[i].name, stdout);
+			first = 0;
+		}
+	}
+}
+
+/* 0xffffff00 style netmask, the way BSD ifconfig prints it */
+static void darwin_print_netmask(const struct sockaddr *sa)
+{
+	const struct sockaddr_in *sin = (const struct sockaddr_in *)sa;
+
+	if (!sa || sa->sa_family != AF_INET)
+		return;
+	printf(" netmask 0x%08x", (unsigned)ntohl(sin->sin_addr.s_addr));
+}
+
+static int darwin_display_interfaces(char *ifname)
+{
+	struct ifaddrs *ifap, *ifa;
+	int shown = 0;
+
+	if (getifaddrs(&ifap) != 0) {
+		bb_perror_msg("getifaddrs");
+		return 1;
+	}
+
+	for (ifa = ifap; ifa; ifa = ifa->ifa_next) {
+		/* One pass per interface: only act on the AF_LINK entry, which is
+		 * the one that carries flags and if_data, then print every
+		 * address that belongs to that name. */
+		struct ifaddrs *j;
+		const struct if_data *ifd;
+
+		if (!(ifa->ifa_flags & IFF_UP) && ifa != ifap)
+			continue;
+		if (ifa->ifa_addr == NULL)
+			continue;
+		if (ifa->ifa_addr->sa_family != AF_LINK)
+			continue;
+		if (ifname && ifname != IFNAME_SHOW_DOWNED_TOO && strcmp(ifname, ifa->ifa_name) != 0)
+			continue;
+		/* skip the address families already printed for this name */
+		{
+			int dup = 0;
+			for (j = ifap; j != ifa; j = j->ifa_next) {
+				if (j->ifa_addr
+				 && j->ifa_addr->sa_family == AF_LINK
+				 && strcmp(j->ifa_name, ifa->ifa_name) == 0
+				) {
+					dup = 1;
+					break;
+				}
+			}
+			if (dup)
+				continue;
+		}
+
+		ifd = (const struct if_data *)ifa->ifa_data;
+		printf("%s: flags=%x<", ifa->ifa_name, (unsigned)ifa->ifa_flags);
+		darwin_print_flags(ifa->ifa_flags);
+		bb_putchar('>');
+		if (ifd)
+			printf(" mtu %u", (unsigned)ifd->ifi_mtu);
+		bb_putchar('\n');
+
+		for (j = ifap; j; j = j->ifa_next) {
+			if (!j->ifa_addr || strcmp(j->ifa_name, ifa->ifa_name) != 0)
+				continue;
+			switch (j->ifa_addr->sa_family) {
+			case AF_LINK: {
+				const struct sockaddr_dl *sdl = (const struct sockaddr_dl *)j->ifa_addr;
+				const unsigned char *mac;
+				if (sdl->sdl_alen != 6)
+					break;
+				mac = (const unsigned char *)LLADDR(sdl);
+				printf("\tether %02x:%02x:%02x:%02x:%02x:%02x\n",
+					mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+				break;
+			}
+			case AF_INET: {
+				char buf[64];
+				const struct sockaddr_in *sin = (const struct sockaddr_in *)j->ifa_addr;
+				inet_ntop(AF_INET, &sin->sin_addr, buf, sizeof(buf));
+				printf("\tinet %s", buf);
+				darwin_print_netmask(j->ifa_netmask);
+				if (j->ifa_broadaddr && (j->ifa_flags & IFF_BROADCAST)) {
+					const struct sockaddr_in *b = (const struct sockaddr_in *)j->ifa_broadaddr;
+					inet_ntop(AF_INET, &b->sin_addr, buf, sizeof(buf));
+					printf(" broadcast %s", buf);
+				}
+				bb_putchar('\n');
+				break;
+			}
+			case AF_INET6: {
+				char buf[64];
+				const struct sockaddr_in6 *sin6 = (const struct sockaddr_in6 *)j->ifa_addr;
+				const unsigned char *m = ((const struct sockaddr_in6 *)j->ifa_netmask)->sin6_addr.s6_addr;
+				int plen = 0;
+				unsigned k;
+
+				for (k = 0; k < 16; k++)
+					plen += __builtin_popcount(m[k]);
+				inet_ntop(AF_INET6, &sin6->sin6_addr, buf, sizeof(buf));
+				printf("\tinet6 %s prefixlen %d\n", buf, plen);
+				break;
+			}
+			default:
+				break;
+			}
+		}
+
+		if (ifd) {
+			printf("\tstatus: %s\n", (ifa->ifa_flags & IFF_RUNNING) ? "active" : "inactive");
+			if (ifd->ifi_ibytes || ifd->ifi_obytes) {
+				printf("\t%llu bytes in, %llu bytes out\n",
+					(unsigned long long)ifd->ifi_ibytes,
+					(unsigned long long)ifd->ifi_obytes);
+			}
+		}
+		shown++;
+	}
+
+	freeifaddrs(ifap);
+	if (!shown && ifname && ifname != IFNAME_SHOW_DOWNED_TOO) {
+		/* Match the Linux wording (and its shape) so stderr parses the
+		 * same way on both platforms. */
+		bb_error_msg("%s: error fetching interface information: Device not found",
+				ifname);
+		return 1;
+	}
+	return 0;
+}
+#endif /* __APPLE__ */
+
 int FAST_FUNC display_interfaces(char *ifname)
 {
+#if defined(__APPLE__)
+	return darwin_display_interfaces(ifname);
+#else
 	struct interface *ife;
 	int res;
 	struct iface_list ilist;
@@ -1104,9 +1289,10 @@ int FAST_FUNC display_interfaces(char *ifname)
 	res = do_if_print(ife, /*show_downed_too:*/ 1);
  ret:
 	return (res < 0); /* status < 0 == 1 -- error */
+#endif /* !__APPLE__ */
 }
 

+/*
+ * APFS volumes in one container share their free space, so statvfs() reports
+ * container-wide usage: df would claim "/" is 71% full when the sealed system
+ * volume actually holds ~13 GB.  /bin/df asks the volume itself via
+ * ATTR_VOL_SPACEUSED, whose reply is a packed { uint32_t length; off_t used; }
+ * - note the value sits at offset 4, not 8, so it cannot be read through a
+ * normally-aligned struct.
+ */
+#include <sys/attr.h>
+
+static unsigned long long darwin_volume_used(const char *path)
+{
+	struct attrlist al;
+	unsigned char buf[32];
+	uint64_t used;
+
+	memset(&al, 0, sizeof(al));
+	al.bitmapcount = ATTR_BIT_MAP_COUNT;
+	al.volattr = ATTR_VOL_INFO | ATTR_VOL_SPACEUSED;
+	memset(buf, 0, sizeof(buf));
+	if (getattrlist(path, &al, buf, sizeof(buf), 0) != 0)
+		return 0;
+	memcpy(&used, buf + sizeof(uint32_t), sizeof(used));
+	return (unsigned long long)used;
+}

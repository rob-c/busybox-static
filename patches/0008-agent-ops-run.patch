+/* ---------- run: capture ---------- */
+
+/* ---------- timeline: one line, one timestamp, both streams ---------- */
+
+/* The two pipes are separate, so byte order between them is not recoverable;
+ * what IS recoverable is the order in which this process read each complete
+ * line. Stamping at read time is the honest approximation, and it is far
+ * better than the two-section view, which loses the interleaving entirely.
+ * Timestamps are CLOCK_MONOTONIC microseconds since the child was forked. */
+struct tlrec {
+	unsigned long long ns;
+	char stream;      /* 'o' or 'e' */
+	char *text;
+};
+
+static struct {
+	struct tlrec *v;
+	unsigned n, cap;
+	size_t bytes, budget;          /* budget: hard cap on held records */
+	int truncated;
+	unsigned long long start_ns;
+	unsigned long long start_unix_us;
+	int nanosec;                 /* --stamp-ns: 9 digits instead of 6 */
+	unsigned res_ns;
+	unsigned out_truncated;
+	size_t out_budget;
+	char *part[2];    /* partial line per stream */
+	size_t plen[2], pcap[2];
+	int on;
+} tl;
+
+static void tl_put(int i, const char *p, size_t n, unsigned long long ns)
+{
+	struct tlrec *r;
+
+	if (tl.bytes + n + 1 > tl.budget) {
+		tl.truncated = 1;
+		return;
+	}
+	if (tl.n == tl.cap) {
+		tl.cap = tl.cap ? tl.cap * 2 : 256;
+		tl.v = xrealloc(tl.v, tl.cap * sizeof(tl.v[0]));
+	}
+	r = &tl.v[tl.n++];
+	r->ns = ns;
+	r->stream = i ? 'e' : 'o';
+	r->text = xmalloc(n + 1);
+	memcpy(r->text, p, n);
+	r->text[n] = '\0';
+	tl.bytes += n + 1;
+}
+
+/* Assemble lines per stream; a line is stamped when its newline arrives. */
+static void tl_feed(int i, const char *p, size_t n)
+{
+	unsigned long long ns;
+
+	if (!tl.on)
+		return;
+	ns = monotonic_ns() - tl.start_ns;
+	while (n) {
+		const char *nl = memchr(p, '\n', n);
+		size_t take = nl ? (size_t)(nl - p) : n;
+
+		if (tl.plen[i] + take + 1 > tl.pcap[i]) {
+			tl.pcap[i] = (tl.plen[i] + take + 1) * 2;
+			tl.part[i] = xrealloc(tl.part[i], tl.pcap[i]);
+		}
+		memcpy(tl.part[i] + tl.plen[i], p, take);
+		tl.plen[i] += take;
+		p += take;
+		n -= take;
+		if (nl) {
+			tl_put(i, tl.part[i], tl.plen[i], ns);
+			tl.plen[i] = 0;
+			p++;
+			n--;
+		}
+	}
+}
+
+static void tl_flush_partials(void)
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		if (tl.plen[i]) {
+			tl_put(i, tl.part[i], tl.plen[i], monotonic_ns() - tl.start_ns);
+			tl.plen[i] = 0;
+		}
+	}
+}
+
+/* The held records are complete; the *printed* ones are bounded, so a small
+ * budget shortens the view without shortening the evidence on disk. */
+static int tl_line_len(const struct tlrec *r)
+{
+	return 30 + (int)strlen(r->text);   /* stamp + " out] " + text + "\n" */
+}
+
+/* ns mode: [   0.015623417 out]   us mode: [   0.015623 out] */
+static void tl_stamp(char *out, unsigned long long ns)
+{
+	unsigned long long s = ns / 1000000000ULL;
+	unsigned long long frac = ns % 1000000000ULL;
+	int n = 0, k, digits = tl.nanosec ? 9 : 6;
+	char t[24];
+
+	if (!tl.nanosec)
+		frac /= 1000ULL;             /* microseconds */
+	out[n++] = '[';
+	k = 0;
+	do { t[k++] = (char)('0' + (int)(s % 10)); s /= 10; } while (s);
+	while (k < 5) t[k++] = '0';          /* five columns, dmesg-ish */
+	while (k) out[n++] = t[--k];
+	out[n++] = '.';
+	k = digits;
+	while (k) { t[k - 1] = (char)('0' + (int)(frac % 10)); frac /= 10; k--; }
+	memcpy(out + n, t, (size_t)digits);
+	n += digits;
+	out[n++] = ' ';
+	out[n] = '\0';
+}
+
+static unsigned tl_head_count(size_t budget)
+{
+	size_t used = 0;
+	unsigned i;
+
+	for (i = 0; i < tl.n; i++) {
+		int n = tl_line_len(&tl.v[i]);
+
+		if (i && used + (size_t)n > budget) {
+			tl.out_truncated = 1;
+			break;
+		}
+		used += (size_t)n;
+	}
+	return i;
+}
+
+static unsigned tl_shown_count(void)
+{
+	return tl_head_count(tl.out_budget);
+}
+
+/* Newest lines that fit the budget: the failing assertion is at the end. */
+static unsigned tl_tail_count(size_t budget)
+{
+	size_t used = 0;
+	unsigned i = tl.n;
+
+	while (i > 0) {
+		int n = tl_line_len(&tl.v[i - 1]);
+
+		if (used + (size_t)n > budget)
+			break;
+		used += (size_t)n;
+		i--;
+	}
+	return tl.n - i;
+}
+
+/*
+ * Text mode shows head and tail, like the JSON view: a head-only view of a
+ * failing suite hides the failure. Three quarters of the budget goes to the
+ * head, the rest to the tail, and the omitted middle is one marker line.
+ */
+static unsigned tl_text_head(void)
+{
+	return tl_head_count(tl.out_budget * 3 / 4);
+}
+
+static unsigned tl_text_shown(void)
+{
+	unsigned head = tl_text_head();
+
+	if (head >= tl.n)
+		return head;
+	return head + tl_tail_count(tl.out_budget - tl.out_budget * 3 / 4);
+}
+
+static void tl_print_one(unsigned i)
+{
+	char st[40];
+
+	tl_stamp(st, tl.v[i].ns);
+	fputs(st, stdout);
+	printf("%s] %s\n", tl.v[i].stream == 'e' ? "err" : "out", tl.v[i].text);
+}
+
+static void tl_print_text(unsigned id)
+{
+	unsigned head = tl_text_head();
+	unsigned tail = 0;
+	unsigned i;
+
+	if (head < tl.n)
+		tail = tl_tail_count(tl.out_budget - tl.out_budget * 3 / 4);
+	if (head + tail > tl.n)
+		tail = tl.n - head;
+
+	for (i = 0; i < head; i++)
+		tl_print_one(i);
+	if (head + tail < tl.n)
+		printf("... [timeline truncated: %u of %u lines shown"
+				" (%u omitted); `log R%u --stream timeline' has them] ...\n",
+				head + tail, tl.n, tl.n - head - tail, id);
+	for (i = tl.n - tail; tail && i < tl.n; i++)
+		tl_print_one(i);
+}
+
+/* the same records, written once, unbounded, as evidence */
+static void tl_write_file(const char *dir)
+{
+	char *path = art_path(dir, "timeline");
+	int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	unsigned i;
+
+	free(path);
+	if (fd < 0)
+		return;
+	for (i = 0; i < tl.n; i++) {
+		char hdr[64];
+		char st[40];
+		int n;
+
+		tl_stamp(st, tl.v[i].ns);
+		n = sprintf(hdr, "%s%s] ", st, tl.v[i].stream == 'e' ? "err" : "out");
+
+		full_write(fd, hdr, (size_t)n);
+		full_write(fd, tl.v[i].text, strlen(tl.v[i].text));
+		full_write(fd, "\n", 1);
+	}
+	close(fd);
+}
+
+static void tl_print_json(void)
+{
+	unsigned i, show = tl_shown_count();
+	size_t used = 0;
+	int first = 1;
+
+	printf("\"started_unix_us\":%llu,\"stamp_ns\":%s,\"stamp_res_ns\":%u,"
+			"\"timeline\":[",
+			tl.start_unix_us, tl.nanosec ? "true" : "false", tl.res_ns);
+	for (i = 0; i < show; i++) {
+		int n = tl_line_len(&tl.v[i]);
+
+		printf("%s{\"ns\":%llu,\"us\":%llu,\"stream\":\"%s\",\"text\":",
+				first ? "" : ",", tl.v[i].ns, tl.v[i].ns / 1000,
+				tl.v[i].stream == 'e' ? "err" : "out");
+		json_write_str(tl.v[i].text);
+		putchar('}');
+		used += (size_t)n;
+		first = 0;
+	}
+	printf("],\"timeline_lines\":%u,\"timeline_shown\":%u,"
+			"\"timeline_truncated\":%s",
+			tl.n, i, (tl.truncated || tl.out_truncated) ? "true" : "false");
+}
+
+/* ---------- pty: the guest gets a terminal of its own ---------- */
+
+/*
+ * A pty run is the same execution with one substitution: instead of two pipes,
+ * the guest's fds 0/1/2 are the slave side of a fresh pty, and this process
+ * reads the master. Everything the guest writes to its terminal, including what
+ * it writes to /dev/tty, arrives there in order. The environment is untouched -
+ * fork/exec inherits it - so a pty run and a pipe run differ only where the
+ * guest itself notices isatty().
+ *
+ * Two platform facts shape the code below, both measured, not assumed:
+ *   - When the guest closes its side, Linux returns EIO from read(master) and
+ *     Darwin returns a 0-length read. Both mean EOF.
+ *   - Writing to the master after the guest's side is gone is EIO on Darwin and
+ *     a silent success on Linux, so a failed feed stops the feed on both.
+ */
+struct pty_box {
+	int master;
+	char slave[128];
+	int cols;
+	int rows;
+};
+
+/* Allocate master + slave. Both platforms have /dev/ptmx; grantpt/unlockpt are
+ * POSIX and Darwin aliases them. */
+static int pty_alloc(struct pty_box *pb)
+{
+	int m;
+	const char *name;
+
+	m = open("/dev/ptmx", O_RDWR | O_NOCTTY);
+	if (m < 0)
+		return -1;
+	if (grantpt(m) != 0 || unlockpt(m) != 0) {
+		close(m);
+		return -1;
+	}
+	name = ptsname(m);
+	if (!name || strlen(name) >= sizeof(pb->slave)) {
+		close(m);
+		return -1;
+	}
+	strcpy(pb->slave, name);
+	pb->master = m;
+	return 0;
+}
+
+/* The size the guest's terminal reports. An explicit --pty-size wins; otherwise
+ * the parent's own terminal is inherited (that is the "parent environment" a
+ * full-screen guest actually cares about); otherwise the classic 80x24, so
+ * `stty size` answers instead of printing 0 0. */
+static void pty_pick_size(struct pty_box *pb)
+{
+	int i, cols = pty_req_cols, rows = pty_req_rows;
+
+	if (!(cols > 0 && rows > 0)) {
+		struct winsize ws;
+
+		for (i = 0; i <= 2; i++) {
+			if (isatty(i) && ioctl(i, TIOCGWINSZ, &ws) == 0
+			 && ws.ws_col > 0 && ws.ws_row > 0
+			) {
+				cols = ws.ws_col;
+				rows = ws.ws_row;
+				break;
+			}
+		}
+	}
+	if (!(cols > 0 && rows > 0)) {
+		cols = DEFAULT_COLS;
+		rows = DEFAULT_ROWS;
+	}
+	pb->cols = cols;
+	pb->rows = rows;
+}
+
+/*
+ * Line discipline. The point is that the captured bytes are the guest's own:
+ * no echo (a terminal would otherwise repeat the fed stdin into the capture)
+ * and no ONLCR (a terminal would otherwise turn every "\n" into "\r\n", so a
+ * pty run and a pipe run of the same command would disagree). ICANON and ISIG
+ * stay on, so a guest that reads a line still gets line editing and a real EOF
+ * from VEOF. --pty-raw turns all of it off, for byte-transparent transports.
+ */
+static void pty_apply_termios(int fd)
+{
+	struct termios tio;
+
+	if (tcgetattr(fd, &tio) != 0)
+		return;
+	if (pty_raw) {
+		tio.c_iflag &= ~(IGNBRK | BRKINT | PARMRK | ISTRIP
+				| INLCR | IGNCR | ICRNL | IXON);
+		tio.c_oflag &= ~OPOST;
+		tio.c_lflag &= ~(ECHO | ECHONL | ICANON | ISIG | IEXTEN);
+		tio.c_cflag &= ~(CSIZE | PARENB);
+		tio.c_cflag |= CS8;
+	} else {
+		tio.c_oflag &= ~(ONLCR | OCRNL);
+		tio.c_lflag &= ~(ECHO | ECHONL);
+	}
+	tio.c_cc[VMIN] = 1;
+	tio.c_cc[VTIME] = 0;
+	tcsetattr(fd, TCSANOW, &tio);
+}
+
+/*
+ * Child side. Order matters twice:
+ *   - setsid() must precede the slave open, or the tty joins the parent's
+ *     session instead of becoming the guest's controlling terminal;
+ *   - setsid() fails for a process-group leader, which is why the parent does
+ *     NOT setpgid() in pty mode. After setsid() the guest's own pgid is its
+ *     pid, so the group kill the reaper uses still reaches it.
+ * TIOCSCTTY is asked for explicitly on both platforms so the controlling
+ * terminal does not depend on whether the open happened to be first.
+ */
+static void pty_child_setup(struct pty_box *pb, int set_stderr)
+{
+	int fd;
+
+	close(pb->master);
+	setsid();
+	fd = open(pb->slave, O_RDWR | O_NOCTTY);
+	if (fd < 0) {
+		bb_perror_msg("can't open %s", pb->slave);
+		_exit(126);
+	}
+	if (ioctl(fd, TIOCSCTTY, 0) != 0) {
+		bb_perror_msg("can't make %s the controlling terminal", pb->slave);
+		_exit(126);
+	}
+	pty_apply_termios(fd);
+	{
+		struct winsize ws;
+
+		memset(&ws, 0, sizeof(ws));
+		ws.ws_col = (unsigned short)pb->cols;
+		ws.ws_row = (unsigned short)pb->rows;
+		ioctl(fd, TIOCSWINSZ, &ws);
+	}
+	dup2(fd, 0);
+	dup2(fd, 1);
+	if (set_stderr)
+		dup2(fd, 2);
+	if (fd > 2)
+		close(fd);
+}
+
+/*
+ * Drain the guest's streams until they are all closed, holding the deadline,
+ * the cancel signal and the capture quota while doing it.
+ *
+ *   fds[i]    stream to read (a pipe, or the pty master)
+ *   arts[i]   artifact to append it to
+ *   feed_to   master to write fed stdin into, or -1
+ *   feed_from stdin to copy into feed_to, or -1
+ *
+ * The fds array is rewritten as streams reach EOF, so the caller can close
+ * anything the loop left open.
+ */
+static void pump(int fds[3], int arts[3], int nr, int feed_to, int feed_from,
+		int feed_always, long deadline_ms, int kill_after_ms,
+		long capture_limit, pid_t pid, struct meta *m)
+{
+	struct pollfd pfd[4];
+	unsigned long long captured = 0, term_at = 0, last_data = 0;
+	long quota_used[3] = { 0, 0, 0 };
+	int open_count = 0, phase = 0, i;
+	char buf[16384];
+	char feed[4096];
+	size_t feed_len = 0, feed_off = 0;
+	int feed_done = (feed_to < 0 || feed_from < 0);
+	(void)0;
+	int feed_on_line = 1;   /* every byte fed so far ended on a newline */
+
+	for (i = 0; i < nr; i++) {
+		if (fds[i] >= 0)
+			open_count++;
+	}
+
+	while (open_count > 0) {
+		unsigned long long now = now_ms();
+		int rc;
+
+		if (phase == 0 && deadline_ms > 0 && (long)now >= deadline_ms) {
+			m->timed_out = 1;
+			kill(-pid, SIGTERM);
+			kill(pid, SIGTERM);
+			term_at = now;
+			phase = 1;
+		}
+		if (phase == 0 && idle_ms > 0 && last_data
+		 && (long)now - (long)last_data >= idle_ms
+		) {
+			/* The guest is not producing anything: that is the hang, not the
+			 * total runtime, which may be legitimately long. */
+			m->idle_out = 1;
+			kill(-pid, SIGTERM);
+			kill(pid, SIGTERM);
+			term_at = now;
+			phase = 1;
+		}
+		if (phase == 0 && bb_got_signal) {
+			m->cancelled = 1;
+			kill(-pid, SIGTERM);
+			kill(pid, SIGTERM);
+			term_at = now;
+			phase = 1;
+		}
+		if (phase == 1 && now - term_at >= (unsigned long long)kill_after_ms) {
+			kill(-pid, SIGKILL);
+			kill(pid, SIGKILL);
+			phase = 2;
+		}
+
+		for (i = 0; i < nr; i++) {
+			pfd[i].fd = fds[i];
+			pfd[i].events = POLLIN;
+			pfd[i].revents = 0;
+			/* the master is non-blocking: finish a partial feed only
+			 * when the terminal has room for it */
+			if (fds[i] == feed_to && feed_len > feed_off)
+				pfd[i].events |= POLLOUT;
+		}
+		/* The feed source is polled only when nothing is still pending: a
+		 * queue that took half of the last chunk must be given the other
+		 * half before the next read, or the bytes are lost. */
+		pfd[nr].fd = (feed_done || feed_off < feed_len) ? -1 : feed_from;
+		pfd[nr].events = POLLIN;
+		pfd[nr].revents = 0;
+
+		rc = poll(pfd, nr + 1, 100);
+		if (rc < 0) {
+			if (errno == EINTR)
+				continue;
+			break;
+		}
+		/* rc == 0 is only "no stream is ready": the feed still gets its turn. */
+
+		/* stdin first: a guest that prompts has the answer waiting.
+		 * Any readiness event counts, not just POLLIN: Darwin reports
+		 * POLLNVAL for /dev/null, which is very much a readable "no
+		 * input", and a FIFO with no writer reports POLLHUP. */
+		if (pfd[nr].fd >= 0 && (feed_always || pfd[nr].revents != 0)) {
+			ssize_t r = safe_read(feed_from, feed, sizeof(feed));
+
+			if (r > 0) {
+				feed_len = (size_t)r;
+				feed_off = 0;
+				feed_on_line = (feed[feed_len - 1] == '\n');
+			} else if (r == 0 || (errno != EINTR && errno != EAGAIN)) {
+				/* End of input. Under --pty-raw there is no line
+				 * discipline to carry a VEOF, so the feed just stops. */
+				feed_done = 1;
+				feed_len = feed_off = 0;
+				if (!pty_raw) {
+					/* One VEOF is EOF when the queue stopped on a line
+					 * boundary; with a trailing partial line the first
+					 * one only flushes that line, so a second is needed -
+					 * the two-Ctrl-D rule of a real terminal. */
+					feed[0] = '\004';
+					feed_len = 1;
+					if (!feed_on_line) {
+						feed[1] = '\004';
+						feed_len = 2;
+					}
+				}
+			}
+		}
+		if (feed_len > feed_off) {
+			ssize_t w = write(feed_to, feed + feed_off, feed_len - feed_off);
+
+			if (w > 0)
+				feed_off += (size_t)w;
+			else if (w < 0 && (errno == EAGAIN || errno == EINTR))
+				;   /* retried when the master reports POLLOUT */
+			else {
+				/* the guest's side is gone (EIO on Darwin) */
+				feed_done = 1;
+				feed_len = feed_off = 0;
+			}
+		}
+
+		if (rc == 0)
+			continue;
+		for (i = 0; i < nr; i++) {
+			ssize_t r, w = 0;
+
+			if (pfd[i].fd < 0)
+				continue;
+			if (!(pfd[i].revents & (POLLIN | POLLHUP | POLLERR)))
+				continue;
+			r = read(pfd[i].fd, buf, sizeof(buf));
+			if (r < 0 && (errno == EINTR || errno == EAGAIN))
+				continue;
+			if (r <= 0) {
+				/* r == 0 is EOF; r < 0 is EIO on Linux, which is
+				 * what a pty master reports once the guest's side
+				 * of the terminal is closed. Same meaning. */
+				close(pfd[i].fd);
+				fds[i] = -1;
+				pfd[i].fd = -1;
+				open_count--;
+				continue;
+			}
+			captured += (unsigned long long)r;
+			last_data = now;      /* the idle deadline measures silence, not runtime */
+			if (i == 0)
+				m->out_bytes += (unsigned long long)r;
+			else
+				m->err_bytes += (unsigned long long)r;
+			/* Keep the child unblocked: always drain, record what the
+			 * quota allows, and say so when evidence was dropped. */
+			if (quota_used[i] < capture_limit) {
+				long room = capture_limit - quota_used[i];
+				w = write(arts[i], buf, (size_t)(r < room ? r : room));
+				if (w < 0)
+					w = 0;
+				quota_used[i] += w;
+			}
+			if (quota_used[i] >= capture_limit && (size_t)r > (size_t)w)
+				m->capture_complete = 0;
+			tl_feed(i, buf, (size_t)r);
+		}
+	}
+	(void)captured;
+	tl_flush_partials();
+}
+
+/* Bound head+tail into ONE string, so JSON gets a single scalar. */
+static char *bounded_string(const char *path, size_t budget)
+{
+	int fd = open(path, O_RDONLY);
+	struct stat st;
+	size_t half = budget / 2;
+	char *head = NULL, *tail = NULL, *out;
+	ssize_t rh = 0, rt = 0;
+
+	if (fd < 0 || fstat(fd, &st) != 0) {
+		if (fd >= 0)
+			close(fd);
+		return xstrdup("");
+	}
+	head = xmalloc(half + 1);
+	rh = safe_read(fd, head, half);
+	if (rh < 0)
+		rh = 0;
+	head[rh] = '\0';
+	if ((unsigned long long)st.st_size > (unsigned long long)budget) {
+		tail = xmalloc(half + 1);
+		if (lseek(fd, (off_t)(st.st_size - (off_t)half), SEEK_SET) >= 0) {
+			rt = safe_read(fd, tail, half);
+			if (rt < 0)
+				rt = 0;
+			tail[rt] = '\0';
+		} else
+			tail[0] = '\0';
+		out = xasprintf("%s\n... [%llu bytes] ...\n%s", head,
+				(unsigned long long)st.st_size, tail ? tail : "");
+		free(tail);
+	} else {
+		out = xstrdup(head);
+	}
+	free(head);
+	close(fd);
+	return out;
+}

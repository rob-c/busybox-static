+/*
+ * Pipe an artifact through the brief applet (in a child, so getopt state is
+ * private) and return at most `budget` bytes of the reduced text.
+ * Returns NULL when brief is not built in or the artifact is empty.
+ */
+static char *brief_reduce(const char *path, size_t budget, int json)
+{
+#if ENABLE_BRIEF
+	struct stat sb;
+	char *buf, *av[5];
+	size_t len = 0;
+	ssize_t n;
+	int p[2], fd, st;
+	pid_t pid;
+
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return NULL;
+	if (fstat(fd, &sb) != 0 || sb.st_size == 0) {
+		close(fd);
+		return NULL;
+	}
+	if (pipe(p) != 0) {
+		close(fd);
+		return NULL;
+	}
+	fflush_all();
+	pid = fork();
+	if (pid == 0) {
+		dup2(fd, 0);
+		dup2(p[1], 1);
+		if (fd > 2)
+			close(fd);
+		if (p[0] > 2)
+			close(p[0]);
+		if (p[1] > 2)
+			close(p[1]);
+		av[0] = (char *)"brief";
+		av[1] = (char *)"-d";
+		av[2] = (char *)"-F";
+		av[3] = json ? (char *)"json" : (char *)"text";
+		av[4] = NULL;
+		brief_main_main(4, av);
+		_exit(0);
+	}
+	close(fd);
+	close(p[1]);
+	buf = xzalloc(budget + 1);
+	while (len < budget && (n = safe_read(p[0], buf + len, budget - len)) > 0)
+		len += (size_t)n;
+	close(p[0]);
+	buf[len] = '\0';
+	waitpid(pid, &st, 0);
+	return buf;
+#else
+	(void)path;
+	(void)budget;
+	(void)json;
+	return NULL;
+#endif
+}

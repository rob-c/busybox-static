+static size_t dump_bounded(const char *path, size_t budget, int json, const char *label)
+{
+	int fd = open(path, O_RDONLY);
+	struct stat st;
+	size_t half = budget / 2, shown = 0;
+	char *b;
+
+	if (fd < 0)
+		return 0;
+	if (fstat(fd, &st) != 0) {
+		close(fd);
+		return 0;
+	}
+	b = xmalloc(half + 1);
+	if ((unsigned long long)st.st_size <= (unsigned long long)budget) {
+		ssize_t r = safe_read(fd, b, half);
+
+		if (r > 0) {
+			if (json) {
+				char *tmp = xstrndup(b, (size_t)r);
+				json_write_str(tmp);
+				free(tmp);
+			} else {
+				fwrite(b, 1, (size_t)r, stdout);
+			}
+			shown += (size_t)r;
+		}
+	} else {
+		ssize_t r = safe_read(fd, b, half);
+
+		if (r > 0) {
+			if (json) {
+				char *tmp = xstrndup(b, (size_t)r);
+				json_write_str(tmp);
+				free(tmp);
+			} else {
+				fwrite(b, 1, (size_t)r, stdout);
+				printf("\n... [%llu bytes total]\n",
+						(unsigned long long)st.st_size);
+			}
+			shown += (size_t)r;
+		}
+		if (lseek(fd, (off_t)(st.st_size > (off_t)half ? st.st_size - (off_t)half : 0),
+				SEEK_SET) >= 0) {
+			r = safe_read(fd, b, half);
+			if (r > 0) {
+				if (json) {
+					char *tmp = xstrndup(b, (size_t)r);
+					json_write_str(tmp);
+					free(tmp);
+				} else {
+					fwrite(b, 1, (size_t)r, stdout);
+				}
+				shown += (size_t)r;
+			}
+		}
+	}
+	free(b);
+	close(fd);
+	(void)label;
+	return shown;
+}

+
+/* ---------- log ---------- */
+
+static int read_all(const char *path, char **pdata, size_t *plen)
+{
+	int fd = open(path, O_RDONLY);
+	struct stat st;
+	char *data;
+	size_t len = 0, cap;
+
+	if (fd < 0)
+		return -1;
+	if (fstat(fd, &st) != 0) {
+		close(fd);
+		return -1;
+	}
+	cap = st.st_size > 0 ? (size_t)st.st_size + 1 : 4096;
+	data = xmalloc(cap);
+	for (;;) {
+		ssize_t r;
+
+		if (len == cap - 1) {
+			cap *= 2;
+			data = xrealloc(data, cap);
+		}
+		r = safe_read(fd, data + len, cap - 1 - len);
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			free(data);
+			close(fd);
+			return -1;
+		}
+		if (r == 0)
+			break;
+		len += (size_t)r;
+	}
+	close(fd);
+	data[len] = '\0';
+	*pdata = data;
+	*plen = len;
+	return 0;
+}
+
+static size_t *line_starts(const char *d, size_t len, unsigned *pn)
+{
+	size_t *v;
+	size_t i;
+	unsigned n = 0, cap = 256;
+
+	v = xmalloc(cap * sizeof(*v));
+	v[n++] = 0;
+	for (i = 0; i < len; i++) {
+		if (d[i] != '\n' || i + 1 >= len)
+			continue;
+		if (n == cap) {
+			cap *= 2;
+			v = xrealloc(v, cap * sizeof(*v));
+		}
+		v[n++] = i + 1;
+	}
+	*pn = n;
+	return v;
+}
+
+static size_t line_len(const char *d, const size_t *starts, unsigned n,
+		size_t len, unsigned i)
+{
+	size_t end = (i + 1 < n) ? starts[i + 1] - 1 : len;
+	size_t l;
+
+	if (end > starts[i] && d[end - 1] == '\n')
+		end--;
+	if (end > starts[i] && d[end - 1] == '\r')
+		end--;
+	l = end - starts[i];
+	return l;
+}
+
+static int dump_stream(const char *path, const char *label, const char *match,
+		long first, long last, long ctx, long budget, int json)
+{
+	char *data = NULL;
+	size_t len = 0, *starts, shown = 0;
+	unsigned nlines = 0, i;
+	struct rng r[MAX_RANGES];
+	unsigned nr = 0;
+	int truncated = 0;
+
+	if (read_all(path, &data, &len) != 0) {
+		if (json) {
+			printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"error\","
+					"\"code\":\"NOT_FOUND\",\"message\":", label);
+			json_write_str("run not found or stream missing");
+			putchar('}');
+		} else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+
+	if (match) {
+		for (i = 0; i < nlines && nr < MAX_RANGES; i++) {
+			size_t l = line_len(data, starts, nlines, len, i);
+			char *line;
+			int hit;
+
+			if (l == 0)
+				continue;
+			line = xstrndup(data + starts[i], l);
+			hit = strstr(line, match) != NULL;
+			free(line);
+			if (!hit)
+				continue;
+			{
+				unsigned lo = (i >= (unsigned)ctx) ? i - (unsigned)ctx : 0;
+				unsigned hi = i + (unsigned)ctx;
+				if (hi >= nlines)
+					hi = nlines - 1;
+				if (nr && lo <= r[nr - 1].last + 1) {
+					if (hi > r[nr - 1].last)
+						r[nr - 1].last = hi;
+				} else {
+					r[nr].first = lo;
+					r[nr].last = hi;
+					nr++;
+				}
+			}
+		}
+		if (nr == 0) {
+			if (json)
+				printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"error\","
+						"\"code\":\"NOT_FOUND\",\"message\":\"no match\"}", label);
+			else
+				fprintf(stderr, "%s: NOT_FOUND: no match for \"%s\"\n",
+						path, match);
+			free(starts);
+			free(data);
+			return 1;
+		}
+	} else {
+		unsigned lo, hi;
+
+		if (first < 1)
+			first = 1;
+		if (last < first)
+			last = first;
+		if ((unsigned long)last > nlines)
+			last = nlines;
+		lo = (unsigned)first - 1;
+		hi = (unsigned)last - 1;
+		r[0].first = lo;
+		r[0].last = hi;
+		nr = 1;
+	}
+
+	if (json) {
+		printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"ok\",\"lines\":[",
+				label);
+		for (i = 0; i < nr; i++)
+			printf("%s[%u,%u]", i ? "," : "", r[i].first + 1, r[i].last + 1);
+		fputs("],\"content\":[", stdout);
+	} else {
+		printf("%s lines=", label);
+		for (i = 0; i < nr; i++)
+			printf("%s%u-%u", i ? "," : "", r[i].first + 1, r[i].last + 1);
+		putchar('\n');
+	}
+
+	{
+		unsigned emitted = 0;
+
+		for (i = 0; i < nr && !truncated; i++) {
+			unsigned li;
+
+			if (!json && i > 0)
+				fputs("--\n", stdout);
+			for (li = r[i].first; li <= r[i].last; li++) {
+				size_t l = line_len(data, starts, nlines, len, li);
+				char num[32];
+				int nd = snprintf(num, sizeof(num), "%u | ", li + 1);
+
+				if (shown + (size_t)nd + l + 1 > (size_t)budget) {
+					truncated = 1;
+					break;
+				}
+				if (json) {
+					if (emitted++)
+						putchar(',');
+					printf("{\"n\":%u,\"text\":", li + 1);
+					{
+						char *t = xstrndup(data + starts[li], l);
+						json_write_str(t);
+						free(t);
+					}
+					putchar('}');
+				} else {
+					fwrite(num, 1, (size_t)nd, stdout);
+					fwrite(data + starts[li], 1, l, stdout);
+					putchar('\n');
+				}
+				shown += (size_t)nd + l + 1;
+			}
+		}
+	}
+
+	if (json)
+		printf("],\"shown_bytes\":%u,\"truncated\":%s}",
+				(unsigned)shown, truncated ? "true" : "false");
+	else
+		printf("shown_bytes=%u truncated=%s\n", (unsigned)shown,
+				truncated ? "true" : "false");
+	free(starts);
+	free(data);
+	return 0;
+}
+
+/* log --diff R1:R2: compare two runs' stdout, line by line. */
+/* ---------- time-addressed timeline retrieval ---------- */
+
+/* "[   0.011354 out] text" -> microseconds, and which stream. */
+static long stamp_us(const char *line, size_t len, int *is_err)
+{
+	long sec = 0, frac = 0;
+	size_t i = 0;
+	int digits = 0;
+
+	*is_err = 0;
+	while (i < len && (line[i] == '[' || line[i] == ' '))
+		i++;
+	while (i < len && line[i] >= '0' && line[i] <= '9')
+		sec = sec * 10 + (line[i++] - '0');
+	if (i < len && line[i] == '.') {
+		i++;
+		while (i < len && line[i] >= '0' && line[i] <= '9' && digits < 9) {
+			frac = frac * 10 + (line[i++] - '0');
+			digits++;
+		}
+	}
+	while (digits++ < 9)
+		frac *= 10;
+	for (; i < len; i++)
+		if (line[i] == 'e' && i + 3 < len && memcmp(line + i, "err", 3) == 0) {
+			*is_err = 1;
+			break;
+		}
+	return sec * 1000000L + frac / 1000;
+}
+
+struct tlstat {
+	unsigned lines, err_lines;
+	long first_out, first_err, last;
+	long gap_from, gap_us;
+};
+
+/* Walk the timeline artifact, filling `st` and printing whatever the caller wants. */
+static int tl_query(const char *dir, long since_us, long until_us,
+		double gap_s, long limit, int json, size_t budget)
+{
+	char *path = art_path(dir, "timeline");
+	char *data = NULL;
+	size_t len = 0, starts_n = 0, *starts;
+	unsigned nlines = 0, i, shown = 0;
+	size_t printed = 0;
+	struct tlstat st;
+
+	memset(&st, 0, sizeof(st));
+	st.first_out = -1;
+	st.first_err = -1;
+
+	if (read_all(path, &data, &len) != 0) {
+		if (json)
+			printf("{\"schema\":1,\"stream\":\"timeline\",\"status\":\"error\","
+					"\"code\":\"NOT_FOUND\",\"message\":\"run not found or stream missing\"}");
+		else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		free(path);
+		return 1;
+	}
+	free(path);
+	starts = line_starts(data, len, &nlines);
+
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		st.lines++;
+		if (is_err) {
+			st.err_lines++;
+			if (st.first_err < 0)
+				st.first_err = us;
+		} else if (st.first_out < 0) {
+			st.first_out = us;
+		}
+		if (us > st.last)
+			st.last = us;
+		if (i && st.last > 0) {
+			long prev = 0;
+			int pe;
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+
+			prev = pl ? stamp_us(data + starts[i - 1], pl, &pe) : 0;
+			if (us - prev > st.gap_us) {
+				st.gap_us = us - prev;
+				st.gap_from = prev;
+			}
+		}
+	}
+
+	if (gap_s > 0) {
+		/* The N widest silences, with the line on each side. */
+		long want = (long)(gap_s * 1000000.0);
+		long shown_gaps = 0;
+
+		if (json)
+			printf("{\"schema\":1,\"stream\":\"timeline\",\"status\":\"ok\",\"gaps\":[");
+		for (i = 1; i < nlines && shown_gaps < (limit > 0 ? limit : 3); i++) {
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+			size_t cl = line_len(data, starts, nlines, len, i);
+			int pe, ce;
+			long pu, cu;
+
+			if (!pl || !cl)
+				continue;
+			pu = stamp_us(data + starts[i - 1], pl, &pe);
+			cu = stamp_us(data + starts[i], cl, &ce);
+			if (cu - pu < want)
+				continue;
+			if (json) {
+				printf("%s{\"from_us\":%ld,\"to_us\":%ld,\"gap_us\":%ld,\"before\":",
+						shown_gaps ? "," : "", pu, cu, cu - pu);
+				json_write_str(xstrndup(data + starts[i - 1], pl));
+				printf(",\"after\":");
+				json_write_str(xstrndup(data + starts[i], cl));
+				putchar('}');
+			} else {
+				printf("gap %ldus -> %ldus (%ldus)\n", pu, cu, cu - pu);
+			}
+			shown_gaps++;
+		}
+		if (json)
+			printf("],\"lines\":%u,\"stderr_lines\":%u}", st.lines, st.err_lines);
+		else
+			printf("gaps=%ld lines=%u stderr_lines=%u\n", shown_gaps, st.lines, st.err_lines);
+		free(starts);
+		free(data);
+		fflush(stdout);
+		return 0;
+	}
+
+	if (json)
+		printf("{\"schema\":1,\"stream\":\"timeline\",\"status\":\"ok\",\"events\":[");
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		if (since_us >= 0 && us < since_us)
+			continue;
+		if (until_us >= 0 && us > until_us)
+			continue;
+		if (printed + l + 40 > budget) {
+			shown = i;
+			break;
+		}
+		if (json) {
+			char *text = xstrndup(data + starts[i], l);
+			char *body = strchr(text, ']');
+
+			while (body && *body == ']')
+				body++, body += (*body == ' ');
+			printf("%s{\"n\":%u,\"us\":%ld,\"stream\":\"%s\",\"text\":",
+					printed ? "," : "", i + 1, us, is_err ? "err" : "out");
+			json_write_str(body ? body : "");
+			putchar('}');
+			free(text);
+		} else {
+			fwrite(data + starts[i], 1, l, stdout);
+			putchar('\n');
+		}
+		printed += l;
+	}
+	if (json)
+		printf("],\"shown_bytes\":%u,\"truncated\":%s}", (unsigned)printed,
+				shown ? "true" : "false");
+	free(starts);
+	free(data);
+	fflush(stdout);
+	return 0;
+}
+
+
+static int tl_stats(const char *root, const char *run, struct tlstat *st, long *duration_ms)
+{
+	char *dir = xasprintf("%s/%s", root, run);
+	char *path = art_path(dir, "timeline");
+	char *meta = art_path(dir, "meta");
+	char *data = NULL, *m = NULL;
+	size_t len = 0, mlen = 0, *starts;
+	unsigned nlines = 0, i;
+
+	memset(st, 0, sizeof(*st));
+	st->first_out = st->first_err = -1;
+	*duration_ms = 0;
+	if (read_all(path, &data, &len) != 0) {
+		free(dir); free(path); free(meta);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us, prev = 0;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		st->lines++;
+		if (is_err) {
+			st->err_lines++;
+			if (st->first_err < 0)
+				st->first_err = us;
+		} else if (st->first_out < 0) {
+			st->first_out = us;
+		}
+		if (i) {
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+			int pe;
+
+			prev = pl ? stamp_us(data + starts[i - 1], pl, &pe) : 0;
+			if (us - prev > st->gap_us) {
+				st->gap_us = us - prev;
+				st->gap_from = prev;
+			}
+		}
+	}
+	if (read_all(meta, &m, &mlen) == 0) {
+		char *d = strstr(m, "duration_ms=");
+
+		if (d)
+			*duration_ms = strtol(d + 12, NULL, 10);
+	}
+	free(starts);
+	free(data);
+	free(m);
+	free(dir);
+	free(path);
+	free(meta);
+	return 0;
+}
+
+/* One deterministic digest: what the plugin builds in TypeScript today. */
+static int tl_summary(const char *dir, const char *run, int json)
+{
+	char *path = art_path(dir, "timeline");
+	char *meta = art_path(dir, "meta");
+	char *data = NULL;
+	size_t len = 0, *starts;
+	unsigned nlines = 0, i;
+	struct tlstat st;
+	long exit_code = 0, duration_ms = 0;
+	char *m = NULL;
+	size_t mlen = 0;
+	int timed_out = 0;
+
+	memset(&st, 0, sizeof(st));
+	st.first_out = st.first_err = -1;
+	if (read_all(path, &data, &len) != 0) {
+		if (json)
+			printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\"}");
+		else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+	for (i = 0; i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+		int is_err;
+		long us, prev = 0;
+
+		if (l == 0)
+			continue;
+		us = stamp_us(data + starts[i], l, &is_err);
+		st.lines++;
+		if (is_err) {
+			st.err_lines++;
+			if (st.first_err < 0)
+				st.first_err = us;
+		} else if (st.first_out < 0) {
+			st.first_out = us;
+		}
+		if (i) {
+			size_t pl = line_len(data, starts, nlines, len, i - 1);
+			int pe;
+
+			prev = pl ? stamp_us(data + starts[i - 1], pl, &pe) : 0;
+			if (us - prev > st.gap_us) {
+				st.gap_us = us - prev;
+				st.gap_from = prev;
+			}
+		}
+		if (us > st.last)
+			st.last = us;
+	}
+	if (read_all(meta, &m, &mlen) == 0) {
+		char *p = strstr(m, "exit_code=");
+		char *d = strstr(m, "duration_ms=");
+		char *t = strstr(m, "timed_out=");
+
+		if (p) exit_code = strtol(p + 10, NULL, 10);
+		if (d) duration_ms = strtol(d + 12, NULL, 10);
+		if (t) timed_out = (t[10] == '1');
+	}
+	if (json) {
+		printf("{\"schema\":1,\"run\":");
+		json_write_str(run);
+		printf(",\"status\":\"ok\",\"lines\":%u,\"stderr_lines\":%u,"
+				"\"first_out_us\":%ld,\"first_err_us\":%ld,\"last_us\":%ld,"
+				"\"longest_gap\":{\"from_us\":%ld,\"to_us\":%ld,\"gap_us\":%ld},"
+				"\"exit_code\":%ld,\"duration_ms\":%ld,\"timed_out\":%s}",
+				st.lines, st.err_lines, st.first_out, st.first_err, st.last,
+				st.gap_from, st.gap_from + st.gap_us, st.gap_us,
+				exit_code, duration_ms, timed_out ? "true" : "false");
+	} else {
+		printf("run=%s lines=%u stderr=%u first_out_us=%ld first_err_us=%ld "
+				"last_us=%ld longest_gap_us=%ld exit_code=%ld duration_ms=%ld timed_out=%d\n",
+				run, st.lines, st.err_lines, st.first_out, st.first_err,
+				st.last, st.gap_us, exit_code, duration_ms, timed_out);
+	}
+	free(starts);
+	free(data);
+	free(m);
+	fflush(stdout);
+	return 0;
+}
+
+/* First N and last N lines of a stream: the digest for output brief cannot reduce. */
+static int dump_sample(const char *dir, const char *label, long want,
+		size_t budget, int json)
+{
+	char *path = art_path(dir, label);
+	char *data = NULL;
+	size_t len = 0, *starts, printed = 0;
+	unsigned nlines = 0, i, head, tail;
+
+	if (read_all(path, &data, &len) != 0) {
+		if (json)
+			printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"error\","
+					"\"code\":\"NOT_FOUND\",\"message\":\"run not found or stream missing\"}", label);
+		else
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+		return 1;
+	}
+	starts = line_starts(data, len, &nlines);
+	head = ((unsigned)want < nlines) ? (unsigned)want : nlines;
+	tail = (nlines > head && (nlines - head) > (unsigned)want) ? (unsigned)want : (nlines - head);
+
+	if (json)
+		printf("{\"schema\":1,\"stream\":\"%s\",\"status\":\"ok\",\"lines\":[", label);
+	for (i = 0; i < head; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+
+		if (json) {
+			fputs(i ? "," : "", stdout);
+			json_write_str(xstrndup(data + starts[i], l));
+		} else {
+			fwrite(data + starts[i], 1, l, stdout);
+			putchar('\n');
+		}
+		printed += l;
+	}
+	if (json)
+		printf("],\"omitted\":%u,\"tail\":[", nlines - head - tail);
+	for (i = nlines - tail; tail && i < nlines; i++) {
+		size_t l = line_len(data, starts, nlines, len, i);
+
+		if (json) {
+			fputs(i == nlines - tail ? "" : ",", stdout);
+			json_write_str(xstrndup(data + starts[i], l));
+		} else {
+			fwrite(data + starts[i], 1, l, stdout);
+			putchar('\n');
+		}
+		printed += l;
+	}
+	if (json)
+		printf("],\"shown_bytes\":%u,\"truncated\":%s}", (unsigned)printed,
+				(nlines > head + tail) ? "true" : "false");
+	free(starts);
+	free(data);
+	fflush(stdout);
+	return 0;
+}
+
+
+
+/* Two runs by shape: lines, stderr lines, first stderr, longest gap, duration. */
+static int log_diff_timeline(const char *root, const char *spec, int json)
+{
+	const char *colon = strchr(spec, ':');
+	char *a, *b;
+	struct tlstat sa, sb;
+	long da = 0, dbb = 0;
+	int changed = 0;
+
+	if (!colon || colon == spec || !colon[1]) {
+		fprintf(stderr, "log: --diff-timeline wants RUN1:RUN2\n");
+		return 2;
+	}
+	a = xstrndup(spec, (size_t)(colon - spec));
+	b = xstrdup(colon + 1);
+	if (tl_stats(root, a, &sa, &da) || tl_stats(root, b, &sb, &dbb)) {
+		if (json)
+			printf("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\"}");
+		else
+			fprintf(stderr, "log: one of %s / %s has no timeline\n", a, b);
+		free(a);
+		free(b);
+		return 1;
+	}
+	if (sa.lines != sb.lines || sa.err_lines != sb.err_lines
+	 || sa.gap_us != sb.gap_us || da != dbb)
+		changed = 1;
+	if (json)
+		printf("{\"schema\":1,\"status\":\"ok\",\"a\":\"%s\",\"b\":\"%s\",\"changed\":%s,"
+				"\"lines\":{\"a\":%u,\"b\":%u},\"stderr_lines\":{\"a\":%u,\"b\":%u},"
+				"\"first_err_us\":{\"a\":%ld,\"b\":%ld},"
+				"\"longest_gap_us\":{\"a\":%ld,\"b\":%ld},"
+				"\"duration_ms\":{\"a\":%ld,\"b\":%ld}}",
+				a, b, changed ? "true" : "false",
+				sa.lines, sb.lines, sa.err_lines, sb.err_lines,
+				sa.first_err, sb.first_err, sa.gap_us, sb.gap_us, da, dbb);
+	else
+		printf("%s -> %s lines %u->%u stderr %u->%u gap_us %ld->%ld duration_ms %ld->%ld changed=%s\n",
+				a, b, sa.lines, sb.lines, sa.err_lines, sb.err_lines,
+				sa.gap_us, sb.gap_us, da, dbb, changed ? "true" : "false");
+	free(a);
+	free(b);
+	fflush(stdout);
+	return 0;
+}
+
+static int log_diff(const char *root, const char *spec, int json)
+{
+	char *colon = strchr(spec, ':');
+	char *a = NULL, *b = NULL, *pa, *pb, *sa, *sb;
+	size_t alen = 0, blen = 0;
+	unsigned line = 0, changed = 0, shown = 0;
+	char *spec2;
+
+	if (!colon || !colon[1])
+		bb_error_msg_and_die("--diff needs R1:R2");
+	spec2 = xstrdup(spec);
+	colon = strchr(spec2, ':');
+	*colon = '\0';
+
+	pa = art_path(xasprintf("%s/%s", root, spec2), "stdout");
+	pb = art_path(xasprintf("%s/%s", root, colon + 1), "stdout");
+	if (read_all(pa, &a, &alen) != 0 || read_all(pb, &b, &blen) != 0) {
+		if (json) {
+			fputs("{\"schema\":1,\"status\":\"error\",\"code\":\"NOT_FOUND\",\"message\":", stdout);
+			json_write_str("a run has no stdout artifact");
+			fputs("}\n", stdout);
+		} else {
+			fprintf(stderr, "%s: NOT_FOUND\n", a ? pb : pa);
+		}
+		free(a);
+		free(b);
+		free(spec2);
+		return 1;
+	}
+
+	if (json)
+		fputs("{\"schema\":1,\"status\":\"ok\",\"changes\":[", stdout);
+	sa = a;
+	sb = b;
+	while (*sa || *sb) {
+		char *ea = strchr(sa, '\n');
+		char *eb = strchr(sb, '\n');
+		size_t na = ea ? (size_t)(ea - sa) : strlen(sa);
+		size_t nb = eb ? (size_t)(eb - sb) : strlen(sb);
+
+		line++;
+		if (!(na == nb && memcmp(sa, sb, na) == 0)) {
+			changed++;
+			if (shown < 20) {
+				if (json) {
+					if (shown)
+						putchar(',');
+					printf("{\"line\":%u,\"a\":", line);
+					json_write_str(xasprintf("%.*s", (int)na, sa));
+					fputs(",\"b\":", stdout);
+					json_write_str(xasprintf("%.*s", (int)nb, sb));
+					putchar('}');
+				} else {
+					printf("line %u\n  - %.*s\n  + %.*s\n",
+							line, (int)na, sa, (int)nb, sb);
+				}
+				shown++;
+			}
+		}
+		if (!ea && !eb)
+			break;
+		sa = ea ? ea + 1 : sa + na;
+		sb = eb ? eb + 1 : sb + nb;
+	}
+	if (json)
+		printf("],\"lines\":%u,\"changed\":%u}\n", line, changed);
+	else
+		printf("lines=%u changed=%u\n", line, changed);
+	free(a);
+	free(b);
+	free(spec2);
+	return changed ? 1 : 0;
+}
+
+int log_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
+int log_main(int argc UNUSED_PARAM, char **argv)
+{
+	char *opt_lines = NULL, *opt_match = NULL, *opt_ctx = NULL;
+	char *opt_stream = NULL, *opt_bytes = NULL, *opt_dir = NULL, *opt_fmt = NULL;
+	char *opt_since = NULL, *opt_until = NULL, *opt_gap = NULL;
+	char *opt_limit = NULL, *opt_sample = NULL, *opt_difftl = NULL;
+	int summary_only = 0;
+	char *opt_diff = NULL;
+	unsigned opts;
+	const char *root, *run, *dir;
+	long budget = DEFAULT_VIEW, ctx = DEFAULT_CONTEXT;
+	long first = 1, last = 0;
+	int json = 0, meta_only = 0, rc = 0;
+
+	static const char log_longopts[] ALIGN1 =
+		"lines\0"     Required_argument "l"
+		"match\0"     Required_argument "m"
+		"context\0"   Required_argument "c"
+		"stream\0"    Required_argument "s"
+		"meta\0"      No_argument       "M"
+		"max-bytes\0" Required_argument "B"
+		"dir\0"       Required_argument "D"
+		"format\0"    Required_argument "F"
+		"since\0"     Required_argument "S"
+		"until\0"     Required_argument "U"
+		"around-gap\0" Required_argument "G"
+		"limit\0"     Required_argument "N"
+		"sample\0"    Required_argument "P"
+		"summary\0"   No_argument       "Z"
+		"diff-timeline\0" Required_argument "Q"
+		;
+
+	xfunc_error_retval = 2;
+
+	{
+		int i;
+
+		for (i = 1; argv[i]; i++) {
+			if (strcmp(argv[i], "--diff-timeline") == 0 && argv[i + 1]) {
+				int j;
+
+				opt_difftl = argv[i + 1];
+				for (j = i; argv[j + 2]; j++)
+					argv[j] = argv[j + 2];
+				argv[j] = NULL;
+				break;
+			}
+			if (strcmp(argv[i], "--diff") == 0 && argv[i + 1]) {
+				int j;
+
+				opt_diff = argv[i + 1];
+				for (j = i; argv[j + 2]; j++)
+					argv[j] = argv[j + 2];
+				argv[j] = NULL;
+				break;
+			}
+		}
+	}
+	opts = getopt32long(argv, "l:m:c:s:MB:D:F:S:U:G:N:P:ZQ:", log_longopts,
+			&opt_lines, &opt_match, &opt_ctx, &opt_stream,
+			&opt_bytes, &opt_dir, &opt_fmt,
+			&opt_since, &opt_until, &opt_gap, &opt_limit, &opt_sample,
+			&opt_difftl);
+	meta_only = (opts & (1 << 4)) != 0;   /* M */
+	summary_only = (opts & (1 << 13)) != 0;  /* Z: 14th letter of the optstring */
+	argv += optind;
+
+	if (opt_fmt) {
+		if (strcmp(opt_fmt, "json") == 0)
+			json = 1;
+		else if (strcmp(opt_fmt, "text") != 0)
+			bb_error_msg_and_die("unknown format \"%s\"", opt_fmt);
+	}
+	if (opt_ctx)
+		ctx = strtol(opt_ctx, NULL, 10);
+	if (opt_bytes)
+		budget = strtol(opt_bytes, NULL, 10);
+	if (opt_lines) {
+		char *colon = strchr(opt_lines, ':');
+		first = strtol(opt_lines, NULL, 10);
+		last = (colon && colon[1]) ? strtol(colon + 1, NULL, 10) : first;
+	}
+	root = artifact_root(opt_dir);
+	if (opt_diff)
+		return log_diff(root, opt_diff, json);
+	if (opt_difftl)
+		return log_diff_timeline(root, opt_difftl, json);
+	if (!argv[0])
+		bb_show_usage();
+	run = argv[0];                 /* was lost in the run.c rewrite */
+	dir = xasprintf("%s/%s", root, run);
+
+	if (opt_since || opt_until || opt_gap)
+		return tl_query(dir,
+				opt_since ? (long)(strtod(opt_since, NULL) * 1000000.0) : -1,
+				opt_until ? (long)(strtod(opt_until, NULL) * 1000000.0) : -1,
+				opt_gap ? strtod(opt_gap, NULL) : 0.0,
+				opt_limit ? strtol(opt_limit, NULL, 10) : 3,
+				json, (size_t)budget);
+	if (summary_only)
+		return tl_summary(dir, run, json);
+	if (opt_sample)
+		return dump_sample(dir,
+				opt_stream && strcmp(opt_stream, "stderr") == 0 ? "stderr" : "stdout",
+				strtol(opt_sample, NULL, 10), (size_t)budget, json);
+
+	if (meta_only) {
+		char *path = art_path(dir, "meta");
+		char *buf = NULL;
+		size_t len = 0;
+
+		if (read_all(path, &buf, &len) != 0) {
+			fprintf(stderr, "%s: NOT_FOUND\n", path);
+			return 1;
+		}
+		if (json) {
+			fputs("{\"schema\":1,\"run\":", stdout);
+			json_write_str(run);
+			fputs(",\"meta\":", stdout);
+			json_write_str(buf);
+			fputs("}\n", stdout);
+		} else {
+			fwrite(buf, 1, len, stdout);
+		}
+		free(buf);
+		fflush(stdout);
+		return 0;
+	}
+
+	{
+		const char *which = opt_stream ? opt_stream : "stdout";
+		int both = (strcmp(which, "both") == 0);
+
+		if (!both && strcmp(which, "stdout") != 0
+		 && strcmp(which, "stderr") != 0
+		 && strcmp(which, "timeline") != 0)
+			bb_error_msg_and_die("--stream is stdout, stderr, timeline or both");
+		if (strcmp(which, "timeline") == 0) {
+			rc = dump_stream(art_path(dir, "timeline"), "timeline", opt_match,
+					first, last, ctx, budget, json);
+			fflush(stdout);
+			return rc;
+		}
+		if (json && both)
+			fputs("{\"schema\":1,\"results\":[", stdout);
+		if (both || strcmp(which, "stdout") == 0) {
+			rc |= dump_stream(art_path(dir, "stdout"), "stdout", opt_match,
+					first, last, ctx, budget, json);
+			if (both && json)
+				putchar(',');
+		}
+		if (both || strcmp(which, "stderr") == 0)
+			rc |= dump_stream(art_path(dir, "stderr"), "stderr", opt_match,
+					first, last, ctx, budget, json);
+		if (json && both)
+			fputs("]}\n", stdout);
+		else if (json)
+			putchar('\n');
+	}
+	fflush(stdout);
+	return rc;
+}

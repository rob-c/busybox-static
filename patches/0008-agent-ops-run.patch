+static const char *artifact_root(const char *given)
+{
+	const char *t;
+
+	if (given)
+		return given;
+	t = getenv("TMPDIR");
+	if (t && t[0])
+		return xasprintf("%s/busybox-run", t);
+	return "/tmp/busybox-run";
+}
+
+static unsigned next_run_id(const char *root)
+{
+	DIR *d = opendir(root);
+	struct dirent *de;
+	unsigned max = 0;
+
+	if (!d)
+		return 1;
+	while ((de = readdir(d)) != NULL) {
+		if (de->d_name[0] == 'R' && de->d_name[1] >= '0'
+		 && de->d_name[1] <= '9'
+		) {
+			unsigned v = (unsigned)atoi(de->d_name + 1);
+			if (v > max)
+				max = v;
+		}
+	}
+	closedir(d);
+	return max + 1;
+}
+
+static char *art_path(const char *dir, const char *name)
+{
+	return xasprintf("%s/%s", dir, name);
+}
+
+static void write_meta(const char *dir, const struct meta *m)
+{
+	char *path = art_path(dir, "meta");
+	int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+
+	if (fd >= 0) {
+		char buf[1024];
+		int n = snprintf(buf, sizeof(buf),
+				"cmd=%s\ncwd=%s\nduration_ms=%ld\nexit_code=%d\n"
+				"signal=%d\ntimed_out=%d\ncancelled=%d\n"
+				"capture_complete=%d\nstdout_bytes=%llu\nstderr_bytes=%llu\npgid=%ld\n"
+				"pty=%d\npty_slave=%s\npty_rows=%d\npty_cols=%d\n"
+				"stderr_merged=%d\n",
+				m->cmd ? m->cmd : "", m->cwd ? m->cwd : "",
+				m->duration_ms, m->exit_code, m->term_sig,
+				m->timed_out, m->cancelled, m->capture_complete,
+				m->out_bytes, m->err_bytes, child_pgid,
+				m->pty, m->pty_slave ? m->pty_slave : "",
+				m->pty_rows, m->pty_cols, m->stderr_merged);
+		if (n > 0)
+			full_write(fd, buf, (size_t)n);
+		close(fd);
+	}
+	free(path);
+}

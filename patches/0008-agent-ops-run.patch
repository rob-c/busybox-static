+/* Remove all but the newest `keep` run directories under root. Returns the count. */
+#if 0
+#endif
+/*
+ * Reaper: a tiny child in its own process group that kills the guest group when
+ * this process disappears for ANY reason, including SIGKILL, which cannot be
+ * caught. It watches the parent id until it stops existing, so a wrapper killed
+ * with -9 does not leave the command running.
+ */
+/* Take the watchdog down before returning: it is only needed while we are alive,
+ * and leaving it for up to 100 ms would make it visible to process scans. */
+static void stop_reaper(void)
+{
+	if (reaper_pid > 0) {
+		kill(reaper_pid, SIGKILL);
+		waitpid(reaper_pid, NULL, 0);
+		reaper_pid = 0;
+	}
+}
+
+static void spawn_reaper(pid_t target_group) NORETURN;
+static void spawn_reaper(pid_t target_group)
+{
+	pid_t me = getppid();   /* the run process; stays valid if re-parented */
+	int fd, i;
+
+	setpgid(0, 0);          /* own group: a group kill of the guest misses us */
+	/* Detach from the run's plumbing: holding the capture pipe open would make
+	 * the parent wait for EOF forever. */
+	fd = open("/dev/null", O_RDWR);
+	if (fd >= 0) {
+		dup2(fd, 0);
+		dup2(fd, 1);
+		dup2(fd, 2);
+		if (fd > 2)
+			close(fd);
+	}
+	for (i = 3; i < 256; i++)
+		close(i);
+	for (;;) {
+		if (kill(me, 0) != 0)
+			break;
+		usleep(100 * 1000);
+	}
+	kill(-target_group, SIGKILL);
+	_exit(0);
+}
+
+static unsigned prune_runs(const char *root, unsigned keep)
+{
+	struct dirent *de;
+	DIR *d;
+	unsigned *ids, n = 0, cap = 64, i, j, removed = 0;
+
+	d = opendir(root);
+	if (!d)
+		return 0;
+	ids = xmalloc(sizeof(ids[0]) * cap);
+	while ((de = readdir(d)) != NULL) {
+		unsigned v;
+
+		if (de->d_name[0] != 'R' || sscanf(de->d_name + 1, "%u", &v) != 1)
+			continue;
+		if (n == cap) {
+			cap *= 2;
+			ids = xrealloc(ids, sizeof(ids[0]) * cap);
+		}
+		ids[n++] = v;
+	}
+	closedir(d);
+
+	/* newest first */
+	for (i = 1; i < n; i++) {
+		unsigned t = ids[i];
+
+		for (j = i; j > 0 && ids[j - 1] < t; j--)
+			ids[j] = ids[j - 1];
+		ids[j] = t;
+	}
+	for (i = keep; i < n; i++) {
+		char *dir = xasprintf("%s/R%u", root, ids[i]);
+		/* Empty the directory first: a timed run also holds `timeline` (and
+		 * future artifacts), and an unlink list would rot every time one is
+		 * added. rmdir still refuses if anything is left. */
+		DIR *d = opendir(dir);
+		int emptied = 1;
+
+		if (d) {
+			struct dirent *de;
+
+			while ((de = readdir(d)) != NULL) {
+				char *f;
+
+				if (de->d_name[0] == '.'
+				 && (de->d_name[1] == '\0'
+				  || (de->d_name[1] == '.' && de->d_name[2] == '\0')))
+					continue;
+				f = xasprintf("%s/%s", dir, de->d_name);
+				if (unlink(f) != 0)
+					emptied = 0;
+				free(f);
+			}
+			closedir(d);
+		}
+		if (emptied && rmdir(dir) == 0)
+			removed++;
+		free(dir);
+	}
+	free(ids);
+	return removed;
+}
+
+/* Collect the diagnostic ids a child wrote to its stdout ("E NOT_FOUND"), in
+ * order, deduped, capped: the answer to "what went wrong" without the prose.
+ * Ids are matched by shape, not by a list, so an applet that learns a new code
+ * needs no change here. */
+#define CODES_MAX 8
+static void put_codes(const char *path)
+{
+	char buf[4096];
+	char *seen[CODES_MAX];
+	int nseen = 0, first = 1, fd, n;
+
+	fd = open(path, O_RDONLY);
+	putchar('[');
+	while (fd >= 0 && (n = safe_read(fd, buf, sizeof(buf) - 1)) > 0) {
+		char *p = buf, *end = buf + n;
+		int j;
+
+		buf[n] = '\0';
+		while (p < end) {
+			char *nl = memchr(p, '\n', (size_t)(end - p));
+			char *sp;
+			int len;
+
+			if (!nl)   /* a partial line: ignore it, ids are short */
+				break;
+			len = (int)(nl - p);
+			sp = p + 2;   /* skip "E " */
+			if (len >= 4 && (p[0] == 'E' || p[0] == 'W' || p[0] == 'I')
+			 && p[1] == ' '
+			 && (nl - sp) > 0 && (nl - sp) < 40
+			) {
+				int ok = 1;
+				for (j = 0; j < (int)(nl - sp); j++) {
+					char c = sp[j];
+					if (!((c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9')))
+						ok = 0;
+				}
+				if (ok) {
+					int k, dup = 0;
+					for (k = 0; k < nseen; k++)
+						if ((int)strlen(seen[k]) == len && memcmp(seen[k], p, (size_t)len) == 0)
+							dup = 1;
+					if (!dup && nseen < CODES_MAX) {
+						seen[nseen++] = xstrndup(p, (size_t)len);
+						if (!first)
+							putchar(',');
+						json_write_str(seen[nseen - 1]);
+						first = 0;
+					}
+				}
+			}
+			p = nl + 1;
+		}
+		if (nseen >= CODES_MAX)
+			break;
+	}
+	if (fd >= 0)
+		close(fd);
+	while (nseen > 0)
+		free(seen[--nseen]);
+	putchar(']');
+}
+
+static char *json_join_argv(char **argv)
+{
+		size_t len = 0;
+	int i;
+	char *out, *p;
+
+	for (i = 0; argv[i]; i++)
+		len += strlen(argv[i]) + 1;
+	out = xzalloc(len + 1);
+	p = out;
+	for (i = 0; argv[i]; i++) {
+		size_t n = strlen(argv[i]);
+		if (i)
+			*p++ = ' ';
+		memcpy(p, argv[i], n);
+		p += n;
+	}
+	return out;
+}

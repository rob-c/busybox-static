+			printf("run=R%u exit_code=%d timed_out=%s cancelled=%s idle=%s duration_ms=%ld\n",
+					id, m.exit_code, m.timed_out ? "true" : "false",
+					m.cancelled ? "true" : "false",
+					m.idle_out ? "true" : "false", m.duration_ms);
+			printf("timeline_lines=%u shown=%u truncated=%s stamp=%s res_ns=%u\n",
+					tl.n, tl_text_shown(),
+					(tl.truncated || tl.n > tl_shown_count()) ? "true" : "false",
+					tl.nanosec ? "ns" : "us", tl.res_ns);
+			printf("--- timeline ---\n");
+			tl_print_text(id);
+			if (opt_pgid)
+				printf("pgid=%ld\n", child_pgid);
+		} else if (quiet) {
+			if (brief_out) {
+				char *bv = brief_reduce(p1, (size_t)budget, brief_json);
+
+				if (bv) {
+					fputs(bv, stdout);
+					free(bv);
+				}
+			} else
+				dump_bounded(p1, (size_t)budget, 0, "stdout");
+			if (brief_err) {
+				char *bv = brief_reduce(p2, (size_t)budget / 4, brief_json);
+
+				if (bv) {
+					fputs(bv, stderr);
+					free(bv);
+				}
+			} else
+				dump_bounded(p2, (size_t)budget / 4, 0, "stderr");
+		} else {
+			printf("run=R%u exit_code=%d timed_out=%s cancelled=%s idle=%s duration_ms=%ld\n",
+					id, m.exit_code, m.timed_out ? "true" : "false",
+					m.cancelled ? "true" : "false",
+					m.idle_out ? "true" : "false", m.duration_ms);
+			printf("captured_bytes=%llu stdout=%llu stderr=%llu capture_complete=%s "
+					"view_truncated=%s\n",
+					m.out_bytes + m.err_bytes, m.out_bytes, m.err_bytes,
+					m.capture_complete ? "true" : "false",
+					(m.out_bytes + m.err_bytes) > (unsigned long long)budget
+						? "true" : "false");
+			printf("stdout_artifact=%s\nstderr_artifact=%s\n", p1, p2);
+			if (opt_pgid)
+				printf("pgid=%ld\n", child_pgid);
+			if (pty_mode)
+				printf("pty=%s cols=%d rows=%d raw=%s stderr_merged=%s\n",
+						pb.slave, pb.cols, pb.rows,
+						pty_raw ? "true" : "false",
+						pty_split ? "false" : "true");
+			fputs("--- stdout ---\n", stdout);
+			if (brief_out) {
+				char *bv = brief_reduce(p1, (size_t)budget, brief_json);
+
+				if (bv) {
+					fputs(bv, stdout);
+					shown = strlen(bv);
+					free(bv);
+				} else
+					shown = 0;
+			} else
+				shown = dump_bounded(p1, (size_t)budget, 0, "stdout");
+			if (!shown)
+				fputs("(empty)\n", stdout);
+			fputs("--- stderr ---\n", stdout);
+			if (brief_err) {
+				char *bv = brief_reduce(p2, (size_t)budget / 4, brief_json);
+
+				if (bv) {
+					fputs(bv, stdout);
+					shown = strlen(bv);
+					free(bv);
+				} else
+					shown = 0;
+			} else
+				shown = dump_bounded(p2, (size_t)budget / 4, 0, "stderr");
+			if (!shown)
+				fputs("(empty)\n", stdout);
+			if ((m.out_bytes + m.err_bytes) > (unsigned long long)budget)
+				printf("... view truncated; `log R%u --match ...' has the rest\n", id);
+		}
+	}
+	if (opt_prune) {
+		unsigned keep = (unsigned)strtoul(opt_prune, NULL, 10);
+
+		unsigned gone = prune_runs(root, keep ? keep : 1);
+
+		if (!json)
+			printf("pruned=%u keep=%u\n", gone, keep);
+	}
+	fflush(stdout);
+	if (m.timed_out || m.cancelled || m.idle_out)
+		return 3;
+	if (m.exit_code < 0)
+		return 1;
+	return m.exit_code;
+}

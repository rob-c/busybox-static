diff --git a/libbb/platform.c b/libbb/platform.c
index 7913353..0e61e86 100644
--- a/libbb/platform.c
+++ b/libbb/platform.c
@@ -128,6 +128,54 @@ char* FAST_FUNC strcasestr(const char *s, const char *pattern)
 }
 #endif
 
+#ifndef HAVE_STRVERSCMP
+/*
+ * Compare as glibc's strverscmp(3) does, so that "sort -V" / "ls -v"
+ * produce the same order on a platform whose libc lacks it (macOS) as on
+ * one that has it.  Rule: digit runs compare numerically, and a run that
+ * starts with '0' sorts as if the decimal point came first, which is what
+ * gives 000 < 00 < 01 < 010 < 09 < 0 < 1 < 9 < 10.
+ */
+int FAST_FUNC strverscmp(const char *s1, const char *s2)
+{
+	const unsigned char *l = (const void *)s1;
+	const unsigned char *r = (const void *)s2;
+	unsigned i, dp, j;
+	smallint z = 1;
+
+	/* Longest common prefix; dp = start of the current digit run,
+	 * z = that run is still all zeros. */
+	for (dp = i = 0; l[i] == r[i]; i++) {
+		unsigned c = l[i];
+		if (!c)
+			return 0;
+		if (!isdigit(c)) {
+			dp = i + 1;
+			z = 1;
+		} else if (c != '0') {
+			z = 0;
+		}
+	}
+
+	if (l[dp] != '0' && r[dp] != '0') {
+		/* A digit run not starting with '0' is a whole number:
+		 * the longer run is the larger number. */
+		for (j = i; isdigit(l[j]); j++) {
+			if (!isdigit(r[j]))
+				return 1;
+		}
+		if (isdigit(r[j]))
+			return -1;
+	} else if (z && dp < i && (isdigit(l[i]) || isdigit(r[i]))) {
+		/* Common prefix of the run is all zeros: the run compares
+		 * as a fraction, digit by digit. */
+		return (int)(l[i] - '0') - (int)(r[i] - '0');
+	}
+
+	return (int)l[i] - (int)r[i];
+}
+#endif
+

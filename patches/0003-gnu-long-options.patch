+/* Applets that share another applet's table. */
+static const struct {
+	const char *alias;
+	const char *applet;
+} gnu_longopt_aliases[] = {
+	{ "egrep", "grep" },
+	{ "fgrep", "grep" },
+};
+
+static const char *applet_key(void)
+{
+	const char *name = applet_name;
+	unsigned i;
+
+	if (!name)
+		return NULL;
+	for (i = 0; i < ARRAY_SIZE(gnu_longopt_aliases); i++)
+		if (strcmp(gnu_longopt_aliases[i].alias, name) == 0)
+			return gnu_longopt_aliases[i].applet;
+	return name;
+}
+
+/* Does the applet's own optstring give OPT an argument? */
+static smallint opt_takes_arg(const char *optstring, char opt)
+{
+	if (!optstring)
+		return 0;
+	/* skip bbox extensions: '^', '!', '+', '-' */
+	while (*optstring == '^' || *optstring == '!'
+	    || *optstring == '+' || *optstring == '-'
+	) {
+		optstring++;
+	}
+	while (*optstring) {
+		if (*optstring == opt)
+			return optstring[1] == ':';
+		optstring++;
+	}
+	return 0;
+}
+
+/* Is NAME already declared as a long option by getopt32long's own table? */
+static smallint own_table_has(const char *own, const char *name, unsigned len)
+{
+	while (own && own[0]) {
+		if (strncmp(own, name, len) == 0 && own[len] == '\0')
+			return 1;
+		own += strlen(own) + 3; /* NUL, has_arg, val */
+	}
+	return 0;
+}
+
+/*
+ * Rewrite GNU-style long options in argv in place, before getopt_long sees
+ * them.  "--name=value" and "--name value" both become the short option the
+ * table names, so no applet needs to change.  Unknown names are left alone:
+ * getopt_long then reports them exactly as it does today.
+ *
+ * No allocation: a rewritten argument is always shorter than the original
+ * ("--max-depth=1" -> "-d1"), so it is written over the same buffer.
+ */
+void FAST_FUNC bb_expand_gnu_longopts(char **argv, const char *optstring, const char *own_longopts)
+{
+	const char *key = applet_key();
+	char **av;
+	unsigned i;
+
+	if (!key)
+		return;
+	for (av = argv + 1; av && *av; av++) {
+		char *arg = *av;
+		const char *name;
+		const char *eq;
+		unsigned len;
+		int found = -1;
+		int nmatch = 0;
+
+		if (arg[0] != '-' || arg[1] != '-')
+			continue;
+		if (arg[2] == '\0') /* "--": end of options, argv is not ours */
+			break;
+		name = arg + 2;
+		eq = strchr(name, '=');
+		len = eq ? (unsigned)(eq - name) : (unsigned)strlen(name);
+		if (own_table_has(own_longopts, name, len))
+			continue;
+		for (i = 0; i < ARRAY_SIZE(gnu_longopts); i++) {
+			if (strlen(gnu_longopts[i].name) != len)
+				continue; /* not same length: cannot match */
+			if (strncmp(gnu_longopts[i].name, name, len) != 0)
+				continue;
+			if (strcmp(gnu_longopts[i].applet, key) != 0)
+				continue;
+			found = (int)i;
+			nmatch = 1;
+			break;
+		}
+		if (nmatch == 0) {
+			/* No exact hit; try an unambiguous GNU-style prefix. */
+			for (i = 0; i < ARRAY_SIZE(gnu_longopts); i++) {
+				if (strncmp(gnu_longopts[i].name, name, len) != 0)
+					continue;
+				if (strcmp(gnu_longopts[i].applet, key) != 0)
+					continue;
+				found = (int)i;
+				nmatch++;
+			}
+			if (nmatch > 1)
+				continue; /* ambiguous: let getopt_long complain */
+		}
+		if (found < 0)
+			continue;
+
+		if (!opt_takes_arg(optstring, gnu_longopts[found].opt)) {
+			if (eq) {
+				bb_error_msg_and_die("option '--%s' doesn't allow an argument",
+					gnu_longopts[found].name);
+			}
+			arg[0] = '-';
+			arg[1] = gnu_longopts[found].opt;
+			arg[2] = '\0';
+		} else if (eq) {
+			arg[0] = '-';
+			arg[1] = gnu_longopts[found].opt;
+			overlapping_strcpy(arg + 2, eq + 1);
+		} else {
+			/* "--name value": getopt picks up the next argv element */
+			arg[0] = '-';
+			arg[1] = gnu_longopts[found].opt;
+			arg[2] = '\0';
+		}
+	}
+}

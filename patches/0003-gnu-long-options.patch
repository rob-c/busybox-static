diff --git a/Config.in b/Config.in
index 8955ed3..9189da0 100644
--- a/Config.in
+++ b/Config.in
@@ -66,6 +66,23 @@ config LONG_OPTS
 	Enable this if you want busybox applets to use the gnu --long-option
 	style, in addition to single character -a -b -c style options.
 
+config FEATURE_GNU_LONG_OPTS
+	bool "Accept GNU long options for applets that only parse short ones"
+	default n
+	depends on LONG_OPTS
+	help
+	Many applets parse only short options, so "du --max-depth=1" or
+	"grep --line-number" is rejected even though the same applet has the
+	matching short option. This adds a table of GNU long names to short
+	letters (libbb/gnu_longopts.c) and rewrites argv before getopt32()
+	runs, so no applet source changes are needed.
+
+	Costs about 3k of strings and 760 bytes of code, which came to 704
+	bytes of file size on a Mach-O build. No effect on applets that do
+	not parse options. "--" always ends option processing, and names an
+	applet declares itself take priority, so existing behaviour is
+	unchanged.
+
 config SHOW_USAGE
 	bool "Show applet usage messages"
 	default y
